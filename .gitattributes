# Normalize line endings to LF for cross-platform consistency (avoids CRLF/LF noise on Windows)
* text=auto eol=lf

*.lockb binary diff=lockb

# Golden expectations preserve intentional blank lines at the end of generated files.
examples/**/golden/** whitespace=-blank-at-eof

# Frozen managed MCK kit bytes must match their manifest on every platform.
spec/mck/baseline/kit-2026-09-26/** -text
spec/mck/baseline-ion-2026-09-26/** -text

# Model originals include intentional BOM and CRLF bytes with fixed digests.
spec/workbench/model-originals/0.1.0-draft.1/acceptance/fixtures/** -text
spec/workbench/model-originals/0.1.0-draft.1/acceptance/fixtures/v4-bom-crlf.json whitespace=-blank-at-eol,cr-at-eol

# Toolchain contract fixtures are identified by the SHA-256 of their exact bytes.
docs/spec/toolchain/fixtures/** -text
docs/spec/toolchain/preview/corpus/** -text
# The readiness workflow case lists the SHA-256 of every source and expected file.
spec/toolchain/workflows/** -text

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# The pinned mission-control-tools binary compares the managed OpenSpec files byte for byte.
openspec/schemas/html-design/** text eol=lf
