# Normalize line endings to LF for cross-platform consistency (avoids CRLF/LF noise on Windows)
* text=auto eol=lf

*.lockb binary diff=lockb

# Golden expectations preserve intentional blank lines at the end of generated files.
examples/**/golden/** whitespace=-blank-at-eof

# Vendored web bundles are byte-for-byte build artifacts with provenance hashes.
crates/morphir/src/commands/ui/assets/assets/* binary

# Frozen managed MCK kit bytes must match their manifest on every platform.
spec/mck/baseline/kit-2026-09-26/** -text
spec/mck/baseline-ion-2026-09-26/** -text

# Model originals include intentional BOM and CRLF bytes with fixed digests.
spec/workbench/model-originals/0.1.0-draft.1/acceptance/fixtures/** -text
spec/workbench/model-originals/0.1.0-draft.1/acceptance/fixtures/v4-bom-crlf.json whitespace=-blank-at-eol,cr-at-eol

# Workflow source proofs compare complete files and original JSON token bytes.
crates/morphir-mck/src/workbench/model_originals/workflow/ingress/controls/** -text
crates/morphir-mck/src/workbench/model_originals/workflow/source_proof/controls/** -text
crates/morphir-mck/src/workbench/model_originals/workflow/source_compile/controls/** -text
crates/morphir-mck/src/workbench/model_originals/workflow/raw_boundary_controls/** -text
crates/morphir-mck/src/workbench/model_originals/workflow/observed_controls/** -text
crates/morphir-mck/src/workbench/model_originals/workflow/identity_controls/** -text
crates/morphir-mck/src/workbench/model_originals/workflow/report_controls/** -text
crates/morphir-mck/src/workbench/model_originals/workflow/record_boundary_controls/** -text
crates/morphir-mck/tests/support/workflow_report_controls/** -text
# These literal reply bodies intentionally include CRLF and outer whitespace.
crates/morphir-mck/src/workbench/model_originals/workflow/report_controls/received-reply.payload.json whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
crates/morphir-mck/tests/support/workflow_report_controls/received-reply.payload.json whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
spec/workbench/model-originals/0.1.0-draft.1/reviewed-sources/** -text
crates/morphir-mck/src/workbench/model_originals/workflow/ingress/controls/corpus.json whitespace=cr-at-eol

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads
