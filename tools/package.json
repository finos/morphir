{
	"name": "@morphir/tools",
	"private": true,
	"type": "module",
	"description": "Bun + TypeScript tooling for Morphir specification artifacts.",
	"scripts": {
		"gen:naming-corpus": "bun run gen-naming-corpus.ts",
