            #|    if (side == trade.side) && matchEntityCode trade.entityCode && matchAccount trade.account then
            #|        Just category
            #|
            #|    else
            #|        Nothing
            #|
            #|
            #|{-| Utility type to describe which side the trade is on.
            #|-}
            #|type Side
            #|    = Borrow
            #|    | Loan
            #|
