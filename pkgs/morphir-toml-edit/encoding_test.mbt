// Byte-invalid TOML 1.0 corpus. Same revision and license as conformance_test.mbt.

///|
test "invalid/encoding/bad-codepoint.toml" {
  let bytes = b"\x23\x20\x49\x6e\x76\x61\x6c\x69\x64\x20\x63\x6f\x64\x65\x70\x6f\x69\x6e\x74\x20\x55\x2b\x44\x38\x30\x30\x20\x3a\x20\xed\xa0\x80\x0a"
  let rejected = try {
    ignore(@edit.parse_bytes(bytes))
    false
  } catch {
    @edit.Diagnostic(@edit.InvalidToml, _, _) => true
    _ => false
  }
  assert_true(rejected)
}

