// Generate portable ECMAScript default case tables for Morphir String.
// Elm/core 1.0.5 delegates String.toUpper/Lower to JavaScript.
// Pinned generator runtime: Node Unicode 17.0.
import { writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';

if (process.versions.unicode !== '17.0') {
  throw new Error(`Expected Unicode 17.0, got ${process.versions.unicode}`);
}
const max = 0x10ffff;
const source = [];
source.push('// Generated by tools/generate-case-tables.mjs with Node Unicode 17.0.');
source.push('// Elm/core 1.0.5 delegates default casing to ECMAScript.');
for (const [name, operation] of [['upper', (c: string) => c.toUpperCase()], ['lower', (c: string) => c.toLowerCase()]] as const) {
  source.push('', '///|');
  source.push(`fn ${name}_scalar(code : Int, original : String) -> String {`);
  source.push('  match code {');
  for (let code = 0; code <= max; code++) {
    if (code >= 0xd800 && code <= 0xdfff) continue;
    const character = String.fromCodePoint(code);
    const mapped = operation(character);
    if (mapped !== character) source.push(`    ${code} => ${JSON.stringify(mapped)}`);
  }
  source.push('    _ => original');
  source.push('  }');
  source.push('}');
}
for (const [name, property] of [['cased', 'Cased'], ['case_ignorable', 'Case_Ignorable']]) {
  const regex = new RegExp(`\\p{${property}}`, 'u');
  const ranges = [];
  let start = -1;
  for (let code = 0; code <= max + 1; code++) {
    const hit = code <= max && regex.test(String.fromCodePoint(code));
    if (hit && start < 0) start = code;
    if (!hit && start >= 0) { ranges.push([start, code - 1]); start = -1; }
  }
  source.push('', '///|', `let ${name}_ranges : Array[(Int, Int)] = [`);
  for (const [start, end] of ranges) source.push(`  (${start}, ${end}),`);
  source.push(']');
}
source.push('', '///|', 'fn in_ranges(code : Int, ranges : Array[(Int, Int)]) -> Bool {');
source.push('  let mut low = 0');
source.push('  let mut high = ranges.length()');
source.push('  while low < high {');
source.push('    let mid = low + (high - low) / 2');
source.push('    let (start, end) = ranges[mid]');
source.push('    if code < start {');
source.push('      high = mid');
source.push('    } else if code > end {');
source.push('      low = mid + 1');
source.push('    } else {');
source.push('      return true');
source.push('    }');
source.push('  }');
source.push('  false');
source.push('}');
source.push('', '///|', 'fn is_cased(code : Int) -> Bool {');
source.push('  in_ranges(code, cased_ranges)');
source.push('}');
source.push('', '///|', 'fn is_case_ignorable(code : Int) -> Bool {');
source.push('  in_ranges(code, case_ignorable_ranges)');
source.push('}');
const target = join(dirname(fileURLToPath(import.meta.url)), '..', 'case_tables.mbt');
writeFileSync(target, source.join('\n') + '\n');
