///|
test "generated tests call check_example with literal sources and expectations" {
  let c = parse_chapter(
    "```scheme\n(string-append \"a\" \"\\\"\")\n;; => \"a\\\"\"\n```\n",
  )
  let text = render_examples("README.mbt.md", c)
  assert_true(
    text.has_prefix(
      "// GENERATED by `mise run scheme-docs:generate` from README.mbt.md. Do not edit.\n",
    ),
  )
  assert_true(text.contains("// 1 checked examples; 0 notest blocks.\n"))
  assert_true(text.contains("test \"README.mbt.md example 1 (line 1)\""))
  assert_true(text.contains("          #|(string-append \"a\" \"\\\"\")"))
  assert_true(text.contains("Value(\"\\\"a\\\\\\\"\\\"\")"))
  assert_true(text.contains("fn check_example("))
}

///|
test "difference names the first differing line, ignoring carriage returns" {
  assert_eq(difference("a\nb\n", "a\r\nb\r\n"), None)
  assert_eq(
    difference("a\nb\n", "a\nc\n"),
    Some("line 2: expected `b`, found `c`"),
  )
  assert_eq(
    difference("a\n", "a\nb\n"),
    Some("line 2: expected end of file, found `b`"),
  )
}

///|
test "procedures render a whitebox list only when the chapter has a procedure table" {
  assert_eq(
    render_procedures("README.mbt.md", {
      examples: [],
      skipped: 0,
      procedures: [],
    }),
    None,
  )
  let text = render_procedures("README.mbt.md", {
    examples: [],
    skipped: 0,
    procedures: ["car", "cdr"],
  }).unwrap()
  assert_true(
    text.contains(
      "let documented_procedures : Array[String] = [\"car\", \"cdr\"]",
    ),
  )
}

///|
/// The procedures file generated for `names`.
fn procedures_text(names : Array[String]) -> String {
  render_procedures("README.mbt.md", {
    examples: [],
    skipped: 0,
    procedures: names,
  }).unwrap()
}

///|
test "a procedure list that fits in 80 columns stays on one line" {
  // The declaration takes 48 columns around one name, so a 32-character name makes it 80 wide.
  let name = "x".repeat(32)
  assert_true(
    procedures_text([name]).has_suffix(
      "\nlet documented_procedures : Array[String] = [\"" + name + "\"]\n",
    ),
  )
}

///|
test "a procedure list wider than 80 columns wraps like moon fmt" {
  let name = "x".repeat(33)
  assert_true(
    procedures_text([name]).has_suffix(
      "\nlet documented_procedures : Array[String] = [\n  \"" +
      name +
      "\",\n]\n",
    ),
  )
}

///|
test "a wrapped line takes another name while it is narrower than 80 columns" {
  // A line adds 5 columns to its first name, so a 74-character name leaves it 79 wide and a 75-character one 80.
  let narrow = "a".repeat(74)
  assert_true(
    procedures_text([narrow, "b", "c"]).has_suffix(
      "[\n  \"" + narrow + "\", \"b\",\n  \"c\",\n]\n",
    ),
  )
  let wide = "a".repeat(75)
  assert_true(
    procedures_text([wide, "b", "c"]).has_suffix(
      "[\n  \"" + wide + "\",\n  \"b\", \"c\",\n]\n",
    ),
  )
}

///|
test "literal escapes backslashes, quotes and newlines" {
  assert_eq(literal("a\nb\"c\\d"), "\"a\\nb\\\"c\\\\d\"")
}

///|
test "check messages name the chapter, the example and the generated line" {
  let c = parse_chapter(
    "```scheme\n(+ 1 2)\n;; => 3\n```\n\n```scheme\n(+ 2 2)\n;; => 4\n```\n",
  )
  let expected = render_examples("README.mbt.md", c)
  let file = "docs_examples_test.mbt"
  assert_eq(check_message("README.mbt.md", file, expected, expected), None)
  // A difference inside example 2, whose fence is on chapter line 6.
  let inside = expected.replace_all(old="#|(+ 2 2)", new="#|(+ 2 3)")
  let message = check_message("README.mbt.md", file, expected, inside).unwrap()
  assert_true(
    message.has_prefix(
      "README.mbt.md line 6 (example 2): docs_examples_test.mbt line ",
    ),
  )
  assert_true(
    message.has_suffix(
      ": expected `          #|(+ 2 2)`, found `          #|(+ 2 3)`",
    ),
  )
  // A difference in the expectation of example 1, on the line of its test header block.
  let first = expected.replace_all(old="Value(\"3\")", new="Value(\"4\")")
  assert_true(
    check_message("README.mbt.md", file, expected, first)
    .unwrap()
    .has_prefix(
      "README.mbt.md line 1 (example 1): docs_examples_test.mbt line ",
    ),
  )
  // A difference in the harness names the chapter only.
  let harness_change = expected.replace_all(
    old="priv enum Expect",
    new="enum Expect",
  )
  assert_eq(
    check_message("README.mbt.md", file, expected, harness_change),
    Some(
      "README.mbt.md: docs_examples_test.mbt line 6: expected `priv enum Expect {`, found `enum Expect {`",
    ),
  )
  // A missing generated file differs on its first line.
  assert_true(
    check_message("README.mbt.md", file, expected, "")
    .unwrap()
    .has_prefix(
      "README.mbt.md: docs_examples_test.mbt line 1: expected `// GENERATED",
    ),
  )
}

///|
/// The generated text for a chapter with one failing example whose message is `length` characters long.
fn fails_example(length : Int32) -> String raise {
  let message = "x".repeat(length)
  let source = "```scheme\n(boom)\n;; error: " + message + "\n```\n"
  render_examples("README.mbt.md", parse_chapter(source))
}

///|
test "an expectation that fits in 80 columns stays on one line" {
  // `    Fails("` is 11 columns and `")` is 2 more, so 67 characters make the line 80 wide before its comma.
  let message = "x".repeat(67)
  assert_true(fails_example(67).contains("    Fails(\"" + message + "\"),\n"))
}

///|
test "an expectation wider than 80 columns wraps like moon fmt" {
  let message = "x".repeat(68)
  assert_true(
    fails_example(68).contains(
      "    Fails(\n      \"" + message + "\",\n    ),\n",
    ),
  )
  let long = "y".repeat(90)
  let value = render_examples(
    "README.mbt.md",
    parse_chapter("```scheme\n1\n;; => " + long + "\n```\n"),
  )
  assert_true(value.contains("    Value(\n      \"" + long + "\",\n    ),\n"))
}

///|
test "an expectation's width is counted in UTF-8 bytes, as moon fmt counts it" {
  // `é` is two bytes, so 33 of them and an `a` make the line 80 bytes wide, and 34 make it 82.
  let fits = "é".repeat(33) + "a"
  let fits_text = render_examples(
    "README.mbt.md",
    parse_chapter("```scheme\n1\n;; => " + fits + "\n```\n"),
  )
  assert_true(fits_text.contains("    Value(\"" + fits + "\"),\n"))
  let wide = "é".repeat(34) + "a"
  let wide_text = render_examples(
    "README.mbt.md",
    parse_chapter("```scheme\n1\n;; error: " + wide + "\n```\n"),
  )
  assert_true(
    wide_text.contains("    Fails(\n      \"" + wide + "\",\n    ),\n"),
  )
}

///|
test "a procedure list's width is counted in UTF-8 bytes, as moon fmt counts it" {
  // 16 two-byte names make the one-line declaration 80 bytes wide; one more byte wraps it.
  let fits = "é".repeat(16)
  assert_true(
    procedures_text([fits]).has_suffix(
      "\nlet documented_procedures : Array[String] = [\"" + fits + "\"]\n",
    ),
  )
  let wide = fits + "a"
  assert_true(
    procedures_text([wide]).has_suffix(
      "\nlet documented_procedures : Array[String] = [\n  \"" +
      wide +
      "\",\n]\n",
    ),
  )
  // A wrapped line 79 bytes wide takes another name; one 80 bytes wide does not.
  let narrow = "é".repeat(37)
  assert_true(
    procedures_text([narrow, "b", "c"]).has_suffix(
      "[\n  \"" + narrow + "\", \"b\",\n  \"c\",\n]\n",
    ),
  )
  let full = narrow + "a"
  assert_true(
    procedures_text([full, "b", "c"]).has_suffix(
      "[\n  \"" + full + "\",\n  \"b\", \"c\",\n]\n",
    ),
  )
}

///|
test "the harness silences unused-constructor warnings for any chapter" {
  let only_value = render_examples(
    "README.mbt.md",
    parse_chapter("```scheme\n1\n;; => 1\n```\n"),
  )
  let marked = "\n///|\n#warnings(\"-unused_constructor\")\npriv enum Expect {\n"
  assert_true(only_value.contains(marked))
  assert_true(
    render_examples("README.mbt.md", parse_chapter("")).contains(marked),
  )
}
