  "moonbitlang/x/sys",
  "moonbitlang/async/stdio",
  "finos/morphir-workbench-native" @native,
  "finos/morphir-workbench-native/bridge",
  "finos/morphir-workbench-native-session" @session,
  "finos/morphir-workbench-native-session/response" @reply,
  "finos/morphir-ir/wire",
  "finos/morphir-ir/versions/v4/json" @codec,
  "finos/morphir-moonbit/fixtures",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
}
