supported_targets = "native"

import {
  "finos/morphir-workbench-native-session/response" @reply,
  "finos/morphir-workbench-native-session/workspace-files" @filewire,
  "finos/morphir-engine/workspace" @engine,
  "finos/morphir-workbench/executions",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
}

options(
  "native-stub": [ "filesystem.c" ],
)

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
} for "wbtest"
