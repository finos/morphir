///|
test "definitions-0001 0 canonical" {
  let value = @v4.read_access(
    @wire.parse(
      "{ \"Public\": { \"TypeAliasDefinition\": { \"typeParams\": [], \"typeExp\": \"morphir/SDK:string#string\" } } }",
    ),
    j => @v4.read_documented(j, @v4.read_type_definition),
  )
  let encoded = @v4.write_access(value, v => {
    @v4.write_documented(v, @v4.write_type_definition)
  })
  assert_eq(
    @v4.read_access(encoded, j => {
      @v4.read_documented(j, @v4.read_type_definition)
    }),
    value,
  )
  assert_eq(
    encoded,
    @wire.parse(
      "{ \"Public\": { \"TypeAliasDefinition\": { \"typeParams\": [], \"typeExp\": \"morphir/SDK:string#string\" } } }",
    ),
  )
