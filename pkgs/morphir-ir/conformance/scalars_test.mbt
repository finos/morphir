///|
test "format: historical v1 integer" {
  let version = @wire.read_version(@wire.parse("1"))
  assert_eq(version.to_release_string(), "1.0.0")
  assert_eq(@wire.write_version(version), @wire.parse("1"))
  let result = try {
    version.check_supported()
    "supported"
  } catch {
    error => @wire.diagnostic(error)
  }
  assert_eq(result, "supported")
}

