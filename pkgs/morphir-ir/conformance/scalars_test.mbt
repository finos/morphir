///|
test "JSON root missing formatVersion" {
  let result = try {
    ignore(
      @any_json.read(
        "{\"distribution\":[\"Library\",[[\"example\"]],[],{\"modules\":[]}]}",
      ),
    )
    "accepted"
  } catch {
    error => @wire.diagnostic(error)
  }
  assert_eq(result, "missing_format_version")
}

///|
test "JSON root with duplicate formatVersion" {
  let result = try {
    ignore(
      @any_json.read(
        "{\"formatVersion\":3,\"formatVersion\":3,\"distribution\":[\"Library\",[[\"example\"]],[],{\"modules\":[]}]}",
      ),
    )
    "accepted"
  } catch {
    error => @wire.diagnostic(error)
  }
  assert_eq(result, "duplicate_format_version")
}

