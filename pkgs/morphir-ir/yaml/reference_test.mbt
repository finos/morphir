    (
      "pkg/elm-compat/main/apply-discount.value.yaml", "formatVersion: 4\nname: apply-discount\ndef:\n  Public:\n    doc: \" Apply a percentage discount to a price.\\n\\n    applyDiscount 10 100.0 == 90.0\\n\\n\"\n    ExpressionBody:\n      inputTypes:\n        discount-percent: morphir/SDK:basics#float\n        original-price: morphir/SDK:basics#float\n      outputType: morphir/SDK:basics#float\n      body:\n        LetDefinition:\n          attributes:\n            inferredType: morphir/SDK:basics#float\n          name: discount\n          definition:\n            ExpressionBody:\n              inputTypes: {}\n              outputType: t-8\n              body:\n                Apply:\n                  attributes:\n                    inferredType: morphir/SDK:basics#float\n                  function:\n                    Apply:\n                      attributes:\n                        inferredType:\n                          Function:\n                            parameterType: morphir/SDK:basics#float\n                            returnType: morphir/SDK:basics#float\n                      function:\n                        Reference:\n                          attributes:\n                            inferredType:\n                              Function:\n                                parameterType: morphir/SDK:basics#float\n                                returnType:\n                                  Function:\n                                    parameterType: morphir/SDK:basics#float\n                                    returnType: morphir/SDK:basics#float\n                          fqname: morphir/SDK:basics#multiply\n                      argument:\n                        Variable:\n                          attributes:\n                            inferredType: morphir/SDK:basics#float\n                          name: original-price\n                  argument:\n                    Apply:\n                      attributes:\n                        inferredType: morphir/SDK:basics#float\n                      function:\n                        Apply:\n                          attributes:\n                            inferredType:\n                              Function:\n                                parameterType: morphir/SDK:basics#float\n                                returnType: morphir/SDK:basics#float\n                          function:\n                            Reference:\n                              attributes:\n                                inferredType:\n                                  Function:\n                                    parameterType: morphir/SDK:basics#float\n                                    returnType:\n                                      Function:\n                                        parameterType: morphir/SDK:basics#float\n                                        returnType: morphir/SDK:basics#float\n                              fqname: morphir/SDK:basics#divide\n                          argument:\n                            Variable:\n                              attributes:\n                                inferredType: morphir/SDK:basics#float\n                              name: discount-percent\n                      argument:\n                        Literal:\n                          attributes:\n                            inferredType: morphir/SDK:basics#float\n                          literal:\n                            FloatLiteral: 100.0\n          in:\n            Apply:\n              attributes:\n                inferredType: morphir/SDK:basics#float\n              function:\n                Apply:\n                  attributes:\n                    inferredType:\n                      Function:\n                        parameterType: morphir/SDK:basics#float\n                        returnType: morphir/SDK:basics#float\n                  function:\n                    Reference:\n                      attributes:\n                        inferredType:\n                          Function:\n                            parameterType: morphir/SDK:basics#float\n                            returnType:\n                              Function:\n                                parameterType: morphir/SDK:basics#float\n                                returnType: morphir/SDK:basics#float\n                      fqname: morphir/SDK:basics#subtract\n                  argument:\n                    Variable:\n                      attributes:\n                        inferredType: morphir/SDK:basics#float\n                      name: original-price\n              argument:\n                Variable:\n                  attributes:\n                    inferredType: morphir/SDK:basics#float\n                  name: discount\n",
    ),
    (
      "pkg/elm-compat/main/calculate-total.value.yaml", "formatVersion: 4\nname: calculate-total\ndef:\n  Public:\n    doc: \" Calculate the total price of an order.\\n\\n    calculateTotal { orderId = \\\"1\\\", products = [ ( product, 2 ) ], status = Pending }\\n\\n\"\n    ExpressionBody:\n      inputTypes:\n        order: elm-compat:main#customer-order\n      outputType: morphir/SDK:basics#float\n      body:\n        Apply:\n          attributes:\n            inferredType: morphir/SDK:basics#float\n          function:\n            Reference:\n              attributes:\n                inferredType:\n                  Function:\n                    parameterType:\n                      Reference: [\"morphir/SDK:list#list\", \"morphir/SDK:basics#float\"]\n                    returnType: morphir/SDK:basics#float\n              fqname: morphir/SDK:list#sum\n          argument:\n            Apply:\n              attributes:\n                inferredType:\n                  Reference: [\"morphir/SDK:list#list\", \"morphir/SDK:basics#float\"]\n              function:\n                Apply:\n                  attributes:\n                    inferredType:\n                      Function:\n                        parameterType:\n                          Reference:\n                            - morphir/SDK:list#list\n                            - Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                        returnType:\n                          Reference: [\"morphir/SDK:list#list\", \"morphir/SDK:basics#float\"]\n                  function:\n                    Reference:\n                      attributes:\n                        inferredType:\n                          Function:\n                            parameterType:\n                              Function:\n                                parameterType:\n                                  Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                                returnType: morphir/SDK:basics#float\n                            returnType:\n                              Function:\n                                parameterType:\n                                  Reference:\n                                    - morphir/SDK:list#list\n                                    - Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                                returnType:\n                                  Reference: [\"morphir/SDK:list#list\", \"morphir/SDK:basics#float\"]\n                      fqname: morphir/SDK:list#map\n                  argument:\n                    Lambda:\n                      attributes:\n                        inferredType:\n                          Function:\n                            parameterType:\n                              Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                            returnType: morphir/SDK:basics#float\n                      pattern:\n                        TuplePattern:\n                          attributes:\n                            inferredType:\n                              Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                          patterns:\n                            - AsPattern:\n                                attributes:\n                                  inferredType: elm-compat:main#product\n                                pattern:\n                                  WildcardPattern:\n                                    attributes:\n                                      inferredType: elm-compat:main#product\n                                name: product\n                            - AsPattern:\n                                attributes:\n                                  inferredType: morphir/SDK:basics#int\n                                pattern:\n                                  WildcardPattern:\n                                    attributes:\n                                      inferredType: morphir/SDK:basics#int\n                                name: qty\n                      body:\n                        Apply:\n                          attributes:\n                            inferredType: morphir/SDK:basics#float\n                          function:\n                            Apply:\n                              attributes:\n                                inferredType:\n                                  Function:\n                                    parameterType: morphir/SDK:basics#float\n                                    returnType: morphir/SDK:basics#float\n                              function:\n                                Reference:\n                                  attributes:\n                                    inferredType:\n                                      Function:\n                                        parameterType: morphir/SDK:basics#float\n                                        returnType:\n                                          Function:\n                                            parameterType: morphir/SDK:basics#float\n                                            returnType: morphir/SDK:basics#float\n                                  fqname: morphir/SDK:basics#multiply\n                              argument:\n                                Field:\n                                  attributes:\n                                    inferredType: morphir/SDK:basics#float\n                                  target:\n                                    Variable:\n                                      attributes:\n                                        inferredType: elm-compat:main#product\n                                      name: product\n                                  name: price\n                          argument:\n                            Apply:\n                              attributes:\n                                inferredType: morphir/SDK:basics#float\n                              function:\n                                Reference:\n                                  attributes:\n                                    inferredType:\n                                      Function:\n                                        parameterType: morphir/SDK:basics#int\n                                        returnType: morphir/SDK:basics#float\n                                  fqname: morphir/SDK:basics#to-float\n                              argument:\n                                Variable:\n                                  attributes:\n                                    inferredType: morphir/SDK:basics#int\n                                  name: qty\n              argument:\n                Field:\n                  attributes:\n                    inferredType:\n                      Reference:\n                        - morphir/SDK:list#list\n                        - Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                  target:\n                    Variable:\n                      attributes:\n                        inferredType: elm-compat:main#customer-order\n                      name: order\n                  name: products\n",
