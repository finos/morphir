// Published upstream pair, frozen independently before decoder observations.

///|
test "published populated YAML tree matches its single document" {
  let files : Map[String, String] = Map([
    (
      "manifest.yaml", "formatVersion: 4\ndistribution: Library\npackage: elm-compat\npathBudget: 4000\n",
    ),
    (
      "pkg/elm-compat/api/api-error.type.yaml", "formatVersion: 4\nname: api-error\ndef:\n  Public:\n    doc: \" Possible API errors.\\n\"\n    CustomTypeDefinition:\n      typeParams: []\n      access: Public\n      constructors:\n        internal-error: []\n        invalid-request: [[arg-1, \"morphir/SDK:string#string\"]]\n        order-not-found: [[arg-1, \"morphir/SDK:string#string\"]]\n",
    ),
    (
      "pkg/elm-compat/api/create-order.value.yaml", "formatVersion: 4\nname: create-order\ndef:\n  Public:\n    doc: \" Create a new order from a list of products.\\n\"\n    ExpressionBody:\n      inputTypes:\n        order-id: morphir/SDK:string#string\n        products:\n          Reference:\n            - morphir/SDK:list#list\n            - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n      outputType: elm-compat:main#customer-order\n      body:\n        Record:\n          attributes:\n            inferredType: elm-compat:main#customer-order\n          fields:\n            order-id:\n              Variable:\n                attributes:\n                  inferredType: morphir/SDK:string#string\n                name: order-id\n            products:\n              Variable:\n                attributes:\n                  inferredType:\n                    Reference:\n                      - morphir/SDK:list#list\n                      - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                name: products\n            status:\n              Constructor:\n                attributes:\n                  inferredType: elm-compat:main#order-status\n                fqname: elm-compat:main#pending\n",
    ),
    (
      "pkg/elm-compat/api/get-order-status.value.yaml", "formatVersion: 4\nname: get-order-status\ndef:\n  Public:\n    doc: \" Get the status of an order as a string response.\\n\"\n    ExpressionBody:\n      inputTypes:\n        order: elm-compat:main#customer-order\n      outputType: elm-compat:api#response\n      body:\n        LetDefinition:\n          attributes:\n            inferredType: elm-compat:api#response\n          name: status-str\n          definition:\n            ExpressionBody:\n              inputTypes: {}\n              outputType: morphir/SDK:string#string\n              body:\n                PatternMatch:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n                  value:\n                    Field:\n                      attributes:\n                        inferredType: elm-compat:main#order-status\n                      target:\n                        Variable:\n                          attributes:\n                            inferredType: elm-compat:main#customer-order\n                          name: order\n                      name: status\n                  cases:\n                    - pattern:\n                        ConstructorPattern:\n                          attributes:\n                            inferredType: elm-compat:main#order-status\n                          fqname: elm-compat:main#pending\n                          patterns: []\n                      body:\n                        Literal:\n                          attributes:\n                            inferredType: morphir/SDK:string#string\n                          literal:\n                            StringLiteral: Order is pending\n                    - pattern:\n                        ConstructorPattern:\n                          attributes:\n                            inferredType: elm-compat:main#order-status\n                          fqname: elm-compat:main#confirmed\n                          patterns: []\n                      body:\n                        Literal:\n                          attributes:\n                            inferredType: morphir/SDK:string#string\n                          literal:\n                            StringLiteral: Order has been confirmed\n                    - pattern:\n                        ConstructorPattern:\n                          attributes:\n                            inferredType: elm-compat:main#order-status\n                          fqname: elm-compat:main#shipped\n                          patterns: []\n                      body:\n                        Literal:\n                          attributes:\n                            inferredType: morphir/SDK:string#string\n                          literal:\n                            StringLiteral: Order has been shipped\n                    - pattern:\n                        ConstructorPattern:\n                          attributes:\n                            inferredType: elm-compat:main#order-status\n                          fqname: elm-compat:main#delivered\n                          patterns: []\n                      body:\n                        Literal:\n                          attributes:\n                            inferredType: morphir/SDK:string#string\n                          literal:\n                            StringLiteral: Order has been delivered\n                    - pattern:\n                        ConstructorPattern:\n                          attributes:\n                            inferredType: elm-compat:main#order-status\n                          fqname: elm-compat:main#cancelled\n                          patterns: []\n                      body:\n                        Literal:\n                          attributes:\n                            inferredType: morphir/SDK:string#string\n                          literal:\n                            StringLiteral: Order was cancelled\n          in:\n            Record:\n              attributes:\n                inferredType: elm-compat:api#response\n              fields:\n                message:\n                  Variable:\n                    attributes:\n                      inferredType: morphir/SDK:string#string\n                    name: status-str\n                order-id:\n                  Apply:\n                    attributes:\n                      inferredType:\n                        Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                    function:\n                      Constructor:\n                        attributes:\n                          inferredType:\n                            Function:\n                              parameterType: morphir/SDK:string#string\n                              returnType:\n                                Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                        fqname: morphir/SDK:maybe#just\n                    argument:\n                      Field:\n                        attributes:\n                          inferredType: morphir/SDK:string#string\n                        target:\n                          Variable:\n                            attributes:\n                              inferredType: elm-compat:main#customer-order\n                            name: order\n                        name: order-id\n                success:\n                  Literal:\n                    attributes:\n                      inferredType: morphir/SDK:basics#bool\n                    literal:\n                      BoolLiteral: true\n",
    ),
    (
      "pkg/elm-compat/api/module.yaml", "formatVersion: 4\npath: api\ndoc: \" API module demonstrating request/response patterns.\\n\\nThis module provides types and functions for a simple API layer,\\ndemonstrating how Morphir handles common API patterns.\\n\"\ntypes: [api-error, request, response]\nvalues: [create-order, get-order-status, process-request]\n",
    ),
    (
      "pkg/elm-compat/api/process-request.value.yaml", "formatVersion: 4\nname: process-request\ndef:\n  Public:\n    doc: \" Process an API request and return a response.\\n\"\n    ExpressionBody:\n      inputTypes:\n        request: elm-compat:api#request\n      outputType: elm-compat:api#response\n      body:\n        PatternMatch:\n          attributes:\n            inferredType: elm-compat:api#response\n          value:\n            Field:\n              attributes:\n                inferredType: morphir/SDK:string#string\n              target:\n                Variable:\n                  attributes:\n                    inferredType: elm-compat:api#request\n                  name: request\n              name: action\n          cases:\n            - pattern:\n                LiteralPattern:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n                  literal:\n                    StringLiteral: create\n              body:\n                IfThenElse:\n                  attributes:\n                    inferredType: elm-compat:api#response\n                  condition:\n                    Apply:\n                      attributes:\n                        inferredType: morphir/SDK:basics#bool\n                      function:\n                        Reference:\n                          attributes:\n                            inferredType:\n                              Function:\n                                parameterType:\n                                  Reference:\n                                    - morphir/SDK:list#list\n                                    - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                returnType: morphir/SDK:basics#bool\n                          fqname: morphir/SDK:list#is-empty\n                      argument:\n                        Field:\n                          attributes:\n                            inferredType:\n                              Reference:\n                                - morphir/SDK:list#list\n                                - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                          target:\n                            Variable:\n                              attributes:\n                                inferredType: elm-compat:api#request\n                              name: request\n                          name: products\n                  then:\n                    Record:\n                      attributes:\n                        inferredType: elm-compat:api#response\n                      fields:\n                        message:\n                          Literal:\n                            attributes:\n                              inferredType: morphir/SDK:string#string\n                            literal:\n                              StringLiteral: Cannot create order with no products\n                        order-id:\n                          Constructor:\n                            attributes:\n                              inferredType:\n                                Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                            fqname: morphir/SDK:maybe#nothing\n                        success:\n                          Literal:\n                            attributes:\n                              inferredType: morphir/SDK:basics#bool\n                            literal:\n                              BoolLiteral: false\n                  else:\n                    Record:\n                      attributes:\n                        inferredType: elm-compat:api#response\n                      fields:\n                        message:\n                          Literal:\n                            attributes:\n                              inferredType: morphir/SDK:string#string\n                            literal:\n                              StringLiteral: Order created successfully\n                        order-id:\n                          Apply:\n                            attributes:\n                              inferredType:\n                                Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                            function:\n                              Constructor:\n                                attributes:\n                                  inferredType:\n                                    Function:\n                                      parameterType: morphir/SDK:string#string\n                                      returnType:\n                                        Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                fqname: morphir/SDK:maybe#just\n                            argument:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: new-order-id\n                        success:\n                          Literal:\n                            attributes:\n                              inferredType: morphir/SDK:basics#bool\n                            literal:\n                              BoolLiteral: true\n            - pattern:\n                LiteralPattern:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n                  literal:\n                    StringLiteral: status\n              body:\n                PatternMatch:\n                  attributes:\n                    inferredType: elm-compat:api#response\n                  value:\n                    Field:\n                      attributes:\n                        inferredType:\n                          Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                      target:\n                        Variable:\n                          attributes:\n                            inferredType: elm-compat:api#request\n                          name: request\n                      name: order-id\n                  cases:\n                    - pattern:\n                        ConstructorPattern:\n                          attributes:\n                            inferredType:\n                              Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                          fqname: morphir/SDK:maybe#just\n                          patterns:\n                            - AsPattern:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                pattern:\n                                  WildcardPattern:\n                                    attributes:\n                                      inferredType: morphir/SDK:string#string\n                                name: id\n                      body:\n                        Record:\n                          attributes:\n                            inferredType: elm-compat:api#response\n                          fields:\n                            message:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: Order status retrieved\n                            order-id:\n                              Apply:\n                                attributes:\n                                  inferredType:\n                                    Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                function:\n                                  Constructor:\n                                    attributes:\n                                      inferredType:\n                                        Function:\n                                          parameterType: morphir/SDK:string#string\n                                          returnType:\n                                            Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                    fqname: morphir/SDK:maybe#just\n                                argument:\n                                  Variable:\n                                    attributes:\n                                      inferredType: morphir/SDK:string#string\n                                    name: id\n                            success:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:basics#bool\n                                literal:\n                                  BoolLiteral: true\n                    - pattern:\n                        ConstructorPattern:\n                          attributes:\n                            inferredType:\n                              Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                          fqname: morphir/SDK:maybe#nothing\n                          patterns: []\n                      body:\n                        Record:\n                          attributes:\n                            inferredType: elm-compat:api#response\n                          fields:\n                            message:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: Order ID required for status check\n                            order-id:\n                              Constructor:\n                                attributes:\n                                  inferredType:\n                                    Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                fqname: morphir/SDK:maybe#nothing\n                            success:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:basics#bool\n                                literal:\n                                  BoolLiteral: false\n            - pattern:\n                WildcardPattern:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n              body:\n                Record:\n                  attributes:\n                    inferredType: elm-compat:api#response\n                  fields:\n                    message:\n                      Apply:\n                        attributes:\n                          inferredType: morphir/SDK:string#string\n                        function:\n                          Apply:\n                            attributes:\n                              inferredType:\n                                Function:\n                                  parameterType: morphir/SDK:string#string\n                                  returnType: morphir/SDK:string#string\n                            function:\n                              Reference:\n                                attributes:\n                                  inferredType:\n                                    Function:\n                                      parameterType: morphir/SDK:string#string\n                                      returnType:\n                                        Function:\n                                          parameterType: morphir/SDK:string#string\n                                          returnType: morphir/SDK:string#string\n                                fqname: morphir/SDK:basics#append\n                            argument:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: \"Unknown action: \"\n                        argument:\n                          Field:\n                            attributes:\n                              inferredType: morphir/SDK:string#string\n                            target:\n                              Variable:\n                                attributes:\n                                  inferredType: elm-compat:api#request\n                                name: request\n                            name: action\n                    order-id:\n                      Constructor:\n                        attributes:\n                          inferredType:\n                            Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                        fqname: morphir/SDK:maybe#nothing\n                    success:\n                      Literal:\n                        attributes:\n                          inferredType: morphir/SDK:basics#bool\n                        literal:\n                          BoolLiteral: false\n",
    ),
    (
      "pkg/elm-compat/api/request.type.yaml", "formatVersion: 4\nname: request\ndef:\n  Public:\n    doc: \" Represents an API request to create or modify an order.\\n\"\n    TypeAliasDefinition:\n      typeParams: []\n      typeExp:\n        Record:\n          fields:\n            action: morphir/SDK:string#string\n            order-id:\n              Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n            products:\n              Reference:\n                - morphir/SDK:list#list\n                - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n",
