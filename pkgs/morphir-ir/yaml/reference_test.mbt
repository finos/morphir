    (
      "pkg/elm-compat/main/customer-order.type.yaml", "formatVersion: 4\nname: customer-order\ndef:\n  Public:\n    doc: \" A customer order containing products and quantities.\\n\"\n    TypeAliasDefinition:\n      typeParams: []\n      typeExp:\n        Record:\n          fields:\n            order-id: morphir/SDK:string#string\n            products:\n              Reference:\n                - morphir/SDK:list#list\n                - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n            status: elm-compat:main#order-status\n",
    ),
    (
      "pkg/elm-compat/main/is-valid-order.value.yaml", "formatVersion: 4\nname: is-valid-order\ndef:\n  Public:\n    doc: \" Check if an order is valid (has at least one product with positive quantity).\\n\"\n    ExpressionBody:\n      inputTypes:\n        order: elm-compat:main#customer-order\n      outputType: morphir/SDK:basics#bool\n      body:\n        PatternMatch:\n          attributes:\n            inferredType: morphir/SDK:basics#bool\n          value:\n            Field:\n              attributes:\n                inferredType:\n                  Reference:\n                    - morphir/SDK:list#list\n                    - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n              target:\n                Variable:\n                  attributes:\n                    inferredType: elm-compat:main#customer-order\n                  name: order\n              name: products\n          cases:\n            - pattern:\n                EmptyListPattern:\n                  attributes:\n                    inferredType:\n                      Reference:\n                        - morphir/SDK:list#list\n                        - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n              body:\n                Literal:\n                  attributes:\n                    inferredType: morphir/SDK:basics#bool\n                  literal:\n                    BoolLiteral: false\n            - pattern:\n                WildcardPattern:\n                  attributes:\n                    inferredType:\n                      Reference:\n                        - morphir/SDK:list#list\n                        - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n              body:\n                Apply:\n                  attributes:\n                    inferredType: morphir/SDK:basics#bool\n                  function:\n                    Apply:\n                      attributes:\n                        inferredType:\n                          Function:\n                            parameterType:\n                              Reference:\n                                - morphir/SDK:list#list\n                                - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                            returnType: morphir/SDK:basics#bool\n                      function:\n                        Reference:\n                          attributes:\n                            inferredType:\n                              Function:\n                                parameterType:\n                                  Function:\n                                    parameterType:\n                                      Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                    returnType: morphir/SDK:basics#bool\n                                returnType:\n                                  Function:\n                                    parameterType:\n                                      Reference:\n                                        - morphir/SDK:list#list\n                                        - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                    returnType: morphir/SDK:basics#bool\n                          fqname: morphir/SDK:list#all\n                      argument:\n                        Lambda:\n                          attributes:\n                            inferredType:\n                              Function:\n                                parameterType:\n                                  Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                returnType: morphir/SDK:basics#bool\n                          pattern:\n                            TuplePattern:\n                              attributes:\n                                inferredType:\n                                  Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                              patterns:\n                                - WildcardPattern:\n                                    attributes:\n                                      inferredType: elm-compat:main#product\n                                - AsPattern:\n                                    attributes:\n                                      inferredType: elm-compat:main#quantity\n                                    pattern:\n                                      WildcardPattern:\n                                        attributes:\n                                          inferredType: elm-compat:main#quantity\n                                    name: qty\n                          body:\n                            Apply:\n                              attributes:\n                                inferredType: morphir/SDK:basics#bool\n                              function:\n                                Apply:\n                                  attributes:\n                                    inferredType:\n                                      Function:\n                                        parameterType: elm-compat:main#quantity\n                                        returnType: morphir/SDK:basics#bool\n                                  function:\n                                    Reference:\n                                      attributes:\n                                        inferredType:\n                                          Function:\n                                            parameterType: elm-compat:main#quantity\n                                            returnType:\n                                              Function:\n                                                parameterType: elm-compat:main#quantity\n                                                returnType: morphir/SDK:basics#bool\n                                      fqname: morphir/SDK:basics#greater-than\n                                  argument:\n                                    Variable:\n                                      attributes:\n                                        inferredType: elm-compat:main#quantity\n                                      name: qty\n                              argument:\n                                Literal:\n                                  attributes:\n                                    inferredType: elm-compat:main#quantity\n                                  literal:\n                                    IntegerLiteral: 0\n                  argument:\n                    Field:\n                      attributes:\n                        inferredType:\n                          Reference:\n                            - morphir/SDK:list#list\n                            - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                      target:\n                        Variable:\n                          attributes:\n                            inferredType: elm-compat:main#customer-order\n                          name: order\n                      name: products\n",
    ),
    (
      "pkg/elm-compat/main/module.yaml", "formatVersion: 4\npath: main\ndoc: \" Main module demonstrating Morphir-compatible Elm types and functions.\\n\\nThis module provides a simple e-commerce domain model for testing\\nthe morphir-elm toolchain integration.\\n\"\ntypes: [customer-order, order-status, product, product-id, quantity]\nvalues: [apply-discount, calculate-total, is-valid-order, order-status-to-string]\n",
    ),
    (
      "pkg/elm-compat/main/order-status-to-string.value.yaml", "formatVersion: 4\nname: order-status-to-string\ndef:\n  Public:\n    doc: \" Convert an order status to a human-readable string.\\n\"\n    ExpressionBody:\n      inputTypes:\n        status: elm-compat:main#order-status\n      outputType: morphir/SDK:string#string\n      body:\n        PatternMatch:\n          attributes:\n            inferredType: morphir/SDK:string#string\n          value:\n            Variable:\n              attributes:\n                inferredType: elm-compat:main#order-status\n              name: status\n          cases:\n            - pattern:\n                ConstructorPattern:\n                  attributes:\n                    inferredType: elm-compat:main#order-status\n                  fqname: elm-compat:main#pending\n                  patterns: []\n              body:\n                Literal:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n                  literal:\n                    StringLiteral: Pending\n            - pattern:\n                ConstructorPattern:\n                  attributes:\n                    inferredType: elm-compat:main#order-status\n                  fqname: elm-compat:main#confirmed\n                  patterns: []\n              body:\n                Literal:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n                  literal:\n                    StringLiteral: Confirmed\n            - pattern:\n                ConstructorPattern:\n                  attributes:\n                    inferredType: elm-compat:main#order-status\n                  fqname: elm-compat:main#shipped\n                  patterns: []\n              body:\n                Literal:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n                  literal:\n                    StringLiteral: Shipped\n            - pattern:\n                ConstructorPattern:\n                  attributes:\n                    inferredType: elm-compat:main#order-status\n                  fqname: elm-compat:main#delivered\n                  patterns: []\n              body:\n                Literal:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n                  literal:\n                    StringLiteral: Delivered\n            - pattern:\n                ConstructorPattern:\n                  attributes:\n                    inferredType: elm-compat:main#order-status\n                  fqname: elm-compat:main#cancelled\n                  patterns: []\n              body:\n                Literal:\n                  attributes:\n                    inferredType: morphir/SDK:string#string\n                  literal:\n                    StringLiteral: Cancelled\n",
    ),
    (
      "pkg/elm-compat/main/order-status.type.yaml", "formatVersion: 4\nname: order-status\ndef:\n  Public:\n    doc: \" Possible states of an order.\\n\"\n    CustomTypeDefinition:\n      typeParams: []\n      access: Public\n      constructors:\n        cancelled: []\n        confirmed: []\n        delivered: []\n        pending: []\n        shipped: []\n",
    ),
    (
      "pkg/elm-compat/main/product-id.type.yaml", "formatVersion: 4\nname: product-id\ndef:\n  Public:\n    doc: \" A unique identifier for products.\\n\"\n    TypeAliasDefinition:\n      typeParams: []\n      typeExp: morphir/SDK:string#string\n",
    ),
    (
      "pkg/elm-compat/main/product.type.yaml", "formatVersion: 4\nname: product\ndef:\n  Public:\n    doc: \" A product with price information.\\n\"\n    TypeAliasDefinition:\n      typeParams: []\n      typeExp:\n        Record:\n          fields:\n            id: elm-compat:main#product-id\n            name: morphir/SDK:string#string\n            price: morphir/SDK:basics#float\n",
    ),
    (
      "pkg/elm-compat/main/quantity.type.yaml", "formatVersion: 4\nname: quantity\ndef:\n  Public:\n    doc: \" Represents a quantity of items.\\n\"\n    TypeAliasDefinition:\n      typeParams: []\n      typeExp: morphir/SDK:basics#int\n",
    ),
  ])
  let single = "formatVersion: 4\ndistribution:\n  Library:\n    packageName: elm-compat\n    dependencies: {}\n    def:\n      modules:\n        api:\n          Public:\n            types:\n              api-error:\n                Public:\n                  doc: \" Possible API errors.\\n\"\n                  CustomTypeDefinition:\n                    typeParams: []\n                    access: Public\n                    constructors:\n                      internal-error: []\n                      invalid-request: [[arg-1, \"morphir/SDK:string#string\"]]\n                      order-not-found: [[arg-1, \"morphir/SDK:string#string\"]]\n              request:\n                Public:\n                  doc: \" Represents an API request to create or modify an order.\\n\"\n                  TypeAliasDefinition:\n                    typeParams: []\n                    typeExp:\n                      Record:\n                        fields:\n                          action: morphir/SDK:string#string\n                          order-id:\n                            Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                          products:\n                            Reference:\n                              - morphir/SDK:list#list\n                              - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n              response:\n                Public:\n                  doc: \" Represents an API response.\\n\"\n                  TypeAliasDefinition:\n                    typeParams: []\n                    typeExp:\n                      Record:\n                        fields:\n                          success: morphir/SDK:basics#bool\n                          message: morphir/SDK:string#string\n                          order-id:\n                            Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n            values:\n              create-order:\n                Public:\n                  doc: \" Create a new order from a list of products.\\n\"\n                  ExpressionBody:\n                    inputTypes:\n                      order-id: morphir/SDK:string#string\n                      products:\n                        Reference:\n                          - morphir/SDK:list#list\n                          - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                    outputType: elm-compat:main#customer-order\n                    body:\n                      Record:\n                        attributes:\n                          inferredType: elm-compat:main#customer-order\n                        fields:\n                          order-id:\n                            Variable:\n                              attributes:\n                                inferredType: morphir/SDK:string#string\n                              name: order-id\n                          products:\n                            Variable:\n                              attributes:\n                                inferredType:\n                                  Reference:\n                                    - morphir/SDK:list#list\n                                    - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                              name: products\n                          status:\n                            Constructor:\n                              attributes:\n                                inferredType: elm-compat:main#order-status\n                              fqname: elm-compat:main#pending\n              get-order-status:\n                Public:\n                  doc: \" Get the status of an order as a string response.\\n\"\n                  ExpressionBody:\n                    inputTypes:\n                      order: elm-compat:main#customer-order\n                    outputType: elm-compat:api#response\n                    body:\n                      LetDefinition:\n                        attributes:\n                          inferredType: elm-compat:api#response\n                        name: status-str\n                        definition:\n                          ExpressionBody:\n                            inputTypes: {}\n                            outputType: morphir/SDK:string#string\n                            body:\n                              PatternMatch:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                value:\n                                  Field:\n                                    attributes:\n                                      inferredType: elm-compat:main#order-status\n                                    target:\n                                      Variable:\n                                        attributes:\n                                          inferredType: elm-compat:main#customer-order\n                                        name: order\n                                    name: status\n                                cases:\n                                  - pattern:\n                                      ConstructorPattern:\n                                        attributes:\n                                          inferredType: elm-compat:main#order-status\n                                        fqname: elm-compat:main#pending\n                                        patterns: []\n                                    body:\n                                      Literal:\n                                        attributes:\n                                          inferredType: morphir/SDK:string#string\n                                        literal:\n                                          StringLiteral: Order is pending\n                                  - pattern:\n                                      ConstructorPattern:\n                                        attributes:\n                                          inferredType: elm-compat:main#order-status\n                                        fqname: elm-compat:main#confirmed\n                                        patterns: []\n                                    body:\n                                      Literal:\n                                        attributes:\n                                          inferredType: morphir/SDK:string#string\n                                        literal:\n                                          StringLiteral: Order has been confirmed\n                                  - pattern:\n                                      ConstructorPattern:\n                                        attributes:\n                                          inferredType: elm-compat:main#order-status\n                                        fqname: elm-compat:main#shipped\n                                        patterns: []\n                                    body:\n                                      Literal:\n                                        attributes:\n                                          inferredType: morphir/SDK:string#string\n                                        literal:\n                                          StringLiteral: Order has been shipped\n                                  - pattern:\n                                      ConstructorPattern:\n                                        attributes:\n                                          inferredType: elm-compat:main#order-status\n                                        fqname: elm-compat:main#delivered\n                                        patterns: []\n                                    body:\n                                      Literal:\n                                        attributes:\n                                          inferredType: morphir/SDK:string#string\n                                        literal:\n                                          StringLiteral: Order has been delivered\n                                  - pattern:\n                                      ConstructorPattern:\n                                        attributes:\n                                          inferredType: elm-compat:main#order-status\n                                        fqname: elm-compat:main#cancelled\n                                        patterns: []\n                                    body:\n                                      Literal:\n                                        attributes:\n                                          inferredType: morphir/SDK:string#string\n                                        literal:\n                                          StringLiteral: Order was cancelled\n                        in:\n                          Record:\n                            attributes:\n                              inferredType: elm-compat:api#response\n                            fields:\n                              message:\n                                Variable:\n                                  attributes:\n                                    inferredType: morphir/SDK:string#string\n                                  name: status-str\n                              order-id:\n                                Apply:\n                                  attributes:\n                                    inferredType:\n                                      Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                  function:\n                                    Constructor:\n                                      attributes:\n                                        inferredType:\n                                          Function:\n                                            parameterType: morphir/SDK:string#string\n                                            returnType:\n                                              Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                      fqname: morphir/SDK:maybe#just\n                                  argument:\n                                    Field:\n                                      attributes:\n                                        inferredType: morphir/SDK:string#string\n                                      target:\n                                        Variable:\n                                          attributes:\n                                            inferredType: elm-compat:main#customer-order\n                                          name: order\n                                      name: order-id\n                              success:\n                                Literal:\n                                  attributes:\n                                    inferredType: morphir/SDK:basics#bool\n                                  literal:\n                                    BoolLiteral: true\n              process-request:\n                Public:\n                  doc: \" Process an API request and return a response.\\n\"\n                  ExpressionBody:\n                    inputTypes:\n                      request: elm-compat:api#request\n                    outputType: elm-compat:api#response\n                    body:\n                      PatternMatch:\n                        attributes:\n                          inferredType: elm-compat:api#response\n                        value:\n                          Field:\n                            attributes:\n                              inferredType: morphir/SDK:string#string\n                            target:\n                              Variable:\n                                attributes:\n                                  inferredType: elm-compat:api#request\n                                name: request\n                            name: action\n                        cases:\n                          - pattern:\n                              LiteralPattern:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: create\n                            body:\n                              IfThenElse:\n                                attributes:\n                                  inferredType: elm-compat:api#response\n                                condition:\n                                  Apply:\n                                    attributes:\n                                      inferredType: morphir/SDK:basics#bool\n                                    function:\n                                      Reference:\n                                        attributes:\n                                          inferredType:\n                                            Function:\n                                              parameterType:\n                                                Reference:\n                                                  - morphir/SDK:list#list\n                                                  - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                              returnType: morphir/SDK:basics#bool\n                                        fqname: morphir/SDK:list#is-empty\n                                    argument:\n                                      Field:\n                                        attributes:\n                                          inferredType:\n                                            Reference:\n                                              - morphir/SDK:list#list\n                                              - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                        target:\n                                          Variable:\n                                            attributes:\n                                              inferredType: elm-compat:api#request\n                                            name: request\n                                        name: products\n                                then:\n                                  Record:\n                                    attributes:\n                                      inferredType: elm-compat:api#response\n                                    fields:\n                                      message:\n                                        Literal:\n                                          attributes:\n                                            inferredType: morphir/SDK:string#string\n                                          literal:\n                                            StringLiteral: Cannot create order with no products\n                                      order-id:\n                                        Constructor:\n                                          attributes:\n                                            inferredType:\n                                              Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                          fqname: morphir/SDK:maybe#nothing\n                                      success:\n                                        Literal:\n                                          attributes:\n                                            inferredType: morphir/SDK:basics#bool\n                                          literal:\n                                            BoolLiteral: false\n                                else:\n                                  Record:\n                                    attributes:\n                                      inferredType: elm-compat:api#response\n                                    fields:\n                                      message:\n                                        Literal:\n                                          attributes:\n                                            inferredType: morphir/SDK:string#string\n                                          literal:\n                                            StringLiteral: Order created successfully\n                                      order-id:\n                                        Apply:\n                                          attributes:\n                                            inferredType:\n                                              Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                          function:\n                                            Constructor:\n                                              attributes:\n                                                inferredType:\n                                                  Function:\n                                                    parameterType: morphir/SDK:string#string\n                                                    returnType:\n                                                      Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                              fqname: morphir/SDK:maybe#just\n                                          argument:\n                                            Literal:\n                                              attributes:\n                                                inferredType: morphir/SDK:string#string\n                                              literal:\n                                                StringLiteral: new-order-id\n                                      success:\n                                        Literal:\n                                          attributes:\n                                            inferredType: morphir/SDK:basics#bool\n                                          literal:\n                                            BoolLiteral: true\n                          - pattern:\n                              LiteralPattern:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: status\n                            body:\n                              PatternMatch:\n                                attributes:\n                                  inferredType: elm-compat:api#response\n                                value:\n                                  Field:\n                                    attributes:\n                                      inferredType:\n                                        Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                    target:\n                                      Variable:\n                                        attributes:\n                                          inferredType: elm-compat:api#request\n                                        name: request\n                                    name: order-id\n                                cases:\n                                  - pattern:\n                                      ConstructorPattern:\n                                        attributes:\n                                          inferredType:\n                                            Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                        fqname: morphir/SDK:maybe#just\n                                        patterns:\n                                          - AsPattern:\n                                              attributes:\n                                                inferredType: morphir/SDK:string#string\n                                              pattern:\n                                                WildcardPattern:\n                                                  attributes:\n                                                    inferredType: morphir/SDK:string#string\n                                              name: id\n                                    body:\n                                      Record:\n                                        attributes:\n                                          inferredType: elm-compat:api#response\n                                        fields:\n                                          message:\n                                            Literal:\n                                              attributes:\n                                                inferredType: morphir/SDK:string#string\n                                              literal:\n                                                StringLiteral: Order status retrieved\n                                          order-id:\n                                            Apply:\n                                              attributes:\n                                                inferredType:\n                                                  Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                              function:\n                                                Constructor:\n                                                  attributes:\n                                                    inferredType:\n                                                      Function:\n                                                        parameterType: morphir/SDK:string#string\n                                                        returnType:\n                                                          Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                                  fqname: morphir/SDK:maybe#just\n                                              argument:\n                                                Variable:\n                                                  attributes:\n                                                    inferredType: morphir/SDK:string#string\n                                                  name: id\n                                          success:\n                                            Literal:\n                                              attributes:\n                                                inferredType: morphir/SDK:basics#bool\n                                              literal:\n                                                BoolLiteral: true\n                                  - pattern:\n                                      ConstructorPattern:\n                                        attributes:\n                                          inferredType:\n                                            Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                        fqname: morphir/SDK:maybe#nothing\n                                        patterns: []\n                                    body:\n                                      Record:\n                                        attributes:\n                                          inferredType: elm-compat:api#response\n                                        fields:\n                                          message:\n                                            Literal:\n                                              attributes:\n                                                inferredType: morphir/SDK:string#string\n                                              literal:\n                                                StringLiteral: Order ID required for status check\n                                          order-id:\n                                            Constructor:\n                                              attributes:\n                                                inferredType:\n                                                  Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                              fqname: morphir/SDK:maybe#nothing\n                                          success:\n                                            Literal:\n                                              attributes:\n                                                inferredType: morphir/SDK:basics#bool\n                                              literal:\n                                                BoolLiteral: false\n                          - pattern:\n                              WildcardPattern:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                            body:\n                              Record:\n                                attributes:\n                                  inferredType: elm-compat:api#response\n                                fields:\n                                  message:\n                                    Apply:\n                                      attributes:\n                                        inferredType: morphir/SDK:string#string\n                                      function:\n                                        Apply:\n                                          attributes:\n                                            inferredType:\n                                              Function:\n                                                parameterType: morphir/SDK:string#string\n                                                returnType: morphir/SDK:string#string\n                                          function:\n                                            Reference:\n                                              attributes:\n                                                inferredType:\n                                                  Function:\n                                                    parameterType: morphir/SDK:string#string\n                                                    returnType:\n                                                      Function:\n                                                        parameterType: morphir/SDK:string#string\n                                                        returnType: morphir/SDK:string#string\n                                              fqname: morphir/SDK:basics#append\n                                          argument:\n                                            Literal:\n                                              attributes:\n                                                inferredType: morphir/SDK:string#string\n                                              literal:\n                                                StringLiteral: \"Unknown action: \"\n                                      argument:\n                                        Field:\n                                          attributes:\n                                            inferredType: morphir/SDK:string#string\n                                          target:\n                                            Variable:\n                                              attributes:\n                                                inferredType: elm-compat:api#request\n                                              name: request\n                                          name: action\n                                  order-id:\n                                    Constructor:\n                                      attributes:\n                                        inferredType:\n                                          Reference: [\"morphir/SDK:maybe#maybe\", \"morphir/SDK:string#string\"]\n                                      fqname: morphir/SDK:maybe#nothing\n                                  success:\n                                    Literal:\n                                      attributes:\n                                        inferredType: morphir/SDK:basics#bool\n                                      literal:\n                                        BoolLiteral: false\n            doc: \" API module demonstrating request/response patterns.\\n\\nThis module provides types and functions for a simple API layer,\\ndemonstrating how Morphir handles common API patterns.\\n\"\n        main:\n          Public:\n            types:\n              customer-order:\n                Public:\n                  doc: \" A customer order containing products and quantities.\\n\"\n                  TypeAliasDefinition:\n                    typeParams: []\n                    typeExp:\n                      Record:\n                        fields:\n                          order-id: morphir/SDK:string#string\n                          products:\n                            Reference:\n                              - morphir/SDK:list#list\n                              - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                          status: elm-compat:main#order-status\n              order-status:\n                Public:\n                  doc: \" Possible states of an order.\\n\"\n                  CustomTypeDefinition:\n                    typeParams: []\n                    access: Public\n                    constructors:\n                      cancelled: []\n                      confirmed: []\n                      delivered: []\n                      pending: []\n                      shipped: []\n              product:\n                Public:\n                  doc: \" A product with price information.\\n\"\n                  TypeAliasDefinition:\n                    typeParams: []\n                    typeExp:\n                      Record:\n                        fields:\n                          id: elm-compat:main#product-id\n                          name: morphir/SDK:string#string\n                          price: morphir/SDK:basics#float\n              product-id:\n                Public:\n                  doc: \" A unique identifier for products.\\n\"\n                  TypeAliasDefinition:\n                    typeParams: []\n                    typeExp: morphir/SDK:string#string\n              quantity:\n                Public:\n                  doc: \" Represents a quantity of items.\\n\"\n                  TypeAliasDefinition:\n                    typeParams: []\n                    typeExp: morphir/SDK:basics#int\n            values:\n              apply-discount:\n                Public:\n                  doc: \" Apply a percentage discount to a price.\\n\\n    applyDiscount 10 100.0 == 90.0\\n\\n\"\n                  ExpressionBody:\n                    inputTypes:\n                      discount-percent: morphir/SDK:basics#float\n                      original-price: morphir/SDK:basics#float\n                    outputType: morphir/SDK:basics#float\n                    body:\n                      LetDefinition:\n                        attributes:\n                          inferredType: morphir/SDK:basics#float\n                        name: discount\n                        definition:\n                          ExpressionBody:\n                            inputTypes: {}\n                            outputType: t-8\n                            body:\n                              Apply:\n                                attributes:\n                                  inferredType: morphir/SDK:basics#float\n                                function:\n                                  Apply:\n                                    attributes:\n                                      inferredType:\n                                        Function:\n                                          parameterType: morphir/SDK:basics#float\n                                          returnType: morphir/SDK:basics#float\n                                    function:\n                                      Reference:\n                                        attributes:\n                                          inferredType:\n                                            Function:\n                                              parameterType: morphir/SDK:basics#float\n                                              returnType:\n                                                Function:\n                                                  parameterType: morphir/SDK:basics#float\n                                                  returnType: morphir/SDK:basics#float\n                                        fqname: morphir/SDK:basics#multiply\n                                    argument:\n                                      Variable:\n                                        attributes:\n                                          inferredType: morphir/SDK:basics#float\n                                        name: original-price\n                                argument:\n                                  Apply:\n                                    attributes:\n                                      inferredType: morphir/SDK:basics#float\n                                    function:\n                                      Apply:\n                                        attributes:\n                                          inferredType:\n                                            Function:\n                                              parameterType: morphir/SDK:basics#float\n                                              returnType: morphir/SDK:basics#float\n                                        function:\n                                          Reference:\n                                            attributes:\n                                              inferredType:\n                                                Function:\n                                                  parameterType: morphir/SDK:basics#float\n                                                  returnType:\n                                                    Function:\n                                                      parameterType: morphir/SDK:basics#float\n                                                      returnType: morphir/SDK:basics#float\n                                            fqname: morphir/SDK:basics#divide\n                                        argument:\n                                          Variable:\n                                            attributes:\n                                              inferredType: morphir/SDK:basics#float\n                                            name: discount-percent\n                                    argument:\n                                      Literal:\n                                        attributes:\n                                          inferredType: morphir/SDK:basics#float\n                                        literal:\n                                          FloatLiteral: 100.0\n                        in:\n                          Apply:\n                            attributes:\n                              inferredType: morphir/SDK:basics#float\n                            function:\n                              Apply:\n                                attributes:\n                                  inferredType:\n                                    Function:\n                                      parameterType: morphir/SDK:basics#float\n                                      returnType: morphir/SDK:basics#float\n                                function:\n                                  Reference:\n                                    attributes:\n                                      inferredType:\n                                        Function:\n                                          parameterType: morphir/SDK:basics#float\n                                          returnType:\n                                            Function:\n                                              parameterType: morphir/SDK:basics#float\n                                              returnType: morphir/SDK:basics#float\n                                    fqname: morphir/SDK:basics#subtract\n                                argument:\n                                  Variable:\n                                    attributes:\n                                      inferredType: morphir/SDK:basics#float\n                                    name: original-price\n                            argument:\n                              Variable:\n                                attributes:\n                                  inferredType: morphir/SDK:basics#float\n                                name: discount\n              calculate-total:\n                Public:\n                  doc: \" Calculate the total price of an order.\\n\\n    calculateTotal { orderId = \\\"1\\\", products = [ ( product, 2 ) ], status = Pending }\\n\\n\"\n                  ExpressionBody:\n                    inputTypes:\n                      order: elm-compat:main#customer-order\n                    outputType: morphir/SDK:basics#float\n                    body:\n                      Apply:\n                        attributes:\n                          inferredType: morphir/SDK:basics#float\n                        function:\n                          Reference:\n                            attributes:\n                              inferredType:\n                                Function:\n                                  parameterType:\n                                    Reference: [\"morphir/SDK:list#list\", \"morphir/SDK:basics#float\"]\n                                  returnType: morphir/SDK:basics#float\n                            fqname: morphir/SDK:list#sum\n                        argument:\n                          Apply:\n                            attributes:\n                              inferredType:\n                                Reference: [\"morphir/SDK:list#list\", \"morphir/SDK:basics#float\"]\n                            function:\n                              Apply:\n                                attributes:\n                                  inferredType:\n                                    Function:\n                                      parameterType:\n                                        Reference:\n                                          - morphir/SDK:list#list\n                                          - Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                                      returnType:\n                                        Reference: [\"morphir/SDK:list#list\", \"morphir/SDK:basics#float\"]\n                                function:\n                                  Reference:\n                                    attributes:\n                                      inferredType:\n                                        Function:\n                                          parameterType:\n                                            Function:\n                                              parameterType:\n                                                Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                                              returnType: morphir/SDK:basics#float\n                                          returnType:\n                                            Function:\n                                              parameterType:\n                                                Reference:\n                                                  - morphir/SDK:list#list\n                                                  - Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                                              returnType:\n                                                Reference: [\"morphir/SDK:list#list\", \"morphir/SDK:basics#float\"]\n                                    fqname: morphir/SDK:list#map\n                                argument:\n                                  Lambda:\n                                    attributes:\n                                      inferredType:\n                                        Function:\n                                          parameterType:\n                                            Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                                          returnType: morphir/SDK:basics#float\n                                    pattern:\n                                      TuplePattern:\n                                        attributes:\n                                          inferredType:\n                                            Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                                        patterns:\n                                          - AsPattern:\n                                              attributes:\n                                                inferredType: elm-compat:main#product\n                                              pattern:\n                                                WildcardPattern:\n                                                  attributes:\n                                                    inferredType: elm-compat:main#product\n                                              name: product\n                                          - AsPattern:\n                                              attributes:\n                                                inferredType: morphir/SDK:basics#int\n                                              pattern:\n                                                WildcardPattern:\n                                                  attributes:\n                                                    inferredType: morphir/SDK:basics#int\n                                              name: qty\n                                    body:\n                                      Apply:\n                                        attributes:\n                                          inferredType: morphir/SDK:basics#float\n                                        function:\n                                          Apply:\n                                            attributes:\n                                              inferredType:\n                                                Function:\n                                                  parameterType: morphir/SDK:basics#float\n                                                  returnType: morphir/SDK:basics#float\n                                            function:\n                                              Reference:\n                                                attributes:\n                                                  inferredType:\n                                                    Function:\n                                                      parameterType: morphir/SDK:basics#float\n                                                      returnType:\n                                                        Function:\n                                                          parameterType: morphir/SDK:basics#float\n                                                          returnType: morphir/SDK:basics#float\n                                                fqname: morphir/SDK:basics#multiply\n                                            argument:\n                                              Field:\n                                                attributes:\n                                                  inferredType: morphir/SDK:basics#float\n                                                target:\n                                                  Variable:\n                                                    attributes:\n                                                      inferredType: elm-compat:main#product\n                                                    name: product\n                                                name: price\n                                        argument:\n                                          Apply:\n                                            attributes:\n                                              inferredType: morphir/SDK:basics#float\n                                            function:\n                                              Reference:\n                                                attributes:\n                                                  inferredType:\n                                                    Function:\n                                                      parameterType: morphir/SDK:basics#int\n                                                      returnType: morphir/SDK:basics#float\n                                                fqname: morphir/SDK:basics#to-float\n                                            argument:\n                                              Variable:\n                                                attributes:\n                                                  inferredType: morphir/SDK:basics#int\n                                                name: qty\n                            argument:\n                              Field:\n                                attributes:\n                                  inferredType:\n                                    Reference:\n                                      - morphir/SDK:list#list\n                                      - Tuple: [\"elm-compat:main#product\", \"morphir/SDK:basics#int\"]\n                                target:\n                                  Variable:\n                                    attributes:\n                                      inferredType: elm-compat:main#customer-order\n                                    name: order\n                                name: products\n              is-valid-order:\n                Public:\n                  doc: \" Check if an order is valid (has at least one product with positive quantity).\\n\"\n                  ExpressionBody:\n                    inputTypes:\n                      order: elm-compat:main#customer-order\n                    outputType: morphir/SDK:basics#bool\n                    body:\n                      PatternMatch:\n                        attributes:\n                          inferredType: morphir/SDK:basics#bool\n                        value:\n                          Field:\n                            attributes:\n                              inferredType:\n                                Reference:\n                                  - morphir/SDK:list#list\n                                  - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                            target:\n                              Variable:\n                                attributes:\n                                  inferredType: elm-compat:main#customer-order\n                                name: order\n                            name: products\n                        cases:\n                          - pattern:\n                              EmptyListPattern:\n                                attributes:\n                                  inferredType:\n                                    Reference:\n                                      - morphir/SDK:list#list\n                                      - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                            body:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:basics#bool\n                                literal:\n                                  BoolLiteral: false\n                          - pattern:\n                              WildcardPattern:\n                                attributes:\n                                  inferredType:\n                                    Reference:\n                                      - morphir/SDK:list#list\n                                      - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                            body:\n                              Apply:\n                                attributes:\n                                  inferredType: morphir/SDK:basics#bool\n                                function:\n                                  Apply:\n                                    attributes:\n                                      inferredType:\n                                        Function:\n                                          parameterType:\n                                            Reference:\n                                              - morphir/SDK:list#list\n                                              - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                          returnType: morphir/SDK:basics#bool\n                                    function:\n                                      Reference:\n                                        attributes:\n                                          inferredType:\n                                            Function:\n                                              parameterType:\n                                                Function:\n                                                  parameterType:\n                                                    Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                                  returnType: morphir/SDK:basics#bool\n                                              returnType:\n                                                Function:\n                                                  parameterType:\n                                                    Reference:\n                                                      - morphir/SDK:list#list\n                                                      - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                                  returnType: morphir/SDK:basics#bool\n                                        fqname: morphir/SDK:list#all\n                                    argument:\n                                      Lambda:\n                                        attributes:\n                                          inferredType:\n                                            Function:\n                                              parameterType:\n                                                Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                              returnType: morphir/SDK:basics#bool\n                                        pattern:\n                                          TuplePattern:\n                                            attributes:\n                                              inferredType:\n                                                Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                            patterns:\n                                              - WildcardPattern:\n                                                  attributes:\n                                                    inferredType: elm-compat:main#product\n                                              - AsPattern:\n                                                  attributes:\n                                                    inferredType: elm-compat:main#quantity\n                                                  pattern:\n                                                    WildcardPattern:\n                                                      attributes:\n                                                        inferredType: elm-compat:main#quantity\n                                                  name: qty\n                                        body:\n                                          Apply:\n                                            attributes:\n                                              inferredType: morphir/SDK:basics#bool\n                                            function:\n                                              Apply:\n                                                attributes:\n                                                  inferredType:\n                                                    Function:\n                                                      parameterType: elm-compat:main#quantity\n                                                      returnType: morphir/SDK:basics#bool\n                                                function:\n                                                  Reference:\n                                                    attributes:\n                                                      inferredType:\n                                                        Function:\n                                                          parameterType: elm-compat:main#quantity\n                                                          returnType:\n                                                            Function:\n                                                              parameterType: elm-compat:main#quantity\n                                                              returnType: morphir/SDK:basics#bool\n                                                    fqname: morphir/SDK:basics#greater-than\n                                                argument:\n                                                  Variable:\n                                                    attributes:\n                                                      inferredType: elm-compat:main#quantity\n                                                    name: qty\n                                            argument:\n                                              Literal:\n                                                attributes:\n                                                  inferredType: elm-compat:main#quantity\n                                                literal:\n                                                  IntegerLiteral: 0\n                                argument:\n                                  Field:\n                                    attributes:\n                                      inferredType:\n                                        Reference:\n                                          - morphir/SDK:list#list\n                                          - Tuple: [\"elm-compat:main#product\", \"elm-compat:main#quantity\"]\n                                    target:\n                                      Variable:\n                                        attributes:\n                                          inferredType: elm-compat:main#customer-order\n                                        name: order\n                                    name: products\n              order-status-to-string:\n                Public:\n                  doc: \" Convert an order status to a human-readable string.\\n\"\n                  ExpressionBody:\n                    inputTypes:\n                      status: elm-compat:main#order-status\n                    outputType: morphir/SDK:string#string\n                    body:\n                      PatternMatch:\n                        attributes:\n                          inferredType: morphir/SDK:string#string\n                        value:\n                          Variable:\n                            attributes:\n                              inferredType: elm-compat:main#order-status\n                            name: status\n                        cases:\n                          - pattern:\n                              ConstructorPattern:\n                                attributes:\n                                  inferredType: elm-compat:main#order-status\n                                fqname: elm-compat:main#pending\n                                patterns: []\n                            body:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: Pending\n                          - pattern:\n                              ConstructorPattern:\n                                attributes:\n                                  inferredType: elm-compat:main#order-status\n                                fqname: elm-compat:main#confirmed\n                                patterns: []\n                            body:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: Confirmed\n                          - pattern:\n                              ConstructorPattern:\n                                attributes:\n                                  inferredType: elm-compat:main#order-status\n                                fqname: elm-compat:main#shipped\n                                patterns: []\n                            body:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: Shipped\n                          - pattern:\n                              ConstructorPattern:\n                                attributes:\n                                  inferredType: elm-compat:main#order-status\n                                fqname: elm-compat:main#delivered\n                                patterns: []\n                            body:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: Delivered\n                          - pattern:\n                              ConstructorPattern:\n                                attributes:\n                                  inferredType: elm-compat:main#order-status\n                                fqname: elm-compat:main#cancelled\n                                patterns: []\n                            body:\n                              Literal:\n                                attributes:\n                                  inferredType: morphir/SDK:string#string\n                                literal:\n                                  StringLiteral: Cancelled\n            doc: \" Main module demonstrating Morphir-compatible Elm types and functions.\\n\\nThis module provides a simple e-commerce domain model for testing\\nthe morphir-elm toolchain integration.\\n\"\n"
