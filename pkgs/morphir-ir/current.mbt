///|
/// The unversioned API follows the current supported model, initially v4.
pub using @v4 {
  type Access,
  type AccessControlled,
  type Annotation,
  type AnnotationArgument,
  type ApplicationDependencies,
  type Constructors,
  type Data,
  type Dependencies,
  type DerivedTypeDetails,
  type Distribution,
  type Documented,
  type EntryPoint,
  type EntryPointKind,
  type ExternalBinding,
  type FQName,
  type HoleReason,
  type IRFile,
  type Incompleteness,
  type Literal,
  type ModuleDefinition,
  type ModuleName,
  type ModuleSpecification,
  type Name,
  type NameSegment,
  type NameError,
  type NativeHint,
  type NativeInfo,
  type PackageDefinition,
  type PackageName,
  type PackageSpecification,
  type Path,
  type Pattern,
  type PatternLiteral,
  type SourceLocation,
  type Type,
  type TypeAttributes,
  type TypeDefinition,
  type TypeSpecification,
  type TypeSpecificationBody,
  type Value,
  type ValueAttributes,
  type ValueDefinition,
  type ValueSpecification,
}

///|
pub const CURRENT_FORMAT_MAJOR : UInt32 = 4U
