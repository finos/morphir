import {
  "finos/morphir-engine/ids",
  "finos/morphir-host/identity",
  "finos/morphir-host/platform",
  "finos/morphir-ir" @ir,
  "finos/morphir-ir/yaml",
  "moonbitlang/x/crypto",
  "moonbit-community/casefold",
  "moonbit-community/unicode-normalization" @normalization,
  "finos/morphir-ir/wire" @model_wire,
  "finos/morphir-moonbit/mep/model_access",
  "moonbitlang/async",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/cmp",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonrockz/moon-lander-hosting" @hosting,
}

// The async imports are used only by the channel and driver files, which
// wasm-gc does not build.

warnings = "-29"

import {
  "finos/morphir-engine/ids",
  "finos/morphir-host/worker",
  "moonbitlang/x/fs",
  "finos/morphir-moonbit/mep/model_access",
  "finos/morphir-moonbit/mep" @guest_mep,
  "finos/morphir-ir/json" @ir_json,
  "finos/morphir-moonbit/fixtures" @generator_fixtures,
} for "test"

// moonbitlang/async has no event loop on wasm-gc. The types and the pure code
// build on all four targets; the async channel, launcher, driver and their
// tests build on native, js and wasm only.

import {
  "finos/morphir-host" @host,
  "finos/morphir-engine/data",
  "finos/morphir-ir/version",
  "moonbitlang/core/env",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
} for "wbtest"

options(
  targets: {
    "tree_producer_wbtest.mbt": [ "native" ],
    "tree_generation_wbtest.mbt": [ "native" ],
    "tree_producer.mbt": [ "native" ],
    "tree_generation.mbt": [ "native" ],
    "tree_snapshot.mbt": [ "native" ],
    "tree_stage.mbt": [ "native" ],
    "channel.mbt": [ "native", "js", "wasm" ],
    "memory_channel.mbt": [ "native", "js", "wasm" ],
    "memory_channel_test.mbt": [ "native", "js", "wasm" ],
    "host_driver.mbt": [ "native", "js", "wasm" ],
    "host_driver_test.mbt": [ "native", "js", "wasm" ],
    "bounded_guest_test.mbt": [ "native", "js", "wasm" ],
    "host_driver_wbtest.mbt": [ "native", "js", "wasm" ],
  },
)
