import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
}

warnings = "-29"

// Imports are used by different target adapters.
import {
  "finos/morphir-host/platform",
} for "test"

options(
  "native-stub": [ "platform.c", "originals_observer.c" ],
  targets: {
    "observation.mbt": [ "wasm", "wasm-gc" ],
    "desktop.mbt": [ "native", "js" ],
    "native.mbt": [ "native" ],
    "js.mbt": [ "js" ],
    "wasi.mbt": [ "wasm" ],
    "gc.mbt": [ "wasm-gc" ],
  },
)
