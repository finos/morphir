#!/bin/sh

# Fast pre-push checks.
#
# This hook deliberately does not run lint or the test suite. Both are gated in
# CI on every pull request, and locally they mean `cargo clippy --all-targets
# --all-features` plus `cargo test --workspace`, which take many minutes and do
# not link at all on some developer machines. A hook that slow gets bypassed with
# --no-verify, and a bypassed hook protects nothing.
#
# Set MORPHIR_SKIP_HOOKS=1 to skip, for example when pushing a work in progress
# branch you know does not build.

# Chain the beads-managed hook. See .husky/post-merge for why this is explicit.
if [ -x .beads/hooks/pre-push ]; then
    .beads/hooks/pre-push "$@" || exit $?
fi

if [ "$MORPHIR_SKIP_HOOKS" = "1" ]; then
    echo "pre-push: skipped (MORPHIR_SKIP_HOOKS=1)"
    exit 0
fi

if ! command -v mise > /dev/null 2>&1; then
    echo "pre-push: mise not found on PATH, skipping format check."
    echo "  Install mise from https://mise.jdx.dev/ to enable it."
    exit 0
fi

# Notice, not a gate. The published export is a mirror of an authoritative
# database, so a stale mirror is untidy rather than wrong, and blocking a code
# push over it would be disproportionate.
if command -v bun > /dev/null 2>&1 && command -v bd > /dev/null 2>&1; then
    if ! bun run tools/check-beads-drift.ts > /dev/null 2>&1; then
        echo "pre-push: the beads export on beads-sync is behind the database."
        echo "  Publish it with: mise run beads:publish"
    fi
fi

echo "pre-push: checking formatting..."
if ! mise run fmt-check; then
    echo ""
    echo "Formatting check failed. Fix it with:"
    echo "    mise run fmt"
    echo ""
    echo "To push anyway: MORPHIR_SKIP_HOOKS=1 git push"
    exit 1
fi

echo "pre-push: formatting ok."
