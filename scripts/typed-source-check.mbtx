///|
/// Compile original and generated mixed-type libraries on the pinned four targets.
import {
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/crypto",
  "moonrockz/ion@0.5.0/json" @ion_json,
  "moonrockz/ion@0.5.0/ion",
  "moonrockz/ion@0.5.0/binary",
  "moonrockz/ion@0.5.0/text",
}

///|
fn field(value : Json, key : String) -> Json {
  guard value is Object(fields) else { abort("Expected object") }
  fields[key]
}

///|
fn string(value : Json) -> String {
  guard value is String(text) else { abort("Expected string") }
  text
}

///|
fn array(value : Json) -> Array[Json] {
  guard value is Array(values) else { abort("Expected array") }
  values
}

///|
async fn command(
  program : String,
  args : Array[String],
  cwd~ : String = ".",
) -> String {
  let (code, out, err) = @process.collect_output(program, args, cwd~)
  guard code == 0 else {
    fail(program + " " + args.join(" ") + ": " + out.text() + err.text())
  }
  out.text()
}

///|
async fn main {
  let repository = @fs.realpath(".")
  let root = repository + "/.dev/typed-source-acceptance"
  @fs.mkdir(root, recursive=true, allow_exist=true)
  let workspace = root + "/workspace"
  // A previous or interrupted run may leave private probes or obsolete sources.
  // Qualify only the artifacts produced by this invocation.
  if @fs.exists(workspace) {
    @fs.rmdir(workspace, recursive=true)
  }
  @fs.mkdir(workspace)
  let compiler = command("moonc", ["-v"])
  assert_true(compiler.has_prefix("v0.10.15+943464bfa"))
  let home = match @env.get_env_var("MOON_HOME") {
    Some(home) => home
    None => command("mise", ["where", "http:moonbit"]).trim().to_owned()
  }
  let suffix = if @env.get_env_var("OS") == Some("Windows_NT") {
    ".exe"
  } else {
    ""
  }
  let compiler_hash = @crypto.bytes_to_hex_string(
    @crypto.sha256(@fs.read_file(home + "/bin/moonc" + suffix).binary()),
  )
  let core_manifest = @fs.read_file(home + "/lib/core/moon.mod").text()
  assert_true(core_manifest.contains("0.10.15+943464bfa"))
  let output = @json.parse(
    command("moon", [
      "run", "pkgs/morphir-moonbit-frontend/typed-acceptance", "--target", "native",
    ]),
  )
  @fs.write_file(root + "/models.json", output.stringify())
  let members = [repository + "/pkgs/morphir-sdk", "./consumer"]
  let imports = ["\"finos/morphir-sdk@0.1.0\""]
  let aliases = [
    "\"finos/morphir-sdk\" @sdk", "\"finos/morphir-sdk/int\" @int", "\"finos/morphir-sdk/integer\" @integer",
  ]
  let tests = StringBuilder()
  let private_probes = []
  for model in array(field(output, "models")) {
    let id = string(field(model, "id"))
    let model_id = id.strip_prefix("current").map(s => s.to_owned()).unwrap_or(id)
    let kind = model_id.strip_prefix("supported").map(s => s.to_owned()).unwrap_or(model_id)
    let model_tests = StringBuilder()
    let original = workspace + "/original-" + id
    let generated = workspace + "/generated-" + id
    @fs.mkdir(original, allow_exist=true)
    @fs.mkdir(generated, allow_exist=true)
    @fs.write_file(
      original + "/moon.mod",
      "name = \"acceptance/" + id + "\"\nversion = \"0.0.0\"\n",
    )
    @fs.write_file(original + "/moon.pkg", "")
    @fs.write_file(original + "/original.mbt", string(field(model, "source")))
    for artifact in array(field(model, "artifacts")) {
      let path = generated + "/" + string(field(artifact, "path"))
      match field(artifact, "content") {
        String(text) => @fs.write_file(path, text)
        Array(values) =>
          @fs.write_file(
            path,
            Bytes::from_array(
              values.map(v => {
                guard v is Number(n, ..) else { abort("Expected byte") }
                n.to_int().to_byte()
              }),
            ),
          )
        _ => fail("Expected artifact content")
      }
    }
    members.append(["./original-" + id, "./generated-" + id])
    let module_name = string(field(model, "module"))
    imports.append([
      ("acceptance/" + id + "@0.0.0").escape(),
      (module_name + "@0.0.0").escape(),
    ])
    aliases.append([
      ("acceptance/" + id).escape() + " @o" + id,
      module_name.escape() + " @g" + id,
    ])
    let symbols = array(field(model, "symbols"))
    fn g(name : String) -> String {
      "@g" +
      id +
      "." +
      string(
        field(
          symbols.filter(s => string(field(s, "fqname")).has_suffix("#" + name))[0],
          "function",
        ),
      ) +
      "()"
    }
    for symbol in symbols {
      if field(symbol, "public") == Json::boolean(false) {
        private_probes.push(
          "test { ignore(@g" +
          id +
          "." +
          string(field(symbol, "function")) +
          ") }",
        )
      }
    }
    if kind == "foundation" {
      model_tests.write_string(
        "test \"mixed Bool/Int32 original and generated boundaries\" {\n  for flag in [false, true] {\n    let a = @int.to_int32(@integer.from_string(\"-2147483648\").unwrap()).unwrap()\n    let b = @int.to_int32(@integer.from_string(\"2147483647\").unwrap()).unwrap()\n    let original = @ofoundation.choose(flag, -2147483648, 2147483647)\n    assert_eq(original, if flag { -2147483648 } else { 2147483647 })\n    assert_eq(@integer.to_string(@int.from_int32(" +
        g("choose") +
        "(flag)(a)(b))), original.to_string())\n  }\n}\n",
      )
    } else if kind == "strings" {
      model_tests.write_string(
        "test \"String original, Scheme and generated greeting\" {\n  for name in [\"\", \"Morphir\", \"😀\", \"é\", \"é\"] {\n    let original = @ostrings.greet(name)\n    assert_eq(original, \"Hello, \" + name)\n    assert_eq(" +
        g("greet") +
        "(@sdk.Text::from_string(name)).to_string(), original)\n    for enabled in [false, true] {\n      let original = @ostrings.welcome(name, enabled)\n      assert_eq(original, if enabled { \"Hello, \" + name } else { \"\" })\n      assert_eq(" +
        g("welcome") +
        "(@sdk.Text::from_string(name))(enabled).to_string(), original)\n      assert_eq(" +
        g("choose") +
        "(@sdk.Text::from_string(name))(@sdk.Text::from_string(\"other\"))(enabled).to_string(), @ostrings.choose(name, \"other\", enabled))\n    }\n  }\n}\n",
      )
      model_tests.write_string(
        "test \"String equality does not normalize and escapes cook exactly\" {\n  for (a, b, expected) in [(\"\", \"\", true), (\"é\", \"é\", false), (\"😀\", \"😀\", true), (\"a\", \"b\", false)] {\n    assert_eq(@ostrings.same(a, b), expected)\n    assert_eq(" +
        g("same") +
        "(@sdk.Text::from_string(a))(@sdk.Text::from_string(b)), expected)\n  }\n  assert_eq(@ostrings.escapes(), \"😀́AA\\n\")\n  assert_eq(" +
        g("escapes") +
        ".to_string(), @ostrings.escapes())\n}\n",
      )
      model_tests.write_string(
        "test \"generated public guards reject raw UTF-16 halves\" {\n  for unit in [55296, 56320] {\n    let invalid = @sdk.Text::from_units([unit.to_uint16()])\n    try { ignore(" +
        g("ignore-text") +
        "(invalid)); fail(\"Expected refusal\") } catch { @sdk.UnrepresentableText(_) => (); error => raise error }\n    try { ignore(" +
        g("welcome") +
        "(invalid)(false)); fail(\"Expected refusal\") } catch { @sdk.UnrepresentableText(_) => (); error => raise error }\n  }\n}\n",
      )
    } else if kind == "bounded" {
      model_tests.write_string(
        "test \"generated bounds preflight growth and public unused inputs\" {\n  let a = @sdk.Text::from_string(\"a\")\n  let emoji = @sdk.Text::from_string(\"😀\")\n  assert_eq(" +
        g("join") +
        "(a)(emoji).to_string(), @obounded.join(\"a\", \"😀\"))\n  assert_false(" +
        g("short") +
        ")\n  assert_false(@obounded.short())\n  try { ignore(" +
        g("join") +
        "(@sdk.Text::from_string(\"abc\"))(@sdk.Text::from_string(\"def\"))); fail(\"Expected growth refusal\") } catch { @sdk.OutOfRange(_) => (); error => raise error }\n  try { ignore(" +
        g("ignore-text") +
        "(@sdk.Text::from_string(\"123456\"))); fail(\"Expected input refusal\") } catch { @sdk.OutOfRange(_) => (); error => raise error }\n  try { ignore(" +
        g("order") +
        "); fail(\"Expected ordered refusal\") } catch { @sdk.OutOfRange(message) => assert_true(message.contains(\"concatenation\")); error => raise error }\n}\n",
      )
    }
    if model_id == "supported" {
      model_tests.write_string(
        "test \"supported union crosses Bool, String and Int32 boundaries\" {\n  let a = @int.to_int32(@integer.parse(\"-2147483648\")).unwrap()\n  let b = @int.to_int32(@integer.parse(\"2147483647\")).unwrap()\n  for (name, enabled, expected) in [(\"Morphir\", true, -2147483648), (\"Morphir\", false, 2147483647), (\"😀\", true, 2147483647)] {\n    assert_eq(@osupported.choose_for(name, enabled, -2147483648, 2147483647), expected)\n    assert_eq(@integer.to_string(@int.from_int32(" +
        g("choose-for") +
        "(@sdk.Text::from_string(name))(enabled)(a)(b))), expected.to_string())\n  }\n}\n",
      )
      model_tests.write_string(
        "test \"supported union validates String inputs on Int32 results\" {\n  let n = @int.to_int32(@integer.parse(\"0\")).unwrap()\n  let invalid = @sdk.Text::from_units([(55296).to_uint16()])\n  try { ignore(" +
        g("choose-for") +
        "(invalid)(false)(n)(n)); fail(\"Expected UTF-16 refusal\") } catch { @sdk.UnrepresentableText(_) => (); error => raise error }\n}\n",
      )
    } else if model_id == "supportedbool" {
      model_tests.write_string(
        "test \"supported union retains the complete qualified Boolean operators\" {\n  for a in [false, true] { for b in [false, true] {\n    assert_eq(" +
        g("both") +
        "(a)(b), a && b)\n    assert_eq(" +
        g("either") +
        "(a)(b), a || b)\n    assert_eq(" +
        g("equal") +
        "(a)(b), a == b)\n    assert_eq(" +
        g("unequal") +
        "(a)(b), a != b)\n    assert_eq(" +
        g("shadow") +
        "(a), a)\n    assert_eq(@osupportedbool.both(a, b), a && b)\n    assert_eq(@osupportedbool.either(a, b), a || b)\n    assert_eq(@osupportedbool.equal(a, b), a == b)\n    assert_eq(@osupportedbool.unequal(a, b), a != b)\n    assert_eq(@osupportedbool.shadow(a), a)\n  } }\n  assert_true(" +
        g("yes") +
        ")\n  assert_true(@osupportedbool.yes())\n}\n",
      )
    }
    if kind == "ordered" {
      model_tests.write_string(
        "test \"String comparisons match pinned source and independent shortlex expectations\" {\n  for (a, b, order) in [(\"b\", \"aa\", -1), (\"aa\", \"b\", 1), (\"\", \"a\", -1), (\"\", \"\", 0), (\"😀\", \"\\u{e000}a\", -1), (\"\\u{e000}a\", \"😀\", 1), (\"😀\", \"\\u{e000}\", 1), (\"é\", \"é\", -1), (\"ab\", \"aa\", 1), (\"😀\", \"😀\", 0), (\"a\\u0000\", \"aa\", -1)] {\n    let x = @sdk.Text::from_string(a)\n    let y = @sdk.Text::from_string(b)\n    assert_eq(@oordered.lt(a, b), order < 0)\n    assert_eq(@oordered.le(a, b), order <= 0)\n    assert_eq(@oordered.gt(a, b), order > 0)\n    assert_eq(@oordered.ge(a, b), order >= 0)\n    assert_eq(CALL_LT(x)(y), order < 0)\n    assert_eq(CALL_LE(x)(y), order <= 0)\n    assert_eq(CALL_GT(x)(y), order > 0)\n    assert_eq(CALL_GE(x)(y), order >= 0)\n  }\n}\n"
        .replace(old="CALL_LT", new=g("lt"))
        .replace(old="CALL_LE", new=g("le"))
        .replace(old="CALL_GT", new=g("gt"))
        .replace(old="CALL_GE", new=g("ge")),
      )
      model_tests.write_string(
        "test \"ordered String calls select exact Int32 boundaries\" {\n  let low = @int.to_int32(@integer.parse(\"-2147483648\")).unwrap()\n  let high = @int.to_int32(@integer.parse(\"2147483647\")).unwrap()\n  for (a, b, expected) in [(\"b\", \"aa\", -2147483648), (\"aa\", \"b\", 2147483647), (\"😀\", \"\\u{e000}a\", -2147483648), (\"\", \"\", 2147483647)] {\n    assert_eq(@oordered.choose(a, b, -2147483648, 2147483647), expected)\n    assert_eq(@integer.to_string(@int.from_int32(CALL_CHOOSE(@sdk.Text::from_string(a))(@sdk.Text::from_string(b))(low)(high))), expected.to_string())\n  }\n}\n"
        .replace(old="CALL_CHOOSE", new=g("choose")),
      )
      model_tests.write_string(
        "test \"ordered entries reject malformed UTF-16 in either position without repair\" {\n  for units in [[55296], [56320], [56320, 55296], [55296, 97]] {\n    let invalid = @sdk.Text::from_units(units.map(u => u.to_uint16()))\n    let empty = @sdk.Text::from_string(\"\")\n    try { ignore(invalid.to_string()); fail(\"Expected host conversion refusal\") } catch { @sdk.UnrepresentableText(_) => (); error => raise error }\n    for (a, b) in [(invalid, empty), (empty, invalid)] {\n      try { ignore(CALL_LT(a)(b)); fail(\"Expected source UTF-16 refusal\") } catch { @sdk.UnrepresentableText(_) => (); error => raise error }\n      try { ignore(CALL_LE(a)(b)); fail(\"Expected source UTF-16 refusal\") } catch { @sdk.UnrepresentableText(_) => (); error => raise error }\n      try { ignore(CALL_GT(a)(b)); fail(\"Expected source UTF-16 refusal\") } catch { @sdk.UnrepresentableText(_) => (); error => raise error }\n      try { ignore(CALL_GE(a)(b)); fail(\"Expected source UTF-16 refusal\") } catch { @sdk.UnrepresentableText(_) => (); error => raise error }\n    }\n  }\n}\n"
        .replace(old="CALL_LT", new=g("lt"))
        .replace(old="CALL_LE", new=g("le"))
        .replace(old="CALL_GT", new=g("gt"))
        .replace(old="CALL_GE", new=g("ge")),
      )
    } else if kind == "orderedbounded" {
      model_tests.write_string(
        "test \"ordering is strict left to right and Bool operators still short circuit\" {\n  try { ignore(CALL_FIRST); fail(\"Expected first refusal\") } catch { @sdk.OutOfRange(message) => assert_true(message.contains(\"concatenation\")); error => raise error }\n  try { ignore(CALL_SECOND); fail(\"Expected second refusal\") } catch { @sdk.OutOfRange(message) => assert_true(message.contains(\"code-unit limit\")); error => raise error }\n  try { ignore(CALL_EAGER); fail(\"Expected strict right operand refusal\") } catch { @sdk.OutOfRange(message) => assert_true(message.contains(\"code-unit limit\")); error => raise error }\n  assert_false(CALL_SHORT)\n  assert_false(@oorderedbounded.short())\n}\n"
        .replace(old="CALL_FIRST", new=g("first"))
        .replace(old="CALL_SECOND", new=g("second"))
        .replace(old="CALL_EAGER", new=g("eager"))
        .replace(old="CALL_SHORT", new=g("short")),
      )
    }
    let original_alias = if ["foundation", "strings", "bounded", "ordered", "orderedbounded"].contains(kind) { kind } else { model_id }
    tests.write_string(model_tests.to_string().split("@o" + original_alias).join("@o" + id).split("test \"").join("test \"" + id + ": "))
  }
  let consumer = workspace + "/consumer"
  @fs.mkdir(consumer, allow_exist=true)
  @fs.write_file(
    workspace + "/moon.work",
    "members = [" + members.map(m => m.escape()).join(",") + "]\n",
  )
  @fs.write_file(
    consumer + "/moon.mod",
    "name = \"acceptance/consumer\"\nversion = \"0.0.0\"\nimport {" +
    imports.join(",\n") +
    "}\n",
  )
  @fs.write_file(
    consumer + "/moon.pkg",
    "import {" + aliases.join(",\n") + "}\n",
  )
  @fs.write_file(consumer + "/consumer_test.mbt", tests.to_string())
  let lanes : Array[Json] = []
  for mode in ["debug", "release"] {
    let args = [
      "test", "-p", "acceptance/consumer", "--frozen", "--target", "all",
    ]
    if mode == "release" {
      args.push("--release")
    }
    let log = command("moon", args, cwd=workspace)
    @fs.write_file(root + "/" + mode + ".log", log)
    assert_eq(log.split("Total tests: 30, passed: 30, failed: 0.").count(), 5)
    lanes.push(
      ({ "mode": mode, "targets": ["native", "js", "wasm", "wasm-gc"] } : Json),
    )
  }
  let private_log = StringBuilder()
  for probe in private_probes {
    @fs.write_file(consumer + "/private_test.mbt", probe)
    let (private_code, private_out, private_err) = @process.collect_output(
      "moon",
      ["check", "--frozen", "--target", "native"],
      cwd=workspace,
    )
    @fs.remove(consumer + "/private_test.mbt")
    let diagnostic = private_out.text() + private_err.text()
    assert_true(private_code != 0)
    assert_true(
      diagnostic.contains("Value ") &&
      diagnostic.contains("not found in package"),
    )
    private_log.write_string(probe + "\n" + diagnostic + "\n")
  }
  @fs.write_file(root + "/private.log", private_log.to_string())
  let sdk_files = command("git", [
    "ls-files", "--cached", "--others", "--exclude-standard", "pkgs/morphir-sdk",
  ])
  let identities : Array[Json] = []
  for path in sdk_files.trim().split("\n") {
    identities.push(
      (
        {
          "path": path,
          "sha256": @crypto.bytes_to_hex_string(
            @crypto.sha256(@fs.read_file(path.to_owned()).binary()),
          ),
        } : Json),
    )
  }
  let receipt = (
    {
      "profile": "moonbit-typed-source-acceptance-v1",
      "revision": command("git", ["rev-parse", "HEAD"]).trim().to_owned(),
      "compiler": compiler,
      "compilerSha256": compiler_hash,
      "coreManifest": core_manifest,
      "parser": "0.4.5",
      "lexer": "0.4.3",
      "classicSemanticPin": "bc99af69a8b24d391311fae3822a87eafef3c334",
      "sourceStringExtension": "morphir-moonbit-source-string-v1",
      "lanes": lanes,
      "sdkFiles": identities,
      "models": output,
      "supportedProfiles": ["moonbit-model-library-v1", "moonbit-model-library-2026-10-17"],
      "scope": "Local original source, Scheme, generated direct consumers and private access. Installed qualification remains a separate task.",
    } : Json)
  let ion = @ion_json.to_ion(receipt)
  let bytes = @binary.write_binary_value(ion)
  let text = @text.write_ion_pretty(ion)
  assert_true(@binary.read_binary_value(bytes).equals(ion))
  assert_true(@text.read_ion(text).equals(ion))
  @fs.write_file(root + "/receipt.ionb", bytes)
  @fs.write_file(root + "/receipt.ion", text)
  println(
    "Mixed typed source and String consumers pass all eight target/mode lanes; Ion receipt: " +
    root +
    "/receipt.ionb",
  )
}
