///|
/// Narrow tar-compatible adapter for Proton's pinned Windows CEF setup.
/// CMake's archive engine avoids the runner's external MSYS bzip2 pipe.
import {
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/argparse",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
let json_mode : Ref[Bool] = Ref(false)

///|
suberror ChildFailure {
  ChildFailure(Int32, String)
} derive(Debug)

///|
fn succeeded(result : Json) -> Json {
  {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "workbench.cef.extract",
    "state": "succeeded",
    "exitCode": 0,
    "result": result,
    "diagnostics": [],
  }
}

///|
async fn failed(error : Error) -> Unit {
  let (status, code) = match error {
    ChildFailure(status, _) =>
      (if status < 0 { 128 - status } else { status }, "child_failed")
    _ => (1, "command_failed")
  }
  let message = match error {
    ChildFailure(_, message) => message
    _ => error.to_string()
  }
  @stdio.stderr.write(message + "\n")
  let value : Json = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "workbench.cef.extract",
    "state": "failed",
    "exitCode": status,
    "error": { "code": code, "message": message },
    "diagnostics": [],
  }
  @stdio.stdout.write(value.stringify() + "\n")
  @sys.exit(status)
}

///|
async fn print_progress(message : String) -> Unit {
  if json_mode.val {
    @stdio.stderr.write(message + "\n")
  } else {
    println(message)
  }
}

///|
struct Extraction {
  archive : String
  destination : String
}

///|
fn extraction_command() -> @argparse.Command {
  @argparse.Command(
    // Model Proton's exact tar dialect. Generic flags accept broader forms.
    "workbench-cef-extract.mbtx",
    disable_help_flag=true,
    disable_help_subcommand=true,
    subcommand_required=true,
    subcommands=[
      @argparse.Command(
        "word:-xjf",
        disable_help_flag=true,
        disable_help_subcommand=true,
        subcommand_required=true,
        options=[@argparse.OptionArg("archive", required=true)],
        subcommands=[
          @argparse.Command(
            "word:-C",
            disable_help_flag=true,
            disable_help_subcommand=true,
            options=[@argparse.OptionArg("destination", required=true)],
          ),
        ],
      ),
    ],
  )
}

///|
fn parse(args : ArrayView[String]) -> Extraction? {
  // Slots are fixed independently of token contents. Inline synthetic values
  // retain every data character; the library recognizes the exact words and
  // rejects missing, reordered and additional tokens.
  let slots : Array[String?] = [
    None,
    Some("archive"),
    None,
    Some("destination"),
  ]
  let argv = args
    .to_owned()
    .mapi((index, value) => {
      match slots.get(index).bind(value => value) {
        Some(name) => "--\{name}=\{value}"
        None => "word:" + value
      }
    })
  let matches = extraction_command().parse(argv~, env=Map([])) catch {
    _ => return None
  }
  let extraction = matches.subcommand.unwrap().1
  let directory = extraction.subcommand.unwrap().1
  let archive = extraction.values["archive"][0]
  let destination = directory.values["destination"][0]
  guard !archive.is_empty() && !destination.is_empty() else { return None }
  Some({ archive, destination, })
}

///|
enum Control {
  SelfTest
  Roundtrip
}

///|
fn control(args : ArrayView[String]) -> Control? {
  // Every trailing original word is literal, including --, so each control is
  // exactly one token. The library owns recognition and arity.
  let normalized = match args {
    [] => []
    [first, .. rest] => [first, "--", ..rest]
  }
  let matches = @argparse.Command(
    "workbench-cef-extract.mbtx",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[@argparse.FlagArg("self-test"), @argparse.FlagArg("roundtrip")],
    groups=[
      @argparse.ArgGroup("control", required=true, multiple=false, args=[
        "self-test", "roundtrip",
      ]),
    ],
  ).parse(argv=normalized, env=Map([])) catch {
    _ => return None
  }
  if matches.flags.get("self-test").unwrap_or(false) {
    Some(SelfTest)
  } else {
    Some(Roundtrip)
  }
}

///|
async fn archive_digest(path : String) -> String {
  let file = @fs.open(path, mode=ReadOnly)
  defer file.close()
  let hasher = @crypto.SHA256::new()
  let buffer = FixedArray::make(1024 * 1024, b'\x00')
  while file.read(buffer) is n && n > 0 {
    hasher.update(buffer.unsafe_reinterpret_as_bytes()[:n])
  }
  @crypto.bytes_to_hex_string(hasher.finalize())
}

///|
async fn extract(
  request : Extraction,
  cmake : String,
  expected : String,
) -> Json {
  let destination = @fs.realpath(request.destination)
  let archive = @fs.realpath(request.archive)
  // Proton creates the compressed archive in its own extraction directory.
  // Reject other shapes rather than implementing a general tar command.
  let normalized = archive.replace_all(old="\\", new="/")
  let parent = destination.replace_all(old="\\", new="/").trim_end(chars="/")
  guard normalized.has_prefix(parent + "/") &&
    !normalized.strip_prefix(parent + "/").unwrap().contains("/") &&
    normalized.has_suffix(".tar.bz2") &&
    @fs.kind(request.archive, follow_symlink=false) is Regular &&
    @fs.file_size(archive) <= 256L * 1024L * 1024L &&
    archive_digest(archive) == expected else {
    fail(
      "CEF extraction requires the exact pinned archive in its owned directory",
    )
  }
  let environment = @env.get_env_vars()
  // The Windows archive engine must work without Git's external bzip2. CMake
  // and system DLLs remain reachable through their ordinary executable paths.
  if @async.platform is Windows {
    guard @env.get_env_var("SystemRoot") is Some(system_root) &&
      !system_root.is_empty() else {
      fail("Windows CEF extraction requires SystemRoot")
    }
    for key in environment.keys().to_array() {
      if key.to_lower() == "path" {
        environment.remove(key)
      }
    }
    environment.set("Path", system_root + "\\System32")
  }
  print_progress("Extracting pinned CEF archive with CMake's archive engine")
  let status = @process.run(
    cmake,
    ["-E", "tar", "xjf", archive],
    cwd=destination,
    extra_env=environment,
    inherit_env=false,
    stdout=if json_mode.val { @stdio.stderr } else { @stdio.stdout },
    stderr=@stdio.stderr,
  )
  guard status == 0 else {
    if json_mode.val {
      raise ChildFailure(status, "CMake CEF extraction failed")
    }
    refuse("CMake CEF extraction failed: " + status.to_string())
  }
  {
    "archive": archive,
    "destination": destination,
    "sha256": expected,
    "extracted": true,
  }
}

///|
async fn roundtrip(cmake : String) -> Unit {
  let root = @fs.tmpdir(prefix="morphir-cef-cmake-probe-")
  defer @fs.rmdir(root, recursive=true)
  let original = root + "/original files"
  let extracted = root + "/extracted files"
  @fs.mkdir(original)
  @fs.mkdir(extracted)
  let bytes = @utf8.encode("CEF native archive probe\n\u{0000}exact bytes\r\n")
  @fs.write_file(original + "/probe.bin", bytes)
  let archive = root + "/probe.tar.bz2"
  let creation_status = @process.run(
    cmake,
    ["-E", "tar", "cjf", archive, "probe.bin"],
    cwd=original,
    stdout=if json_mode.val { @stdio.stderr } else { @stdio.stdout },
    stderr=@stdio.stderr,
  )
  guard creation_status == 0 else {
    if json_mode.val {
      raise ChildFailure(creation_status, "Archive probe creation failed")
    }
    refuse("Archive probe creation failed")
  }
  // Use the exact same-parent shape that Proton passes to its tar helper.
  @fs.write_file(extracted + "/probe.tar.bz2", @fs.read_file(archive).binary())
  extract(
    { archive: extracted + "/probe.tar.bz2", destination: extracted, },
    cmake,
    archive_digest(archive),
  )
  |> ignore
  guard @fs.read_file(extracted + "/probe.bin").binary() == bytes else {
    refuse("Archive probe bytes changed")
  }
  @fs.remove(extracted + "/probe.bin")
  try
    extract(
      { archive: extracted + "/probe.tar.bz2", destination: extracted, },
      cmake,
      String::make(64, '0'),
    )
    |> ignore
  catch {
    _ => ()
  } noraise {
    _ => refuse("A mismatched archive digest was accepted")
  }
  guard !@fs.exists(extracted + "/probe.bin") else {
    refuse("A mismatched archive created output")
  }
  print_progress(
    "CMake archive roundtrip and checksum refusal passed; no actual host package qualified",
  )
}

///|
async fn execute(args : ArrayView[String]) -> Json {
  let selected = control(args)
  if selected is Some(SelfTest) {
    guard parse(["-xjf", "input.tar.bz2", "-C", "output"]) is Some(_) else {
      refuse("Valid extraction refused")
    }
    for
      invalid in [
        [],
        ["-xf", "input", "-C", "output"],
        ["-xjf", "input", "-C", "output", "extra"],
        ["-xjf", "", "-C", "output"],
        ["-xjf", "input", "-C", ""],
        ["-xjf", "input", "-Coutput"],
        ["-xjfinput", "-C", "output"],
        ["-x", "-j", "-f", "input", "-C", "output"],
        ["-C", "output", "-xjf", "input"],
        ["--", "-xjf", "input", "-C", "output"],
        ["-xjf", "input", "--", "-C", "output"],
        ["--help"],
      ] {
      guard parse(invalid) is None else {
        refuse("Unsupported archive command accepted")
      }
    }
    for
      archive in [
        "input.tar.bz2", "--", "--help", "-C", "a λ $;= b", "--archive=x=y", "word:-xjf",
        "資料/input", "a\nline\r\t",
      ] {
      for
        destination in [
          "output", "--", "--self-test", "-xjf", "a λ $;= b", "--destination=x=y",
          "word:-C", "資料/output", "a\nline\r\t",
        ] {
        guard parse(["-xjf", archive, "-C", destination]) is Some(actual) &&
          actual.archive == archive &&
          actual.destination == destination else {
          refuse("Literal archive operands changed")
        }
      }
    }
    for
      args in [
        [],
        ["--self-test", "--"],
        ["--self-test", "--self-test"],
        ["--roundtrip", "--"],
        ["--roundtrip", "--roundtrip"],
        ["--help"],
        ["-h"],
        ["--self-test", "--roundtrip"],
        ["--self-test=true"],
        ["--roundtrip=true"],
        ["--", "--self-test"],
        ["--", "--roundtrip"],
        ["--roundtrip", "--help"],
        ["help", "--self-test"],
      ] {
      guard control(args) is None else { refuse("Invalid control accepted") }
    }
    guard control(["--self-test"]) is Some(SelfTest) &&
      control(["--roundtrip"]) is Some(Roundtrip) else {
      refuse("Exact control refused")
    }
    print_progress("Narrow CEF archive command refusal checks passed")
    return { "passed": true }
  }
  guard @env.get_env_var("MORPHIR_CEF_CMAKE") is Some(cmake) else {
    refuse("Missing configured CMake executable")
  }
  if selected is Some(Roundtrip) {
    roundtrip(cmake)
    return { "roundtrip": true, "extractor": cmake }
  }
  guard parse(args) is Some(request) &&
    @env.get_env_var("MORPHIR_CEF_ARCHIVE_SHA256") is Some(expected) else {
    refuse("Only Proton's configured CEF extraction is supported")
  }
  extract(request, cmake, expected)
}

///|
fn[T] refuse(message : String) -> T raise {
  if json_mode.val {
    fail(message)
  } else {
    abort(message)
  }
}

///|
fn json_command() -> @argparse.Command {
  @argparse.Command(
    "workbench-cef-extract.mbtx",
    about="Extract only the exact configured CEF archive; JSON extraction: -xjf ARCHIVE -C DESTINATION --json",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[
      @argparse.FlagArg("json", required=true),
      @argparse.FlagArg("help"),
      @argparse.FlagArg("self-test"),
      @argparse.FlagArg("roundtrip"),
    ],
    options=[
      @argparse.OptionArg("archive", requires=["destination"]),
      @argparse.OptionArg("destination", requires=["archive"]),
    ],
    groups=[
      @argparse.ArgGroup("operation", required=true, multiple=false, args=[
        "help", "self-test", "roundtrip", "archive",
      ]),
    ],
  )
}

///|
fn literal_arity(argv : ArrayView[String], count : Int32) -> Unit raise {
  ignore(
    @argparse.Command(
      "workbench-cef-extract",
      disable_help_flag=true,
      disable_help_subcommand=true,
      positionals=[
        @argparse.PositionArg(
          "argument",
          num_args=@argparse.ValueRange(lower=count, upper=count),
        ),
      ],
    ).parse(argv=["--"] + argv.to_owned(), env=Map([])),
  )
}

///|
fn json_arguments(argv : ArrayView[String]) -> Array[String] {
  // The tar adapter has exactly four legacy slots. Data slots are never flags.
  match argv {
    ["-xjf", archive, "-C", destination, "--json"] =>
      ["--json", "--archive=" + archive, "--destination=" + destination]
    ["--help", "--json"] => ["--json", "--help"]
    ["--self-test", "--json"] => ["--json", "--self-test"]
    ["--roundtrip", "--json"] => ["--json", "--roundtrip"]
    _ => argv.to_owned()
  }
}

///|
async fn main {
  let argv = @env.args()[1:]
  json_mode.val = match argv {
    ["--json", ..] | [_, "--json", ..] | [_, _, _, _, "--json", ..] => true
    _ => false
  }
  // A four-token extraction is always the legacy grammar, even if a path is --json.
  if argv is ["-xjf", _, "-C", _] {
    json_mode.val = false
  }
  if !json_mode.val {
    ignore(execute(argv))
    return
  }
  try {
    literal_arity(argv, if argv is ["-xjf", ..] { 5 } else { 2 })
    let matches = json_command().parse(argv=json_arguments(argv), env=Map([]))
    let result : Json = if matches.flags.get("help").unwrap_or(false) {
      { "render_help": json_command().render_help() }
    } else if matches.flags.get("self-test").unwrap_or(false) {
      execute(["--self-test"])
    } else if matches.flags.get("roundtrip").unwrap_or(false) {
      execute(["--roundtrip"])
    } else {
      let archive = matches.values["archive"][0]
      let destination = matches.values["destination"][0]
      execute(["-xjf", archive, "-C", destination])
    }
    @stdio.stdout.write(succeeded(result).stringify() + "\n")
  } catch {
    error => failed(error)
  }
}

///|
test "JSON extraction preserves all four literal tar slots" {
  for archive in ["--", "--json", "--help", "", "資料/archive λ.tar.bz2"] {
    for destination in ["--", "--json", "--self-test", "", "資料/output λ"] {
      let argv = ["-xjf", archive, "-C", destination, "--json"]
      literal_arity(argv, 5)
      let matches = json_command().parse(argv=json_arguments(argv), env=Map([]))
      assert_eq(matches.values["archive"], [archive])
      assert_eq(matches.values["destination"], [destination])
    }
  }
  for
    argv in [
      ["--json", "--help", "--"],
      ["-xjf", "a", "-C", "b", "--json", "--"],
    ] {
    let refused = try {
      literal_arity(argv, if argv[0] == "-xjf" { 5 } else { 2 })
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}
