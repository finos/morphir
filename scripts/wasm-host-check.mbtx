///|
/// Opt-in component qualification. No production adapter or CI runtime selection.
import {
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
  "moonbitlang/core/json",
}

///|
let json_mode : Ref[Bool] = Ref(false)

///|
suberror ChildFailure {
  ChildFailure(Int32, String)
} derive(Debug)

///|
fn succeeded(result : Json) -> Json {
  {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "wasm.host.check",
    "state": "succeeded",
    "exitCode": 0,
    "result": result,
    "diagnostics": [],
  }
}

///|
async fn failed(error : Error) -> Unit {
  let (status, code) = match error {
    ChildFailure(status, _) =>
      (if status < 0 { 128 - status } else { status }, "child_failed")
    _ => (1, "command_failed")
  }
  let message = match error {
    ChildFailure(_, message) => message
    _ => error.to_string()
  }
  @stdio.stderr.write(message + "\n")
  let value : Json = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "wasm.host.check",
    "state": "failed",
    "exitCode": status,
    "error": { "code": code, "message": message },
    "diagnostics": [],
  }
  @stdio.stdout.write(value.stringify() + "\n")
  @sys.exit(status)
}

///|
async fn print_progress(message : String) -> Unit {
  if json_mode.val {
    @stdio.stderr.write(message + "\n")
  } else {
    println(message)
  }
}

///|
let build = ".dev/wasm-host-qualification"

///|
async fn checked(program : String, args : Array[String]) -> String {
  let arguments = args.join(" ")
  @stdio.stderr.write("[wasm-host] \{program} \{arguments}\n")
  let (code, output, errors) = @async.with_timeout(180000, async fn() {
    @process.collect_output(program, args)
  })
  @stdio.stderr.write(errors.text())
  if code != 0 {
    @stdio.stderr.write(output.text())
    if json_mode.val {
      raise ChildFailure(code, "Qualification command failed: " + program)
    }
    fail("Qualification command failed, exit \{code}: \{program}")
  }
  output.text()
}

///|
async fn wasm_tools(args : Array[String]) -> String {
  checked("mise", ["exec", "wasm-tools@1.259.0", "--", "wasm-tools"] + args)
}

///|
async fn wasmtime(args : Array[String]) -> String {
  checked(
    "mise",
    ["exec", "aqua:bytecodealliance/wasmtime@49.0.3", "--", "wasmtime"] + args,
  )
}

///|
enum LifetimeWorld {
  Resources
  Callbacks
}

///|
async fn build_lifetime_world(world : LifetimeWorld) -> Unit {
  let (name, package, declarations) = match world {
    Resources =>
      ("resources", "gen/interface/morphir/lifetime-probe/sessions", 7)
    Callbacks => ("callbacks", "gen/world/callbacks", 1)
  }
  let guest = build + "/" + name + "-guest"
  checked("mise", [
    "exec", "github:bytecodealliance/wit-bindgen@0.63.0", "--", "wit-bindgen", "moonbit",
    "tests/wasm-host/lifetimes.wit", "--world", name, "--out-dir", guest, "--derive-eq",
    "--derive-debug",
  ])
  |> ignore
  @fs.write_file(guest + "/moon.work", "members = [\".\"]\n")
  // Keep generated resource helpers. Only replace the generated implementation
  // declarations, exactly as for the original world stub.
  let lines : Array[String] = []
  let mut removed = 0
  for
    line in @fs.read_file(guest + "/" + package + "/top.mbt").text().split("\n") {
    if line.has_prefix("declare pub fn ") {
      removed += 1
    } else {
      lines.push(line.to_owned())
    }
  }
  guard removed == declarations else {
    fail("Unexpected generated " + name + " implementation declarations")
  }
  @fs.write_file(
    guest + "/" + package + "/top.mbt",
    lines.join("\n") +
    "\n" +
    @fs.read_file("tests/wasm-host/" + name + ".mbt").text(),
  )
  match world {
    Callbacks =>
      @fs.write_file(
        guest + "/" + package + "/moon.pkg",
        "import { \"morphir/lifetime-probe/interface/morphir/lifetime-probe/host\", }\nwarnings = \"-44\"\n",
      )
    Resources => ()
  }
  checked("moon", ["-C", guest, "build", "--target", "wasm", "--release"])
  |> ignore
  wasm_tools([
    "component",
    "embed",
    "tests/wasm-host/lifetimes.wit",
    "--world",
    name,
    guest + "/_build/wasm/release/build/gen/gen.wasm",
    "--encoding",
    "utf16",
    "--output",
    build + "/" + name + ".core.wasm",
  ])
  |> ignore
  wasm_tools([
    "component",
    "new",
    build + "/" + name + ".core.wasm",
    "--output",
    build + "/" + name + ".component.wasm",
  ])
  |> ignore
  wasm_tools(["validate", build + "/" + name + ".component.wasm"]) |> ignore
  checked("node", [
    "tests/wasm-host/node_modules/@bytecodealliance/jco/dist/jco.js",
    "transpile",
    build + "/" + name + ".component.wasm",
    "-o",
    build + "/js",
    "--base64-cutoff",
    "0",
    "--instantiation",
    "async",
  ])
  |> ignore
}

///|
async fn native_probe(checkout : String) -> Json {
  let source = @fs.realpath(checkout)
  let revision = checked("git", ["-C", source, "rev-parse", "HEAD"])
  guard revision.trim() == "5490d6bf1cc293c1a3adc42dd3583e607b1ec631" else {
    fail("Wasmoon must be the source revision qualified by the hosting study")
  }
  // Keep generated probe code in our own build directory. Never install a probe
  // into the supplied source checkout or rewrite its build rules.
  let native = build + "/native"
  let probe = native + "/probe"
  @fs.mkdir(probe, recursive=true, allow_exist=true)
  let members = [Json::string("./probe")]
  for
    module_ in [
      "wasm_core", "wasm_component", "wasm_milkir", "milkir", "vcode", "regalloc",
      "vcode_regalloc", "x64_target", "aarch64_target", "wasmoon_jit", "wasmoon",
    ] {
    members.push(Json::string(source + "/modules/" + module_))
  }
  @fs.write_file(
    native + "/moon.work",
    "members = " + Json::array(members).stringify() + "\n",
  )
  @fs.write_file(
    probe + "/moon.mod",
    "name = \"morphir/wasmoon-host-probe\"\nimport { \"Milky2018/wasmoon@0.16.0\", \"moonbitlang/async@0.22.4\", \"moonbitlang/x@0.5.5\", }\n",
  )
  @fs.write_file(
    probe + "/moon.pkg",
    "import { \"Milky2018/wasmoon/component\", \"moonbitlang/async\", \"moonbitlang/async/fs\", \"moonbitlang/core/env\", \"moonbitlang/core/json\", \"moonbitlang/core/argparse\", \"moonbitlang/x/sys\", \"moonbitlang/async/stdio\", }\npkgtype(kind: \"executable\")\n",
  )
  @fs.write_file(
    probe + "/main.mbt",
    @fs.read_file("tests/wasm-host/wasmoon.mbt").text(),
  )
  let component = @fs.realpath(build + "/probe.component.wasm")
  let resources = @fs.realpath(build + "/resources.component.wasm")
  let callbacks = @fs.realpath(build + "/callbacks.component.wasm")
  let output = checked("moon", [
    "-C", probe, "run", ".", "--target", "native", "--", component, resources, callbacks,
  ])
  let report = @json.parse(output)
  guard report is Object(fields) else {
    fail("Native probe did not return an evidence object")
  }
  fields["sourceRevision"] = Json::string(revision.trim().to_owned())
  fields["sourceDiff"] = Json::string(
    checked("git", ["-C", source, "diff", "HEAD", "--"]),
  )
  @fs.write_file(build + "/wasmoon-report.json", report.stringify() + "\n")
  report
}

///|
enum Action {
  Qualify
  Setup
  SelfTest
} derive(Eq, Debug)

///|
fn command() -> @argparse.Command {
  @argparse.Command(
    "wasm-host-check",
    about="Qualify component hosts by default, or setup browser dependencies explicitly.",
    disable_help_flag=true,
    positionals=[
      @argparse.PositionArg(
        "mode",
        num_args=@argparse.ValueRange(lower=0, upper=1),
        about="setup",
      ),
    ],
  )
}

///|
fn action(argv : Array[String]) -> Action raise {
  // Modes are literal operands. A fixed delimiter preserves every original
  // token, so a raw -- cannot become the no-argument qualification action.
  let matches = command().parse(argv=["--"] + argv) catch {
    _ => fail("Usage: moonx scripts/wasm-host-check.mbtx [setup]")
  }
  match matches.values.get("mode") {
    None => Qualify
    Some(["setup"]) => Setup
    Some(["--self-test"]) => SelfTest
    _ => fail("Usage: moonx scripts/wasm-host-check.mbtx [setup]")
  }
}

///|
async fn execute(
  selected : Action,
  invoke : async (String, Array[String]) -> String,
  qualify : async () -> Unit,
) -> Unit {
  match selected {
    Setup => {
      invoke("bun", ["install", "--frozen-lockfile", "--cwd", "tests/wasm-host"])
      |> ignore
      invoke("bun", [
        "run", "--cwd", "tests/wasm-host", "playwright", "install", "chromium",
      ])
      |> ignore
    }
    Qualify => qualify()
    SelfTest => self_test()
  }
}

///|
fn json_command() -> @argparse.Command {
  @argparse.Command(
    "wasm-host-check",
    about="[setup] --json; --self-test --json; --help --json",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[
      @argparse.FlagArg("json", required=true),
      @argparse.FlagArg("help"),
      @argparse.FlagArg("self-test"),
    ],
    positionals=[
      @argparse.PositionArg("mode", num_args=@argparse.ValueRange(upper=1)),
    ],
    groups=[
      @argparse.ArgGroup("operation", required=false, multiple=false, args=[
        "help", "self-test", "mode",
      ]),
    ],
  )
}

///|
fn literal_arity(argv : ArrayView[String], count : Int32) -> Unit raise {
  ignore(
    @argparse.Command(
      "wasm-host-check",
      disable_help_flag=true,
      disable_help_subcommand=true,
      positionals=[
        @argparse.PositionArg(
          "argument",
          num_args=@argparse.ValueRange(lower=count, upper=count),
        ),
      ],
    ).parse(argv=["--"] + argv.to_owned(), env=Map([])),
  )
}

///|
fn json_arguments(argv : ArrayView[String]) -> Array[String] {
  // This is a fixed mode/control slot, not an external argument tail.
  match argv {
    ["--help", "--json"] => ["--json", "--help"]
    ["--self-test", "--json"] => ["--json", "--self-test"]
    [mode, "--json"] => ["--json", "--", mode]
    ["--json", "--"] => ["--json", "--", "--"]
    ["--json", "--", mode] => ["--json", "--", mode]
    _ => argv.to_owned()
  }
}

///|
async fn main {
  let argv = @env.args()[1:]
  json_mode.val = match argv {
    ["--json", ..] | [_, "--json", ..] => true
    _ => false
  }
  if !json_mode.val {
    legacy_main()
    return
  }
  try {
    literal_arity(
      argv,
      match argv {
        ["--json", "--", _] => 3
        ["--json"] => 1
        _ => 2
      },
    )
    let matches = json_command().parse(argv=json_arguments(argv), env=Map([]))
    let result : Json = if matches.flags.get("help").unwrap_or(false) {
      { "render_help": json_command().render_help() }
    } else {
      let selected = if matches.flags.get("self-test").unwrap_or(false) {
        SelfTest
      } else {
        action(matches.values.get("mode").unwrap_or([]))
      }
      if selected == SelfTest {
        self_test()
        ({ "passed": true } : Json)
      } else if selected == Setup {
        execute(selected, checked, qualify)
        (
          {
            "dependenciesDirectory": "tests/wasm-host",
            "browser": "chromium",
            "steps": [{ "exitCode": 0 }, { "exitCode": 0 }],
          } : Json)
      } else {
        qualify()
        @fs.read_file(build + "/run.ion").json()
      }
    }
    @stdio.stdout.write(succeeded(result).stringify() + "\n")
  } catch {
    error => failed(error)
  }
}

///|
async fn legacy_main() -> Unit {
  let selected = action(@env.args()[1:].to_owned())
  execute(selected, checked, qualify)
}

///|
async fn qualify() -> Unit {
  @fs.mkdir(build, recursive=true, allow_exist=true)
  // Remove the completion record first so a failed rerun cannot look successful.
  if @fs.exists(build + "/run.ion") {
    @fs.remove(build + "/run.ion")
  }
  let compiler = checked("moon", ["version", "--all"])
  guard compiler.contains("0.10.16+b1a0e846e") else {
    fail("MoonBit 0.10.16+b1a0e846e required")
  }
  // These fixture sources are copied into generated modules outside moon.work.
  for fixture in ["guest", "resources", "callbacks", "wasmoon"] {
    let path = "tests/wasm-host/" + fixture + ".mbt"
    guard checked("moonfmt", [path]) == @fs.read_file(path).text() else {
      fail("Format the fixture with moonfmt -w " + path)
    }
  }
  checked("bun", ["install", "--frozen-lockfile", "--cwd", "tests/wasm-host"])
  |> ignore
  // Exercise the built production adapter, including its adjacent .mjs imports.
  // A clean checkout has no generated runtime files from other test tasks.
  checked("bun", ["install", "--frozen-lockfile"]) |> ignore
  checked("bun", [
    "install", "--frozen-lockfile", "--cwd", "pkgs/morphir-host/embedding",
  ])
  |> ignore
  checked("bun", ["run", "--cwd", "pkgs/morphir-host/embedding", "build"])
  |> ignore
  checked("bun", ["check", "--project", "tests/wasm-host/tsconfig.json"])
  |> ignore
  let generator = checked("mise", [
    "exec", "github:bytecodealliance/wit-bindgen@0.63.0", "--", "wit-bindgen", "--version",
  ])
  checked("mise", [
    "exec",
    "github:bytecodealliance/wit-bindgen@0.63.0",
    "--",
    "wit-bindgen",
    "moonbit",
    "tests/wasm-host/probe.wit",
    "--out-dir",
    build + "/guest",
    "--derive-eq",
    "--derive-debug",
  ])
  |> ignore
  @fs.write_file(build + "/guest/moon.work", "members = [\".\"]\n")
  @fs.write_file(
    build + "/guest/gen/world/probe/top.mbt",
    @fs.read_file("tests/wasm-host/guest.mbt").text(),
  )
  checked("moon", [
    "-C",
    build + "/guest",
    "build",
    "--target",
    "wasm",
    "--release",
  ])
  |> ignore
  wasm_tools([
    "component",
    "embed",
    "tests/wasm-host/probe.wit",
    build + "/guest/_build/wasm/release/build/gen/gen.wasm",
    "--encoding",
    "utf16",
    "--output",
    build + "/probe.core.wasm",
  ])
  |> ignore
  wasm_tools([
    "component",
    "new",
    build + "/probe.core.wasm",
    "--output",
    build + "/probe.component.wasm",
  ])
  |> ignore
  wasm_tools(["validate", build + "/probe.component.wasm"]) |> ignore
  let wit = wasm_tools(["component", "wit", build + "/probe.component.wasm"])
  @fs.write_file(build + "/component.wit", wit)
  let reference = wasmtime([
    "run",
    "--invoke",
    "exchange({label: \"Morphir 😀\", payload: [224,1,0,234,33,42], encoding: ion-binary})",
    build + "/probe.component.wasm",
  ])
  guard reference.trim() ==
    "ok({label: \"Morphir 😀\", payload: [224, 1, 0, 234, 33, 42], encoding: ion-binary})" else {
    fail("Wasmtime reference changed: " + reference)
  }
  @fs.write_file(build + "/wasmtime.txt", reference)
  checked("node", [
    "tests/wasm-host/node_modules/@bytecodealliance/jco/dist/jco.js",
    "transpile",
    build + "/probe.component.wasm",
    "-o",
    build + "/js",
    "--base64-cutoff",
    "0",
  ])
  |> ignore
  build_lifetime_world(Resources)
  build_lifetime_world(Callbacks)
  checked("bun", [
    "build",
    "tests/wasm-host/browser-entry.mts",
    "--target",
    "browser",
    "--outfile",
    build + "/checks.js",
  ])
  |> ignore
  checked("node", ["tests/wasm-host/node.mts", build]) |> ignore
  checked("node", ["tests/wasm-host/browser.mts", build]) |> ignore
  let native = match @env.get_env_var("MORPHIR_WASMOON_CHECKOUT") {
    Some(checkout) => native_probe(checkout)
    None =>
      Json({
        "status": "not-run",
        "reason": "MORPHIR_WASMOON_CHECKOUT not supplied",
      })
  }
  let report = Json::object(
    Map::from_array([
      ("study", Json::string("morphir-ukvn.5.55.7")),
      (
        "scope",
        Json::string(
          "component-boundary-fixture; not full MEP or production adapter qualification",
        ),
      ),
      ("moonbit", Json::string(compiler)),
      ("witBindgen", Json::string(generator)),
      ("wasmTools", Json::string(wasm_tools(["--version"]))),
      ("wasmtime", Json::string(wasmtime(["--version"]))),
      ("jco", Json::string("1.39.0")),
      ("reference", Json::string(reference)),
      ("node", @fs.read_file(build + "/node-report.json").json()),
      ("browser", @fs.read_file(build + "/browser-report.json").json()),
      ("wasmoon", native),
    ]),
  )
  // JSON spelling is also valid Ion text. Individual JS test reports deliberately
  // remain JSON for direct inspection by JavaScript test tooling.
  @fs.write_file(build + "/run.ion", report.stringify() + "\n")
  print_progress(
    "Component study completed; inspect per-host support statuses: " +
    build +
    "/run.ion",
  )
}

///|
async fn self_test() -> Unit {
  for
    (argv, expected) in [
      ([], Qualify),
      (["setup"], Setup),
      (["--self-test"], SelfTest),
    ] {
    guard action(argv) == expected else { fail("Wrong Wasm-host action") }
  }
  for
    argv in [
      ["unknown"],
      ["--"],
      ["--", "setup"],
      ["setup", "--"],
      ["--", "--"],
      ["--help"],
      ["-h"],
      ["help"],
      ["--help", "unknown"],
      ["setup", "--help"],
      [""],
      ["setup", "extra"],
      ["--unknown"],
      ["setup", "--unknown"],
      ["--self-test", "setup"],
      ["--self-test", "--self-test"],
      ["--self-test", "--"],
      ["--", "--self-test"],
      ["--self-test", "--help"],
      ["--self-test=true"],
      ["--", "--help"],
    ] {
    let calls = []
    let refused = try {
      execute(
        action(argv),
        (program, args) => {
          calls.push((program, args.copy()))
          "stub output"
        },
        () => calls.push(("qualify", [])),
      )
      false
    } catch {
      _ => true
    }
    guard refused && calls.is_empty() else {
      fail("Invalid Wasm-host argv was accepted or reached effects")
    }
  }
  let expected = [
    ("bun", ["install", "--frozen-lockfile", "--cwd", "tests/wasm-host"]),
    (
      "bun",
      ["run", "--cwd", "tests/wasm-host", "playwright", "install", "chromium"],
    ),
  ]
  let calls = []
  let invoke : async (String, Array[String]) -> String = fn(program, args) {
    calls.push((program, args.copy()))
    "stub output"
  }
  let qualify : async () -> Unit = fn() { calls.push(("qualify", [])) }
  execute(action(["setup"]), invoke, qualify)
  guard calls == expected else { fail("Changed setup command boundaries") }
  for argv in [[]] {
    calls.clear()
    execute(action(argv), invoke, qualify)
    guard calls == [("qualify", [])] else {
      fail("Default invocation must select qualification exactly once")
    }
  }
  for stop in 0..<expected.length() {
    calls.clear()
    let failed = try {
      execute(
        Setup,
        (program, args) => {
          calls.push((program, args.copy()))
          if calls.length() == stop + 1 {
            fail("Injected checked child failure")
          }
          "stub output"
        },
        qualify,
      )
      false
    } catch {
      _ => true
    }
    guard failed && calls == expected[:stop + 1].to_owned() else {
      fail("Setup child failure did not stop execution")
    }
  }
  calls.clear()
  let failed = try {
    execute(Qualify, invoke, () => fail("Injected qualification failure"))
    false
  } catch {
    _ => true
  }
  guard failed && calls.is_empty() else {
    fail("Qualification failure was swallowed or ran setup commands")
  }
  print_progress(
    "wasm-host-check: parser, default dispatch, setup and failures pass",
  )
}

///|
test "JSON mode uses complete grammar and literal mode boundaries" {
  for mode in ["setup", "--", "--json", "", "雪"] {
    let matches = json_command().parse(
      argv=json_arguments([mode, "--json"]),
      env=Map([]),
    )
    assert_eq(matches.values["mode"], [mode])
  }
  for control in ["--help", "--self-test"] {
    let matches = json_command().parse(
      argv=json_arguments([control, "--json"]),
      env=Map([]),
    )
    assert_true(matches.flags[control.strip_prefix("--").unwrap().to_owned()])
  }
  for argv in [["--json", "--help", "--"], ["--self-test", "--json", "extra"]] {
    let refused = try {
      literal_arity(argv, 2)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}
