///|
/// Fixture preparation may use Moon; actual library assembly and fresh loading
/// run with an empty PATH and no MOON_HOME in the application acceptance test.
import {
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/stdio",
}

///|
async fn output(command : String, args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output(command, args)
  if code != 0 {
    fail("Assembly fixture preparation failed: " + err.text())
  }
  out.text()
}

///|
async fn run(command : String, args : Array[String]) -> Unit {
  let code = @process.run(
    command,
    args,
    stdout=if json_mode { @stdio.stderr } else { @stdio.stdout },
    stderr=@stdio.stderr,
  )
  if code != 0 {
    fail("Assembly qualification failed: " + command)
  }
}

///|
async fn execute() -> Json {
  let core_root = output("moon", ["run", "scripts/moonbit-core.mbtx", "check"])
    .trim()
    .to_owned()
  let directory = @fs.tmpdir(prefix="morphir-assembly-qualification-")
  (if json_mode { @stdio.stderr } else { @stdio.stdout }).write(
    "Assembly qualification workspace: " + directory + "\n",
  )
  // Keep a failed run for diagnosis; remove successful test publications only
  // after an independent consumer has loaded and executed both saved variants.
  @fs.write_file(
    directory + "/generated.json",
    output("moon", [
      "run", "pkgs/morphir-host/assembly/qualification", "--target", "js",
    ]),
  )
  @fs.write_file(
    directory + "/core-graph.json",
    output("moon", ["-C", core_root, "tree", "--package", "--json"]),
  )
  @fs.write_file(
    directory + "/sdk-build.txt",
    output("moon", [
      "build", "--dry-run", "--target", "wasm", "--release", "pkgs/morphir-sdk/basics",
    ]),
  )
  run("bun", ["run", "--cwd", "pkgs/morphir-host/embedding", "build"])
  run("node", [
    "pkgs/morphir-host/embedding/test/generated.mts", directory, core_root,
  ])
  if !@fs.exists(".dev") {
    @fs.mkdir(".dev", recursive=true)
  }
  @fs.write_file(
    ".dev/assembly-qualification-report.json",
    @fs.read_file(directory + "/report.json"),
  )
  let receipt = if json_mode {
    @fs.read_file(".dev/assembly-qualification-report.json").json()
  } else {
    Json::null()
  }
  @fs.rmdir(directory, recursive=true)
  (
    {
      "reportPath": ".dev/assembly-qualification-report.json",
      "receipt": receipt,
    } : Json)
}

///|
let json_mode : Bool = match @env.args() {
  [_, "--json", ..] => true
  _ => false
}

///|
fn json_command() -> @argparse.Command {
  @argparse.Command(
    "assembly-check",
    disable_help_flag=true,
    disable_help_subcommand=true,
    about="Opt-in JSON results. Use --json [--help] or --json -- RAW. Other argv retains legacy ignored-tail behavior. stdout is one compact command-result 0.1.0 value plus LF; progress and live child stdout go to stderr. Success has result and diagnostics; failure has error {code,message}, diagnostics and the mapped exitCode. Expected refusals and ordinary errors exit 1, JSON syntax exits 2; explicitly propagated positive child statuses are retained, negative statuses map to 1. Default abort/signal behavior is unchanged; JSON refusals use normal exit 1. Help returns result.render_help without effects. Operation result fields: reportPath and receipt, decoded from the completed assembly qualification report.",
    flags=[@argparse.FlagArg("json"), @argparse.FlagArg("help")],
    positionals=[
      @argparse.PositionArg("legacy", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn success(result : Json) -> Unit {
  @stdio.stdout.write(
    (
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "assembly.check",
        "state": "succeeded",
        "exitCode": 0,
        "result": result,
        "diagnostics": [],
      } : Json).stringify() +
    "\n",
  )
}

///|
async fn failure(code : Int32, category : String, message : String) -> Unit {
  @stdio.stdout.write(
    (
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "assembly.check",
        "state": "failed",
        "exitCode": code,
        "error": { "code": category, "message": message },
        "diagnostics": [],
      } : Json).stringify() +
    "\n",
  )
}

///|
async fn main {
  if !json_mode {
    ignore(execute())
    return
  }
  let command = json_command()
  let matches = command.parse(argv=@env.args()[1:]) catch {
    error => {
      failure(2, "invalid_arguments", error.to_string())
      @sys.exit(2)
      panic()
    }
  }
  if matches.flags.get("help").unwrap_or(false) {
    success({ "render_help": command.render_help() })
    return
  }
  try {
    let result = execute()
    success(result)
  } catch {
    error => {
      failure(1, "command_failed", error.to_string())
      @sys.exit(1)
    }
  }
}
