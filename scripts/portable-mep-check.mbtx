///|
/// Local operation acceptance, separate from independent shared MCK verdicts.
import {
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/async@0.22.1/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/crypto",
}

///|
async fn digest(path : String) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(@fs.read_file(path).binary()))
}

///|
async fn checked(
  program : String,
  args : Array[String],
  environment~ : Map[String, String] = {},
) -> String {
  let (code, out, err) = @process.collect_output(
    program,
    args,
    extra_env=environment,
  )
  guard code == 0 else {
    @stdio.stderr.write(out.text() + err.text())
    fail("Portable MEP acceptance failed: " + program)
  }
  out.text()
}

///|
async fn main {
  let root = @fs.realpath(".")
  let artifacts = @fs.realpath(
    @env.get_env_var("MORPHIR_MEP_ARTIFACTS").unwrap_or(".dev/portable-mep") +
    "/extension",
  )
  let evidence = @env.get_env_var("MORPHIR_MEP_EVIDENCE").unwrap_or(
    ".dev/portable-mep-acceptance",
  )
  guard !@fs.exists(evidence) else {
    fail("Choose a new MEP evidence directory to preserve earlier results")
  }
  @fs.mkdir(evidence, recursive=true)
  let evidence = @fs.realpath(evidence)
  let compiler = checked("moon", ["version", "--all"])
  guard compiler.contains("0.10.15+943464bfa") else {
    fail("Pinned MoonBit 0.10.15 is required")
  }
  ignore(
    checked("bun", ["run", "--cwd", "pkgs/morphir-host/embedding", "build"]),
  )
  ignore(
    checked("moon", [
      "build", "--target", "native", "--release", "apps/morphir-extension/acceptance",
    ]),
  )
  let node = checked("node", ["-p", "process.execPath"]).trim().to_owned()
  let version = checked(node, ["--version"]).trim().to_owned()
  guard version == "v24.22.0" else { fail("Node 24.22.0 is required") }
  let guest_args = Json([
    root + "/pkgs/morphir-host/embedding/node-mep-cli.mjs",
    artifacts,
  ])
  let wasm_digest = digest(artifacts + "/model.wasm")
  let manifest_digest = digest(artifacts + "/manifest.ion")
  let host_modules : Array[Json] = []
  let host_paths = [
    "node-mep-cli.mjs", "node-mep-stdio.mjs", "node-mep-adapter.mjs", "node-mep-worker.mjs",
    "mep-adapter.mjs", "mep-frames.mjs", "wasm-memory.mjs", "node-artifacts.mjs",
    "artifacts.mjs", "assembly.mjs", "index.mjs", "dist/bridge.mjs",
  ]
  let host_digests : Array[String] = []
  for name in host_paths {
    let hash = digest(root + "/pkgs/morphir-host/embedding/" + name)
    host_digests.push(hash)
    host_modules.push({ "path": name, "sha256": hash })
  }
  let acceptance = root +
    "/_build/native/release/build/finos/morphir-extension/acceptance/acceptance.exe"
  let result = checked(acceptance, [node, root, evidence], environment={
    "MORPHIR_MEP_GUEST_ARGS": guest_args.stringify(),
    "MORPHIR_MEP_GUEST_ENV": Json({ "PATH": "", "MOON_HOME": "" }).stringify(),
  })
  guard wasm_digest == digest(artifacts + "/model.wasm") &&
    manifest_digest == digest(artifacts + "/manifest.ion") else {
    fail("Saved extension changed during qualification")
  }
  for i, name in host_paths {
    guard host_digests[i] ==
      digest(root + "/pkgs/morphir-host/embedding/" + name) else {
      fail("Host module changed during qualification: " + name)
    }
  }
  let receipt : Json = {
    "scope": "local acceptance; independent shared MEP conformance required separately",
    "node": version,
    "nodeSha256": digest(node),
    "runtime": checked(node, [
      "-p", "JSON.stringify({node:process.version,v8:process.versions.v8,arch:process.arch,platform:process.platform})",
    ])
    .trim()
    .to_owned(),
    "hostModules": host_modules,
    "guestCompilerAccess": "PATH and MOON_HOME empty in fresh guest processes",
    "wasmSha256": wasm_digest,
    "manifestSha256": manifest_digest,
    "compiler": compiler,
    "acceptance": result.trim().to_owned(),
  }
  @fs.write_file(
    evidence + "/portable-receipt.ion",
    "portable_mep_acceptance::" + receipt.stringify() + "\n",
  )
  println("Fresh saved MEP process and source consumer acceptance passed")
}
