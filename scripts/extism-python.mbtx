----
import {
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Opt-in qualification of an existing Python Extism bundle. Acquisition and
/// dependency installation are explicit prerequisites, never side effects.
suberror CommandFailure {
  CommandFailure(Int32, String, String)
}

///|
async fn checked(
  program : String,
  args : Array[String],
  environment~ : Map[String, String] = Map([]),
) -> Unit {
  let moon_home = @env.get_env_var("MOON_HOME").unwrap_or("")
  let executable = if program == "moon" && moon_home != "" {
    moon_home + "/bin/moon"
  } else {
    program
  }
  let variables = environment.copy()
  if moon_home != "" {
    variables["PATH"] = moon_home +
      "/bin:" +
      @env.get_env_var("PATH").unwrap_or("")
  }
  let status = @process.run(
    executable,
    args,
    extra_env=variables,
    stdout=@stdio.stderr,
    stderr=@stdio.stderr,
  )
  guard status == 0 else {
    raise CommandFailure(
      if status > 0 {
        status
      } else {
        1
      },
      "extism.qualification_failed",
      program + " failed with status " + status.to_string(),
    )
  }
}

///|
fn required(matches : @argparse.Matches, key : String) -> String raise {
  let value = match matches.values.get(key) {
    Some([value]) => value
    _ => ""
  }
  guard value.has_prefix("/") && !value.contains("\u0000") else {
    raise CommandFailure(
      1,
      "extism.invalid_input",
      "--" + key + " must name an explicit absolute local path",
    )
  }
  value
}

///|
fn field(value : Json, key : String) -> Json {
  match value {
    Object(fields) => fields.get(key).unwrap_or(Json::null())
    _ => Json::null()
  }
}

///|
async fn digest(path : String) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(@fs.read_file(path).binary()))
}

///|
async fn capture(program : String, args : Array[String]) -> String {
  let (status, output, errors) = @process.collect_output(program, args)
  if errors.text() != "" {
    @stdio.stderr.write(errors.text())
  }
  guard status == 0 else {
    raise CommandFailure(
      if status > 0 {
        status
      } else {
        1
      },
      "extism.qualification_failed",
      "Unable to inspect " + program + " for candidate-bound qualification",
    )
  }
  output.text()
}

///|
/// The caller takes this snapshot before the real-bundle suite and compares it
/// again afterwards. A source/artifact change while tests run cannot be blessed
/// by a receipt that merely hashes the new bytes after the fact.
async fn candidate(root : String, bundle : String, python : String) -> Json {
  let node = @json.parse(
    capture("node", [
      "-p", "JSON.stringify({platform:process.platform,architecture:process.arch,node:process.version,executable:process.execPath})",
    ]),
  )
  guard field(node, "executable") is String(runtime) else {
    raise CommandFailure(
      1, "extism.invalid_receipt", "Node runtime identity is missing",
    )
  }
  let host = @json.parse(
    @fs.read_file(root + "/.dev/native-services/host-pin.json").text(),
  )
  guard field(host, "executable") is String(host_program) &&
    field(host, "sha256") == Json::string(digest(host_program)) else {
    raise CommandFailure(
      1, "extism.invalid_receipt", "Pinned host bytes changed",
    )
  }
  let host_evidence = @json.parse(
    @fs.read_file(root + "/.dev/native-services/evidence.json").text(),
  )
  guard field(host_evidence, "host") == host &&
    field(host_evidence, "sourceRevision") == field(host, "sourceRevision") &&
    field(host_evidence, "cargoLockSha256") ==
    Json::string(digest(root + "/.dev/native-services/Cargo.lock")) else {
    raise CommandFailure(
      1, "extism.invalid_receipt", "Host build evidence does not match its executable or lock",
    )
  }
  let host_build : Map[String, Json] = Map([])
  for
    key in [
      "sourceRevision", "sharedRustTree", "target", "rust", "moonbit", "cargoLockSha256",
    ] {
    guard field(host_evidence, key) is String(text) && text != "" else {
      raise CommandFailure(
        1,
        "extism.invalid_receipt",
        "Missing host build identity: " + key,
      )
    }
    host_build[key] = Json::string(text)
  }
  let descriptor = @json.parse(@fs.read_file(bundle + "/release.json").text())
  guard field(descriptor, "artifacts") is Array(artifacts) &&
    artifacts
    .iter()
    .find_first(a => field(a, "runtime") == Json::string("wasm"))
    is Some(wasm) &&
    field(descriptor, "version") is String(version) &&
    field(wasm, "filename") is String(filename) &&
    filename != "" &&
    !filename.has_prefix("/") &&
    !filename.contains("\\") &&
    filename.split("/").all(part => part != "" && part != "." && part != "..") &&
    field(wasm, "sha256") == Json::string(digest(bundle + "/" + filename)) else {
    raise CommandFailure(
      1, "extism.invalid_receipt", "Python WASM bytes changed",
    )
  }
  let descriptor_sha = digest(bundle + "/release.json")
  let bundle_fields : Map[String, Json] = Map::from_array([
    ("descriptorSha256", Json::string(descriptor_sha)),
    ("wasmSha256", field(wasm, "sha256")),
    ("extensionId", field(descriptor, "extensionId")),
    ("version", field(descriptor, "version")),
  ])
  if descriptor is Object(fields) && fields.get("gitCommit") is Some(commit) {
    bundle_fields["gitCommit"] = commit
  }
  let source_files : Map[String, Json] = Map([])
  for
    path in [
      "apps/morphir/cli/extism.mbt", "apps/morphir/cli/extension.mbt", "apps/morphir/cli/arguments.mbt",
      "apps/morphir/native-services/main.rs", "apps/morphir/native-services/extism.rs",
      "apps/morphir/native-services/extism_tests.rs", "apps/morphir/native-services/Cargo.lock",
      "apps/morphir/dist/morphir.js", "apps/morphir/build-provider/extism.mts", "apps/morphir/build-provider/test-extism.mts",
      "apps/morphir/fixtures/extism-python/v1/acme/models.py", "apps/morphir/fixtures/extism-python/v1/acme/rules.py",
      "apps/morphir/scripts/extism-python-api.py", "scripts/extism-python.mbtx",
    ] {
    source_files[path] = Json::string(digest(root + "/" + path))
  }
  let modules : Map[String, Json] = Map([])
  for name in ["extism.mjs", "supervision.mjs", "windows-job.mjs"] {
    modules[name] = Json::string(
      digest(root + "/apps/morphir/build-provider/" + name),
    )
  }
  let runtime_sha = digest(runtime)
  let entry_sha = digest(root + "/apps/morphir/bin/morphir.js")
  let launchers : Json = {
    "source-native": {
      "programSha256": digest(
        root + "/_build/native/debug/build/morphir/morphir/morphir.exe",
      ),
      "entrypointSha256": Json::null(),
    },
    "source-js": { "programSha256": runtime_sha, "entrypointSha256": entry_sha },
    "packaged-native": {
      "programSha256": digest(
        root + "/_build/native/release/build/morphir/morphir/morphir.exe",
      ),
      "entrypointSha256": Json::null(),
    },
    "packaged-npm": {
      "programSha256": runtime_sha,
      "entrypointSha256": entry_sha,
    },
  }
  let expected_pin : Json = {
    "contractVersion": "0.1.0",
    "binding": "extism-wasm",
    "executionProfile": "morphir/extism-mep-0.1/v1",
    "host": host,
    "runtime": {
      "executable": runtime,
      "version": field(node, "node"),
      "sha256": runtime_sha,
    },
    "helper": {
      "root": root + "/apps/morphir/build-provider",
      "modules": Json::object(modules),
    },
    "artifact": {
      "directory": bundle,
      "descriptorSha256": descriptor_sha,
      "wasmSha256": field(wasm, "sha256"),
      "extensionId": field(descriptor, "extensionId"),
      "version": field(descriptor, "version"),
    },
    "origin": "finos/morphir-python release " + version,
  }
  {
    "platform": field(node, "platform"),
    "architecture": field(node, "architecture"),
    "node": field(node, "node"),
    "runtimeSha256": runtime_sha,
    "python": { "executable": python, "sha256": digest(python) },
    "host": host,
    "hostBuild": Json::object(host_build),
    "bundle": Json::object(bundle_fields),
    "sourceRevision": capture("git", ["rev-parse", "HEAD"]).trim().to_owned(),
    "sourceFiles": Json::object(source_files),
    "checkDefinitionSha256": digest(
      root + "/apps/morphir/scripts/test-extism-python.ts",
    ),
    "helpers": Json::object(modules),
    "launchers": launchers,
    "pin": expected_pin,
  }
}

///|
fn receipt_valid(receipt : Json, expected : Json) -> Bool {
  if field(receipt, "profile") !=
    Json::string("morphir/extism-python-qualification") ||
    field(receipt, "contractVersion") != Json::string("0.1.0") ||
    field(receipt, "state") != Json::string("succeeded") {
    return false
  }
  for
    key in [
      "platform", "architecture", "node", "runtimeSha256", "python", "host", "hostBuild",
      "bundle", "sourceRevision", "sourceFiles", "checkDefinitionSha256",
    ] {
    if field(receipt, key) != field(expected, key) {
      return false
    }
  }
  guard field(receipt, "results") is Array(results) && results.length() == 4 else {
    return false
  }
  let seen : Map[String, Bool] = Map([])
  for result in results {
    guard field(result, "name") is String(name) &&
      ["source-native", "source-js", "packaged-native", "packaged-npm"].contains(
        name,
      ) &&
      !seen.contains(name) else {
      return false
    }
    seen[name] = true
    let launcher = field(field(expected, "launchers"), name)
    if field(result, "programSha256") != field(launcher, "programSha256") ||
      field(result, "helpers") != field(expected, "helpers") {
      return false
    }
    guard field(result, "entrypoint") is Array(entries) else { return false }
    match field(launcher, "entrypointSha256") {
      Null => if !entries.is_empty() { return false }
      String(hash) =>
        if entries.length() != 1 ||
          field(entries[0], "sha256") != Json::string(hash) {
          return false
        }
      _ => return false
    }
    guard field(result, "versions") is Array(versions) && versions.length() == 2 else {
      return false
    }
    let completed : Map[String, Bool] = Map([])
    for version in versions {
      guard field(version, "version") is String(major) &&
        ["3", "4"].contains(major) &&
        !completed.contains(major) &&
        field(field(version, "parity"), "apiParity") == Json::boolean(true) &&
        field(field(version, "parity"), "consumer") == Json::boolean(true) &&
        field(version, "modelSha256") is String(hash) &&
        hash.length() == 64 &&
        hash.iter().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) &&
        field(version, "generated") is Array(files) &&
        !files.is_empty() else {
        return false
      }
      completed[major] = true
    }
  }
  true
}

///|
async fn main {
  let mut json_mode = @env.args().contains("--json")
  try {
    let schema = @argparse.Command(
      "test:cli-extism-python",
      about="Qualify a local Python Extism bundle with the pinned shared host, native and JS source/packaged CLIs. Requires existing dependencies, local bundle and independent matching Python API; never downloads or installs them. --json emits one morphir/command-result 0.1.0 document on stdout; progress and child output use stderr. Success returns receiptPath, receiptSha256 and pinPath for fresh checked evidence under .dev/extism/. Failure returns error {code,message} instead of result. Validation exits 1, syntax 2, positive child statuses are preserved. Help uses result.help and performs no builds.",
      disable_help_flag=true,
      disable_help_subcommand=true,
      options=[
        @argparse.OptionArg(
          "shared",
          about="Absolute finos/morphir checkout at the pinned revision",
        ),
        @argparse.OptionArg(
          "bundle",
          about="Absolute corrected Python bundle with release.json and frontend.multiDocument=true",
        ),
        @argparse.OptionArg(
          "python",
          about="Absolute Python interpreter with the matching independent morphir-tools API installed",
        ),
      ],
      flags=[@argparse.FlagArg("json"), @argparse.FlagArg("help", short='h')],
    )
    let matches = schema.parse(argv=@env.args()[1:]) catch {
      error =>
        raise CommandFailure(2, "extism.invalid_arguments", error.to_string())
    }
    json_mode = matches.flags.get("json").unwrap_or(false)
    if matches.flags.get("help").unwrap_or(false) {
      if json_mode {
        println(
          (
            {
              "profile": "morphir/command-result",
              "contractVersion": "0.1.0",
              "command": "test:cli-extism-python",
              "state": "succeeded",
              "exitCode": 0,
              "diagnostics": [],
              "result": { "help": schema.render_help() },
            } : Json).stringify(),
        )
      } else {
        println(schema.render_help())
      }
      return
    }
    let shared = @fs.realpath(required(matches, "shared"))
    let bundle = @fs.realpath(required(matches, "bundle"))
    // Keep a virtualenv's interpreter path: resolving its symlink would lose
    // pyvenv.cfg discovery and could accidentally select a different API.
    let python = required(matches, "python")
    guard @fs.exists(shared + "/.git") &&
      @fs.exists(bundle + "/release.json") &&
      @fs.exists(python) else {
      raise CommandFailure(
        1, "extism.invalid_input", "Expected a local shared checkout and Python bundle release.json",
      )
    }
    let declared = @json.parse(@fs.read_file(bundle + "/release.json").text())
    guard field(declared, "artifacts") is Array(artifacts) &&
      artifacts
      .iter()
      .find_first(a => field(a, "runtime") == Json::string("wasm"))
      is Some(wasm) &&
      field(field(field(wasm, "claims"), "capabilities"), "frontend")
      is Object(frontend) &&
      frontend.get("multiDocument") == Some(Json::boolean(true)) else {
      raise CommandFailure(
        1, "extism.invalid_input", "Full qualification requires a corrected Python bundle declaring frontend.multiDocument=true; older bundles are limited to one source document",
      )
    }
    qualification_receipt_states()
    qualification_receipt_consumers()
    checked(
      "moon",
      [
        "run", "scripts/native-services.mbtx", "--", "--shared", shared, "--json",
      ],
      environment={ "CARGO_NET_OFFLINE": "true", "RUSTUP_AUTO_INSTALL": "0" },
    )
    let root = @fs.realpath(".")
    let host_evidence = @json.parse(
      @fs.read_file(root + "/.dev/native-services/evidence.json").text(),
    )
    guard host_evidence is Object(evidence) &&
      evidence.get("target") is Some(String(target)) &&
      target != "" else {
      raise CommandFailure(
        1, "extism.invalid_receipt", "The pinned host build must identify its Rust target before adapter tests",
      )
    }
    checked(
      "cargo",
      [
        "+1.98.0",
        "test",
        "--locked",
        "--manifest-path",
        root + "/.dev/native-services/Cargo.toml",
        "--bin",
        "morphir-moonbit-native-services",
        "--test",
        "shared-restricted-extism",
        "--",
        "--include-ignored",
        "--test-threads=1",
      ],
      environment={
        "CARGO_NET_OFFLINE": "true",
        "RUSTUP_AUTO_INSTALL": "0",
        "MORPHIR_NATIVE_TARGET": target,
        "MORPHIR_TEST_GUEST": root +
        "/_build/native/release/build/finos/morphir-extension/morphir-extension.exe",
        "MORPHIR_EXTISM_TEST_BUNDLE": bundle,
      },
    )
    checked("moon", ["build", "apps/morphir", "--target", "native"])
    checked("moon", ["build", "apps/morphir", "--target", "native", "--release"])
    checked("bun", ["run", "--cwd", "apps/morphir", "build"])
    checked("node", ["apps/morphir/build-provider/test-extism.mts"])
    for target in ["native", "js"] {
      checked("moon", [
        "test", "apps/morphir/cli/extism_wbtest.mbt", "--target", target,
      ])
    }
    let expected = candidate(root, bundle, python)
    let receipt_path = root + "/.dev/extism/qualification.json"
    if @fs.exists(receipt_path) {
      @fs.remove(receipt_path)
    }
    checked(
      "node",
      ["apps/morphir/scripts/test-extism-python.ts"],
      environment=Map::from_array([
        ("MORPHIR_EXTISM_BUNDLE", bundle),
        ("MORPHIR_EXTISM_PYTHON", python),
        (
          "MORPHIR_EXTISM_HOST_PIN",
          root + "/.dev/native-services/host-pin.json",
        ),
        (
          "MORPHIR_EXTISM_NATIVE",
          root + "/_build/native/debug/build/morphir/morphir/morphir.exe",
        ),
        (
          "MORPHIR_EXTISM_RELEASE",
          root + "/_build/native/release/build/morphir/morphir/morphir.exe",
        ),
      ]),
    )
    let contents = @fs.read_file(receipt_path)
    let bytes = contents.binary()
    let receipt = @json.parse(contents.text())
    let pin_path = root + "/.dev/extism/python-pin.json"
    let pin = @json.parse(@fs.read_file(pin_path).text())
    guard candidate(root, bundle, python) == expected &&
      receipt_valid(receipt, expected) &&
      pin == field(expected, "pin") else {
      raise CommandFailure(
        1, "extism.invalid_receipt", "Real-bundle evidence is missing, incomplete, failed or belongs to different candidate bytes",
      )
    }
    let result : Json = {
      "receiptPath": receipt_path,
      "receiptSha256": @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
      "pinPath": pin_path,
      "receipt": receipt,
    }
    if json_mode {
      println(
        (
          {
            "profile": "morphir/command-result",
            "contractVersion": "0.1.0",
            "command": "test:cli-extism-python",
            "state": "succeeded",
            "exitCode": 0,
            "diagnostics": [],
            "result": result,
          } : Json).stringify(),
      )
    } else {
      println("Python Extism qualification passed: " + receipt_path)
    }
  } catch {
    error => {
      let (status, code, message) = match error {
        CommandFailure(status, code, message) => (status, code, message)
        _ => (1, "extism.qualification_failed", error.to_string())
      }
      @stdio.stderr.write(message + "\n")
      if json_mode {
        println(
          (
            {
              "profile": "morphir/command-result",
              "contractVersion": "0.1.0",
              "command": "test:cli-extism-python",
              "state": "failed",
              "exitCode": status,
              "diagnostics": [],
              "error": { "code": code, "message": message },
            } : Json).stringify(),
        )
      }
      @sys.exit(status)
    }
  }
}

///|
fn qualification_fixture() -> (Json, Json) {
  let hash = "0".repeat(64)
  let modules : Json = {
    "extism.mjs": hash,
    "supervision.mjs": hash,
    "windows-job.mjs": hash,
  }
  let expected : Map[String, Json] = Map::from_array([
    ("platform", Json::string("darwin")),
    ("architecture", Json::string("arm64")),
    ("node", Json::string("v24.22.1")),
    ("runtimeSha256", Json::string(hash)),
    ("python", { "executable": "/python", "sha256": hash }),
    (
      "host",
      { "executable": "/host", "sha256": hash, "sourceRevision": "approved" },
    ),
    ("hostBuild", { "sourceRevision": "approved", "cargoLockSha256": hash }),
    ("bundle", { "descriptorSha256": hash, "wasmSha256": hash }),
    ("sourceRevision", Json::string("candidate")),
    ("sourceFiles", { "source": hash }),
    ("checkDefinitionSha256", Json::string(hash)),
    ("helpers", modules),
  ])
  let receipt = expected.copy()
  receipt.remove("helpers")
  receipt["profile"] = Json::string("morphir/extism-python-qualification")
  receipt["contractVersion"] = Json::string("0.1.0")
  receipt["state"] = Json::string("succeeded")
  let launchers : Map[String, Json] = Map([])
  let results : Array[Json] = []
  for name in ["source-native", "source-js", "packaged-native", "packaged-npm"] {
    let js = name == "source-js" || name == "packaged-npm"
    launchers[name] = {
      "programSha256": hash,
      "entrypointSha256": if js {
        Json::string(hash)
      } else {
        Json::null()
      },
    }
    results.push({
      "name": name,
      "programSha256": hash,
      "helpers": modules,
      "entrypoint": if js {
        [{ "file": "/bin/morphir.js", "sha256": hash }]
      } else {
        []
      },
      "versions": ["3", "4"].map(major => {
        (
          {
            "version": major,
            "parity": { "apiParity": true, "consumer": true },
            "modelSha256": hash,
            "generated": ["models.py"],
          } : Json)
      }),
    })
  }
  expected["launchers"] = Json::object(launchers)
  receipt["results"] = Json::array(results)
  (Json::object(receipt), Json::object(expected))
}

///|
fn replace_field(value : Json, key : String, replacement : Json) -> Json {
  guard value is Object(fields) else { panic() }
  let changed = fields.copy()
  changed[key] = replacement
  Json::object(changed)
}

///|
fn qualification_receipt_states() -> Unit raise {
  let (receipt, expected) = qualification_fixture()
  assert_true(receipt_valid(receipt, expected))
  for state in ["failed", "skipped", "pending"] {
    assert_false(
      receipt_valid(
        replace_field(receipt, "state", Json::string(state)),
        expected,
      ),
    )
  }
  for
    key in [
      "host", "hostBuild", "sourceRevision", "sourceFiles", "checkDefinitionSha256",
      "platform", "architecture", "node", "runtimeSha256", "python", "bundle",
    ] {
    assert_false(
      receipt_valid(
        replace_field(receipt, key, Json::string("different candidate")),
        expected,
      ),
    )
  }
}

///|
fn qualification_receipt_consumers() -> Unit raise {
  let (receipt, expected) = qualification_fixture()
  guard field(receipt, "results") is Array(rows) else { panic() }
  assert_false(
    receipt_valid(
      replace_field(receipt, "results", Json::array(rows[:3].to_owned())),
      expected,
    ),
  )
  let duplicated = rows.copy()
  duplicated[3] = duplicated[0]
  assert_false(
    receipt_valid(
      replace_field(receipt, "results", Json::array(duplicated)),
      expected,
    ),
  )
  guard field(rows[0], "versions") is Array(versions) else { panic() }
  for
    bad_version in [
      replace_field(versions[1], "version", Json::string("3")),
      replace_field(versions[1], "parity", {
        "apiParity": true,
        "consumer": false,
      }),
      replace_field(versions[1], "parity", {
        "apiParity": false,
        "consumer": true,
      }),
      replace_field(versions[1], "modelSha256", Json::string("g".repeat(64))),
      replace_field(versions[1], "generated", []),
    ] {
    let changed = rows.copy()
    changed[0] = replace_field(rows[0], "versions", [versions[0], bad_version])
    assert_false(
      receipt_valid(
        replace_field(receipt, "results", Json::array(changed)),
        expected,
      ),
    )
  }
  let changed = rows.copy()
  changed[1] = replace_field(rows[1], "entrypoint", [
    { "file": "/bin/morphir.js", "sha256": "other bytes" },
  ])
  assert_false(
    receipt_valid(
      replace_field(receipt, "results", Json::array(changed)),
      expected,
    ),
  )
}

///|
test "qualification refuses failed, skipped and stale candidate evidence" {
  qualification_receipt_states()
}

///|
test "qualification requires all four launchers and both successful IR consumers" {
  qualification_receipt_consumers()
}
