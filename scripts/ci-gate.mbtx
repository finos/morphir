///|
/// Reject failed/cancelled jobs and skipped/absent required jobs. Qualification
/// receipts bind the exact candidate SHA and workflow run.
import {
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/stdio",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonrockz/ion@0.5.0/binary",
  "moonrockz/ion@0.5.0/ion",
  "moonrockz/ion@0.5.0/json" @ion_json,
}

///|
fn check(needs : Json, required : Json) -> Unit raise {
  guard needs is Object(jobs) && required is Array(names) && !names.is_empty() else {
    fail("Expected jobs and a nonempty required-job array")
  }
  for name in names {
    guard name is String(name) &&
      jobs.get(name) is Some(Object(job)) &&
      job.get("result") == Some(Json::string("success")) else {
      fail(
        "Required job missing, failed, cancelled or skipped: " +
        name.stringify(),
      )
    }
  }
  for name, job in jobs {
    guard job is Object(job) &&
      job.get("result") is Some(String(result)) &&
      (result == "success" || result == "skipped") else {
      fail("Job did not pass: " + name)
    }
  }
}

///|
fn accepts(needs : Json, required : Json) -> Bool {
  try {
    check(needs, required)
    true
  } catch {
    _ => false
  }
}

///|
async fn self_test() -> Unit {
  presentation_self_test()
  let required : Json = ["changes", "build"]
  let good : Json = {
    "changes": { "result": "success" },
    "build": { "result": "success" },
    "optional": { "result": "skipped" },
  }
  guard accepts(good, required) else {
    fail("Successful selected jobs refused")
  }
  for state in ["failure", "cancelled", "skipped", "pending", "unknown"] {
    let needs : Json = {
      "changes": { "result": "success" },
      "build": { "result": state },
    }
    guard !accepts(needs, required) else { fail("Accepted required \{state}") }
  }
  for
    needs in [
      Json::null(),
      { "changes": { "result": "success" } },
      {
        "changes": { "result": "success" },
        "build": { "result": "success" },
        "other": { "result": "failure" },
      },
      { "changes": { "result": "skipped" }, "build": { "result": "skipped" } },
    ] {
    guard !accepts(needs, required) else {
      fail("Accepted invalid job results")
    }
  }
  guard !accepts(good, []) && !accepts(good, [42]) else {
    fail("Accepted malformed required jobs")
  }
  // Every independently selected baseline job must fail closed, even when all
  // other jobs succeeded. Optional cancellation must also reject the aggregate.
  for
    selected in ["supervision", "embedding", "typescript", "elm-scheme", "site"] {
    for state in ["failure", "cancelled", "skipped"] {
      let needs : Map[String, Json] = {
        "changes": { "result": "success" },
        "build": { "result": "success" },
      }
      needs.set(selected, { "result": state })
      guard !accepts(Json::object(needs), Json(["changes", "build", selected])) else {
        fail("Accepted selected \{selected} with \{state}")
      }
    }
  }
  let focused : Json = {
    "runner": "ubuntu-24.04",
    "full": false,
    "provider": false,
    "acceptance-lanes": "[]",
  }
  guard selected_jobs("--native", focused) ==
    Json(["native-cli", "mep-process", "native-cli-acceptance"]) else {
    fail("Wrong focused native requirements")
  }
  let full : Json = {
    "runner": "ubuntu-24.04",
    "full": true,
    "provider": true,
    "acceptance-lanes": "[\"frontend\"]",
  }
  let full_jobs = selected_jobs("--native", full)
  guard full_jobs is Array(jobs) && jobs.length() == 7 else {
    fail("Full native requirements omitted a producer or consumer")
  }
  let statuses : Map[String, Json] = Map([])
  for job in jobs {
    guard job is String(name) else { fail("Invalid job name") }
    statuses.set(name, { "result": "success" })
  }
  statuses.set("installed-provider", { "result": "skipped" })
  guard !accepts(Json::object(statuses), full_jobs) else {
    fail("A skipped selected provider consumer passed the reusable workflow")
  }
  guard selected_jobs("--installed", { "workbench": true }) ==
    Json(["workbench"]) else {
    fail("Wrong focused installed requirements")
  }
  let (status, out, _) = @process.collect_output("git", ["rev-parse", "HEAD"])
  guard status == 0 else { fail("Missing candidate fixture checkout") }
  verify_candidate(out.text().trim().to_owned())
  let mismatch_refused = try {
    verify_candidate("0000000000000000000000000000000000000000")
    false
  } catch {
    _ => true
  }
  guard mismatch_refused else {
    fail("Accepted qualification for a different commit")
  }
  receipt_self_test()
  qualification_self_test()
  cli_self_test()
  test_note(
    "ci-gate: success, optional skip and selected baseline refusal cases pass",
  )
  test_note(
    "ci-gate: focused/full native and installed nested requirements pass",
  )
  test_note("ci-gate: exact candidate match and mismatch refusal pass")
}

///|
fn receipt_fixture_env(pr : PrRef?) -> ReceiptEnv {
  {
    repository: "finos/morphir-moonbit",
    event: if pr is Some(_) {
      "pull_request"
    } else {
      "merge_group"
    },
    run_id: "39549808921",
    run_attempt: "1",
    tested_commit: "1111111111111111111111111111111111111111",
    tested_tree: "2222222222222222222222222222222222222222",
    pr,
  }
}

///|
async fn receipt_self_test() -> Unit {
  let needs : Json = {
    "changes": { "result": "success" },
    "lint": { "result": "success" },
    "site": { "result": "skipped" },
  }
  let required : Json = ["changes", "lint"]
  let selection : Json = { "code": "true", "full": "false" }
  // receipt_pull_request: every field present, including the PR block.
  let pr = { number: 194, head: "aaaa", base: "bbbb", payload_base: None, }
  let expected : Json = {
    "profile": "morphir-ci-receipt-v1",
    "repository": "finos/morphir-moonbit",
    "event": "pull_request",
    "runId": "39549808921",
    "runAttempt": "1",
    "testedCommit": "1111111111111111111111111111111111111111",
    "testedTree": "2222222222222222222222222222222222222222",
    "pr": { "number": 194, "head": "aaaa", "base": "bbbb" },
    "selection": selection,
    "required": required,
    "results": needs,
  }
  guard receipt(needs, required, selection, receipt_fixture_env(Some(pr))) ==
    expected else {
    fail("Wrong pull_request receipt")
  }
  // receipt_merge_group: pr is null.
  let merged = receipt(needs, required, selection, receipt_fixture_env(None))
  guard merged is Object(fields) &&
    fields.get("pr") == Some(Json::null()) &&
    fields.get("event") == Some(Json::string("merge_group")) else {
    fail("Merge group receipt must carry a null pr")
  }
  // The PR block follows the event, not the presence of PR_NUMBER.
  guard pr_ref(
      "pull_request",
      Some("194"),
      Some("aaaa"),
      Some("bbbb"),
      Some("bbbb"),
    )
    is Some({ number: 194, base: "bbbb", payload_base: None, .. }) else {
    fail("pull_request must carry its PR")
  }
  for event in ["merge_group", "push"] {
    guard pr_ref(event, Some("194"), Some("aaaa"), Some("bbbb"), None) is None else {
      fail("\{event} must not carry a PR")
    }
  }
  for
    missing in [
      (None, Some("a"), Some("b"), Some("b")),
      (Some("1"), None, Some("b"), Some("b")),
      (Some("1"), Some("a"), None, Some("b")),
      (Some("1"), Some("a"), Some("b"), None),
    ] {
    let refused = try {
      ignore(pr_ref("pull_request", missing.0, missing.1, missing.2, missing.3))
      false
    } catch {
      _ => true
    }
    guard refused else { fail("pull_request without a full PR passed") }
  }
  merge_parent_self_test()
  // The file is written, with its missing parent directory created.
  let directory = ".dev/ci/self-test"
  let path = "\{directory}/receipt.json"
  if @fs.exists(path) {
    @fs.remove(path)
  }
  let head = git_output(["rev-parse", "HEAD"])
  let env = { ..receipt_fixture_env(Some(pr)), tested_commit: head, }
  write_receipt(path, needs, required, selection, env)
  guard @json.parse(@fs.read_file(path).text()) ==
    receipt(needs, required, selection, env) else {
    fail("Receipt file differs from the receipt value")
  }
  @fs.remove(path)
  // receipt_refuses_failed_gate: a failed gate writes nothing.
  let failed : Json = {
    "changes": { "result": "success" },
    "lint": { "result": "failure" },
  }
  let refused = try {
    write_receipt(path, failed, required, selection, env)
    false
  } catch {
    _ => true
  }
  guard refused && !@fs.exists(path) else {
    fail("A failed gate must not write a receipt")
  }
  @fs.rmdir(directory)
  test_note("ci-gate: receipt fields, null pr and failed-gate refusal pass")
}

///|
/// Git object files are read-only on Windows, so deleting a fixture repository
/// can fail after the test passed. Cleanup is best effort.
async fn remove_fixture(root : String) -> Unit {
  @fs.rmdir(root, recursive=true) catch {
    _ => ()
  }
}

///|
/// receipt_merge_parent_base: a pull_request run tests a merge commit whose
/// first parent is the base it tested. When the payload base differs, the
/// receipt records the first parent as `pr.base` and the payload value as
/// `pr.payloadBase`.
async fn merge_parent_self_test() -> Unit {
  let root = @fs.tmpdir(prefix="morphir-ci-gate-")
  defer remove_fixture(root)
  async fn git(args : Array[String]) -> String {
    let config = [
      "-c",
      "commit.gpgsign=false",
      "-c",
      "user.name=CI fixture",
      "-c",
      "user.email=ci@example.invalid",
      "-c",
      "core.hooksPath=" + root + "/no-hooks",
    ]
    git_output(config + args, cwd=root)
  }

  ignore(git(["init", "-q"]))
  @fs.write_file(root + "/README.md", "payload base\n")
  ignore(git(["add", "."]))
  ignore(git(["commit", "-qm", "payload base"]))
  let payload = git(["rev-parse", "HEAD"])
  @fs.write_file(root + "/README.md", "tested base\n")
  ignore(git(["commit", "-qam", "tested base"]))
  let tested = git(["rev-parse", "HEAD"])
  let merge = git([
    "commit-tree", "HEAD^{tree}", "-p", tested, "-p", payload, "-m", "merge",
  ])
  ignore(git(["checkout", "-q", "--detach", merge]))
  let parent = tested_parent(cwd=root)
  guard parent == Some(tested) else {
    fail("Wrong first parent of the tested merge commit")
  }
  guard pr_ref("pull_request", Some("194"), Some("aaaa"), Some(payload), parent)
    is Some(pr) &&
    pr.base == tested &&
    pr.payload_base == Some(payload) else {
    fail("pull_request receipt must record the merge commit's first parent")
  }
  let recorded = receipt(
    Json::object({}),
    Json::array([]),
    Json::object({}),
    receipt_fixture_env(Some(pr)),
  )
  guard recorded is Object(fields) &&
    fields.get("pr") ==
    Some({
      "number": 194,
      "head": "aaaa",
      "base": tested,
      "payloadBase": payload,
    }) else {
    fail("Wrong pr block for a moved payload base")
  }
  guard first_parent("tree t\nauthor a\n\nparent in the message\n") is None &&
    first_parent("tree t\nparent p1\nparent p2\n\nmessage\n") == Some("p1") else {
    fail("Wrong first parent of commit text")
  }
  test_note("ci-gate: merge commit first parent is the recorded PR base")
}

///|
fn evidence_fixture() -> EvidenceRef {
  {
    run: 39549808921L,
    artifact: 4012345678L,
    fingerprint: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    sha: "1111111111111111111111111111111111111111",
  }
}

///|
fn plans(
  mode : MacosMode,
  event : String,
  ref_ : String,
  evidence : EvidenceRef?,
) -> Bool {
  try {
    plan_qualification(mode, event, ref_, evidence)
    true
  } catch {
    _ => false
  }
}

///|
fn qualifies(needs : Json, mode : MacosMode) -> Bool {
  try {
    check_qualification(needs, mode)
    true
  } catch {
    _ => false
  }
}

///|
/// Job results of a qualification run: every base job and every macOS job
/// with the given result.
fn qualification_needs(macos : String) -> Map[String, Json] {
  let needs : Map[String, Json] = Map([])
  for job in base_jobs {
    needs.set(job, { "result": "success" })
  }
  for job in macos_jobs {
    needs.set(job, { "result": macos })
  }
  needs
}

///|
fn qualification_self_test() -> Unit raise {
  let evidence = evidence_fixture()
  // plan_rejects_merge_paths: only skip runs on a pull request, merge queue
  // or branch push event.
  let merge_paths = [
    ("pull_request", "refs/pull/1/merge"),
    ("pull_request_target", "refs/heads/main"),
    ("merge_group", "refs/heads/gh-readonly-queue/main/pr-1-abc"),
    ("push", "refs/heads/main"),
  ]
  for path in merge_paths {
    let (event, ref_) = path
    guard !plans(Run, event, ref_, None) &&
      !plans(Reuse, event, ref_, Some(evidence)) else {
      fail("Planned macOS lanes for \{event} on \{ref_}")
    }
    guard plans(Skip, event, ref_, None) else {
      fail("Refused skip for \{event} on \{ref_}")
    }
  }
  // plan_allows_release_and_nightly: a tag push, the schedule and a manual
  // dispatch can run macOS.
  for
    path in [
      ("push", "refs/tags/v1.0.0"),
      ("schedule", "refs/heads/main"),
      ("workflow_dispatch", "refs/heads/main"),
    ] {
    let (event, ref_) = path
    guard plans(Run, event, ref_, None) else {
      fail("Refused run for \{event} on \{ref_}")
    }
  }
  // plan_reuse_needs_evidence: reuse needs a well-formed evidence reference,
  // only reuse takes one, and a release never reuses.
  guard !plans(Reuse, "schedule", "refs/heads/main", None) else {
    fail("Planned reuse without evidence")
  }
  guard plans(Reuse, "schedule", "refs/heads/main", Some(evidence)) &&
    plans(Reuse, "workflow_dispatch", "refs/heads/main", Some(evidence)) else {
    fail("Refused reuse with evidence")
  }
  guard !plans(Reuse, "push", "refs/tags/v1.0.0", Some(evidence)) else {
    fail("Planned reuse for a release")
  }
  guard !plans(Run, "schedule", "refs/heads/main", Some(evidence)) &&
    !plans(Skip, "pull_request", "refs/pull/1/merge", Some(evidence)) else {
    fail("Accepted evidence for a mode other than reuse")
  }
  guard EvidenceRef::parse(evidence.to_json()) == evidence &&
    evidence_input(Some(evidence.to_json().stringify())) == Some(evidence) &&
    evidence_input(None) is None &&
    evidence_input(Some("")) is None else {
    fail("Evidence reference does not round-trip")
  }
  fn changed(key : String, value : Json) -> Json {
    guard evidence.to_json() is Object(fields) else { return Json::null() }
    let fields = Map::from_iter(fields.iter())
    fields.set(key, value)
    Json::object(fields)
  }

  let bad_evidence : Array[Json] = [
    Json::null(),
    {},
    changed("fingerprint", "0123"),
    changed(
      "fingerprint", "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF",
    ),
    changed("sha", "abc"),
    changed("run", "39549808921"),
    changed("run", 1.5),
    changed("artifact", 0),
  ]
  for json in bad_evidence {
    let refused = try {
      ignore(EvidenceRef::parse(json))
      false
    } catch {
      _ => true
    }
    guard refused else { fail("Accepted bad evidence \{json.stringify()}") }
  }
  let refused = try {
    ignore(evidence_input(Some("not json")))
    false
  } catch {
    _ => true
  }
  guard refused else { fail("Accepted evidence that is not JSON") }
  // plan_rejects_unknown_mode: only skip, run and reuse are modes.
  for text in ["", "always"] {
    let refused = try {
      ignore(MacosMode::parse(text))
      false
    } catch {
      _ => true
    }
    guard refused else { fail("Accepted macOS mode \{text.escape()}") }
  }
  for mode in [Skip, Run, Reuse] {
    guard MacosMode::parse(mode.to_string()) == mode else {
      fail("macOS mode \{mode.to_string()} does not round-trip")
    }
  }
  // gate_skip_mode: skip and reuse need all five macOS jobs skipped.
  let skipped = qualification_needs("skipped")
  for mode in [Skip, Reuse] {
    guard qualifies(Json::object(skipped), mode) else {
      fail("Refused \{mode.to_string()} with all macOS jobs skipped")
    }
    for job in macos_jobs {
      let ran = qualification_needs("skipped")
      ran.set(job, { "result": "success" })
      let missing = qualification_needs("skipped")
      missing.remove(job)
      guard !qualifies(Json::object(ran), mode) &&
        !qualifies(Json::object(missing), mode) else {
        fail("Accepted \{mode.to_string()} with \{job} run or missing")
      }
    }
  }
  // gate_run_mode: run needs all five macOS jobs successful.
  guard qualifies(Json::object(qualification_needs("success")), Run) else {
    fail("Refused run with all macOS jobs successful")
  }
  for job in macos_jobs {
    for state in ["skipped", "cancelled", "failure"] {
      let needs = qualification_needs("success")
      needs.set(job, { "result": state })
      guard !qualifies(Json::object(needs), Run) else {
        fail("Accepted run with \{job} \{state}")
      }
    }
    let missing = qualification_needs("success")
    missing.remove(job)
    guard !qualifies(Json::object(missing), Run) else {
      fail("Accepted run with \{job} missing")
    }
  }
  // gate_plan_required: a failed, skipped or missing plan fails every mode.
  for case in [(Skip, "skipped"), (Reuse, "skipped"), (Run, "success")] {
    let (mode, macos) = case
    for state in ["failure", "skipped", "cancelled"] {
      let needs = qualification_needs(macos)
      needs.set("plan", { "result": state })
      guard !qualifies(Json::object(needs), mode) else {
        fail("Accepted \{mode.to_string()} with plan \{state}")
      }
    }
    let missing = qualification_needs(macos)
    missing.remove("plan")
    guard !qualifies(Json::object(missing), mode) else {
      fail("Accepted \{mode.to_string()} without plan")
    }
  }
  // receipt_v2_fields: the v2 receipt records the mode, the evidence and the
  // fixed job list.
  let env = {
    revision: "1111111111111111111111111111111111111111",
    repository: "finos/morphir-moonbit",
    run_id: "39549808921",
    run_attempt: "1",
  }
  for
    case in [
      (Skip, None, "skipped"),
      (Run, None, "success"),
      (Reuse, Some(evidence), "skipped"),
    ] {
    let (mode, evidence, macos) = case
    let needs = Json::object(qualification_needs(macos))
    let expected : Json = {
      "profile": "morphir-ci-qualification-v2",
      "revision": "1111111111111111111111111111111111111111",
      "repository": "finos/morphir-moonbit",
      "runId": "39549808921",
      "runAttempt": "1",
      "macos": mode.to_string(),
      "macosEvidence": match evidence {
        Some(evidence) => evidence.to_json()
        None => Json::null()
      },
      "requiredJobs": qualification_required(mode),
      "results": needs,
    }
    guard qualification_receipt(needs, mode, evidence, env) == expected else {
      fail("Wrong \{mode.to_string()} qualification receipt")
    }
  }
  guard qualification_jobs() ==
    { "base": Json(base_jobs), "macos": Json(macos_jobs) } &&
    qualification_jobs().stringify() ==
    "{\"base\":[\"plan\",\"setup\",\"native\",\"installed\",\"packaged\"],\"macos\":[\"macos-setup\",\"macos-native\",\"macos-installed\",\"macos-supervision\",\"macos-headless\"]}" else {
    fail("qualification_jobs: wrong fixed job lists")
  }
  guard qualification_required(Run) == Json(base_jobs + macos_jobs) &&
    qualification_required(Skip) == Json(base_jobs) &&
    qualification_required(Reuse) == Json(base_jobs) else {
    fail("Wrong fixed qualification job lists")
  }
  for
    case in [
      (Run, None, "skipped"),
      (Skip, None, "success"),
      (Reuse, None, "skipped"),
    ] {
    let (mode, evidence, macos) = case
    let refused = try {
      ignore(
        qualification_receipt(
          Json::object(qualification_needs(macos)),
          mode,
          evidence,
          env,
        ),
      )
      false
    } catch {
      _ => true
    }
    guard refused else {
      fail("Wrote a \{mode.to_string()} receipt for a failed gate")
    }
  }
  let ion = @binary.read_binary_value(
    qualification_ion(
      qualification_receipt(Json::object(skipped), Skip, None, env),
    ),
  )
  guard ion.annotations().map(token => token.text) ==
    [Some("morphir_ci_qualification_v2")] else {
    fail("Wrong qualification receipt annotation")
  }
  test_note(
    "ci-gate: qualification plan, macOS modes, fixed job lists and v2 receipt pass",
  )
}

///|
fn cli_self_test() -> Unit raise {
  let command = gate_command()
  let cases : Array[(Array[String], String, String?)] = [
    ([], "check", None),
    (["--self-test"], "self-test", None),
    (["--qualification"], "qualification", None),
    (["--qualification-plan"], "qualification-plan", None),
    (["--qualification-jobs"], "qualification-jobs", None),
    (["--native"], "native", None),
    (["--installed"], "installed", None),
    (
      ["--receipt", ".dev/ci/receipt.json"],
      "check",
      Some(".dev/ci/receipt.json"),
    ),
  ]
  for case in cases {
    let (argv, mode, path) = case
    let matches = command.parse(argv~)
    guard gate_mode(matches) == mode && receipt_path(matches) == path else {
      fail("Wrong parse of \{argv.join(" ")}")
    }
  }
  for
    argv in [
      ["--bogus"],
      ["--native", "--installed"],
      ["--receipt"],
      ["--native", "--receipt", "x"],
      ["--qualification-plan", "--qualification"],
      ["--qualification-plan", "--receipt", "x"],
      ["--qualification-jobs", "--qualification"],
      ["--qualification-jobs", "--receipt", "x"],
    ] {
    let refused = try {
      ignore(command.parse(argv~))
      false
    } catch {
      _ => true
    }
    guard refused else { fail("Accepted bad arguments \{argv.join(" ")}") }
  }
  test_note("ci-gate: argparse forms and refusals pass")
}

///|
async fn git_output(args : Array[String], cwd~ : String = ".") -> String {
  let (status, out, _) = @process.collect_output("git", args, cwd~)
  guard status == 0 else { fail("git \{args.join(" ")} failed") }
  out.text().trim().to_owned()
}

///|
async fn verify_candidate(revision : String) -> Unit {
  let (status, out, _) = @process.collect_output("git", ["rev-parse", "HEAD"])
  guard status == 0 && out.text().trim() == revision else {
    fail("Qualification checkout differs from candidate GITHUB_SHA")
  }
}

///|
fn environment(name : String) -> String raise {
  match @env.get_env_var(name) {
    Some(value) => value
    None => fail("Missing " + name)
  }
}

///|
fn selected_jobs(mode : String, inputs : Json) -> Json raise {
  guard inputs is Object(fields) else {
    fail("Expected reusable workflow inputs")
  }
  let jobs : Array[String] = []
  if mode == "--native" {
    guard fields.get("runner") is Some(String(runner)) &&
      ["ubuntu-24.04", "macos-15"].contains(runner) else {
      fail("Unqualified native runner")
    }
    jobs.append(["native-cli", "mep-process"])
    if fields.get("runner") == Some(Json::string("ubuntu-24.04")) {
      jobs.push("native-cli-acceptance")
      if fields.get("full") == Some(Json::boolean(true)) {
        jobs.push("native-workspace")
      }
      guard fields.get("acceptance-lanes") is Some(String(lanes)) &&
        @json.parse(lanes) is Array(lanes) else {
        fail("Expected acceptance-lanes JSON array")
      }
      guard lanes
        .iter()
        .all(lane => {
          [
            Json::string("compiler"),
            Json::string("frontend"),
            Json::string("conformance"),
          ].contains(lane)
        }) else {
        fail("Unknown acceptance lane")
      }
      if !lanes.is_empty() {
        jobs.push("native-acceptance")
      }
    }
    if fields.get("provider") == Some(Json::boolean(true)) {
      jobs.append(["provider-tools", "installed-provider"])
    }
  } else if mode == "--installed" {
    for job in ["lifecycle", "telemetry", "workbench"] {
      if fields.get(job) == Some(Json::boolean(true)) {
        jobs.push(job)
      }
    }
  } else {
    fail("Unknown workflow mode")
  }
  Json(jobs)
}

///|
/// How a qualification run treats the macOS lanes: `skip` them, `run` them,
/// or `reuse` recorded evidence of an earlier run instead of running them.
priv enum MacosMode {
  Skip
  Run
  Reuse
} derive(Eq)

///|
fn MacosMode::parse(text : String) -> MacosMode raise {
  match text {
    "skip" => Skip
    "run" => Run
    "reuse" => Reuse
    _ =>
      fail("Unknown macOS mode \{text.escape()}; expected skip, run or reuse")
  }
}

///|
fn MacosMode::to_string(self : MacosMode) -> String {
  match self {
    Skip => "skip"
    Run => "run"
    Reuse => "reuse"
  }
}

///|
/// The evidence artifact of an earlier macOS run that a `reuse` run relies on.
priv struct EvidenceRef {
  run : Int64
  artifact : Int64
  fingerprint : String
  sha : String
} derive(Eq)

///|
fn is_lower_hex(text : String, length : Int32) -> Bool {
  text.length() == length &&
  text.iter().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))
}

///|
fn EvidenceRef::parse(json : Json) -> EvidenceRef raise {
  fn id(value : Json?, name : String) -> Int64 raise {
    guard value is Some(Number(n, ..)) &&
      n >= 1.0 &&
      n <= 9007199254740991.0 &&
      n == n.floor() else {
      fail("Evidence \{name} must be a positive integer")
    }
    n.to_int64()
  }

  guard json is Object(fields) else {
    fail("Evidence reference must be an object")
  }
  guard fields.get("fingerprint") is Some(String(fingerprint)) &&
    is_lower_hex(fingerprint, 64) else {
    fail("Evidence fingerprint must be 64 lowercase hex digits")
  }
  guard fields.get("sha") is Some(String(sha)) && is_lower_hex(sha, 40) else {
    fail("Evidence sha must be 40 lowercase hex digits")
  }
  {
    run: id(fields.get("run"), "run"),
    artifact: id(fields.get("artifact"), "artifact"),
    fingerprint,
    sha,
  }
}

///|
fn EvidenceRef::to_json(self : EvidenceRef) -> Json {
  {
    "run": Json::number(self.run.to_double()),
    "artifact": Json::number(self.artifact.to_double()),
    "fingerprint": self.fingerprint,
    "sha": self.sha,
  }
}

///|
/// `CI_MACOS_EVIDENCE`: empty or absent, or a JSON evidence reference.
fn evidence_input(text : String?) -> EvidenceRef? raise {
  match text {
    None | Some("") => None
    Some(text) => Some(EvidenceRef::parse(@json.parse(text)))
  }
}

///|
/// Only `reuse` takes an evidence reference, and it needs one.
fn MacosMode::check_evidence(
  self : MacosMode,
  evidence : EvidenceRef?,
) -> Unit raise {
  match (self, evidence) {
    (Reuse, None) => fail("macOS mode reuse needs CI_MACOS_EVIDENCE")
    (Reuse, Some(_)) | (_, None) => ()
    (_, Some(_)) =>
      fail(
        "CI_MACOS_EVIDENCE is only for macOS mode reuse, not \{self.to_string()}",
      )
  }
}

///|
/// Jobs that every qualification run must pass.
let base_jobs : Array[String] = [
  "plan", "setup", "native", "installed", "packaged",
]

///|
/// The macOS lanes: all `success` in mode `run`, all `skipped` otherwise.
let macos_jobs : Array[String] = [
  "macos-setup", "macos-native", "macos-installed", "macos-supervision", "macos-headless",
]

///|
/// The fixed job lists as one object, `{"base": [...], "macos": [...]}`. The
/// `test:ci` task feeds it to `ci-platforms.mbtx --expect-guarded`, so the
/// guard and the gate cannot disagree about which jobs are macOS lanes.
fn qualification_jobs() -> Json {
  { "base": Json(base_jobs), "macos": Json(macos_jobs) }
}

///|
/// Check the macOS mode against the event before any macOS lane starts. Pull
/// requests, the merge queue and branch pushes only skip. The schedule and a
/// manual dispatch can run or reuse; a tag push, the release trigger, can run
/// but never reuse. Any other event only skips.
fn plan_qualification(
  mode : MacosMode,
  event : String,
  ref_ : String,
  evidence : EvidenceRef?,
) -> Unit raise {
  mode.check_evidence(evidence)
  guard mode != Skip else { return }
  let release = event == "push" && ref_.has_prefix("refs/tags/")
  let nightly = event == "schedule" || event == "workflow_dispatch"
  guard release || nightly else {
    fail(
      "macOS mode \{mode.to_string()} is not allowed for \{event} on \{ref_}",
    )
  }
  guard !(release && mode == Reuse) else {
    fail("A release must run macOS, not reuse evidence")
  }
}

///|
/// The jobs that must succeed in a qualification run of this mode.
fn qualification_required(mode : MacosMode) -> Json {
  match mode {
    Run => Json(base_jobs + macos_jobs)
    Skip | Reuse => Json(base_jobs)
  }
}

///|
/// Mode `run` needs every base and macOS job successful. Modes `skip` and
/// `reuse` need every base job successful and every macOS job skipped.
fn check_qualification(needs : Json, mode : MacosMode) -> Unit raise {
  check(needs, qualification_required(mode))
  guard mode != Run && needs is Object(jobs) else { return }
  for job in macos_jobs {
    guard jobs.get(job) is Some(Object(result)) &&
      result.get("result") == Some(Json::string("skipped")) else {
      fail("macOS job must be skipped in mode \{mode.to_string()}: \{job}")
    }
  }
}

///|
/// Wire values of the qualification receipt read from the workflow environment.
priv struct QualificationEnv {
  revision : String
  repository : String
  run_id : String
  run_attempt : String
}

///|
/// The v2 qualification receipt, only for a run that passed its gate.
fn qualification_receipt(
  needs : Json,
  mode : MacosMode,
  evidence : EvidenceRef?,
  env : QualificationEnv,
) -> Json raise {
  mode.check_evidence(evidence)
  check_qualification(needs, mode)
  {
    "profile": "morphir-ci-qualification-v2",
    "revision": env.revision,
    "repository": env.repository,
    "runId": env.run_id,
    "runAttempt": env.run_attempt,
    "macos": mode.to_string(),
    "macosEvidence": match evidence {
      Some(evidence) => evidence.to_json()
      None => Json::null()
    },
    "requiredJobs": qualification_required(mode),
    "results": needs,
  }
}

///|
fn qualification_ion(receipt : Json) -> Bytes raise {
  @ion_json.to_ion(receipt).with_annotations([
    @ion.SymbolToken::new("morphir_ci_qualification_v2"),
  ])
  |> @binary.write_binary_value
}

///|
/// `base` is the first parent of the tested merge commit, the base the run
/// tested. `payload_base` is the event payload's base when it differs.
priv struct PrRef {
  number : Int32
  head : String
  base : String
  payload_base : String?
}

///|
/// Wire values read from the workflow environment.
priv struct ReceiptEnv {
  repository : String
  event : String
  run_id : String
  run_attempt : String
  tested_commit : String
  tested_tree : String
  pr : PrRef?
}

///|
fn receipt(
  needs : Json,
  required : Json,
  selection : Json,
  env : ReceiptEnv,
) -> Json {
  let pr : Json = match env.pr {
    Some(pr) => {
      let fields : Map[String, Json] = {
        "number": pr.number,
        "head": pr.head,
        "base": pr.base,
      }
      if pr.payload_base is Some(payload_base) {
        fields.set("payloadBase", Json::string(payload_base))
      }
      Json::object(fields)
    }
    None => Json::null()
  }
  {
    "profile": "morphir-ci-receipt-v1",
    "repository": env.repository,
    "event": env.event,
    "runId": env.run_id,
    "runAttempt": env.run_attempt,
    "testedCommit": env.tested_commit,
    "testedTree": env.tested_tree,
    "pr": pr,
    "selection": selection,
    "required": required,
    "results": needs,
  }
}

///|
/// Write the receipt only after the gate passes and the checkout is the
/// tested commit.
async fn write_receipt(
  path : String,
  needs : Json,
  required : Json,
  selection : Json,
  env : ReceiptEnv,
) -> Unit {
  check(needs, required)
  verify_candidate(env.tested_commit)
  if path.rev_find("/") is Some(slash) {
    let directory = path[:slash].to_owned()
    if !@fs.exists(directory) {
      @fs.mkdir(directory, recursive=true)
    }
  }
  @fs.write_file(path, receipt(needs, required, selection, env).stringify())
}

///|
fn optional_environment(name : String) -> String? {
  match @env.get_env_var(name) {
    Some("") | None => None
    value => value
  }
}

///|
/// Only a pull_request run has a PR; it must name number, head and base, and
/// its tested merge commit must have a first parent. That parent is the base
/// the run tested; the payload base, which can be older or newer, is kept
/// only when it differs. Every other event has none, whatever the environment
/// holds.
fn pr_ref(
  event : String,
  number : String?,
  head : String?,
  base : String?,
  tested_parent : String?,
) -> PrRef? raise {
  guard event == "pull_request" else { return None }
  guard number is Some(number) && head is Some(head) && base is Some(base) else {
    fail("pull_request run needs PR_NUMBER, PR_HEAD and PR_BASE")
  }
  guard tested_parent is Some(parent) else {
    fail("pull_request run tested a commit without a parent")
  }
  Some({
    number: @string.parse_int(number),
    head,
    base: parent,
    payload_base: if base == parent {
      None
    } else {
      Some(base)
    },
  })
}

///|
/// The first `parent` line of a commit as `git cat-file -p` prints it. Only
/// the header counts; it ends at the first empty line.
fn first_parent(commit : String) -> String? {
  for line in commit.split("\n") {
    if line.is_empty() {
      return None
    }
    if line.strip_prefix("parent ") is Some(parent) {
      return Some(parent.to_owned())
    }
  }
  None
}

///|
/// The first parent of HEAD. `git cat-file -p` reads only the commit object,
/// so this works in a depth-1 checkout, where `HEAD^1` does not.
async fn tested_parent(cwd~ : String = ".") -> String? {
  first_parent(git_output(["cat-file", "-p", "HEAD"], cwd~))
}

///|
async fn receipt_env() -> ReceiptEnv {
  let commit = environment("GITHUB_SHA")
  let event = environment("EVENT")
  let pr = pr_ref(
    event,
    optional_environment("PR_NUMBER"),
    optional_environment("PR_HEAD"),
    optional_environment("PR_BASE"),
    if event == "pull_request" {
      tested_parent()
    } else {
      None
    },
  )
  {
    repository: environment("GITHUB_REPOSITORY"),
    event,
    run_id: environment("GITHUB_RUN_ID"),
    run_attempt: environment("GITHUB_RUN_ATTEMPT"),
    tested_commit: commit,
    tested_tree: git_output(["rev-parse", "HEAD^{tree}"]),
    pr,
  }
}

///|
fn gate_command(json~ : Bool = false) -> @argparse.Command {
  fn mode_flag(name : String, about : String) -> @argparse.FlagArg {
    @argparse.FlagArg(
      name,
      about~,
      conflicts_with=gate_modes.filter(mode => mode != name) + ["receipt"],
    )
  }

  let help = if json {
    [@argparse.FlagArg("help", short='h', about="Show help information.")]
  } else {
    []
  }
  @argparse.Command(
    "ci-gate",
    about="Reject failed, cancelled or skipped required CI jobs",
    disable_help_flag=json,
    disable_help_subcommand=json,
    flags=[
      ..help,
      @argparse.FlagArg("json"),
      mode_flag("self-test", "Run the built-in tests"),
      mode_flag("qualification", "Write a qualification receipt"),
      mode_flag(
        "qualification-plan", "Check the macOS mode of a qualification run",
      ),
      mode_flag(
        "qualification-jobs", "Print the fixed base and macOS job lists as JSON",
      ),
      mode_flag("native", "Gate the reusable native workflow"),
      mode_flag("installed", "Gate the reusable installed workflow"),
    ],
    options=[
      @argparse.OptionArg(
        "receipt",
        about="Write the CI receipt to this path when the gate passes",
      ),
    ],
  )
}

///|
let gate_modes : Array[String] = [
  "self-test", "qualification", "qualification-plan", "qualification-jobs", "native",
  "installed",
]

///|
fn gate_mode(matches : @argparse.Matches) -> String {
  for mode in gate_modes {
    if matches.flags.get(mode).unwrap_or(false) {
      return mode
    }
  }
  "check"
}

///|
fn receipt_path(matches : @argparse.Matches) -> String? {
  match matches.values.get("receipt") {
    Some([path]) => Some(path)
    _ => None
  }
}

///|
/// `--qualification`: gate the run by its macOS mode, then write the v2
/// receipt for the candidate commit.
async fn qualify(needs : Json) -> Unit {
  let mode = MacosMode::parse(environment("CI_MACOS_MODE"))
  let evidence = evidence_input(optional_environment("CI_MACOS_EVIDENCE"))
  let revision = environment("GITHUB_SHA")
  let receipt = qualification_receipt(needs, mode, evidence, {
    revision,
    repository: environment("GITHUB_REPOSITORY"),
    run_id: environment("GITHUB_RUN_ID"),
    run_attempt: environment("GITHUB_RUN_ATTEMPT"),
  })
  verify_candidate(revision)
  @fs.mkdir(".dev/qualification", recursive=true)
  @fs.write_file(".dev/qualification/receipt.ionb", qualification_ion(receipt))
  println(receipt.stringify())
}

///|
async fn execute(argv : Array[String]) -> Unit {
  let matches = gate_command(json=output_mode.json).parse(argv~, env=Map([]))
  if output_mode.json && matches.flags.get("help").unwrap_or(false) {
    @stdio.stdout.write(
      command_result({ "help": gate_command().render_help() }).stringify() +
      "\n",
    )
    return
  }
  output_mode.json = output_mode.json ||
    matches.flags.get("json").unwrap_or(false)
  let mode = gate_mode(matches)
  if mode == "self-test" {
    self_test()
    if output_mode.json {
      @stdio.stdout.write(command_result({ "passed": true }).stringify() + "\n")
    }
    return
  }
  if mode == "qualification-plan" {
    let macos = MacosMode::parse(environment("CI_MACOS_MODE"))
    plan_qualification(
      macos,
      environment("EVENT"),
      environment("GITHUB_REF"),
      evidence_input(optional_environment("CI_MACOS_EVIDENCE")),
    )
    println(Json::object({ "macos": macos.to_string() }).stringify())
    return
  }
  if mode == "qualification-jobs" {
    println(qualification_jobs().stringify())
    return
  }
  let needs = @json.parse(environment("CI_NEEDS"))
  if mode == "qualification" {
    qualify(needs)
  } else {
    let required = if mode == "native" || mode == "installed" {
      selected_jobs("--" + mode, @json.parse(environment("CI_INPUTS")))
    } else {
      @json.parse(environment("CI_REQUIRED_JOBS"))
    }
    check(needs, required)
    if receipt_path(matches) is Some(path) {
      let selection = @json.parse(environment("CI_SELECTION"))
      write_receipt(path, needs, required, selection, receipt_env())
      if output_mode.json {
        println(@fs.read_file(path).json().stringify())
      }
    } else if output_mode.json {
      @stdio.stdout.write(
        command_result({
          "mode": mode,
          "requiredJobs": required,
          "results": needs,
          "passed": true,
        }).stringify() +
        "\n",
      )
    }
  }
  if !output_mode.json {
    println("All selected checks passed; unselected checks may be skipped.")
  }
}

///|
/// Output selection belongs to the command boundary, never to data operands.
priv struct OutputMode {
  mut json : Bool
}

///|
let output_mode : OutputMode = { json: false, }

///|
fn command_result(result : Json) -> Json {
  {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "ci.gate",
    "state": "succeeded",
    "exitCode": 0,
    "result": result,
    "diagnostics": [],
  }
}

///|
fn command_error(error : Error, code~ : String = "command_failed") -> Json {
  {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "ci.gate",
    "state": "failed",
    "exitCode": 1,
    "error": { "code": code, "message": error.to_string() },
    "diagnostics": [],
  }
}

///|
fn test_note(message : String) -> Unit {
  if output_mode.json {
    eprintln(message)
  } else {
    println(message)
  }
}

///|
/// Reserve one explicit prefix and unwrap it once. A literal --json is still
/// data in the legacy grammar, or after the reserved prefix's delimiter.
fn presentation_arguments(argv : Array[String]) -> Array[String] {
  match argv {
    ["--json", "--", .. raw] => {
      output_mode.json = true
      return raw.to_owned()
    }
    _ => ()
  }
  if !argv.is_empty() {
    try
      @argparse.Command(
        "json-prefix",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("json", required=true)],
      ).parse(argv=argv[:1], env=Map([]))
    catch {
      _ => ()
    } noraise {
      _ => output_mode.json = true
    }
  }
  if presentation_probe(argv) is Some(matches) {
    output_mode.json = output_mode.json ||
      matches.flags.get("json").unwrap_or(false)
    if matches.subcommand is Some((_, child)) {
      output_mode.json = output_mode.json ||
        child.flags.get("json").unwrap_or(false)
    }
  }
  argv
}

///|
async fn main {
  try {
    let argv = presentation_arguments(command_arguments())
    execute(argv)
  } catch {
    error => {
      if !output_mode.json {
        raise error
      }
      @stdio.stdout.write(command_error(error).stringify() + "\n")
      @sys.exit(1)
    }
  }
}

///|
/// Presentation recognition uses the full declared vocabulary, with requirements
/// relaxed so the real parser can report syntax errors inside the JSON boundary.
/// The parsed data is never forwarded or used to execute the command.
fn presentation_probe(argv : Array[String]) -> @argparse.Matches? {
  Some(
    @argparse.Command(
      "ci.gate",
      disable_help_flag=true,
      disable_help_subcommand=true,
      flags=[
        @argparse.FlagArg("json"),
        @argparse.FlagArg("help", short='h'),
        @argparse.FlagArg("self-test"),
        @argparse.FlagArg("qualification"),
        @argparse.FlagArg("qualification-plan"),
        @argparse.FlagArg("native"),
        @argparse.FlagArg("installed"),
      ],
      options=[@argparse.OptionArg("receipt")],
      positionals=[
        @argparse.PositionArg(
          "arguments",
          num_args=@argparse.ValueRange(lower=0),
          allow_hyphen_values=true,
        ),
      ],
    ).parse(argv~, env=Map([])),
  ) catch {
    _ => presentation_controls(argv)
  }
}

///|
fn presentation_self_test() -> Unit raise {
  let saved = output_mode.json
  defer {
    output_mode.json = saved
  }

  for literal in ["", "λ 雪", "--", "--json", "--help", "--self-test"] {
    let raw = [literal, "--", "--json", ""]
    output_mode.json = false
    assert_eq(presentation_arguments(["--json", "--", ..raw]), raw)
    assert_true(output_mode.json)
  }
  output_mode.json = false
  assert_eq(presentation_arguments(["--json", "--", "--json", "--", "value"]), [
    "--json", "--", "value",
  ])

  output_mode.json = false
  let raw = ["--receipt=--json"]
  assert_eq(presentation_arguments(raw), raw)
  assert_true(!output_mode.json)
}

///|
#cfg(target="js")
fn command_arguments() -> Array[String] {
  match @env.args() {
    [_, _, .. rest] => rest.to_owned()
    _ => []
  }
}

///|
#cfg(not(target="js"))
fn command_arguments() -> Array[String] {
  match @env.args() {
    [_, .. rest] => rest.to_owned()
    _ => []
  }
}

///|
/// A missing option value can stop the full grammar before it reports JSON.
/// This library grammar selects presentation only; the complete command grammar
/// still diagnoses every operand and option. Its values never reach execution.
fn presentation_controls(argv : Array[String]) -> @argparse.Matches? {
  Some(
    @argparse.Command(
      "presentation",
      disable_help_flag=true,
      disable_help_subcommand=true,
      flags=[@argparse.FlagArg("json"), @argparse.FlagArg("help", short='h')],
      positionals=[
        @argparse.PositionArg(
          "data",
          num_args=@argparse.ValueRange(lower=0),
          allow_hyphen_values=true,
        ),
      ],
    ).parse(argv~, env=Map([])),
  ) catch {
    _ => None
  }
}
