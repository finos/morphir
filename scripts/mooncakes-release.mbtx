///|
async fn qualify_worker_cli(
  program : String,
  prefix : Array[String],
  stage : String,
  environment : Map[String, String],
) -> Unit {
  let stage = @fs.realpath(stage)
  let fixture = @fs.realpath(@fs.tmpdir(prefix="morphir-release-worker-probe-"))
  defer @fs.rmdir(fixture, recursive=true)
  let guest = release_worker_guest()
  let guest_path = join_host(fixture, "probe.wasm")
  let pin_path = join_host(fixture, "pin.json")
  @fs.write_file(guest_path, guest, create_mode=CreateNew)
  let pin : Json = {
    "contractVersion": "0.2.0",
    "artifact": { "path": guest_path, "sha256": digest(guest) },
    "runtime": { "kind": "wasm", "abi": "extism-kernel-v1" },
    "origin": "release-qualification",
  }
  @fs.write_file(pin_path, pin.stringify(), create_mode=CreateNew)
  let (status, stdout, stderr) = @async.with_timeout(30000, () => {
    @process.collect_output(
      program,
      [
        ..prefix, "extension", "describe", "--extension-pin", pin_path, "--isolated",
        "--discovery-boundary", stage, "--json",
      ],
      cwd=stage,
      extra_env=environment,
    )
  })
  write_diagnostic(stderr.text())
  require_worker_guest_failure(status, stdout.text())
}

///|
fn require_worker_guest_failure(status : Int32, stdout : String) -> Unit raise {
  let document = @json.parse(stdout)
  guard status == 1 &&
    string_field(document, "profile") == Some("morphir/command-result") &&
    string_field(document, "contractVersion") == Some("0.1.0") &&
    string_field(document, "command") == Some("extension.describe") &&
    string_field(document, "state") == Some("failed") &&
    object_field(document, "exitCode") == Some(Json(1)) &&
    object_field(document, "error") is Some(error) &&
    string_field(error, "code") == Some("extension.incomplete_session") &&
    string_field(error, "message") ==
    Some("the guest set an error (1): no parser") else {
    raise Refusal(
      CandidateMismatch(
        "Packaged WASM worker did not complete its real guest-error probe",
      ),
    )
  }
}

///|
test "worker qualification requires the exact finite guest fault rather than cancellation or launch failure" {
  assert_eq(
    digest(release_worker_guest()),
    "e90aaff7e9fb289c08c26c3ecd8e92a9a1dc2dd36c4203ab8d2be39320cd61a4",
  )
  let error : Json = {
    "code": "extension.incomplete_session",
    "message": "the guest set an error (1): no parser",
  }
  let document = {
    "profile": Json("morphir/command-result"),
    "contractVersion": Json("0.1.0"),
    "command": Json("extension.describe"),
    "state": Json("failed"),
    "exitCode": Json(1),
    "error": error,
  }
  require_worker_guest_failure(1, Json(document).stringify())
  for kind in ["exit", "cancelled", "launch", "other-guest"] {
    let changed = document.copy()
    let status = if kind == "exit" { 0 } else { 1 }
    if kind == "cancelled" {
      changed["exitCode"] = Json(130)
      changed["error"] = {
        "code": "extension.cancelled",
        "message": "the command was cancelled",
      }
    }
    if kind == "launch" {
      changed["error"] = {
        "code": "extension.launch_failed",
        "message": "the worker module is missing",
      }
    }
    if kind == "other-guest" {
      changed["error"] = {
        "code": "extension.incomplete_session",
        "message": "another failure",
      }
    }
    let refused = try {
      require_worker_guest_failure(status, Json(changed).stringify())
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused, msg=kind)
  }
}

///|
async fn qualify_portable_cli(
  program : String,
  prefix : Array[String],
  stage : String,
  environment : Map[String, String],
  version : ReleaseVersion,
) -> Unit {
  let stage = @fs.realpath(stage)
  if !consumer_child(program, [..prefix, "--help"], stage, environment).contains(
      "Usage: morphir",
    ) {
    raise Refusal(CandidateMismatch("Portable CLI help is unavailable"))
  }
  require_cli_version(
    consumer_child(program, [..prefix, "version", "--json"], stage, environment),
    version,
  )
  let answer_path = join_host(stage, "portable-answer.scm")
  @fs.write_file(answer_path, "(+ 40 2)", create_mode=CreateNew)
  let options = ["--isolated", "--discovery-boundary", stage, "--json"]
  let answer = @json.parse(
    consumer_child(
      program,
      [..prefix, "worksheet", answer_path, ..options],
      stage,
      environment,
    ),
  )
  guard object_field(answer, "observations") is Some(Array([row])) &&
    object_field(row, "outcome") is Some(outcome) &&
    string_field(outcome, "status") == Some("returned") &&
    object_field(outcome, "value") is Some(value) &&
    string_field(value, "type") == Some("int") &&
    string_field(value, "value") == Some("42") else {
    raise Refusal(
      CandidateMismatch("Portable CLI worksheet did not return integer 42"),
    )
  }
  let invalid_path = join_host(stage, "portable-invalid.scm")
  @fs.write_file(invalid_path, "(", create_mode=CreateNew)
  let (status, stdout, stderr) = @process.collect_output(
    program,
    [..prefix, "worksheet", invalid_path, ..options],
    cwd=stage,
    extra_env=environment,
  )
  write_diagnostic(stderr.text())
  let failure = @json.parse(stdout.text())
  guard status == 1 &&
    object_field(failure, "completion") is Some(completion) &&
    string_field(completion, "status") == Some("failed") &&
    object_field(completion, "failure") is Some(detail) &&
    string_field(detail, "code") == Some("worksheet.read_failed") else {
    raise Refusal(
      CandidateMismatch(
        "Portable CLI malformed input changed JSON or exit status",
      ),
    )
  }
  qualify_worker_cli(program, prefix, stage, environment)
}

///|
fn require_cli_version(text : String, version : ReleaseVersion) -> Unit raise {
  guard @json.parse(text) is Object(fields) &&
    fields.get("profile") == Some(Json("morphir/command-result")) &&
    fields.get("contractVersion") == Some(Json("0.1.0")) &&
    fields.get("command") == Some(Json("version")) &&
    fields.get("state") == Some(Json("succeeded")) &&
    fields.get("exitCode") == Some(Json(0)) &&
    fields.get("result") is Some(result) &&
    string_field(result, "name") == Some("finos/morphir") &&
    string_field(result, "version") == Some(version.0) else {
    raise Refusal(
      CandidateMismatch("Published CLI version differs from candidate"),
    )
  }
}

///|
enum ConsumerToolchain {
  Release
  Minimum(String)
}

///|
fn consumer_output(toolchain : ConsumerToolchain) -> String {
  match toolchain {
    Release => ".dev/mooncakes-release/consumer.json"
    Minimum(_) => ".dev/mooncakes-release/consumer-minimum.json"
  }
}

///|
test "public consumer defaults keep both compiler receipts" {
  assert_eq(consumer_output(Release), ".dev/mooncakes-release/consumer.json")
  assert_eq(
    consumer_output(Minimum("toolchain")),
    ".dev/mooncakes-release/consumer-minimum.json",
  )
}

///|
test "minimum consumer pins exact stock 0.10.20" {
  assert_eq(minimum_version, "0.10.20+65efd5b93")
  assert_eq(
    minimum_core_sha256, "e801a28a1e362b13c58ebaf432938bccec56e1de06c8667d9d8df272ee8f82ab",
  )
  assert_eq(minimum_core_files_count, 1916)
  assert_eq(
    minimum_windows_compiler_sha256, "bdff9a3b2d7c61a3adae2fe09221d3de63effc6cab28bfa0cbeb94fb0d529d79",
  )
  assert_eq(
    minimum_windows_core_sha256, "d7982eed233e0c4f933f566274cc9777466447e0d5b633006e8bf18975c7c833",
  )
}

///|
test "public consumer refuses a mismatched actual compiler" {
  require_consumer_version(
    "v" + minimum_version + " (minimum compiler)",
    minimum_version,
  )
  for
    actual in [
      "v0.10.18+6c83a7f62 (2026-10-29)", "v0.10.20+65efd5b93-other", "",
    ] {
    let refused = try {
      require_consumer_version(actual, minimum_version)
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused)
  }
}

///|
fn require_consumer_version(reported : String, expected : String) -> Unit raise {
  if !reported.has_prefix("v" + expected + " ") {
    raise Refusal(
      CandidateMismatch("Consumer compiler must be exactly " + expected),
    )
  }
}

///|
// Only exclusive temporary stages created by this script reach this helper.
// Never traverse links: consumer homes link to the real compiler installation.
async fn remove_owned_entry(path : String) -> Unit {
  let kind = @fs.kind(path, follow_symlink=false) catch {
    @os_error.OSError(_) as error if error.is_ENOENT() => return
    error => raise error
  }
  match kind {
    Directory => {
      for name in @fs.readdir(path, include_hidden=true) {
        remove_owned_entry(join_host(path, name))
      }
      @fs.rmdir(path)
    }
    Regular =>
      @fs.remove(path) catch {
        @os_error.OSError(_) as error if @env.get_env_var("OS") ==
          Some("Windows_NT") &&
          error.is_EACCES() => {
          // Git marks packed registry objects read-only on Windows. async's
          // chmod is unsupported there; invoke the OS attribute utility only
          // after a failed unlink and another no-follow regular-file check.
          guard @fs.kind(path, follow_symlink=false) is Regular else {
            raise error
          }
          ignore(child("attrib.exe", ["-R", path]))
          @fs.remove(path)
        }
        error => raise error
      }
    _ => @fs.remove(path)
  }
}

///|
async fn dispose_owned_stage(
  stage : String,
  preserving_error~ : Bool = false,
) -> Unit nocancel {
  @async.protect_from_cancel(() => {
    remove_owned_entry(stage) catch {
      error => {
        if !preserving_error {
          raise error
        }
        // A failing body remains the primary error. Cleanup failure still
        // reaches stderr, and a cleanup-only failure never permits success.
        write_diagnostic(
          "Owned consumer cleanup also failed: " + error.to_string() + "\n",
        ) catch {
          _ => ()
        }
      }
    }
  })
}

///|
async test "consumer cleanup removes owned read-only files without following compiler links" {
  let external = @fs.tmpdir(prefix="morphir-cleanup-external-")
  defer @fs.rmdir(external, recursive=true)
  let stage = @fs.tmpdir(prefix="morphir-cleanup-owned-")
  let sentinel = join_host(external, "compiler")
  @fs.write_file(sentinel, "caller-owned compiler")
  @fs.symlink(target=external, join_host(stage, "compiler-link"))
  @fs.symlink(
    target=join_host(external, "missing"),
    join_host(stage, "dangling-link"),
  )
  @fs.mkdir(join_host(stage, ".registry"))
  let object = join_host(stage, ".registry/packed.idx")
  @fs.write_file(object, "owned registry object")
  if @env.get_env_var("OS") == Some("Windows_NT") {
    ignore(child("attrib.exe", ["+R", object]))
  } else {
    @fs.chmod(object, 0o444)
  }
  dispose_owned_stage(stage)
  dispose_owned_stage(stage)
  assert_false(@fs.exists(stage))
  assert_eq(@fs.read_file(sentinel).text(), "caller-owned compiler")
  assert_true(@fs.can_write(sentinel))
}

///|
async test "consumer cleanup preserves a body failure but refuses cleanup-only failure" {
  let stage = @fs.tmpdir(prefix="morphir-cleanup-errors-")
  defer @fs.rmdir(stage)
  // No file is created: this overlong component makes the filesystem query
  // fail independently of the user privileges and platform ACL defaults.
  let invalid = join_host(stage, "x".repeat(300))
  let cleanup_refused = try {
    dispose_owned_stage(invalid)
    false
  } catch {
    _ => true
  }
  assert_true(cleanup_refused)
  let failed = Ref(false)
  let original_preserved = try {
    defer dispose_owned_stage(invalid, preserving_error=failed.val)
    errdefer {
      failed.val = true
    }
    raise Refusal(CandidateMismatch("original qualification failure"))
  } catch {
    Refusal(CandidateMismatch("original qualification failure")) => true
    _ => false
  }
  assert_true(original_preserved)
}

///|
async fn consumer_environment(
  source : String,
  stage : String,
) -> Map[String, String] {
  let home = join_host(stage, "moon-home")
  @fs.mkdir(home)
  for name in ["bin", "lib", "include", "share"] {
    let original = join_host(source, name)
    if @fs.exists(original) {
      @fs.symlink(target=original, join_host(home, name))
    }
  }
  {
    "MOON_HOME": home,
    "MOON_TOOLCHAIN_ROOT": home,
    "PATH": join_host(home, "bin") +
    @host_path.delimiter.to_string() +
    @env.get_env_var("PATH").unwrap_or(""),
    "MOON_WORK": join_host(stage, "moon.work"),
    "MOON_DEP_CACHE": join_host(stage, "dependency-cache"),
    "MOON_BUILD_CACHE": join_host(stage, "build-cache"),
    "MOONCAKES_TOKEN": "",
  }
}

///|
async test "public consumer cannot inherit publisher credentials or registry config" {
  let source = @fs.tmpdir(prefix="morphir-consumer-source-")
  defer @fs.rmdir(source, recursive=true)
  let stage = @fs.tmpdir(prefix="morphir-consumer-isolation-")
  defer @fs.rmdir(stage, recursive=true)
  for name in ["bin", "lib", "include", "share"] {
    @fs.mkdir(join_host(source, name))
  }
  for name in ["credentials.json", "config.json"] {
    @fs.write_file(join_host(source, name), "publisher-only")
  }
  let environment = consumer_environment(source, stage)
  let home = environment["MOON_HOME"]
  assert_true(is_within(stage, home))
  assert_eq(environment["MOON_TOOLCHAIN_ROOT"], home)
  assert_eq(environment["MOONCAKES_TOKEN"], "")
  assert_eq(environment["MOON_WORK"], join_host(stage, "moon.work"))
  assert_true(
    environment["PATH"].has_prefix(
      join_host(home, "bin") + @host_path.delimiter.to_string(),
    ),
  )
  for name in ["credentials.json", "config.json"] {
    assert_false(@fs.exists(join_host(home, name)))
    assert_eq(@fs.read_file(join_host(source, name)).text(), "publisher-only")
  }
  for name in ["bin", "lib", "include", "share"] {
    assert_eq(
      @fs.realpath(join_host(home, name)),
      @fs.realpath(join_host(source, name)),
    )
  }
  assert_false(@fs.exists(environment["MOON_DEP_CACHE"]))
  assert_false(@fs.exists(environment["MOON_BUILD_CACHE"]))
}

///|
async test "consumer commands override a hostile ambient toolchain root" {
  let source = @fs.realpath(moon_home())
  let stage = @fs.tmpdir(prefix="morphir-consumer-hostile-root-")
  defer @fs.rmdir(stage, recursive=true)
  // Model the inherited root before applying the same extra_env overlay used
  // by consumer_child. Do not mutate this concurrent test process's globals.
  let environment : Map[String, String] = {
    "MOON_TOOLCHAIN_ROOT": join_host(stage, "missing-toolchain"),
  }
  for key, value in consumer_environment(source, stage) {
    environment[key] = value
  }
  let home = environment["MOON_HOME"]
  assert_eq(environment["MOON_TOOLCHAIN_ROOT"], home)
  @fs.write_file(
    join_host(stage, "moon.mod"),
    "name = \"morphir-release/root-isolation\"\nversion = \"0.0.0\"\n",
  )
  @fs.write_file(join_host(stage, "moon.pkg"), "")
  @fs.write_file(
    join_host(stage, "answer.mbt"),
    "pub fn answer() -> Int { 42 }\n",
  )
  @fs.write_file(join_host(stage, "moon.work"), "members = [\".\"]\n")
  ignore(
    consumer_child(
      join_host(home, "bin/moon"),
      ["build", "--target", "wasm"],
      stage,
      environment,
    ),
  )
}

///|
async test "minimum public consumer rejects missing or nonstock source before registry effects" {
  let root = @fs.tmpdir(prefix="morphir-consumer-invalid-")
  defer @fs.rmdir(root, recursive=true)
  @fs.mkdir(join_host(root, "lib"))
  @fs.mkdir(join_host(root, "lib/core"))
  for home in ["missing", root] {
    let refused = try {
      ignore(minimum_compiler_source(root, home))
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused)
  }
  assert_false(@fs.exists(join_host(root, "credentials.json")))
  assert_false(@fs.exists(join_host(root, ".mooncakes")))
}

///|
/// Remove deferred public modules from verification. A deferred module is a
/// public module of this release that was not published. Refuse an unknown or
/// repeated name, a module that another verified module depends on, and a
/// selection that leaves nothing to verify.
fn deferred_inspection(
  inspection : Inspection,
  deferred : Array[String],
) -> Inspection raise Refusal {
  let names = inspection.ordered.map(manifest => manifest.name)
  let seen : Map[String, Bool] = Map([])
  for name in deferred {
    if !names.contains(name) || seen.contains(name) {
      raise Refusal(
        CandidateMismatch("Deferred module is not one public module: " + name),
      )
    }
    seen[name] = true
  }
  let kept = inspection.ordered.filter(manifest => !seen.contains(manifest.name))
  if kept.is_empty() {
    raise Refusal(CandidateMismatch("Every public module is deferred"))
  }
  for manifest in kept {
    for dependency, _ in manifest.dependencies {
      if seen.contains(dependency) {
        raise Refusal(
          CandidateMismatch(
            manifest.name + " depends on deferred module " + dependency,
          ),
        )
      }
    }
  }
  { ..inspection, ordered: kept, }
}

///|
/// A deferred module must be absent from the registry at the release version,
/// so deferral cannot hide a published module from verification.
fn require_deferred_absent(
  name : String,
  state : RegistryState,
) -> Unit raise Refusal {
  guard state is Absent else {
    raise Refusal(
      CandidateMismatch(
        "Deferred module must be absent from the registry: " + name,
      ),
    )
  }
}

///|
async fn verify_consumer(
  root : String,
  inspection : Inspection,
  version : ReleaseVersion,
  toolchain~ : ConsumerToolchain = Release,
) -> Json {
  if version != inspection.version {
    raise Refusal(
      CandidateMismatch(
        "Verification version must match the checked-out release inventory",
      ),
    )
  }
  let commit = CommitId::parse(
    child("git", ["-C", root, "rev-parse", "HEAD"]).trim().to_owned(),
  )
  let (producer_compiler, core_pin_sha256) = compiler_for(root, commit)
  let (source, compiler) = match toolchain {
    Release => (moon_home(), producer_compiler)
    Minimum(home) => (minimum_compiler_source(root, home), minimum_version)
  }
  if (
      @env.get_env_var("MOONCAKES_REGISTRY") is Some(value) && !value.is_empty()
    ) ||
    @fs.exists(join_host(moon_home(), "config.json")) ||
    @fs.exists(join_host(source, "config.json")) {
    raise Refusal(
      CandidateMismatch(
        "Consumer verification requires the default Mooncakes registry",
      ),
    )
  }
  let stage = @fs.tmpdir(prefix="morphir-registry-consumer-")
  let failed = Ref(false)
  defer dispose_owned_stage(stage, preserving_error=failed.val)
  errdefer {
    failed.val = true
  }
  let environment = consumer_environment(source, stage)
  let moon = join_host(environment["MOON_HOME"], "bin/moon")
  let moonx = join_host(environment["MOON_HOME"], "bin/moonx")
  require_consumer_version(
    consumer_child(
      join_host(environment["MOON_HOME"], "bin/moonc"),
      ["-v"],
      stage,
      environment,
    ),
    compiler,
  )
  @fs.write_file(join_host(stage, "moon.work"), "members = [\".\"]\n")
  @fs.write_file(join_host(stage, "moon.mod"), consumer_manifest(inspection))
  @fs.write_file(
    join_host(stage, "moon.pkg"),
    "pkgtype(kind: \"executable\")\nimport {\n  \"finos/morphir-scheme\" @scheme,\n  \"moonbitlang/core/bigint\",\n}\n",
  )
  @fs.write_file(join_host(stage, "main.mbt"), consumer_source)
  // The public consumer owns a new registry index as well as dependency/build
  // caches. Never reuse the publisher's pre-upload index or credentials.
  ignore(consumer_child(moon, ["update"], stage, environment))
  let targets = ["wasm", "wasm-gc", "js", "native"]
  for target in targets {
    let output = consumer_child(
      moon,
      ["run", ".", "--target", target],
      stage,
      environment,
    )
    if output.trim() != "morphir-registry-consumer-ok" {
      raise Refusal(
        CandidateMismatch(
          "Registry library consumer did not finish its Scheme and stock-core decimal checks",
        ),
      )
    }
  }
  let resolved : Array[Json] = []
  for manifest in inspection.ordered {
    let path = join_host(stage, ".mooncakes/" + manifest.name + "/moon.mod")
    let actual = decode_manifest(manifest.path, @fs.read_file(path).text())
    if actual.name != manifest.name || actual.version != version.0 {
      raise Refusal(
        CandidateMismatch(
          "Consumer resolved an unexpected module identity: " + manifest.name,
        ),
      )
    }
    resolved.push({ "name": actual.name, "version": actual.version })
  }
  let coordinate = "finos/morphir@" + version.0
  let portable_coordinate = "finos/morphir/moonx@" + version.0
  // Registry executable builds materialize their own module outside this
  // consumer. They must not inherit its pinned workspace.
  let executable_environment = environment.copy()
  executable_environment["MOON_WORK"] = "off"
  qualify_portable_cli(
    moonx,
    [portable_coordinate],
    stage,
    executable_environment,
    version,
  )
  let portable = qualify_portable_boundary(
    root,
    stage,
    executable_environment,
    version,
    PublicEntry,
  )
  let portable_file = match toolchain {
    Release => ".dev/mooncakes-release/moonx-public.json"
    Minimum(_) => ".dev/mooncakes-release/moonx-public-minimum.json"
  }
  write_owned_json(
    release_file(root, portable_file),
    {
      "profile": "morphir/moonx-public-qualification",
      "contractVersion": "0.1.0",
      "state": "succeeded",
      "sha": commit.0,
      "version": version.0,
      "result": portable,
    },
    "morphir/moonx-public-qualification",
  )
  let binaries = join_host(stage, "bin")
  ignore(
    consumer_child(
      moon,
      ["install", coordinate, "--bin", binaries],
      stage,
      executable_environment,
    ),
  )
  let executable = if @fs.exists(join_host(binaries, "morphir")) {
    join_host(binaries, "morphir")
  } else {
    join_host(binaries, "morphir.exe")
  }
  let installed_help = consumer_child(
    executable,
    ["--help"],
    stage,
    executable_environment,
  )
  if !installed_help.contains("Usage: morphir") {
    raise Refusal(CandidateMismatch("Installed native CLI help is unavailable"))
  }
  require_cli_version(
    consumer_child(
      executable,
      ["version", "--json"],
      stage,
      executable_environment,
    ),
    version,
  )
  let worksheet = join_host(stage, "answer.scm")
  @fs.write_file(worksheet, "(+ 40 2)")
  let answer = @json.parse(
    consumer_child(
      executable,
      ["worksheet", worksheet, "--json"],
      stage,
      executable_environment,
    ),
  )
  guard answer is Object(fields) &&
    fields.get("observations") is Some(Array(rows)) &&
    rows.length() == 1 &&
    string_field(rows[0], "preview") == Some("42") &&
    fields.get("completion") is Some(completion) &&
    string_field(completion, "status") == Some("returned") else {
    raise Refusal(
      CandidateMismatch("Installed native CLI worksheet did not return 42"),
    )
  }
  qualify_worker_cli(executable, [], stage, executable_environment)
  let receipt : Json = {
    "profile": "morphir/mooncakes-consumer",
    "contractVersion": "0.1.0",
    "sha": commit.0,
    "version": version.0,
    "compilerVersion": compiler,
    "corePinSha256": core_pin_sha256,
    "modules": resolved,
    "libraryTargets": targets,
    "stockCoreLongDecimal": "passed",
    "moonxHelp": "passed",
    "moonxPackage": portable_coordinate,
    "moonxVersion": "passed",
    "moonxWorksheet": "42",
    "moonxInvalidWorksheetExitCode": 1,
    "moonxWasmWorkerGuestError": "passed",
    "nativeHelp": "passed",
    "nativeVersion": "passed",
    "nativeWorksheet": "42",
    "nativeWasmWorkerGuestError": "passed",
    "dependencyCache": "fresh",
    "localWorkspaceInputs": false,
  }
  if toolchain is Minimum(_) && receipt is Object(fields) {
    fields["producerCompilerVersion"] = Json(producer_compiler)
    fields["consumerCoreSourceSha256"] = Json(minimum_core_sha256)
    fields["consumerCoreSourceFiles"] = Json(minimum_core_files_count)
  }
  receipt
}

///|
async fn discovered_modules(root : String) -> Array[ModulePath] {
  // Include new unignored manifests as well as tracked source. Git excludes
  // build caches and installed dependencies from the source-module inventory.
  let output = child("git", [
    "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard",
  ])
  let paths = []
  for file in output.split("\u{0}") {
    if file == "moon.mod" {
      paths.push(ModulePath::parse("."))
    } else if file.has_suffix("/moon.mod") {
      paths.push(
        ModulePath::parse(
          file[:file.length() - "/moon.mod".length()].to_owned(),
        ),
      )
    } else if file == "moon.mod.json" || file.has_suffix("/moon.mod.json") {
      raise Refusal(
        ManifestSyntax(
          "Migrate legacy module manifest before release: " + file.to_owned(),
        ),
      )
    }
  }
  paths.sort_by((left, right) => left.0.lexical_compare(right.0))
  paths
}

///|
async fn confined_file(
  directory : String,
  relative : String,
  problem : Problem,
) -> Unit {
  let ModulePath(path) = ModulePath::parse(relative)
  if !@fs.exists(join_host(directory, path)) {
    raise Refusal(problem)
  }
  let canonical = @fs.realpath(join_host(directory, path))
  if !is_within(directory, canonical) {
    raise Refusal(InvalidPath(relative))
  }
  guard @fs.kind(canonical) is Regular else { raise Refusal(problem) }
}

///|
async fn inspect(root : String) -> Inspection {
  let root = @fs.realpath(root)
  let inventory = decode_inventory(
    @json.parse(
      @fs.read_file(join_host(root, "scripts/mooncakes-modules.json")).text(),
    ),
  )
  let discovered = discovered_modules(root)
  let manifests = []
  for path in discovered {
    let directory = @fs.realpath(join_host(root, path.0))
    if !is_within(root, directory) {
      raise Refusal(InvalidPath(path.0))
    }
    confined_file(directory, "moon.mod", MissingModule(path.0))
    manifests.push(
      decode_manifest(
        path,
        @fs.read_file(join_host(directory, "moon.mod")).text(),
      ),
    )
  }
  guard inventory.iter().filter(entry => entry.disposition is Public).next()
    is Some(first) &&
    manifests.iter().filter(manifest => manifest.path == first.path).next()
    is Some(first_manifest) else {
    raise Refusal(InvalidInventory("No public module manifest"))
  }
  let version = ReleaseVersion::parse(first_manifest.version)
  let ordered = publish_order(inventory, manifests, discovered, version)
  for manifest in ordered {
    require_default_backend(manifest)
    let directory = @fs.realpath(join_host(root, manifest.path.0))
    confined_file(
      directory,
      manifest.readme.unwrap(),
      MissingReadme(manifest.name),
    )
    confined_file(directory, "LICENSE", MissingLicense(manifest.name))
    if manifest.name == "finos/morphir" {
      confined_file(
        directory,
        "cli/release_identity.mbt",
        MissingModule("CLI generated identity"),
      )
      require_identity(
        manifest,
        @fs.read_file(join_host(directory, "cli/release_identity.mbt")).text(),
      )
    }
  }
  { inventory, ordered, version, }
}

///|
fn is_within(directory : String, target : String) -> Bool {
  let relative = @host_path.Path(target).relative(
    base=@host_path.Path(directory),
  )
  !relative.is_absolute() &&
  relative.0 != ".." &&
  !relative.0.has_prefix(".." + @host_path.sep.to_string())
}

///|
fn join_host(directory : String, relative : String) -> String {
  @host_path.Path(directory).join(@host_path.Path(relative)).0
}

///|
test "host path confinement respects directory boundaries" {
  let root = @host_path.Path("release-root").resolve().0
  assert_true(is_within(root, join_host(root, "pkgs/core/README.md")))
  assert_true(is_within(root, root))
  assert_false(is_within(root, join_host(root, "../outside")))
  assert_false(is_within(root, root + "-sibling"))
}

///|
fn command(name : String) -> @argparse.Command {
  let options = if name == "plan" {
    [
      @argparse.OptionArg(
        "minimum-home",
        default_values=[".dev/mooncakes-release/minimum-toolchain"],
        about="Exact stock 0.10.20 installation; plan always qualifies its archives with it",
      ),
      @argparse.OptionArg("tag"),
      @argparse.OptionArg("sha"),
      @argparse.OptionArg("mode"),
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/plan.json",
      ]),
    ]
  } else if name == "check" {
    [
      @argparse.OptionArg(
        "minimum-home",
        about="Also qualify the archives with this exact stock 0.10.20 installation",
      ),
    ]
  } else if name == "qualify-source" {
    [
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/portable-source-host.json",
      ]),
    ]
  } else if name == "qualify-artifacts" {
    [
      @argparse.OptionArg("plan", default_values=[
        ".dev/mooncakes-release/plan.json",
      ]),
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/portable-host.json",
      ]),
    ]
  } else if name == "check-artifacts" {
    [
      @argparse.OptionArg("plan", default_values=[
        ".dev/mooncakes-release/plan.json",
      ]),
    ]
  } else if name == "publish" {
    [
      @argparse.OptionArg("plan", default_values=[
        ".dev/mooncakes-release/plan.json",
      ]),
      @argparse.OptionArg("report", default_values=[
        ".dev/mooncakes-release/publication.json",
      ]),
    ]
  } else if name == "verify" {
    [
      @argparse.OptionArg(
        "minimum-home",
        about="Use exact stock 0.10.20 for the fresh public consumer; the producer must still match the release pin",
      ),
      @argparse.OptionArg(
        "output",
        about="Receipt path; defaults to consumer.json, or consumer-minimum.json with --minimum-home, under .dev/mooncakes-release/",
      ),
      @argparse.OptionArg(
        "defer",
        action=Append,
        about="Public module of this release that was not published; repeat for each. It must be absent from the registry at VERSION and no verified module may depend on it. The receipt lists it under deferredModules.",
      ),
    ]
  } else if name == "workflow" {
    [@argparse.OptionArg("mode")]
  } else if name == "gate-ci" {
    [
      @argparse.OptionArg("sha"),
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/ci-gate.json",
      ]),
    ]
  } else if name == "gate-qualification" {
    [
      @argparse.OptionArg("sha"),
      @argparse.OptionArg("output", default_values=[
        ".dev/mooncakes-release/qualification-gate.json",
      ]),
      @argparse.OptionArg("receipt", default_values=[
        ".dev/qualification-receipt/receipt.ionb",
      ]),
    ]
  } else {
    []
  }
  // The parsing library owns required inputs and help's alternative. There is
  // no second scanner that guesses whether required options can be skipped.
  let groups = if name == "plan" {
    ["tag", "sha", "mode"].map(name => {
      @argparse.ArgGroup(name + "-or-help", required=true, multiple=true, args=[
        name, "help",
      ])
    })
  } else if name == "verify" {
    [
      @argparse.ArgGroup("version-or-help", required=true, multiple=true, args=[
        "version", "help",
      ]),
    ]
  } else if name == "workflow" ||
    name == "gate-ci" ||
    name == "gate-qualification" {
    let option = if name == "workflow" { "mode" } else { "sha" }
    [
      @argparse.ArgGroup(option + "-or-help", required=true, multiple=true, args=[
        option, "help",
      ]),
    ]
  } else {
    []
  }
  @argparse.Command(
    name,
    about=if name == "bootstrap-minimum" {
      "Install exact MoonBit 0.10.20 beside the release compiler in a new .dev/mooncakes-release/minimum-toolchain directory. Refuse existing content or MOON_CORE_OVERRIDE. Unix uses the official installer; its result contains compilerVersion, path and installerSha256. Windows extracts checksum-pinned official compiler/core ZIPs into the owned path and bundles there, without writing into the user home or changing PATH; its result instead contains bootstrap=official-windows-archives and compilerArchiveUrl/compilerArchiveSha256/coreArchiveUrl/coreArchiveSha256. --json emits one morphir/command-result 0.1.0 document on stdout. Installer progress uses stderr. Exit 0 is success, 1 is refusal/failure and 2 is argument syntax. Help performs no installation. Plan must still verify compiler/core bytes and qualify the candidate archives."
    } else if name == "qualify-source" {
      "Package clean exact HEAD and qualify actual generated Moonx source archives on this host with both stock compilers. In Actions HEAD must match GITHUB_SHA. --output selects the distinct morphir/moonx-source-host-qualification 0.1.0 receipt under .dev/mooncakes-release/. The receipt binds source, archive/payload identities, both compiler versions, host and run/attempt. It is manual source evidence, never release-tag or public-consumer authority. No credentials, uploads or tag changes. Windows archive builds append /bigobj only in child CL while preserving inherited flags. --json emits one command-result on stdout; build/test diagnostics use stderr. Success is written last. Syntax exits 2; refusal/failure exits 1. Help has no effects."
    } else if name == "qualify-artifacts" {
      "Qualify the retained generated Moonx entry on this host without repackaging. --plan selects the candidate plan; --output selects the owned morphir/moonx-host-qualification 0.1.0 receipt under .dev/mooncakes-release/. Candidate/compiler/core/archive identity, all reconstructed payload bytes, Wasm entry, help/version, worksheet integer 42 and malformed JSON input status 1 must pass. Missing portable support refuses. The receipt binds archive hashes, compiler/Node/host and workflow run/attempt; success is written last. --json emits one morphir/command-result document on stdout; child diagnostics use stderr. Syntax exits 2 and refusal/failure exits 1. Help has no effects; no credentials or uploads are used."
    } else {
      ""
    },
    flags=[@argparse.FlagArg("help", short='h', global=true)] +
      (if name == "workflow" {
        [@argparse.FlagArg("github-output")]
      } else {
        []
      }),
    options~,
    groups~,
    positionals=if name == "verify" {
      [@argparse.PositionArg("version", num_args=@argparse.ValueRange(upper=1))]
    } else {
      []
    },
    disable_help_flag=true,
    disable_help_subcommand=true,
    disable_version_flag=true,
  )
}

///|
fn cli() -> @argparse.Command {
  @argparse.Command(
    "mooncakes-release.mbtx",
    disable_help_flag=true,
    disable_help_subcommand=true,
    disable_version_flag=true,
    about="Check public Mooncakes packages, plan a fixed candidate, or publish a qualified tag candidate in dependency order. Workflow validates actual GitHub event/ref/SHA and optionally writes --github-output. Gate-ci requires successful exact main-push CI and ci-ok, polling at most 20 minutes. Gate-qualification checks --receipt Ion against --sha, the current workflow run/attempt, v2 profile, macos:run and every required job. Gate commands emit version 0.1.0 morphir/mooncakes-ci-gate or morphir/mooncakes-qualification-gate evidence. Unavailable, skipped, cancelled, failed or stale evidence refuses publication. Check and plan never read credentials or upload. Identity regenerates the tracked apps/morphir/cli/release_identity.mbt after a version change; check refuses stale identity. Verify takes X.Y.Z and resolves every public version with fresh dependency/build caches outside any repository workspace, then exercises Scheme and long-decimal parsing on four targets, moonx help/version and an installed native CLI worksheet. Verify --defer NAME (repeatable) leaves out a public module that this release did not publish; it must be absent from the registry at X.Y.Z and no verified module may depend on it, and the receipt lists it under deferredModules. Inventory and check refuse a public module whose supported_targets excludes the default backend wasm without preferred_target, and check runs moon package without a target in each unpacked archive, as moon publish does. Verify --minimum-home PATH selects exact stock 0.10.20 after checking its core source bytes and actual compiler; the invoking producer still must match the release pin. Each consumer owns a fresh credential-free Moon home, registry index and dependency/build caches. Default receipts are consumer.json or consumer-minimum.json; --output overrides the owned path. Minimum receipts add producerCompilerVersion and consumerCoreSourceSha256/consumerCoreSourceFiles while compilerVersion reports the selected consumer. Consumer results use morphir/mooncakes-consumer 0.1.0. Publication and consumer hosts are qualified on Linux. They require the default registry without Moon home config.json or MOONCAKES_REGISTRY overrides. Plan writes --output, default .dev/mooncakes-release/plan.json. Check-artifacts consumes --plan, verifies every retained archive against the candidate/toolchain/minimum-compiler proof, and requires byte-identical repackaging in an owned workspace without credentials or uploads. Its result is the package evidence object with sha, compilerVersion, corePinSha256, isolatedTargets and modules. Publish consumes those same qualified ZIPs and --plan and persists --report after each module; missing or changed archives refuse before upload. Result files must be under .dev/mooncakes-release/. Dry-run plans cannot publish. Existing versions require a downloaded archive SHA-256 equal to the planned candidate. Only read-only transient/index visibility checks retry, at most six reads and 31 seconds of backoff per poll. Upload errors stop without retrying. --json emits one morphir/command-result 0.1.0 document on stdout; progress and child diagnostics use stderr. Success has state=succeeded, exitCode=0, diagnostics and result; failure has state=failed, exitCode and error{code,message}. Partial publication outcomes remain in the report on failure. Help returns result.help without file or subprocess effects. Exit 2 is argument syntax; exit 1 is validation/child failure. Check gives inventory and package/toolchain evidence; plan adds tag, commit and mode. Publication records published, verified-existing, failed and not-attempted modules.",
    flags=[
      @argparse.FlagArg("json", global=true),
      @argparse.FlagArg("help", short='h', global=true),
    ],
    options=[@argparse.OptionArg("root", global=true, default_values=["."])],
    subcommands=[
      command("check"),
      command("bootstrap-minimum"),
      command("inventory"),
      command("plan"),
      command("publish"),
      command("check-artifacts"),
      command("qualify-artifacts"),
      command("qualify-source"),
      command("identity"),
      command("verify"),
      command("workflow"),
      command("gate-ci"),
      command("gate-qualification"),
      command("gate-needs"),
    ],
  )
}

///|
fn wants_json(argv : Array[String]) -> Bool {
  let probe = @argparse.Command(
    "presentation",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[@argparse.FlagArg("json")],
    positionals=[
      @argparse.PositionArg(
        "opaque",
        allow_hyphen_values=true,
        num_args=@argparse.ValueRange(lower=0),
      ),
    ],
  )
  let parsed = probe.parse(argv~, env=Map([])) catch { _ => return false }
  parsed.flags.get_or_default("json", false)
}

///|
fn inspection_json(inspection : Inspection) -> Json {
  {
    "version": inspection.version.0,
    "publicModules": inspection.ordered.length(),
    "excludedModules": inspection.inventory.length() -
    inspection.ordered.length(),
    "order": inspection.ordered.map(manifest => Json(manifest.name)),
  }
}

///|
async fn emit(
  name : String,
  json_mode : Bool,
  code : Int32,
  result : Json,
  error? : String,
) -> Unit {
  let output : Json = match error {
    Some(message) =>
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "release." + name,
        "state": "failed",
        "exitCode": code,
        "error": {
          "code": if code == 2 {
            "invalid_arguments"
          } else {
            "release_refused"
          },
          "message": message,
        },
        "diagnostics": [],
      }
    None =>
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "release." + name,
        "state": "succeeded",
        "exitCode": 0,
        "result": result,
        "diagnostics": [],
      }
  }
  if json_mode {
    @stdio.stdout.write(output.stringify() + "\n")
  } else if error is Some(message) {
    write_diagnostic(message + "\n")
  } else if string_field(result, "help") is Some(help) {
    @stdio.stdout.write(help + "\n")
  } else {
    @stdio.stdout.write(result.stringify(indent=2) + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = @env.args()[1:].to_owned()
  let json_mode = wants_json(argv)
  let parsed = cli().parse(argv~, env=Map([])) catch {
    error => {
      emit("mooncakes", json_mode, 2, Json::null(), error=error.to_string())
      return
    }
  }
  let (name, args) = parsed.subcommand.unwrap_or(("check", parsed))
  let help = args.flags.get_or_default("help", false) ||
    parsed.flags.get_or_default("help", false)
  if help || parsed.subcommand is None {
    emit(name, json_mode, 0, {
      "help": if parsed.subcommand is None {
        cli().render_help()
      } else {
        command(name).render_help()
      },
    })
    return
  }
  let result : Json = try {
    let root_input = parsed.values.get("root").unwrap_or(["."])[0]
    if root_input.is_empty() {
      raise Refusal(InvalidPath("Root must be nonempty"))
    }
    let root = @fs.realpath(root_input)
    if name == "bootstrap-minimum" {
      let result = bootstrap_minimum(root)
      emit(name, json_mode, 0, result)
      return
    }
    if name == "identity" {
      let directory = join_host(root, "apps/morphir")
      let manifest = decode_manifest(
        ModulePath::parse("apps/morphir"),
        @fs.read_file(join_host(directory, "moon.mod")).text(),
      )
      @fs.write_file(
        join_host(directory, "cli/release_identity.mbt"),
        identity_source(manifest),
      )
      emit(name, json_mode, 0, {
        "path": "apps/morphir/cli/release_identity.mbt",
        "name": manifest.name,
        "version": manifest.version,
      })
      return
    }
    let inspection = inspect(root)
    if name == "inventory" {
      inspection_json(inspection)
    } else if name == "workflow" {
      workflow_candidate(
        root,
        inspection,
        ReleaseMode::parse(args.values["mode"][0]),
        args.flags.get_or_default("github-output", false),
      )
    } else if name == "gate-needs" {
      require_release_needs(
        @json.parse(@env.get_env_var("RELEASE_NEEDS").unwrap_or("null")),
      )
      {
        "prerequisites": ["plan", "ci", "qualification", "headless"],
        "state": "succeeded",
      }
    } else if name == "gate-ci" {
      let file = release_file(root, args.values["output"][0])
      let evidence = gate_ci(CommitId::parse(args.values["sha"][0]))
      write_owned_json(file, evidence, "morphir/mooncakes-ci-gate")
      evidence
    } else if name == "gate-qualification" {
      let file = release_file(root, args.values["output"][0])
      let evidence = gate_qualification(
        root,
        args.values["receipt"][0],
        CommitId::parse(args.values["sha"][0]),
      )
      write_owned_json(file, evidence, "morphir/mooncakes-qualification-gate")
      evidence
    } else if name == "qualify-source" {
      let profile = "morphir/moonx-source-host-qualification"
      let output = release_file(root, args.values["output"][0])
      write_owned_json(
        output,
        {
          "profile": profile,
          "contractVersion": "0.1.0",
          "state": "failed",
          "message": "Source host qualification has not completed",
        },
        profile,
      )
      let receipt = qualify_source_cli(root, inspection)
      write_owned_json(output, receipt, profile)
      receipt
    } else if name == "qualify-artifacts" {
      let profile = "morphir/moonx-host-qualification"
      let output = release_file(root, args.values["output"][0])
      write_owned_json(
        output,
        {
          "profile": profile,
          "contractVersion": "0.1.0",
          "state": "failed",
          "message": "Host qualification has not completed",
        },
        profile,
      )
      let plan = @json.parse(
        @fs.read_file(release_file(root, args.values["plan"][0])).text(),
      )
      let packages = retained_packages(root, inspection, plan)
      let receipt = qualify_retained_cli(root, packages)
      write_owned_json(output, receipt, profile)
      receipt
    } else if name == "check-artifacts" {
      let plan = @json.parse(
        @fs.read_file(release_file(root, args.values["plan"][0])).text(),
      )
      let packages = retained_packages(root, inspection, plan)
      check_retained_archives(root, packages)
      package_set_json(packages)
    } else if name == "check" {
      let packages = package_sources(root, inspection)
      let minimum = match args.values.get("minimum-home") {
        Some([home]) => qualify_minimum(root, packages, home)
        _ => Json::null()
      }
      {
        "inventory": inspection_json(inspection),
        "packages": package_set_json(packages),
        "minimumConsumer": minimum,
      }
    } else if name == "verify" {
      let toolchain : ConsumerToolchain = match
        args.values.get("minimum-home") {
        Some([home]) => Minimum(home)
        None => Release
        _ =>
          raise Refusal(
            CandidateMismatch("Select exactly one minimum compiler home"),
          )
      }
      let file = release_file(
        root,
        args.values.get("output").unwrap_or([consumer_output(toolchain)])[0],
      )
      let version = ReleaseVersion::parse(args.values["version"][0])
      let deferred = args.values.get("defer").unwrap_or([])
      let verified = deferred_inspection(inspection, deferred)
      for manifest in inspection.ordered {
        if deferred.contains(manifest.name) {
          require_deferred_absent(
            manifest.name,
            registry_archive(
              { ..manifest, version: version.0, },
              check=EvidenceOnly,
            ),
          )
        }
      }
      let receipt = verify_consumer(root, verified, version, toolchain~)
      if receipt is Object(fields) {
        fields["deferredModules"] = Json(deferred)
      }
      write_owned_json(file, receipt, "morphir/mooncakes-consumer")
      receipt
    } else if name == "publish" {
      let plan_file = release_file(root, args.values["plan"][0])
      let report_file = release_file(root, args.values["report"][0])
      if plan_file == report_file {
        raise Refusal(
          CandidateMismatch(
            "Plan and publication report must use different files",
          ),
        )
      }
      publish_candidate(
        root,
        inspection,
        @json.parse(@fs.read_file(plan_file).text()),
        report_file,
      )
    } else {
      let mode = match args.values["mode"][0] {
        "dry-run" => DryRun
        "publish" => Publish
        text =>
          raise Refusal(
            InvalidInventory("Mode must be dry-run or publish: " + text),
          )
      }
      let candidate = Candidate::from_input(
        inspection.version.0,
        args.values["tag"][0],
        args.values["sha"][0],
        mode,
      )
      let actual = child("git", ["-C", root, "rev-parse", "HEAD"])
        .trim()
        .to_owned()
      if actual != candidate.commit.0 {
        raise Refusal(CandidateMismatch("Checkout HEAD differs from --sha"))
      }
      if !child("git", [
          "-C", root, "status", "--porcelain=v1", "--untracked-files=normal",
        ]).is_empty() {
        raise Refusal(CandidateMismatch("Candidate checkout must be clean"))
      }
      let packaged = package_sources(root, inspection)
      if packaged.commit != candidate.commit {
        raise Refusal(
          CandidateMismatch("Packaged commit differs from candidate"),
        )
      }
      let preflight = registry_preflight(root, packaged)
      let minimum = qualify_minimum(
        root,
        packaged,
        args.values["minimum-home"][0],
      )
      let plan : Json = {
        "profile": "morphir/mooncakes-plan",
        "contractVersion": "0.1.0",
        "tag": "v" + candidate.version.0,
        "sha": candidate.commit.0,
        "mode": if candidate.mode is DryRun {
          "dry-run"
        } else {
          "publish"
        },
        "inventory": inspection_json(inspection),
        "packages": package_set_json(packaged),
        "registryPreflight": preflight,
        "minimumConsumer": minimum,
      }
      write_owned_json(
        release_file(root, args.values["output"][0]),
        plan,
        "morphir/mooncakes-plan",
      )
      plan
    }
  } catch {
    error => {
      emit(name, json_mode, 1, Json::null(), error=error.to_string())
      return
    }
  }
  emit(name, json_mode, 0, result)
}

///|
test "argument library owns required plan inputs and global JSON help" {
  for
    argv in [
      ["--json", "plan", "--help"],
      ["plan", "--json", "--help"],
      ["--help", "plan", "--json"],
      ["check", "--help", "--json"],
      ["bootstrap-minimum", "--help", "--json"],
      ["check-artifacts", "--help", "--json"],
      ["qualify-artifacts", "--help", "--json"],
      ["qualify-source", "--help", "--json"],
    ] {
    let parsed = cli().parse(argv~, env=Map([]))
    assert_true(parsed.flags.get_or_default("json", false))
  }
  let invalid = try {
    ignore(cli().parse(argv=["plan", "--tag", "v0.1.0"], env=Map([])))
    false
  } catch {
    _ => true
  }
  assert_true(invalid)
  assert_true(wants_json(["check", "--unknown", "--json"]))
  assert_false(wants_json(["--", "--json"]))
  assert_false(wants_json(["--root=--json"]))
}

///|
test "public verification selects a minimum consumer without changing the producer pin" {
  let parsed = cli().parse(
    argv=["verify", "0.1.0", "--minimum-home", "compiler with spaces", "--json"],
    env=Map([]),
  )
  guard parsed.subcommand is Some(("verify", args)) else {
    fail("expected the public verification command")
  }
  assert_eq(args.values["version"], ["0.1.0"])
  assert_eq(args.values["minimum-home"], ["compiler with spaces"])
  assert_eq(args.values.get("output"), None)
}

///|
test "official manifest parser retains pins and rejects invalid configuration" {
  let parsed = decode_manifest(
    ModulePath::parse("pkgs/core"),
    (
      #|name = "finos/morphir-core"
      #|version = "0.1.0"
      #|readme = "README.md"
      #|license = "Apache-2.0"
      #|import { "moonbitlang/x@0.5.5" }
    ),
  )
  assert_eq(parsed.dependencies, { "moonbitlang/x": "0.5.5" })
  assert_eq(parsed.visibility, Open)
  let broken = refused(fn() raise Refusal {
    ignore(decode_manifest(ModulePath("pkgs/core"), "name = \"unterminated"))
  })
  assert_true(broken is Some(ManifestSyntax(_)))
  let entry = fixture_entry("pkgs/core", "finos/morphir-core")
  for
    (manifest, expected) in [
      (
        fixture_manifest("pkgs/core", "finos/morphir-core", license=None),
        MissingLicense("finos/morphir-core"),
      ),
      (
        fixture_manifest("pkgs/core", "finos/morphir-core", visibility=Private),
        PrivateModule("finos/morphir-core"),
      ),
    ] {
    assert_eq(
      refused(fn() raise Refusal {
        ignore(
          publish_order(
            [entry],
            [manifest],
            [entry.path],
            ReleaseVersion("0.1.0"),
          ),
        )
      }),
      Some(expected),
    )
  }
}

///|
async fn fixture_repository(root : String) -> Unit {
  ignore(child("git", ["init", "--quiet", root]))
  @fs.mkdir(root + "/scripts", recursive=true)
  @fs.mkdir(root + "/pkgs/core", recursive=true)
  let inventory : Json = {
    "profile": "morphir/mooncakes-inventory",
    "contractVersion": "0.1.0",
    "modules": [
      {
        "path": "pkgs/core",
        "name": "finos/morphir-core",
        "disposition": "public",
        "reason": "Test public module",
      },
    ],
  }
  @fs.write_file(
    join_host(root, "scripts/mooncakes-modules.json"),
    inventory.stringify(),
  )
  @fs.write_file(
    root + "/pkgs/core/moon.mod",
    (
      #|name = "finos/morphir-core"
      #|version = "0.1.0"
      #|readme = "README.md"
      #|license = "Apache-2.0"
    ),
  )
  @fs.write_file(root + "/pkgs/core/LICENSE", "Test fixture license")
}

///|
async test "source inspection includes new manifests and verifies declared files" {
  let root = @fs.tmpdir(prefix="morphir release source ")
  defer @fs.rmdir(root, recursive=true)
  fixture_repository(root)
  let absent = try {
    ignore(inspect(root))
    None
  } catch {
    Refusal(problem) => Some(problem)
    error => raise error
  }
  assert_eq(absent, Some(MissingReadme("finos/morphir-core")))
  @fs.write_file(root + "/pkgs/core/README.md", "Core fixture")
  assert_eq(inspect(root).ordered.map(manifest => manifest.name), [
    "finos/morphir-core",
  ])
  @fs.mkdir(root + "/new")
  @fs.write_file(root + "/new/moon.mod", "name = \"finos/morphir-new\"")
  let changed = try {
    ignore(inspect(root))
    None
  } catch {
    Refusal(problem) => Some(problem)
    error => raise error
  }
  assert_eq(changed, Some(UnclassifiedModule("new")))
}

///|
async test "command JSON help and syntax errors stay parseable without repository effects" {
  let script = @fs.realpath("mooncakes-release.mbtx")
  for
    (args, expected, state) in [
      (["--json", "--help"], 0, "succeeded"),
      (["plan", "--help", "--json"], 0, "succeeded"),
      (["--help", "plan", "--json"], 0, "succeeded"),
      (["verify", "--help", "--json"], 0, "succeeded"),
      (
        [
          "verify", "--minimum-home", "missing compiler with spaces", "--help", "--json",
        ],
        0,
        "succeeded",
      ),
      (["publish", "--help", "--json"], 0, "succeeded"),
      (["inventory", "--help", "--json"], 0, "succeeded"),
      (["identity", "--help", "--json"], 0, "succeeded"),
      (["workflow", "--help", "--json"], 0, "succeeded"),
      (["gate-ci", "--help", "--json"], 0, "succeeded"),
      (["gate-qualification", "--help", "--json"], 0, "succeeded"),
      (["gate-needs", "--help", "--json"], 0, "succeeded"),
      (["check-artifacts", "--help", "--json"], 0, "succeeded"),
      (["qualify-artifacts", "--help", "--json"], 0, "succeeded"),
      (["qualify-source", "--help", "--json"], 0, "succeeded"),
      (["qualify-source", "--plan", "must-not-read", "--json"], 2, "failed"),
      (["qualify-source", "--output", "--json"], 2, "failed"),
      (
        [
          "check-artifacts", "--plan", ".dev/mooncakes-release/missing-retained-plan.json",
          "--json",
        ],
        1,
        "failed",
      ),
      (["plan", "--json"], 2, "failed"),
      (["verify", "--json"], 2, "failed"),
      (["verify", "0.1.0", "--minimum-home", "--json"], 2, "failed"),
      (["workflow", "--json"], 2, "failed"),
      (["gate-ci", "--json"], 2, "failed"),
      (["gate-qualification", "--json"], 2, "failed"),
      (["check", "--unknown", "--json"], 2, "failed"),
      (["--unknown", "--json"], 2, "failed"),
    ] {
    let (code, output, stderr) = @process.collect_output(
      "moonx",
      [script, ..args],
    )
    assert_eq(code, expected, msg=stderr.text())
    let result = @json.parse(output.text())
    assert_eq(string_field(result, "state"), Some(state))
    assert_false(output.text().contains("Downloading"))
  }
}

///|
fn fixture_archive(
  files : Array[(String, Bytes)],
  mtime~ : Int32 = 0,
) -> Bytes raise {
  let archive = @zipc.Archive::empty()
  for (path, data) in files {
    ignore(
      archive.add(
        @zipc.Member::make(
          path,
          File(@zipc.File::stored_from_bytes(data)),
          mtime~,
        ),
      ),
    )
  }
  archive.to_bytes()
}

///|
fn fixture_archive_files() -> Array[(String, Bytes)] {
  [
    (
      "moon.mod",
      @utf8.encode(
        "name = \"finos/morphir-core\"\nversion = \"0.1.0\"\nreadme = \"README.md\"\nlicense = \"Apache-2.0\"",
      ),
    ),
    ("LICENSE", b"Fixture license"),
    ("README.md", b"Core fixture"),
    ("moon.pkg", b"options(\"native-stub\": [\"native.c\"] )"),
    ("native.c", b"/* Fixture native asset */"),
  ]
}

///|
test "archive content proof ignores timestamps and detects changed source bytes" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let files = fixture_archive_files()
  let first = inspect_archive(
    manifest,
    fixture_archive(files, mtime=@zipc.dos_epoch),
  )
  let second = inspect_archive(
    manifest,
    fixture_archive(files.rev(), mtime=@zipc.dos_epoch + 1000),
  )
  assert_eq(first.content_sha256, second.content_sha256)
  assert_true(first.archive_sha256 != second.archive_sha256)
  assert_eq(first.files, 5)
  assert_true(first.bytes > 0)
  let changed = files.map(entry => {
    if entry.0 == "native.c" {
      (entry.0, b"/* Changed */")
    } else {
      entry
    }
  })
  assert_true(
    inspect_archive(manifest, fixture_archive(changed)).content_sha256 !=
    first.content_sha256,
  )
}

///|
test "archive inspection refuses absent README license and native assets" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  for missing in ["README.md", "LICENSE", "native.c"] {
    let files = fixture_archive_files().filter(entry => entry.0 != missing)
    let problem = try {
      ignore(inspect_archive(manifest, fixture_archive(files)))
      None
    } catch {
      Refusal(problem) => Some(problem)
      error => raise error
    }
    assert_true(problem is Some(ArchiveInvalid(_)))
  }
  let files = fixture_archive_files()
  files.push(("node_modules/dependency/index.js", b"unrelated build payload"))
  let problem = try {
    ignore(inspect_archive(manifest, fixture_archive(files)))
    None
  } catch {
    Refusal(problem) => Some(problem)
    error => raise error
  }
  assert_true(problem is Some(ArchiveInvalid(_)))
}

///|
test "compiler concurrency spelling retains strict package and native asset checks" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let config = "max_concurrent_tests = 1\noptions(\"native-stub\": [\"native.c\"])\n"
  let files = fixture_archive_files().map(entry => {
    if entry.0 == "moon.pkg" {
      (entry.0, @utf8.encode(config))
    } else {
      entry
    }
  })
  ignore(inspect_archive(manifest, fixture_archive(files)))
  let missing = files.filter(entry => entry.0 != "native.c")
  let refused = try {
    ignore(inspect_archive(manifest, fixture_archive(missing)))
    false
  } catch {
    Refusal(ArchiveInvalid(message)) =>
      message == "Missing native stub: native.c"
    error => raise error
  }
  assert_true(refused)
  for
    invalid in [
      "max_concurrent_tests = \"1\"", "max_concurrent_tests = 0", "max_concurrent_tests = -1",
      "max_concurrent_tests = 1.5", "max_concurrent_tests = 2147483648", "max_concurrent_tests = 1\nmax_concurrent_tests = 2",
      "max_concurrent_tests = 1\noptions(\"max-concurrent-tests\": 2)", "max_concurrent_tests = 1\nunknown_option = true",
      "max_concurrent_tests = 1\noptions(", "max_concurrent_tests = 1\noptions(\"native-stub\": 42)",
    ] {
    let files = fixture_archive_files().map(entry => {
      if entry.0 == "moon.pkg" {
        (entry.0, @utf8.encode(invalid))
      } else {
        entry
      }
    })
    let refused = try {
      ignore(inspect_archive(manifest, fixture_archive(files)))
      false
    } catch {
      Refusal(ArchiveInvalid(_)) => true
      error => raise error
    }
    assert_true(refused, msg=invalid)
  }
}

///|
test "conditional imports retain strict package and native asset checks" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let accepted = [
    "import {\n  \"moonbitlang/core/env\",\n}\n\n// Only native calls @sys.exit.\n#cfg(not(target=\"js\"))\nimport {\n  \"moonbitlang/x/sys\",\n}\n\noptions(\"native-stub\": [\"native.c\"])\n",
    "#cfg(all(target=\"native\", platform=\"windows\"))\nimport {\n  \"moonbitlang/x/sys\",\n}\noptions(\"native-stub\": [\"native.c\"])\n",
  ]
  for config in accepted {
    let files = fixture_archive_files().map(entry => {
      if entry.0 == "moon.pkg" {
        (entry.0, @utf8.encode(config))
      } else {
        entry
      }
    })
    ignore(inspect_archive(manifest, fixture_archive(files)))
    let missing = files.filter(entry => entry.0 != "native.c")
    let refused = try {
      ignore(inspect_archive(manifest, fixture_archive(missing)))
      false
    } catch {
      Refusal(ArchiveInvalid(message)) =>
        message == "Missing native stub: native.c"
      error => raise error
    }
    assert_true(refused, msg=config)
  }
  let parsed = archive_package_config("moon.pkg", accepted[0])
  guard parsed is Object(fields) &&
    fields.get("import") is Some(Array(base)) &&
    fields.get("conditional-import") is Some(Array([conditional])) &&
    conditional is Object(entry) else {
    fail("Conditional import is not retained: " + parsed.stringify())
  }
  assert_eq(base.length(), 1)
  assert_eq(entry.get("cfg"), Some(Json::string("not(target=\"js\")")))
  assert_true(entry.get("import") is Some(Array([_])))
  for
    invalid in [
      "#cfg(not(target=\"js\"))\n", "#cfg(not(target=\"js\"))\noptions(\"native-stub\": [\"native.c\"])\n",
      "#cfg(not(target=\"js\")\nimport {\n  \"moonbitlang/x/sys\",\n}\n", "#cfg()\nimport {\n  \"moonbitlang/x/sys\",\n}\n",
      "#cfg(not(target=\"js\"))\nimport {\n  \"moonbitlang/x/sys\",\n", "#cfg(not(target=\"js\"))\nimport {\n  42,\n}\n",
      "#cfg(not(target=\"js\"))\n#cfg(target=\"native\")\nimport {\n  \"moonbitlang/x/sys\",\n}\n",
      "#deprecated\nimport {\n  \"moonbitlang/x/sys\",\n}\n", "#cfg(not(target=\"js\")) import {\n  \"moonbitlang/x/sys\",\n}\n",
      "#cfg(not(target=\"js\"))\nimport {\n  \"moonbitlang/x/sys\",\n} unknown_option = true\n",
    ] {
    let files = fixture_archive_files().map(entry => {
      if entry.0 == "moon.pkg" {
        (entry.0, @utf8.encode(invalid))
      } else {
        entry
      }
    })
    let refused = try {
      ignore(inspect_archive(manifest, fixture_archive(files)))
      false
    } catch {
      Refusal(ArchiveInvalid(_)) => true
      error => raise error
    }
    assert_true(refused, msg=invalid)
  }
}

///|
test "public modules must select a target when the default backend is unsupported" {
  let path = ModulePath::parse("pkgs/native")
  let header = "name = \"finos/morphir-native\"\nversion = \"0.1.0\"\n"
  // The v0.1.0 workbench-native manifest: moon publish checks it on the
  // default backend and Moon refuses the native-only module.
  let native_only = decode_manifest(
    path,
    header + "supported_targets = \"native\"\n",
  )
  assert_eq(native_only.supported_targets, Some(["native"]))
  assert_eq(native_only.preferred_target, None)
  assert_true(
    refused(() => require_default_backend(native_only))
    is Some(ManifestSyntax(_)),
  )
  for
    accepted in [
      "", "supported_targets = \"js+native+wasm+wasm-gc\"\n", "preferred_target = \"native\"\nsupported_targets = \"native\"\n",
      "preferred_target = \"native\"\nsupported_targets = \"native+wasm\"\n",
    ] {
    require_default_backend(decode_manifest(path, header + accepted))
  }
  for
    invalid in [
      "preferred_target = \"js\"\nsupported_targets = \"native\"\n", "supported_targets = \"\"\n",
      "supported_targets = \"native+riscv\"\n", "preferred_target = \"riscv\"\n",
    ] {
    assert_true(
      refused(() => {
        require_default_backend(decode_manifest(path, header + invalid))
      })
      is Some(ManifestSyntax(_)),
      msg=invalid,
    )
  }
}

///|
async test "isolated archive check runs the default-backend package step of moon publish" {
  let root = @fs.tmpdir(prefix="morphir default backend ")
  defer @fs.rmdir(root, recursive=true)
  let native_only = fixture_archive_files().map(entry => {
    if entry.0 == "moon.mod" {
      (
        entry.0,
        @utf8.encode(
          "name = \"finos/morphir-core\"\nversion = \"0.1.0\"\nreadme = \"README.md\"\nlicense = \"Apache-2.0\"\nsupported_targets = \"native\"\n",
        ),
      )
    } else {
      entry
    }
  })
  native_only.push(("answer.mbt", b"pub fn answer() -> Int { 42 }\n"))
  let bytes = fixture_archive(native_only)
  @fs.write_file(join_host(root, "archive.zip"), bytes)
  let manifest = fixture_manifest(
    "pkgs/core",
    "finos/morphir-core",
    supported_targets=Some(["native"]),
  )
  let record : PackagedModule = {
    manifest,
    archive_path: "archive.zip",
    evidence: inspect_archive(manifest, bytes),
  }
  let message = try {
    ignore(verify_archive_graph(root, [record]))
    ""
  } catch {
    Refusal(ArchiveInvalid(message)) => message
    error => raise error
  }
  assert_eq(
    message, "Isolated archive cannot be packaged as moon publish does: finos/morphir-core",
  )
}

///|
test "verification defers only absent public modules that nothing verified needs" {
  let version = ReleaseVersion::parse("0.1.0")
  let session = fixture_manifest("pkgs/session", "finos/morphir-session")
  let workbench = fixture_manifest(
    "apps/workbench",
    "finos/morphir-workbench",
    dependencies={ "finos/morphir-session": "0.1.0" },
  )
  let native = fixture_manifest("pkgs/native", "finos/morphir-native", dependencies={
    "finos/morphir-workbench": "0.1.0",
  })
  let inspection : Inspection = {
    version,
    ordered: [session, workbench, native],
    inventory: [],
  }
  assert_eq(
    deferred_inspection(inspection, []).ordered.map(manifest => manifest.name),
    ["finos/morphir-session", "finos/morphir-workbench", "finos/morphir-native"],
  )
  assert_eq(
    deferred_inspection(inspection, ["finos/morphir-native"]).ordered.map(manifest => {
      manifest.name
    }),
    ["finos/morphir-session", "finos/morphir-workbench"],
  )
  for
    invalid in [
      ["finos/morphir-workbench"],
      ["finos/morphir-unknown"],
      ["finos/morphir-native", "finos/morphir-native"],
      [
        "finos/morphir-session", "finos/morphir-workbench", "finos/morphir-native",
      ],
    ] {
    assert_true(
      refused(() => ignore(deferred_inspection(inspection, invalid)))
      is Some(CandidateMismatch(_)),
      msg=invalid.join(","),
    )
  }
  require_deferred_absent("finos/morphir-native", Absent)
  for state in [Present("abc"), Transient(503), Rejected(403), Unavailable] {
    assert_true(
      refused(() => require_deferred_absent("finos/morphir-native", state))
      is Some(CandidateMismatch(_)),
    )
  }
}
