  "moonbitlang/core/encoding/utf8",
  "moonbitlang/moon_config@0.4.4" @manifest_parser,
  "moonbitlang/lexer@0.4.4/basic",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/os_error",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/async@0.22.7/http",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/path/posix",
  "moonbitlang/x@0.5.5/path" @host_path,
  "moonbitstack/moonsver@0.1.0" @semver,
  "moonbit-community/zipc@0.2.2",
  "moonrockz/ion@0.6.0/binary",
  "moonrockz/ion@0.6.0/json" @ion_json,
}
----

///|
#derive(Eq, Debug)
enum Disposition {
  Public
  Excluded
}

///|
#derive(Eq, Debug)
struct ModulePath(String)

///|
#derive(Eq, Debug)
struct ReleaseVersion(String)

///|
#derive(Eq, Debug)
struct CommitId(String)

///|
#derive(Eq, Debug)
enum ReleaseMode {
  DryRun
  Publish
}

///|
fn ReleaseMode::parse(text : String) -> ReleaseMode raise {
  match text {
    "dry-run" => DryRun
    "publish" => Publish
    _ => raise Refusal(CandidateMismatch("Mode must be dry-run or publish"))
  }
}

///|
#derive(Eq, Debug)
struct Candidate {
  version : ReleaseVersion
  commit : CommitId
  mode : ReleaseMode
}

///|
#derive(Eq, Debug)
enum Problem {
  InvalidPath(String)
  InvalidVersion(String)
  DuplicatePath(String)
  DuplicateName(String)
  UnclassifiedModule(String)
  MissingModule(String)
  IdentityMismatch(String)
  VersionMismatch(String)
  MissingReadme(String)
  InternalDependency(String, String)
  DependencyVersion(String, String)
  Cycle(Array[String])
  InvalidInventory(String)
  InvalidCommit(String)
  TagMismatch(String)
  ManifestSyntax(String)
  MissingLicense(String)
  PrivateModule(String)
  CandidateMismatch(String)
  ArchiveInvalid(String)
}

///|
#derive(Debug)
suberror Refusal {
  Refusal(Problem)
}

///|
impl Show for Refusal with fn output(self, logger) {
  let Refusal(problem) = self
  logger.write_string(@debug.to_string(problem))
}

///|
#derive(Eq, Debug)
struct WorkflowRun {
  id : String
  attempt : String
}

///|
#derive(Eq, Debug)
enum CiState {
  Missing
  Pending
  Passed(WorkflowRun)
  Failed(String)
}

///|
fn object_field(value : Json, name : String) -> Json? {
  match value {
    Object(fields) => fields.get(name)
    _ => None
  }
}

///|
fn decimal_id(value : Json) -> String raise {
  match value {
    String(text) if !text.is_empty() &&
      text != "0" &&
      !text.has_prefix("0") &&
      text.iter().all(c => c >= '0' && c <= '9') => text
    Number(number, ..) if number >= 1 &&
      number <= 9007199254740991.0 &&
      number.floor() == number => number.to_int64().to_string()
    _ =>
      raise Refusal(CandidateMismatch("Invalid GitHub run or attempt identity"))
  }
}

///|
fn exact_ci(value : Json, commit : CommitId) -> CiState raise {
  guard object_field(value, "workflow_runs") is Some(Array(runs)) else {
    raise Refusal(CandidateMismatch("GitHub returned no workflow run list"))
  }
  for run in runs {
    let repository = match object_field(run, "repository") {
      Some(value) => string_field(value, "full_name")
      None => None
    }
    let head_repository = match object_field(run, "head_repository") {
      Some(value) => string_field(value, "full_name")
      None => None
    }
    let path = string_field(run, "path")
    if repository != Some("finos/morphir-moonbit") ||
      head_repository != repository ||
      string_field(run, "event") != Some("push") ||
      string_field(run, "head_branch") != Some("main") ||
      string_field(run, "head_sha") != Some(commit.0) ||
      !(path == Some(".github/workflows/ci.yml") ||
      path == Some(".github/workflows/ci.yml@refs/heads/main") ||
      path == Some(".github/workflows/ci.yml@main")) {
      continue
    }
    match string_field(run, "status") {
      Some("queued" | "in_progress" | "waiting" | "pending" | "requested") =>
        return Pending
      Some("completed") => {
        if string_field(run, "conclusion") != Some("success") {
          return Failed("Main push CI did not succeed")
        }
        return Passed({
          id: decimal_id(object_field(run, "id").unwrap_or(Json::null())),
          attempt: decimal_id(
            object_field(run, "run_attempt").unwrap_or(Json::null()),
          ),
        })
      }
      _ => return Failed("Main push CI reported an unknown state")
    }
  }
  Missing
}

///|
fn require_ci_job(
  jobs : Array[Json],
  run : WorkflowRun,
  commit : CommitId,
) -> Unit raise {
  let aggregate = jobs.filter(job => string_field(job, "name") == Some("ci-ok"))
  guard aggregate is [job] &&
    string_field(job, "head_sha") == Some(commit.0) &&
    decimal_id(object_field(job, "run_id").unwrap_or(Json::null())) == run.id &&
    string_field(job, "status") == Some("completed") &&
    string_field(job, "conclusion") == Some("success") else {
    raise Refusal(
      CandidateMismatch("Exact main-push run has no successful ci-ok aggregate"),
    )
  }
}

///|
async fn github_api(path : String) -> Json {
  @async.with_timeout(30000, () => {
    let (code, output, _) = @process.collect_output("gh", [
      "api", "--method", "GET", path,
    ])
    if code != 0 {
      raise Refusal(
        CandidateMismatch(
          "GitHub evidence API is unavailable; publication remains blocked",
        ),
      )
    }
    @json.parse(output.text())
  })
}

///|
async fn gate_ci(commit : CommitId) -> Json {
  let base = "repos/finos/morphir-moonbit/actions/"
  for attempt in 0..<121 {
    let response = github_api(
      base +
      "workflows/ci.yml/runs?branch=main&event=push&head_sha=" +
      commit.0 +
      "&per_page=100",
    )
    match exact_ci(response, commit) {
      Passed(run) => {
        let jobs : Array[Json] = []
        for page in 1..<=10 {
          let response = github_api(
            base +
            "runs/" +
            run.id +
            "/attempts/" +
            run.attempt +
            "/jobs?per_page=100&page=" +
            page.to_string(),
          )
          guard object_field(response, "jobs") is Some(Array(items)) &&
            object_field(response, "total_count") is Some(Number(total, ..)) &&
            total >= 0 &&
            total <= 1000 else {
            raise Refusal(
              CandidateMismatch(
                "GitHub CI job evidence exceeds the bounded page contract",
              ),
            )
          }
          jobs.append(items)
          if jobs.length().to_double() >= total {
            break
          }
          if items.is_empty() {
            raise Refusal(
              CandidateMismatch("GitHub CI job evidence is incomplete"),
            )
          }
        }
        require_ci_job(jobs, run, commit)
        return {
          "profile": "morphir/mooncakes-ci-gate",
          "contractVersion": "0.1.0",
          "repository": "finos/morphir-moonbit",
          "sha": commit.0,
          "workflow": ".github/workflows/ci.yml",
          "event": "push",
          "branch": "main",
          "runId": run.id,
          "runAttempt": run.attempt,
          "aggregate": "ci-ok",
          "state": "succeeded",
        }
      }
      Failed(message) => raise Refusal(CandidateMismatch(message))
      Missing | Pending => {
        if attempt == 120 {
          break
        }
        @async.sleep(10000)
      }
    }
  }
  raise Refusal(
    CandidateMismatch(
      "Successful exact main-push CI was not available within 20 minutes",
    ),
  )
}

///|
fn require_qualification(
  value : Json,
  commit : CommitId,
  run : WorkflowRun,
  required : Array[String],
) -> Unit raise {
  guard object_field(value, "profile") ==
    Some(Json("morphir-ci-qualification-v2")) &&
    string_field(value, "repository") == Some("finos/morphir-moonbit") &&
    string_field(value, "revision") == Some(commit.0) &&
    string_field(value, "runId") == Some(run.id) &&
    string_field(value, "runAttempt") == Some(run.attempt) &&
    string_field(value, "macos") == Some("run") &&
    object_field(value, "macosEvidence") == Some(Json::null()) &&
    !required.is_empty() &&
    object_field(value, "requiredJobs") == Some(Json(required)) &&
    object_field(value, "results") is Some(Object(results)) else {
    raise Refusal(
      CandidateMismatch(
        "Fresh exact-candidate macos:run v2 qualification receipt is required for this workflow attempt",
      ),
    )
  }
  for name in required {
    guard results.get(name) is Some(result) &&
      string_field(result, "result") == Some("success") else {
      raise Refusal(
        CandidateMismatch(
          "Qualification has missing, skipped or failed required job: " + name,
        ),
      )
    }
  }
}

///|
async fn gate_qualification(
  root : String,
  receipt_file : String,
  commit : CommitId,
) -> Json {
  let bytes = @fs.read_file(receipt_file).binary()
  let receipt = @ion_json.to_json(@binary.read_binary_value(bytes[:]))
  let run : WorkflowRun = {
    id: decimal_id(Json(@env.get_env_var("GITHUB_RUN_ID").unwrap_or(""))),
    attempt: decimal_id(
      Json(@env.get_env_var("GITHUB_RUN_ATTEMPT").unwrap_or("")),
    ),
  }
  let definition = @json.parse(
    child("moonx", [
      join_host(root, "scripts/ci-gate.mbtx"),
      "--qualification-jobs",
      "--json",
    ]),
  )
  guard object_field(definition, "base") is Some(Array(base)) &&
    object_field(definition, "macos") is Some(Array(macos)) &&
    !macos.is_empty() else {
    raise Refusal(
      CandidateMismatch("Qualification job definition is unavailable"),
    )
  }
  let required = (base + macos).map(value => {
    match value {
      String(name) => name
      _ => raise Refusal(CandidateMismatch("Invalid qualification job name"))
    }
  })
  require_qualification(receipt, commit, run, required)
  {
    "profile": "morphir/mooncakes-qualification-gate",
    "contractVersion": "0.1.0",
    "sha": commit.0,
    "runId": run.id,
    "runAttempt": run.attempt,
    "receiptSha256": digest(bytes),
    "macos": "run",
    "requiredJobs": required,
    "state": "succeeded",
  }
}

///|
fn workflow_identity(
  version : ReleaseVersion,
  commit : CommitId,
  mode : ReleaseMode,
  repository : String,
  event : String,
  reference : String,
  event_sha : String,
) -> Candidate raise {
  if repository != "finos/morphir-moonbit" ||
    !["push", "workflow_dispatch"].contains(event) ||
    event_sha != commit.0 {
    raise Refusal(
      CandidateMismatch(
        "Workflow context differs from the checked-out release candidate",
      ),
    )
  }
  if mode is Publish && reference != "refs/tags/v" + version.0 {
    raise Refusal(
      CandidateMismatch(
        "Live publication must run on the actual matching release tag; a tag input on main cannot authorize it",
      ),
    )
  }
  { version, commit, mode, }
}

///|
fn require_release_needs(value : Json) -> Unit raise {
  for name in ["plan", "ci", "qualification", "headless"] {
    guard object_field(value, name) is Some(job) &&
      string_field(job, "result") == Some("success") else {
      raise Refusal(
        CandidateMismatch("Release prerequisite did not succeed: " + name),
      )
    }
  }
}

///|
test "publisher refuses missing failed cancelled and skipped prerequisites" {
  let successful : Json = {
    "plan": { "result": "success" },
    "ci": { "result": "success" },
    "qualification": { "result": "success" },
    "headless": { "result": "success" },
  }
  require_release_needs(successful)
  guard successful is Object(fields) else { fail("Expected prerequisites") }
  for name in ["plan", "ci", "qualification", "headless"] {
    for state in ["failure", "cancelled", "skipped", "pending"] {
      let changed = fields.copy()
      changed[name] = { "result": state }
      let refused = try {
        require_release_needs(Json(changed))
        false
      } catch {
        _ => true
      }
      assert_true(refused)
    }
    let changed = fields.copy()
    changed.remove(name)
    let refused = try {
      require_release_needs(Json(changed))
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}

///|
async fn workflow_candidate(
  root : String,
  inspection : Inspection,
  mode : ReleaseMode,
  github_output : Bool,
) -> Json {
  let commit = CommitId::parse(
    child("git", ["-C", root, "rev-parse", "HEAD"]).trim().to_owned(),
  )
  let candidate = workflow_identity(
    inspection.version,
    commit,
    mode,
    @env.get_env_var("GITHUB_REPOSITORY").unwrap_or(""),
    @env.get_env_var("GITHUB_EVENT_NAME").unwrap_or(""),
    @env.get_env_var("GITHUB_REF").unwrap_or(""),
    @env.get_env_var("GITHUB_SHA").unwrap_or(""),
  )
  if candidate.mode is Publish {
    ignore(
      child("git", [
        "-C",
        root,
        "merge-base",
        "--is-ancestor",
        candidate.commit.0,
        "origin/main",
      ]),
    )
  }
  let mode = if candidate.mode is Publish { "publish" } else { "dry-run" }
  if github_output {
    let file = @env.get_env_var("GITHUB_OUTPUT").unwrap_or("")
    if file.is_empty() {
      raise Refusal(CandidateMismatch("GITHUB_OUTPUT is unavailable"))
    }
    @fs.write_file(
      file,
      "sha=" +
      candidate.commit.0 +
      "\ntag=v" +
      candidate.version.0 +
      "\nversion=" +
      candidate.version.0 +
      "\nmode=" +
      mode +
      "\n",
      create_mode=OpenExisting,
      append=true,
    )
  }
  {
    "sha": candidate.commit.0,
    "tag": "v" + candidate.version.0,
    "version": candidate.version.0,
    "mode": mode,
  }
}

///|
fn fixture_ci_run(commit : CommitId) -> Json {
  {
    "id": 42,
    "run_attempt": 1,
    "path": ".github/workflows/ci.yml",
    "repository": { "full_name": "finos/morphir-moonbit" },
    "head_repository": { "full_name": "finos/morphir-moonbit" },
    "head_sha": commit.0,
    "head_branch": "main",
    "event": "push",
    "status": "completed",
    "conclusion": "success",
  }
}

///|
test "release CI accepts only the exact repository main push workflow and successful aggregate" {
  let commit = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  let value = fixture_ci_run(commit)
  let run : WorkflowRun = { id: "42", attempt: "1", }
  assert_eq(exact_ci({ "workflow_runs": [value] }, commit), Passed(run))
  guard value is Object(fields) else { fail("Expected fixture object") }
  for
    (key, wrong) in [
      ("head_sha", Json("1123456789abcdef0123456789abcdef01234567")),
      ("head_branch", Json("feature")),
      ("event", Json("pull_request")),
      ("path", Json(".github/workflows/nightly-qualification.yml")),
      ("head_repository", Json({ "full_name": "fork/morphir-moonbit" })),
    ] {
    let changed = fields.copy()
    changed[key] = wrong
    assert_eq(exact_ci({ "workflow_runs": [Json(changed)] }, commit), Missing)
  }
  for status in ["queued", "in_progress", "waiting"] {
    let changed = fields.copy()
    changed["status"] = Json(status)
    assert_eq(exact_ci({ "workflow_runs": [Json(changed)] }, commit), Pending)
  }
  let job : Json = {
    "name": "ci-ok",
    "run_id": 42,
    "head_sha": commit.0,
    "status": "completed",
    "conclusion": "success",
  }
  require_ci_job([job], run, commit)
  guard job is Object(job_fields) else { fail("Expected job") }
  for conclusion in ["failure", "cancelled", "skipped", "neutral"] {
    let changed = fields.copy()
    changed["conclusion"] = Json(conclusion)
    assert_true(
      exact_ci({ "workflow_runs": [Json(changed), value] }, commit) is Failed(_),
    )
    let changed_job = job_fields.copy()
    changed_job["conclusion"] = Json(conclusion)
    let refused = try {
      require_ci_job([Json(changed_job)], run, commit)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
  let absent = try {
    require_ci_job([], run, commit)
    false
  } catch {
    _ => true
  }
  assert_true(absent)
}

///|
test "qualification requires fresh current-attempt v2 evidence and every macOS run job" {
  let commit = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  let run : WorkflowRun = { id: "42", attempt: "2", }
  let required = ["plan", "native", "macos-native"]
  let value : Json = {
    "profile": "morphir-ci-qualification-v2",
    "repository": "finos/morphir-moonbit",
    "revision": commit.0,
    "runId": "42",
    "runAttempt": "2",
    "macos": "run",
    "macosEvidence": Json::null(),
    "requiredJobs": required,
    "results": {
      "plan": { "result": "success" },
      "native": { "result": "success" },
      "macos-native": { "result": "success" },
    },
  }
  require_qualification(value, commit, run, required)
  let encoded = @binary.write_binary_value(@ion_json.Ion(value))
  let decoded = @ion_json.to_json(@binary.read_binary_value(encoded[:]))
  require_qualification(decoded, commit, run, required)
  guard value is Object(fields) else { fail("Expected receipt") }
  let invalids : Array[(String, Json)] = [
    ("profile", "morphir-ci-qualification-v1"),
    ("revision", "1123456789abcdef0123456789abcdef01234567"),
    ("repository", "fork/morphir-moonbit"),
    ("runId", "41"),
    ("runAttempt", "1"),
    ("macos", "reuse"),
    ("macos", "skip"),
    ("macosEvidence", { "fingerprint": "old" }),
    ("requiredJobs", ["plan", "native"]),
    (
      "results",
      { "plan": { "result": "success" }, "native": { "result": "success" } },
    ),
  ]
  for (key, invalid) in invalids {
    let changed = fields.copy()
    changed[key] = invalid
    let refused = try {
      require_qualification(Json(changed), commit, run, required)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
  for state in ["failure", "cancelled", "skipped"] {
    let changed = fields.copy()
    changed["results"] = {
      "plan": { "result": "success" },
      "native": { "result": "success" },
      "macos-native": { "result": state },
    }
    let refused = try {
      require_qualification(Json(changed), commit, run, required)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}

///|
test "a tag parameter on main cannot authorize a release" {
  let version = ReleaseVersion::parse("0.1.0")
  let commit = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  ignore(
    workflow_identity(
      version,
      commit,
      DryRun,
      "finos/morphir-moonbit",
      "workflow_dispatch",
      "refs/heads/main",
      commit.0,
    ),
  )
  ignore(
    workflow_identity(
      version,
      commit,
      Publish,
      "finos/morphir-moonbit",
      "push",
      "refs/tags/v0.1.0",
      commit.0,
    ),
  )
  for
    (repository, event, reference, sha) in [
      (
        "finos/morphir-moonbit",
        "workflow_dispatch",
        "refs/heads/main",
        commit.0,
      ),
      ("finos/morphir-moonbit", "push", "refs/tags/v0.2.0", commit.0),
      ("finos/morphir-moonbit", "pull_request", "refs/tags/v0.1.0", commit.0),
      ("fork/morphir-moonbit", "push", "refs/tags/v0.1.0", commit.0),
      (
        "finos/morphir-moonbit", "push", "refs/tags/v0.1.0", "1123456789abcdef0123456789abcdef01234567",
      ),
    ] {
    let refused = try {
      ignore(
        workflow_identity(
          version,
          commit,
          Publish,
          repository,
          event,
          reference,
          sha,
        ),
      )
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}

///|
test "refusal output retains the actionable problem" {
  let error : Error = Refusal(
    CandidateMismatch("Compiler must match source pin"),
  )
  assert_true(error.to_string().contains("Compiler must match source pin"))
}

///|
#derive(Eq, Debug)
struct InventoryEntry {
  path : ModulePath
  name : String
  disposition : Disposition
  reason : String
}

///|
#derive(Eq, Debug)
struct Manifest {
  path : ModulePath
  name : String
  version : String
  dependencies : Map[String, String]
  readme : String?
  license : String?
  visibility : Visibility
  supported_targets : Array[String]?
  preferred_target : String?
}

///|
#derive(Eq, Debug)
enum Visibility {
  Open
  Private
}

///|
struct Inspection {
  inventory : Array[InventoryEntry]
  ordered : Array[Manifest]
  version : ReleaseVersion
}

///|
struct ArchiveEvidence {
  archive_sha256 : String
  content_sha256 : String
  bytes : Int32
  files : Int32
}

///|
struct PackagedModule {
  manifest : Manifest
  archive_path : String
  evidence : ArchiveEvidence
}

///|
struct PackageSet {
  commit : CommitId
  compiler : String
  core_pin_sha256 : String
  packages : Array[PackagedModule]
  isolated_targets : Array[String]
}

///|
#derive(Eq, Debug)
enum RegistryState {
  Absent
  Present(String)
  Transient(Int32)
  Rejected(Int32)
  Unavailable
}

///|
#derive(Eq)
enum RegistryCheck {
  EvidenceOnly
  Resolvable
}

///|
enum RegistryPhase {
  Metadata
  Archive
}

///|
enum RegistryDownload {
  ArchiveBytes(Bytes)
  ArchiveState(RegistryState)
}

///|
fn registry_archive_location(manifest : Manifest, location : String) -> String? {
  let path = "/user/" + manifest.name + "/" + manifest.version + ".zip"
  let primary = "https://download.mooncakes.io" + path
  let cdn = "https://d251robtodj7m8.cloudfront.net" + path
  if location == path || location == primary {
    Some(primary)
  } else if location == cdn {
    Some(cdn)
  } else {
    None
  }
}

///|
test "registry redirects preserve exact public origin and archive identity" {
  let manifest = fixture_manifest("pkgs/morphir-core", "finos/morphir-core")
  let path = "/user/finos/morphir-core/0.1.0.zip"
  assert_eq(
    registry_archive_location(manifest, path),
    Some("https://download.mooncakes.io" + path),
  )
  assert_eq(
    registry_archive_location(
      manifest,
      "https://d251robtodj7m8.cloudfront.net" + path,
    ),
    Some("https://d251robtodj7m8.cloudfront.net" + path),
  )
  for
    location in [
      "http://download.mooncakes.io" + path,
      "https://other.example" + path,
      "//download.mooncakes.io" + path,
      "https://download.mooncakes.io@other.example" + path,
      "https://download.mooncakes.io" + path + "?token=anything",
      "/user/finos/morphir-core/0.2.0.zip",
    ] {
    assert_eq(registry_archive_location(manifest, location), None)
  }
}

///|
fn registry_http_status(
  phase : RegistryPhase,
  status : Int32,
) -> RegistryState? {
  match status {
    200 => None
    404 =>
      Some(
        match phase {
          Metadata => Absent
          Archive => Transient(425)
        },
      )
    408 | 425 | 429 | 500 | 502 | 503 | 504 => Some(Transient(status))
    _ => Some(Rejected(status))
  }
}

///|
test "an occupied version with a missing download is not available for upload" {
  assert_eq(registry_http_status(Metadata, 404), Some(Absent))
  assert_eq(registry_http_status(Archive, 404), Some(Transient(425)))
  assert_eq(
    availability("hash", registry_http_status(Archive, 404).unwrap()),
    Unverified,
  )
  assert_eq(registry_http_status(Archive, 200), None)
  assert_eq(registry_http_status(Metadata, 403), Some(Rejected(403)))
}

///|
#derive(Eq, Debug)
enum Availability {
  Available
  Identical
  Conflict
  Unverified
}

///|
fn availability(expected : String, observation : RegistryState) -> Availability {
  match observation {
    Absent => Available
    Present(actual) if actual == expected => Identical
    Present(_) => Conflict
    _ => Unverified
  }
}

///|
#derive(Eq, Debug)
enum PublicationState {
  Published
  VerifiedExisting
  Failed(String)
  NotAttempted
}

///|
#derive(Eq, Debug)
struct Publication {
  name : String
  state : PublicationState
}

///|
// Upload is invoked at most once per module. Only read-only registry visibility
// and explicitly transient reads are retried. Auth and opaque publish errors
// cannot trigger another upload. Existing versions require byte-identical
// downloaded evidence, never an error-message guess or a lossy ZIP comparison.
async fn publish_sequence(
  mode : ReleaseMode,
  modules : Array[(String, String)],
  observe : async (String) -> RegistryState,
  upload : async (String) -> Int32,
  save : async (Array[Publication]) -> Unit,
  pause : async (Int32) -> Unit,
) -> Array[Publication] {
  if mode is DryRun {
    raise Refusal(CandidateMismatch("A dry-run plan cannot publish"))
  }
  let outcomes = modules.map(pair => Publication::{
    name: pair.0,
    state: NotAttempted,
  })
  save(outcomes)
  // Check the entire inventory before the first upload. This prevents a
  // known conflict in a later consumer from causing avoidable partial release.
  for index, (name, expected) in modules {
    match availability(expected, poll_registry(name, false, observe, pause)) {
      Available => ()
      Identical => {
        outcomes[index] = { name, state: VerifiedExisting, }
        save(outcomes)
      }
      Conflict | Unverified => {
        outcomes[index] = {
          name,
          state: Failed(
            "Inventory-wide registry preflight found conflicting or unavailable evidence; no upload attempted",
          ),
        }
        save(outcomes)
        return outcomes
      }
    }
  }
  for index, (name, expected) in modules {
    let initial = poll_registry(name, false, observe, pause)
    let state = match initial {
      Present(actual) if actual == expected => VerifiedExisting
      Present(_) => Failed("Existing registry archive differs from candidate")
      Absent => {
        outcomes[index] = {
          name,
          state: Failed("Upload started; completion has not been verified"),
        }
        save(outcomes)
        let status = upload(name)
        if status != 0 {
          Failed(
            "Moon publish failed with status " +
            status.to_string() +
            "; upload was not retried",
          )
        } else {
          match poll_registry(name, true, observe, pause) {
            Present(actual) if actual == expected => Published
            Present(_) => Failed("Published archive differs from candidate")
            _ =>
              Failed(
                "Published archive visibility could not be verified within the bounded wait",
              )
          }
        }
      }
      Rejected(status) =>
        Failed("Registry refused evidence with HTTP " + status.to_string())
      _ => Failed("Registry evidence is unavailable; no upload attempted")
    }
    outcomes[index] = { name, state, }
    save(outcomes)
    if state is Failed(_) {
      break
    }
  }
  outcomes
}

///|
async fn poll_registry(
  name : String,
  await_publication : Bool,
  observe : async (String) -> RegistryState,
  pause : async (Int32) -> Unit,
) -> RegistryState {
  let mut observation = Unavailable
  for attempt in 0..<6 {
    observation = observe(name)
    let retry = match observation {
      Transient(_) => true
      Absent => await_publication
      _ => false
    }
    if !retry || attempt == 5 {
      break
    }
    pause(1000 << attempt)
  }
  observation
}

///|
async test "dry-run cannot inspect credentials registry or upload" {
  let mut effects = 0
  let refused = try {
    ignore(
      publish_sequence(
        DryRun,
        [("finos/a", "hash")],
        _ => {
          effects += 1
          Absent
        },
        _ => {
          effects += 1
          0
        },
        _ => effects += 1,
        _ => effects += 1,
      ),
    )
    false
  } catch {
    Refusal(_) => true
    error => raise error
  }
  assert_true(refused)
  assert_eq(effects, 0)
}

///|
async test "identical existing versions are verified and failed dependencies stop consumers" {
  let uploads = []
  let snapshots = []
  let result = publish_sequence(
    Publish,
    [("a", "same"), ("b", "wanted"), ("c", "wanted")],
    name => if name == "a" { Present("same") } else { Present("different") },
    name => {
      uploads.push(name)
      0
    },
    states => snapshots.push(states.copy()),
    _ => (),
  )
  assert_eq(result[0].state, VerifiedExisting)
  assert_true(result[1].state is Failed(_))
  assert_eq(result[2].state, NotAttempted)
  assert_eq(uploads, [])
  assert_eq(snapshots.length(), 3)
  assert_eq(snapshots[0][0].state, NotAttempted)
}

///|
async test "transient reads and index delay retry within bounds with one upload" {
  let reads = [
    Transient(503),
    Absent,
    Absent,
    Absent,
    Transient(429),
    Present("hash"),
  ]
  let mut calls = 0
  let mut uploads = 0
  let delays = []
  let result = publish_sequence(
    Publish,
    [("a", "hash")],
    _ => {
      let value = reads[calls]
      calls += 1
      value
    },
    _ => {
      uploads += 1
      0
    },
    _ => (),
    delay => delays.push(delay),
  )
  assert_eq(result[0].state, Published)
  assert_eq(uploads, 1)
  assert_eq(calls, 6)
  assert_eq(delays, [1000, 1000, 2000])
  let mut unavailable_calls = 0
  let unavailable = publish_sequence(
    Publish,
    [("a", "hash")],
    _ => {
      unavailable_calls += 1
      Transient(503)
    },
    _ => {
      uploads += 1
      0
    },
    _ => (),
    _ => (),
  )
  assert_eq(unavailable_calls, 6)
  assert_eq(uploads, 1)
  assert_true(unavailable[0].state is Failed(_))
}

///|
async test "authentication unknown evidence and opaque publish failure never retry uploads" {
  for initial in [Rejected(401), Rejected(403), Unavailable, Absent] {
    let mut reads = 0
    let mut uploads = 0
    let result = publish_sequence(
      Publish,
      [("a", "hash"), ("consumer", "hash")],
      _ => {
        reads += 1
        initial
      },
      _ => {
        uploads += 1
        1
      },
      _ => (),
      _ => (),
    )
    assert_eq(reads, if initial is Absent { 3 } else { 1 })
    assert_eq(uploads, if initial is Absent { 1 } else { 0 })
    assert_true(result[0].state is Failed(_))
    assert_eq(result[1].state, NotAttempted)
  }
}

///|
async test "a later inventory conflict prevents every new upload" {
  let uploads = []
  let checked = []
  let result = publish_sequence(
    Publish,
    [("dependency", "hash"), ("consumer", "hash")],
    name => {
      checked.push(name)
      if name == "dependency" {
        Absent
      } else {
        Present("other-source")
      }
    },
    name => {
      uploads.push(name)
      0
    },
    _ => (),
    _ => (),
  )
  assert_eq(checked, ["dependency", "consumer"])
  assert_eq(uploads, [])
  assert_eq(result[0].state, NotAttempted)
  assert_true(result[1].state is Failed(_))
}

///|
async test "post-preflight races are rechecked before a consumer upload" {
  let uploaded : Map[String, Bool] = Map([])
  let uploads = []
  let result = publish_sequence(
    Publish,
    [("dependency", "hash"), ("consumer", "hash")],
    name => {
      if name == "consumer" && uploaded.contains("dependency") {
        Present("raced-conflict")
      } else if uploaded.contains(name) {
        Present("hash")
      } else {
        Absent
      }
    },
    name => {
      uploads.push(name)
      uploaded[name] = true
      0
    },
    _ => (),
    _ => (),
  )
  assert_eq(uploads, ["dependency"])
  assert_eq(result[0].state, Published)
  assert_true(result[1].state is Failed(_))
}

///|
async test "partial publication resumes the identical candidate without reuploading dependencies" {
  let uploaded : Map[String, Bool] = Map([])
  let uploads = []
  let mut failed_once = false
  let observe : async (String) -> RegistryState = name => {
    if uploaded.contains(name) {
      Present("hash")
    } else {
      Absent
    }
  }
  let upload : async (String) -> Int32 = name => {
    uploads.push(name)
    if name == "consumer" && !failed_once {
      failed_once = true
      1
    } else {
      uploaded[name] = true
      0
    }
  }
  let modules = [("dependency", "hash"), ("consumer", "hash")]
  let partial = publish_sequence(Publish, modules, observe, upload, _ => (), _ => {
    ()
  })
  assert_eq(partial[0].state, Published)
  assert_true(partial[1].state is Failed(_))
  let resumed = publish_sequence(Publish, modules, observe, upload, _ => (), _ => {
    ()
  })
  assert_eq(resumed[0].state, VerifiedExisting)
  assert_eq(resumed[1].state, Published)
  assert_eq(uploads, ["dependency", "consumer", "consumer"])
  let trace : Json = {
    "simulation": "partial-release-and-identical-candidate-resume",
    "partial": partial.map(row => {
      Json([Json(row.name), Json(@debug.to_string(row.state))])
    }),
    "resumed": resumed.map(row => {
      Json([Json(row.name), Json(@debug.to_string(row.state))])
    }),
    "uploads": uploads,
  }
  println(trace.stringify())
}

///|
fn digest(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
fn identity_source(manifest : Manifest) -> String raise {
  if manifest.name != "finos/morphir" {
    raise Refusal(
      IdentityMismatch("CLI identity generator requires finos/morphir"),
    )
  }
  ignore(ReleaseVersion::parse(manifest.version))
  "// Generated by mise run release:identity. Commit this file; dependency builds skip generation.\n\n" +
  "///|\nlet release_identity : Json = {\n" +
  "  \"name\": \"finos/morphir\",\n" +
  "  // Shared release version from apps/morphir/moon.mod.\n" +
  "  \"version\": " +
  Json(manifest.version).stringify() +
  ",\n}\n"
}

///|
fn require_identity(manifest : Manifest, text : String) -> Unit raise {
  if text.replace_all(old="\r\n", new="\n") != identity_source(manifest) {
    raise Refusal(
      CandidateMismatch(
        "CLI identity is stale; run mise run release:identity and commit release_identity.mbt",
      ),
    )
  }
}

///|
test "committed CLI identity must match its manifest and accepts checkout CRLF" {
  let manifest = fixture_manifest("apps/morphir", "finos/morphir")
  let source = identity_source(manifest)
  require_identity(manifest, source)
  require_identity(manifest, source.replace_all(old="\n", new="\r\n"))
  let stale = try {
    require_identity({ ..manifest, version: "0.2.0", }, source)
    false
  } catch {
    Refusal(_) => true
    error => raise error
  }
  assert_true(stale)
}

///|
async test "owned result writes persist partial outcomes and preserve unrelated files" {
  let directory = @fs.tmpdir(prefix="morphir release report ")
  defer @fs.rmdir(directory, recursive=true)
  let file = join_host(directory, "publication.json")
  let snapshots = []
  let outcomes = publish_sequence(
    Publish,
    [("dependency", "wanted"), ("consumer", "wanted")],
    _ => Absent,
    _ => 1,
    states => {
      let value : Json = {
        "profile": "morphir/mooncakes-publication",
        "states": states.map(state => Json(@debug.to_string(state.state))),
      }
      write_owned_json(file, value, "morphir/mooncakes-publication")
      snapshots.push(@json.parse(@fs.read_file(file).text()))
    },
    _ => (),
  )
  assert_true(outcomes[0].state is Failed(_))
  assert_eq(outcomes[1].state, NotAttempted)
  assert_eq(snapshots.length(), 3)
  assert_true(
    snapshots[1].stringify().contains("completion has not been verified"),
  )
  assert_false(@fs.exists(file + ".tmp"))
  @fs.write_file(file, "unrelated content")
  let refused = try {
    write_owned_json(
      file,
      { "profile": "morphir/mooncakes-publication" },
      "morphir/mooncakes-publication",
    )
    false
  } catch {
    _ => true
  }
  assert_true(refused)
  assert_eq(@fs.read_file(file).text(), "unrelated content")
}

///|
test "registry identity and latest index records must agree before consumers" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let checksum = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  let metadata : Json = {
    "module": manifest.name,
    "version": manifest.version,
    "yanked": false,
    "metadata": {
      "name": manifest.name,
      "version": manifest.version,
      "checksum": checksum,
    },
  }
  assert_eq(registry_checksum(metadata, manifest), checksum)
  let wrong = try {
    ignore(registry_checksum(metadata, { ..manifest, version: "0.2.0", }))
    false
  } catch {
    Refusal(_) => true
    error => raise error
  }
  assert_true(wrong)
  let present : Json = { "version": "0.1.0", "checksum": checksum }
  let yanked : Json = {
    "version": "0.1.0",
    "checksum": checksum,
    "yanked": true,
  }
  assert_eq(
    index_checksum(present.stringify() + "\n" + yanked.stringify(), "0.1.0"),
    None,
  )
  assert_eq(
    index_checksum(yanked.stringify() + "\n" + present.stringify(), "0.1.0"),
    Some(checksum),
  )
  assert_eq(index_checksum(present.stringify(), "0.2.0"), None)
}

///|
test "candidate proof refuses changed package bytes source and compiler" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let packages : PackageSet = {
    commit: CommitId::parse("0123456789abcdef0123456789abcdef01234567"),
    compiler: "0.10.20+65efd5b93",
    core_pin_sha256: "core-pin",
    isolated_targets: ["wasm", "wasm-gc", "js", "native"],
    packages: [
      {
        manifest,
        archive_path: ".dev/mooncakes-release/test.zip",
        evidence: {
          archive_sha256: "archive",
          content_sha256: "content",
          bytes: 1,
          files: 1,
        },
      },
    ],
  }
  let plan : Json = {
    "packages": package_set_json(packages),
    "minimumConsumer": minimum_proof(packages),
  }
  require_package_proof(plan, packages)
  for
    proof in [
      Json::null(),
      @json.parse(
        minimum_proof(packages)
        .stringify()
        .replace_all(old="succeeded", new="failed"),
      ),
      @json.parse(
        minimum_proof(packages)
        .stringify()
        .replace_all(old=minimum_version, new="changed-minimum-compiler"),
      ),
      @json.parse(
        minimum_proof(packages)
        .stringify()
        .replace_all(old="archive", new="different"),
      ),
      @json.parse(
        minimum_proof(packages)
        .stringify()
        .replace_all(old="nativeWorksheet", new="missingWorksheet"),
      ),
      @json.parse(
        minimum_proof(packages)
        .stringify()
        .replace_all(
          old=packages.commit.0,
          new="1123456789abcdef0123456789abcdef01234567",
        ),
      ),
    ] {
    let refused = try {
      require_package_proof(
        { "packages": package_set_json(packages), "minimumConsumer": proof },
        packages,
      )
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused)
  }
  for
    changed in [
      { ..packages, compiler: "changed", },
      { ..packages, core_pin_sha256: "changed", },
      {
        ..packages,
        commit: CommitId::parse("1123456789abcdef0123456789abcdef01234567"),
      },
      {
        ..packages,
        packages: [
          {
            ..packages.packages[0],
            evidence: {
              ..packages.packages[0].evidence,
              archive_sha256: "changed",
            },
          },
        ],
      },
    ] {
    let refused = try {
      require_package_proof(plan, changed)
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused)
  }
}

///|
fn forbidden_archive_path(path : String) -> Bool {
  path
  .split("/")
  .any(part => {
    [
      "_build", "target", ".git", ".mooncakes", "node_modules", ".dev", "credentials.json",
      ".env",
    ].contains(part.to_owned())
  }) ||
  path.has_prefix(".morphir/logs/")
}

///|
// Inspect archives produced by the pinned Moon invocation, not arbitrary
// registry archives. Existing-version proof must match a raw registry checksum
// or a verified candidate-bound publication receipt; a ZIP map alone cannot
// prove that an external archive had no duplicate entries.
fn inspect_archive(expected : Manifest, bytes : Bytes) -> ArchiveEvidence raise {
  let archive = @zipc.Archive::from_bytes(bytes)
  let entries = archive.to_array()
  entries.sort_by((left, right) => left.path().lexical_compare(right.path()))
  let contents : Map[String, Bytes] = Map([])
  let facts : Array[Json] = []
  for entry in entries {
    let raw = entry.path()
    let path = if raw.has_suffix("/") {
      raw[:raw.length() - 1].to_owned()
    } else {
      raw
    }
    ignore(ModulePath::parse(path))
    if forbidden_archive_path(path) {
      raise Refusal(ArchiveInvalid("Forbidden package content: " + path))
    }
    if (entry.mode() & 0o170000) == 0o120000 {
      raise Refusal(
        ArchiveInvalid(
          "Source archive must contain files, not symbolic links: " + path,
        ),
      )
    }
    match entry.kind() {
      Dir =>
        facts.push(
          Json::array([Json(path), Json("directory"), Json(entry.mode())]),
        )
      File(file) => {
        let data = file.to_bytes()
        contents[path] = data
        facts.push(
          Json::array([
            Json(path),
            Json("file"),
            Json(entry.mode()),
            Json(digest(data)),
          ]),
        )
        if path != "moon.mod" &&
          (path.has_suffix("/moon.mod") || path.has_suffix("moon.mod.json")) {
          raise Refusal(
            ArchiveInvalid("Unexpected nested/legacy module: " + path),
          )
        }
      }
    }
  }
  guard contents.get("moon.mod") is Some(manifest_bytes) else {
    raise Refusal(ArchiveInvalid("Archive has no moon.mod: " + expected.name))
  }
  let actual = decode_manifest(expected.path, @utf8.decode(manifest_bytes))
  if actual != expected {
    raise Refusal(
      ArchiveInvalid(
        "Packaged manifest differs from inspected source: " + expected.name,
      ),
    )
  }
  if expected.name == "finos/morphir" {
    guard contents.get("cli/release_identity.mbt") is Some(identity) else {
      raise Refusal(
        ArchiveInvalid(
          "CLI archive must include committed release_identity.mbt",
        ),
      )
    }
    require_identity(expected, @utf8.decode(identity))
    if expected.dependencies.contains("moonrockz/moon-lander-moonx") {
      require_payload_archive(contents)
      let provenance = @json.parse(
        @utf8.decode(contents["moonx/payload-provenance.json"]),
      )
      require_published_native_stamp(
        expected,
        CommitId::parse(required_string(provenance, "sourceCommit")),
        contents,
      )
    }
  }
  for required in ["LICENSE", expected.readme.unwrap()] {
    if !contents.contains(required) {
      raise Refusal(
        ArchiveInvalid("Missing required archive file: " + required),
      )
    }
  }
  for path, data in contents {
    if path != "moon.pkg" && !path.has_suffix("/moon.pkg") {
      continue
    }
    guard archive_package_config(path, @utf8.decode(data)) is Object(fields) else {
      raise Refusal(ArchiveInvalid(path))
    }
    match fields.get("native-stub") {
      None => ()
      Some(Array(stubs)) =>
        for stub in stubs {
          guard stub is String(file) else {
            raise Refusal(ArchiveInvalid("Invalid native stub in " + path))
          }
          let parent = match path.rev_find("/") {
            Some(at) => path[:at].to_owned()
            None => "."
          }
          let resolved = @posix.Path(parent + "/" + file).normalize().0
          ignore(ModulePath::parse(resolved))
          if !contents.contains(resolved) {
            raise Refusal(ArchiveInvalid("Missing native stub: " + resolved))
          }
        }
      _ => raise Refusal(ArchiveInvalid("Invalid native-stub list: " + path))
    }
  }
  {
    archive_sha256: digest(bytes),
    content_sha256: digest(@utf8.encode(Json::array(facts).stringify())),
    bytes: bytes.length(),
    files: contents.length(),
  }
}

///|
/// Whether `line` is exactly one `#cfg(...)` attribute with a non-empty
/// condition, balanced parentheses outside strings and no escapes.
fn conditional_attribute(line : String) -> String? {
  guard line.has_prefix("#cfg(") && line.has_suffix(")") else { return None }
  let condition = line.exact_view(start=5, end=line.length() - 1).to_owned()
  if condition.trim().is_empty() || condition.contains("\\") {
    return None
  }
  let mut depth = 0
  let mut quoted = false
  for char in condition {
    if char == '"' {
      quoted = !quoted
    } else if !quoted && char == '(' {
      depth += 1
    } else if !quoted && char == ')' {
      depth -= 1
      if depth < 0 {
        return None
      }
    }
  }
  if depth != 0 || quoted {
    return None
  }
  Some(condition)
}

///|
/// Moon 0.10.20 accepts `#cfg(...)` before an `import` block, but the public
/// parser reports every attribute as a syntax error. Remove each such block
/// from the package source, keeping line numbers, and validate it on its own.
/// Any other attribute, or a condition that is not directly followed by a
/// complete `import {` ... `}` block, remains fatal. The archive-only build
/// on every target still evaluates the condition with the actual compiler.
fn conditional_imports(
  path : String,
  source : String,
) -> (String, Array[Json]) raise Refusal {
  let lines = source.split("\n").map(line => line.to_owned()).to_array()
  let imports : Array[Json] = []
  let mut index = 0
  while index < lines.length() {
    let line = lines[index].trim().to_owned()
    if !line.has_prefix("#") {
      index += 1
      continue
    }
    guard conditional_attribute(line) is Some(condition) &&
      index + 1 < lines.length() &&
      lines[index + 1].trim() == "import {" else {
      raise Refusal(ArchiveInvalid("Unsupported package attribute in " + path))
    }
    let start = index + 1
    let mut end = start + 1
    while end < lines.length() && lines[end].trim() != "}" {
      if lines[end].trim().has_prefix("#") {
        raise Refusal(
          ArchiveInvalid("Unsupported package attribute in " + path),
        )
      }
      end += 1
    }
    if end >= lines.length() {
      raise Refusal(ArchiveInvalid("Incomplete conditional import in " + path))
    }
    let block = lines[start:end + 1].join("\n")
    let (ast, reports) = @manifest_parser.parse_moon_pkg(name=path, block)
    reports.append(@manifest_parser.validate_moon_pkg(ast))
    guard reports.is_empty() &&
      ast is Obj(fields, ..) &&
      fields.length() == 1 &&
      fields[0] is ("import", value) else {
      raise Refusal(
        ArchiveInvalid(
          "Invalid conditional import in " +
          path +
          ": " +
          reports.map(report => report.msg).join("; "),
        ),
      )
    }
    imports.push({ "cfg": Json::string(condition), "import": Json(value) })
    for blank in index..<(end + 1) {
      lines[blank] = ""
    }
    index = end + 1
  }
  (lines.join("\n"), imports)
}

///|
fn archive_package_config(path : String, source : String) -> Json raise {
  let (source, conditional) = conditional_imports(path, source)
  let (ast, reports) = @manifest_parser.parse_moon_pkg(name=path, source)
  // Moon 0.10.17 formats this option as a top-level underscore alias. The
  // public parser preserves its AST but reports that spelling as unknown.
  // Accept only that exact report at the one validated value's location.
  // All syntax, duplicate-key and unrelated option reports remain fatal.
  let mut alias_location = None
  let normalized = match ast {
    Obj(fields, loc~) => {
      let fields = fields
        .to_array()
        .map(field => {
          let (key, value) = field
          if key != "max_concurrent_tests" {
            return field
          }
          if alias_location is Some(_) {
            raise Refusal(
              ArchiveInvalid("Duplicate test concurrency in " + path),
            )
          }
          guard value is Float(text, ..) &&
            @json.parse(text) is Number(number, ..) &&
            number >= 1 &&
            number <= 2147483647.0 &&
            number.floor() == number else {
            raise Refusal(ArchiveInvalid("Invalid test concurrency in " + path))
          }
          alias_location = Some(value.loc())
          ("max-concurrent-tests", value)
        })
      @manifest_parser.Ast::Obj(Vector(fields), loc~)
    }
    _ => ast
  }
  let retained = reports.filter(report => {
    !(report.msg ==
    "Invalid moon.pkg config: unexpected key `max_concurrent_tests`." &&
    alias_location == Some(report.loc))
  })
  retained.append(@manifest_parser.validate_moon_pkg(normalized))
  if !retained.is_empty() {
    raise Refusal(
      ArchiveInvalid(
        "Invalid package configuration: " +
        path +
        ": " +
        retained.map(report => report.msg).join("; "),
      ),
    )
  }
  let config = Json(normalized)
  if conditional.is_empty() {
    return config
  }
  guard config is Object(fields) else {
    raise Refusal(ArchiveInvalid("Invalid package configuration: " + path))
  }
  fields["conditional-import"] = Json::array(conditional)
  Json::object(fields)
}

///|
fn ModulePath::parse(text : String) -> ModulePath raise Refusal {
  if text.is_empty() ||
    text.has_prefix("/") ||
    text.contains("\\") ||
    text.contains(":") ||
    text.to_array().any(c => c.to_int() < 32) {
    raise Refusal(InvalidPath(text))
  }
  if text != "." &&
    text.split("/").any(part => part.is_empty() || part == "." || part == "..") {
    raise Refusal(InvalidPath(text))
  }
  ModulePath(text)
}

///|
fn ReleaseVersion::parse(text : String) -> ReleaseVersion raise Refusal {
  let parsed = @semver.Version::parse(text, syntax=@semver.Syntax::strict()) catch {
    _ => raise Refusal(InvalidVersion(text))
  }
  if !parsed.prerelease().is_empty() ||
    !parsed.build().is_empty() ||
    parsed.to_string() != text {
    raise Refusal(InvalidVersion(text))
  }
  ReleaseVersion(text)
}

///|
fn CommitId::parse(text : String) -> CommitId raise Refusal {
  if text.length() != 40 ||
    !text.to_array().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) {
    raise Refusal(InvalidCommit(text))
  }
  CommitId(text)
}

///|
fn Candidate::from_input(
  version : String,
  tag : String,
  sha : String,
  mode : ReleaseMode,
) -> Candidate raise Refusal {
  let version = ReleaseVersion::parse(version)
  let ReleaseVersion(value) = version
  if tag != "v" + value {
    raise Refusal(TagMismatch(tag))
  }
  { version, commit: CommitId::parse(sha), mode, }
}

///|
fn public_module_name(name : String) -> Bool {
  if name == "finos/morphir" {
    return true
  }
  guard name.strip_prefix("finos/morphir-") is Some(suffix) &&
    !suffix.is_empty() else {
    return false
  }
  suffix
  .iter()
  .all(c => {
    (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '-' ||
    c == '_'
  })
}

///|
fn publish_order(
  inventory : Array[InventoryEntry],
  manifests : Array[Manifest],
  discovered : Array[ModulePath],
  version : ReleaseVersion,
) -> Array[Manifest] raise Refusal {
  let paths : Map[String, InventoryEntry] = Map([])
  let identities : Map[String, InventoryEntry] = Map([])
  for entry in inventory {
    let ModulePath(path) = entry.path
    if paths.contains(path) {
      raise Refusal(DuplicatePath(path))
    }
    if identities.contains(entry.name) {
      raise Refusal(DuplicateName(entry.name))
    }
    if entry.reason.trim().is_empty() || entry.name.is_empty() {
      raise Refusal(InvalidInventory(path))
    }
    if entry.disposition is Public &&
      (path == "." || !public_module_name(entry.name)) {
      raise Refusal(InvalidInventory(path))
    }
    paths[path] = entry
    identities[entry.name] = entry
  }
  for ModulePath(path) in discovered {
    if !paths.contains(path) {
      raise Refusal(UnclassifiedModule(path))
    }
  }
  let by_path : Map[String, Manifest] = Map([])
  for manifest in manifests {
    let ModulePath(path) = manifest.path
    if by_path.contains(path) {
      raise Refusal(DuplicatePath(path))
    }
    if !paths.contains(path) {
      raise Refusal(UnclassifiedModule(path))
    }
    by_path[path] = manifest
  }
  let public_modules : Map[String, Manifest] = Map([])
  let ReleaseVersion(expected) = version
  for entry in inventory {
    let ModulePath(path) = entry.path
    guard discovered.contains(entry.path) && by_path.get(path) is Some(manifest) else {
      raise Refusal(MissingModule(path))
    }
    if manifest.name != entry.name {
      raise Refusal(IdentityMismatch(path))
    }
    if entry.disposition is Excluded {
      continue
    }
    if manifest.visibility is Private {
      raise Refusal(PrivateModule(manifest.name))
    }
    if manifest.version != expected {
      raise Refusal(VersionMismatch(manifest.name))
    }
    match manifest.readme {
      None | Some("") => raise Refusal(MissingReadme(manifest.name))
      Some(path) => ignore(ModulePath::parse(path))
    }
    public_modules[manifest.name] = manifest
    if manifest.license is (None | Some("")) {
      raise Refusal(MissingLicense(manifest.name))
    }
  }
  if public_modules.is_empty() {
    raise Refusal(InvalidInventory("No public modules"))
  }
  for name, manifest in public_modules {
    for dependency, pin in manifest.dependencies {
      if !dependency.has_prefix("finos/") {
        continue
      }
      if !public_modules.contains(dependency) {
        raise Refusal(InternalDependency(name, dependency))
      }
      if pin != expected {
        raise Refusal(DependencyVersion(name, dependency))
      }
    }
  }
  let mut pending = public_modules.keys().to_array()
  pending.sort_by((left, right) => left.lexical_compare(right))
  let completed : Map[String, Bool] = Map([])
  let ordered = []
  while !pending.is_empty() {
    let next = pending
      .iter()
      .filter(name => {
        public_modules[name].dependencies
        .keys()
        .all(dependency => {
          !dependency.has_prefix("finos/") || completed.contains(dependency)
        })
      })
      .next()
    guard next is Some(name) else { raise Refusal(Cycle(pending)) }
    ordered.push(public_modules[name])
    completed[name] = true
    pending = pending.filter(other => other != name)
  }
  ordered
}

///|
fn fixture_entry(
  path : String,
  name : String,
  disposition~ : Disposition = Public,
) -> InventoryEntry raise Refusal {
  {
    path: ModulePath::parse(path),
    name,
    disposition,
    reason: "Fixture policy",
  }
}

///|
fn fixture_manifest(
  path : String,
  name : String,
  dependencies~ : Map[String, String] = Map([]),
  version~ : String = "0.1.0",
  readme~ : String? = Some("README.md"),
  license~ : String? = Some("Apache-2.0"),
  visibility~ : Visibility = Open,
  supported_targets~ : Array[String]? = None,
  preferred_target~ : String? = None,
) -> Manifest raise Refusal {
  {
    path: ModulePath::parse(path),
    name,
    version,
    dependencies,
    readme,
    license,
    visibility,
    supported_targets,
    preferred_target,
  }
}

///|
fn refused(operation : () -> Unit raise Refusal) -> Problem? {
  try {
    operation()
    None
  } catch {
    Refusal(problem) => Some(problem)
  }
}

///|
test "release paths and versions refuse unsafe or non-release identities" {
  for
    text in [
      "", "/repo", "../repo", "a/../b", "a//b", "a/./b", "C:/repo", "a\\b", "a\nb",
    ] {
    assert_eq(
      refused(fn() raise Refusal { ignore(ModulePath::parse(text)) }),
      Some(InvalidPath(text)),
    )
  }
  for
    text in [
      "", "v0.1.0", "01.0.0", "0.1", "0.1.0-rc.1", "0.1.0+build", " 0.1.0",
    ] {
    assert_eq(
      refused(fn() raise Refusal { ignore(ReleaseVersion::parse(text)) }),
      Some(InvalidVersion(text)),
    )
  }
  assert_eq(ReleaseVersion::parse("0.1.0"), ReleaseVersion("0.1.0"))
}

///|
test "candidate binds the exact release tag and full commit identity" {
  let sha = "a".repeat(40)
  let candidate = Candidate::from_input("0.1.0", "v0.1.0", sha, DryRun)
  assert_eq(candidate.mode, DryRun)
  assert_eq(candidate.commit, CommitId(sha))
  for tag in ["0.1.0", "v0.2.0", "main", "v0.1.0 "] {
    assert_eq(
      refused(fn() raise Refusal {
        ignore(Candidate::from_input("0.1.0", tag, sha, Publish))
      }),
      Some(TagMismatch(tag)),
    )
  }
  for sha in ["", "main", "abc123", "A".repeat(40), "g".repeat(40)] {
    assert_eq(
      refused(fn() raise Refusal { ignore(CommitId::parse(sha)) }),
      Some(InvalidCommit(sha)),
    )
  }
}

///|
test "changed manifest identity cannot borrow an inventory entry" {
  let item = fixture_entry("pkgs/core", "finos/morphir-core")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [item],
          [fixture_manifest("pkgs/core", "finos/morphir-other")],
          [item.path],
          ReleaseVersion::parse("0.1.0"),
        ),
      )
    }),
    Some(IdentityMismatch("pkgs/core")),
  )
}

///|
test "dependency order is deterministic and puts the CLI after its dependencies" {
  let inventory = [
    fixture_entry("apps/morphir", "finos/morphir"),
    fixture_entry("pkgs/core", "finos/morphir-core"),
    fixture_entry("pkgs/extra", "finos/morphir-extra"),
  ]
  let core = fixture_manifest("pkgs/core", "finos/morphir-core")
  let extra = fixture_manifest("pkgs/extra", "finos/morphir-extra")
  let cli = fixture_manifest("apps/morphir", "finos/morphir", dependencies={
    "finos/morphir-core": "0.1.0",
  })
  let discovered = inventory.map(item => item.path)
  let version = ReleaseVersion::parse("0.1.0")
  let names = publish_order(inventory, [cli, extra, core], discovered, version).map(manifest => {
      manifest.name
    },
  )
  assert_eq(names, [
    "finos/morphir-core", "finos/morphir", "finos/morphir-extra",
  ])
  assert_eq(
    publish_order(
      inventory.rev(),
      [core, cli, extra],
      discovered.rev(),
      version,
    ).map(manifest => manifest.name),
    names,
  )
}

///|
test "every discovered manifest needs an explicit inventory disposition" {
  let item = fixture_entry("pkgs/core", "finos/morphir-core")
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let version = ReleaseVersion::parse("0.1.0")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [item],
          [manifest],
          [item.path, ModulePath::parse("pkgs/new")],
          version,
        ),
      )
    }),
    Some(UnclassifiedModule("pkgs/new")),
  )
  assert_eq(
    refused(fn() raise Refusal {
      ignore(publish_order([item], [manifest], [], version))
    }),
    Some(MissingModule("pkgs/core")),
  )
}

///|
test "duplicate paths and duplicate module identities are refused" {
  let item = fixture_entry("pkgs/core", "finos/morphir-core")
  let other = fixture_entry("pkgs/other", "finos/morphir-core")
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let version = ReleaseVersion::parse("0.1.0")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(publish_order([item, item], [manifest], [item.path], version))
    }),
    Some(DuplicatePath("pkgs/core")),
  )
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [item, other],
          [manifest],
          [item.path, other.path],
          version,
        ),
      )
    }),
    Some(DuplicateName("finos/morphir-core")),
  )
}

///|
test "public consumers cannot depend on unknown or excluded FINOS modules" {
  let item = fixture_entry("pkgs/core", "finos/morphir-core")
  let excluded = fixture_entry(
    "tools/private",
    "finos/morphir-private",
    disposition=Excluded,
  )
  let private_manifest = fixture_manifest(
    "tools/private", "finos/morphir-private",
  )
  let version = ReleaseVersion::parse("0.1.0")
  for dep in ["finos/morphir-missing", "finos/morphir-private"] {
    let manifest = fixture_manifest(
      "pkgs/core",
      "finos/morphir-core",
      dependencies=Map([(dep, "0.1.0")]),
    )
    assert_eq(
      refused(fn() raise Refusal {
        ignore(
          publish_order(
            [item, excluded],
            [manifest, private_manifest],
            [item.path, excluded.path],
            version,
          ),
        )
      }),
      Some(InternalDependency("finos/morphir-core", dep)),
    )
  }
}

///|
test "shared version and internal dependency pins must match the candidate" {
  let a = fixture_entry("pkgs/a", "finos/morphir-a")
  let b = fixture_entry("pkgs/b", "finos/morphir-b")
  let ma = fixture_manifest("pkgs/a", "finos/morphir-a")
  let version = ReleaseVersion::parse("0.1.0")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [a],
          [fixture_manifest("pkgs/a", "finos/morphir-a", version="0.2.0")],
          [a.path],
          version,
        ),
      )
    }),
    Some(VersionMismatch("finos/morphir-a")),
  )
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [a, b],
          [
            ma,
            fixture_manifest("pkgs/b", "finos/morphir-b", dependencies={
              "finos/morphir-a": "0.2.0",
            }),
          ],
          [a.path, b.path],
          version,
        ),
      )
    }),
    Some(DependencyVersion("finos/morphir-b", "finos/morphir-a")),
  )
}

///|
test "cycles and absent declared readmes fail before packaging" {
  let a = fixture_entry("pkgs/a", "finos/morphir-a")
  let b = fixture_entry("pkgs/b", "finos/morphir-b")
  let ma = fixture_manifest("pkgs/a", "finos/morphir-a", dependencies={
    "finos/morphir-b": "0.1.0",
  })
  let mb = fixture_manifest("pkgs/b", "finos/morphir-b", dependencies={
    "finos/morphir-a": "0.1.0",
  })
  let version = ReleaseVersion::parse("0.1.0")
  assert_eq(
    refused(fn() raise Refusal {
      ignore(publish_order([a, b], [ma, mb], [a.path, b.path], version))
    }),
    Some(Cycle(["finos/morphir-a", "finos/morphir-b"])),
  )
  assert_eq(
    refused(fn() raise Refusal {
      ignore(
        publish_order(
          [a],
          [fixture_manifest("pkgs/a", "finos/morphir-a", readme=None)],
          [a.path],
          version,
        ),
      )
    }),
    Some(MissingReadme("finos/morphir-a")),
  )
}

///|
fn string_field(value : Json, name : String) -> String? {
  match value {
    Object(fields) =>
      match fields.get(name) {
        Some(String(text)) => Some(text)
        _ => None
      }
    _ => None
  }
}

///|
fn required_string(value : Json, name : String) -> String raise Refusal {
  match string_field(value, name) {
    Some(text) => text
    None => raise Refusal(InvalidInventory("Missing string field: " + name))
  }
}

///|
fn decode_inventory(value : Json) -> Array[InventoryEntry] raise Refusal {
  guard value is Object(fields) &&
    string_field(value, "profile") == Some("morphir/mooncakes-inventory") &&
    string_field(value, "contractVersion") == Some("0.1.0") &&
    fields.get("modules") is Some(Array(items)) else {
    raise Refusal(
      InvalidInventory("Expected morphir/mooncakes-inventory 0.1.0"),
    )
  }
  items.map(item => {
    let disposition = match required_string(item, "disposition") {
      "public" => Public
      "excluded" => Excluded
      text => raise Refusal(InvalidInventory("Unknown disposition: " + text))
    }
    {
      path: ModulePath::parse(required_string(item, "path")),
      name: required_string(item, "name"),
      disposition,
      reason: required_string(item, "reason"),
    }
  })
}

///|
fn decode_manifest(
  path : ModulePath,
  source : String,
) -> Manifest raise Refusal {
  let ModulePath(directory) = path
  let (ast, reports) = @manifest_parser.parse_moon_mod(
    name=directory + "/moon.mod",
    source,
  )
  if !reports.is_empty() {
    let messages = reports
      .map(fn(report : @basic.Report) { report.msg })
      .join("; ")
    raise Refusal(ManifestSyntax(directory + ": " + messages))
  }
  let value = Json(ast)
  guard value is Object(fields) && fields.get("name") is Some(String(name)) else {
    raise Refusal(ManifestSyntax(directory + ": missing module name"))
  }
  let dependencies : Map[String, String] = Map([])
  match fields.get("deps") {
    None => ()
    Some(Object(deps)) =>
      for dependency, pin in deps {
        guard pin is String(text) else {
          raise Refusal(
            ManifestSyntax(
              directory + ": dependency pin must be a string: " + dependency,
            ),
          )
        }
        dependencies[dependency] = text
      }
    _ =>
      raise Refusal(
        ManifestSyntax(directory + ": dependencies must be an object"),
      )
  }
  let visibility = match fields.get("private") {
    Some(True) => Private
    None | Some(False) => Open
    _ => raise Refusal(ManifestSyntax(directory + ": private must be boolean"))
  }
  {
    path,
    name,
    dependencies,
    visibility,
    version: string_field(value, "version").unwrap_or(""),
    readme: string_field(value, "readme"),
    license: string_field(value, "license"),
    supported_targets: string_field(value, "supported-targets").map(text => {
      text.split("+").map(target => target.to_owned()).to_array()
    }),
    preferred_target: string_field(value, "preferred-target"),
  }
}

///|
/// The backend that Moon 0.10.20 selects when a command names no target.
/// `moon publish` has no target option, so it checks a module on this backend
/// unless the module declares `preferred_target`.
let default_backend = "wasm"

///|
let known_backends : ReadOnlyArray[String] = [
  "wasm", "wasm-gc", "js", "native", "llvm",
]

///|
/// Refuse a module that `moon publish` cannot check: its supported targets
/// exclude the default backend and it names no preferred target, or it names
/// an unknown or unsupported target.
fn require_default_backend(manifest : Manifest) -> Unit raise Refusal {
  let ModulePath(directory) = manifest.path
  if manifest.supported_targets is Some(targets) {
    if targets.is_empty() ||
      targets.any(target => !known_backends.contains(target)) {
      raise Refusal(
        ManifestSyntax(
          directory + ": supported_targets names an unknown backend",
        ),
      )
    }
  }
  match (manifest.preferred_target, manifest.supported_targets) {
    (Some(preferred), _) if !known_backends.contains(preferred) =>
      raise Refusal(
        ManifestSyntax(
          directory + ": preferred_target names an unknown backend",
        ),
      )
    (Some(preferred), Some(targets)) if !targets.contains(preferred) =>
      raise Refusal(
        ManifestSyntax(
          directory + ": preferred_target is not in supported_targets",
        ),
      )
    (None, Some(targets)) if !targets.contains(default_backend) =>
      raise Refusal(
        ManifestSyntax(
          directory +
          ": supported_targets excludes the default backend " +
          default_backend +
          "; declare preferred_target so moon publish can check the module",
        ),
      )
    _ => ()
  }
}

///|
async fn child(program : String, args : Array[String]) -> String {
  let (code, output, error_output) = @process.collect_output(program, args)
  if code != 0 {
    raise Failure("Child failed (\{code}): \{program}\n" + error_output.text())
  }
  output.text()
}

///|
async fn require_clean_sources(
  root : String,
  inspection : Inspection,
) -> CommitId {
  let paths = inspection.inventory
    .filter(entry => entry.disposition is Public)
    .map(entry => entry.path.0)
  let status = child(
    "git",
    [
      "-C", root, "status", "--porcelain=v1", "--untracked-files=normal", "--", "scripts/mooncakes-modules.json",
      "tools/moonbit-core-pin.json", ".gitignore", ..node_producer_inputs, ..paths,
    ],
  )
  if !status.is_empty() {
    raise Refusal(
      CandidateMismatch(
        "Public source, inventory and toolchain pin must be clean before packaging",
      ),
    )
  }
  CommitId::parse(
    child("git", ["-C", root, "rev-parse", "HEAD"]).trim().to_owned(),
  )
}

///|
async fn compiler_for(root : String, commit : CommitId) -> (String, String) {
  if @env.get_env_var("MOON_CORE_OVERRIDE") is Some(value) && !value.is_empty() {
    raise Refusal(
      CandidateMismatch(
        "Release checks require the stock core; unset MOON_CORE_OVERRIDE",
      ),
    )
  }
  let source = child("git", [
    "-C",
    root,
    "show",
    commit.0 + ":tools/moonbit-core-pin.json",
  ])
  let pin = @json.parse(source)
  if string_field(pin, "profile") != Some("morphir/moonbit/core-pin") {
    raise Refusal(CandidateMismatch("Unknown compiler/core pin contract"))
  }
  let expected = required_string(pin, "compilerVersion")
  let versions = @json.parse(child("moon", ["version", "--all", "--json"]))
  guard versions is Object(fields) && fields.get("items") is Some(Array(items)) else {
    raise Refusal(CandidateMismatch("Moon did not report toolchain versions"))
  }
  let reported = items
    .iter()
    .filter(item => string_field(item, "name") == Some("moonc"))
    .next()
  guard reported is Some(record) &&
    string_field(record, "version") is Some(actual) &&
    actual.split(" ").next() == Some("v" + expected) else {
    raise Refusal(
      CandidateMismatch("Compiler must match source pin " + expected),
    )
  }
  (expected, digest(@utf8.encode(source)))
}

///|
async fn snapshot_public_sources(
  root : String,
  stage : String,
  inspection : Inspection,
  commit : CommitId,
) -> String {
  let public_paths = inspection.inventory
    .filter(entry => entry.disposition is Public)
    .map(entry => entry.path.0)
  let archive_path = join_host(stage, "source.zip")
  ignore(
    child(
      "git",
      [
        "-C",
        root,
        "archive",
        "--format=zip",
        "--output=" + archive_path,
        commit.0,
        "--",
        ".gitignore",
        ..public_paths,
      ],
    ),
  )
  let bytes = @fs.read_file(archive_path).binary()
  let archive = @zipc.Archive::from_bytes(bytes)
  for entry in archive.to_array() {
    let raw = entry.path()
    let path = if raw.has_suffix("/") {
      raw[:raw.length() - 1].to_owned()
    } else {
      raw
    }
    ignore(ModulePath::parse(path))
    let allowed = path == ".gitignore" ||
      public_paths.any(selected => {
        path == selected || path.has_prefix(selected + "/")
      }) ||
      (
        entry.is_dir() &&
        public_paths.any(selected => selected.has_prefix(path + "/"))
      )
    if !allowed || (entry.mode() & 0o170000) == 0o120000 {
      raise Refusal(
        ArchiveInvalid("Unexpected source snapshot member: " + path),
      )
    }
    write_member(stage, entry)
  }
  for manifest in inspection.ordered {
    if manifest.name == "finos/morphir" {
      let base = join_host(stage, manifest.path.0)
      let package_path = join_host(base, "moon.pkg")
      @fs.write_file(
        package_path,
        freeze_native_cli_package(@fs.read_file(package_path).text()),
      )
      @fs.write_file(
        join_host(base, published_native_stamp_file),
        published_native_stamp(manifest.version, commit),
        create_mode=CreateNew,
      )
    }
  }
  @fs.write_file(
    join_host(stage, "moon.work"),
    "members = " + Json(public_paths).stringify() + "\n",
  )
  @fs.remove(archive_path)
  digest(bytes)
}

///|
// This name is intentionally distinct from the checkout's ignored build_stamp.mbt.
let published_native_stamp_file : String = "published_build_stamp.mbt"

///|
fn published_native_stamp(version : String, commit : CommitId) -> String {
  "// Frozen native worker identity for this published source archive.\n\n" +
  "///|\nlet build_version : String = " +
  Json(version).stringify() +
  "\n\n///|\nlet build_commit : String = " +
  Json(commit.0).stringify() +
  "\n"
}

///|
fn freeze_native_cli_package(source : String) -> String raise {
  guard archive_package_config("moon.pkg", source) is Object(fields) else {
    raise Refusal(
      ArchiveInvalid("Native CLI package configuration is not an object"),
    )
  }
  let checkout_rules : Json = [
    {
      "command": "moonx $mod_dir/../../scripts/build-stamp.mbtx --version-file $mod_dir/moon.mod --output $output",
      "input": ["moon.mod"],
      "output": "build_stamp.mbt",
    },
  ]
  if fields.get("pre-build") != Some(checkout_rules) {
    raise Refusal(
      ArchiveInvalid(
        "Native CLI pre-build rules differ from the known identity generator",
      ),
    )
  }
  let (ast, _) = @manifest_parser.parse_moon_pkg(name="moon.pkg", source)
  guard ast is Obj(entries, ..) else {
    raise Refusal(
      ArchiveInvalid("Native CLI package configuration has no fields"),
    )
  }
  let mut location = None
  for (key, value) in entries {
    if key == "pre-build" {
      location = Some(value.loc())
    }
  }
  guard location is Some(span) else {
    raise Refusal(
      ArchiveInvalid("Native CLI pre-build rule location is absent"),
    )
  }
  // Use the public parser's exact value span, retaining every other option.
  let frozen = source[:span.start.cnum].to_owned() +
    "[]" +
    source[span.end.cnum:].to_owned()
  let expected = fields.copy()
  expected["pre-build"] = Json::array([])
  if archive_package_config("moon.pkg", frozen) != Json(expected) {
    raise Refusal(
      ArchiveInvalid(
        "Freezing the native identity changed another package option",
      ),
    )
  }
  frozen
}

///|
fn require_published_native_stamp(
  manifest : Manifest,
  commit : CommitId,
  contents : Map[String, Bytes],
) -> Unit raise {
  if contents.get(published_native_stamp_file) !=
    Some(@utf8.encode(published_native_stamp(manifest.version, commit))) ||
    contents.contains("build_stamp.mbt") {
    raise Refusal(
      ArchiveInvalid(
        "CLI archive lacks its exact candidate-bound native identity",
      ),
    )
  }
  guard contents.get("moon.pkg") is Some(package_source) &&
    archive_package_config("moon.pkg", @utf8.decode(package_source))
    is Object(fields) else {
    raise Refusal(
      ArchiveInvalid("CLI archive lacks its native package configuration"),
    )
  }
  if fields.get("pre-build") is Some(rules) && rules != Json::array([]) {
    raise Refusal(
      ArchiveInvalid("CLI archive still requires a consumer pre-build rule"),
    )
  }
}

///|
test "published native identity refuses missing changed and consumer-generated stamps" {
  let source =
    #|pkgtype(kind: "executable")
    #|supported_targets = "native"
    #|options(
    #|  "pre-build": [{
    #|    "command": "moonx $mod_dir/../../scripts/build-stamp.mbtx --version-file $mod_dir/moon.mod --output $output",
    #|    "input": ["moon.mod"],
    #|    "output": "build_stamp.mbt",
    #|  }],
    #|)

  let frozen = freeze_native_cli_package(source)
  let manifest = fixture_manifest("apps/morphir", "finos/morphir")
  let commit = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  let stamp = @utf8.encode(published_native_stamp(manifest.version, commit))
  let contents = { "moon.pkg": @utf8.encode(frozen) }
  contents[published_native_stamp_file] = stamp
  require_published_native_stamp(manifest, commit, contents)
  for kind in ["missing", "version", "commit", "pre-build", "checkout-stamp"] {
    let damaged = contents.copy()
    match kind {
      "missing" => ignore(damaged.remove(published_native_stamp_file))
      "version" =>
        damaged[published_native_stamp_file] = @utf8.encode(
          published_native_stamp("999.0.0", commit),
        )
      "commit" =>
        damaged[published_native_stamp_file] = @utf8.encode(
          published_native_stamp(
            manifest.version,
            CommitId::parse("ffffffffffffffffffffffffffffffffffffffff"),
          ),
        )
      "checkout-stamp" => damaged["build_stamp.mbt"] = stamp
      _ => damaged["moon.pkg"] = @utf8.encode(source)
    }
    let refused = try {
      require_published_native_stamp(manifest, commit, damaged)
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused, msg=kind)
  }
  let unknown_rule = source.replace_all(
    old="scripts/build-stamp.mbtx",
    new="scripts/another-build.mbtx",
  )
  let refused = try {
    ignore(freeze_native_cli_package(unknown_rule))
    false
  } catch {
    Refusal(_) => true
    error => raise error
  }
  assert_true(
    refused,
    msg="Unknown repository build rules must not be discarded",
  )
}

///|
let node_producer_inputs : Array[String] = [
  "package.json", "bun.lock", "tsconfig.base.json", "tsconfig.node.json", "tsconfig.browser.json",
  "tsconfig.worker.json", "tsconfig.tooling.json", "tsconfig.json", "tools/build.ts",
  "tools/build-runtimes.ts", "types", "scripts/native-cli-release.mbtx", "scripts/mooncakes-release.mbtx",
  ".config/mise/config.toml",
]

///|
struct PayloadAsset {
  path : ModulePath
  bytes : Bytes
}

///|
fn require_payload_archive(contents : Map[String, Bytes]) -> Unit raise {
  guard contents.contains("moonx/moon.pkg") &&
    contents.get("moonx/payload.mbt") is Some(source) &&
    contents.get("moonx/payload-provenance.json") is Some(bytes) else {
    raise Refusal(
      ArchiveInvalid("CLI archive lacks its generated Moonx payload"),
    )
  }
  let provenance = @json.parse(@utf8.decode(bytes)) catch {
    _ => raise Refusal(ArchiveInvalid("Invalid Moonx payload provenance"))
  }
  if string_field(provenance, "profile") != Some("morphir/moonx-payload") ||
    string_field(provenance, "contractVersion") != Some("0.1.0") ||
    string_field(provenance, "entry") != Some("bin/morphir.js") ||
    string_field(provenance, "embeddedSourceSha256") != Some(digest(source)) ||
    !@utf8.decode(source).has_prefix(
      "// Generated Morphir Moonx payload, contract 0.1.0.\n",
    ) {
    raise Refusal(
      ArchiveInvalid("CLI archive has an unstaged or changed Moonx payload"),
    )
  }
  ignore(CommitId::parse(required_string(provenance, "sourceCommit")))
  for
    field in [
      "sourceSnapshotSha256", "producerInputsArchiveSha256", "generatorSha256",
    ] {
    let hash = required_string(provenance, field)
    if hash.length() != 64 ||
      !hash.iter().all(c => "0123456789abcdef".contains(c.to_string())) {
      raise Refusal(ArchiveInvalid("Invalid Moonx producer checksum: " + field))
    }
  }
  if object_field(provenance, "producerInputs") !=
    Some(Json(node_producer_inputs)) ||
    object_field(provenance, "consumerBuildRulesRequired") != Some(Json(false)) ||
    object_field(provenance, "separateNpmInstallationRequired") !=
    Some(Json(false)) ||
    required_string(provenance, "compilerVersion").is_empty() ||
    required_string(provenance, "bunVersion").is_empty() {
    raise Refusal(ArchiveInvalid("Incomplete Moonx producer provenance"))
  }
  guard object_field(provenance, "files") is Some(Array(files)) &&
    !files.is_empty() else {
    raise Refusal(ArchiveInvalid("Moonx payload inventory is empty"))
  }
  let paths : Map[String, Bool] = Map([])
  for file in files {
    let path = ModulePath::parse(required_string(file, "path"))
    if path.0 == "." || paths.contains(path.0) {
      raise Refusal(ArchiveInvalid("Invalid Moonx payload inventory path"))
    }
    paths[path.0] = true
    ignore(decimal_id(object_field(file, "bytes").unwrap_or(Json::null())))
    let hash = required_string(file, "sha256")
    if hash.length() != 64 ||
      !hash.iter().all(c => "0123456789abcdef".contains(c.to_string())) {
      raise Refusal(ArchiveInvalid("Invalid Moonx payload file checksum"))
    }
  }
  for
    required in [
      "bin/morphir.js", "package.json", "dist/morphir.js", "dist/connected-core.js",
      "dist/wasm-worker.js", "LICENSE", "NOTICE", "notices.json",
    ] {
    if !paths.contains(required) {
      raise Refusal(ArchiveInvalid("Missing Moonx runtime asset: " + required))
    }
  }
}

///|
fn payload_asset_fact(asset : PayloadAsset) -> Json {
  {
    "path": asset.path.0,
    "bytes": asset.bytes.length(),
    "sha256": digest(asset.bytes),
  }
}

///|
// Core Bytes Show produces MoonBit literals, including every byte value. Small
// literals avoid source-column overflow and the memory cost of integer arrays.
fn embedded_bytes_source(index : Int32, bytes : Bytes) -> String {
  let source : Array[String] = [
    "///|\nfn payload_file_" + index.to_string() + "() -> Bytes {",
    "  let chunks : Array[Bytes] = [",
  ]
  let mut start = 0
  while start < bytes.length() {
    let end = if start + 4096 < bytes.length() {
      start + 4096
    } else {
      bytes.length()
    }
    source.push("    " + bytes[start:end].to_owned().to_string() + ",")
    start = end
  }
  source.push(
    "  ]\n  Bytes::from_iter(chunks.iter().flat_map(chunk => chunk.iter()))\n}\n",
  )
  source.join("\n")
}

///|
fn embedded_payload_source(assets : Array[PayloadAsset]) -> String {
  let source = ["// Generated Morphir Moonx payload, contract 0.1.0.\n"]
  let files : Array[String] = []
  for index, asset in assets {
    source.push(embedded_bytes_source(index, asset.bytes))
    files.push(
      "    @launcher.PayloadFile::new(@launcher.RelativeFilePath::parse(" +
      Json(asset.path.0).stringify() +
      "), payload_file_" +
      index.to_string() +
      "()),",
    )
  }
  source.push(
    "///|\nfn packaged_payload() -> @launcher.Payload raise {\n  let files = [\n" +
    files.join("\n") +
    "\n  ]\n  @launcher.Payload::new(files, @launcher.RelativeFilePath::parse(\"bin/morphir.js\"))\n}\n",
  )
  source.join("\n")
}

///|
async test "generated byte literals reconstruct empty binary and chunk boundaries" {
  let stage = @fs.realpath(@fs.tmpdir(prefix="morphir-payload-literals-"))
  defer @fs.rmdir(stage, recursive=true)
  @fs.write_file(
    join_host(stage, "moon.mod"),
    "name = \"finos/morphir-payload-literals\"\nversion = \"0.0.0\"\nimport { \"moonbitlang/x@0.5.6\" }\n",
  )
  @fs.write_file(
    join_host(stage, "moon.pkg"),
    "pkgtype(kind: \"executable\")\nimport { \"moonbitlang/x/crypto\" }\n",
  )
  let cases = [
    b"",
    Bytes::from_array(Array::makei(256, i => i.to_byte())),
    Bytes::from_array(Array::makei(8193, i => (i % 256).to_byte())),
  ]
  @fs.write_file(
    join_host(stage, "payload.mbt"),
    cases.mapi((index, bytes) => embedded_bytes_source(index, bytes)).join("\n"),
  )
  @fs.write_file(
    join_host(stage, "main.mbt"),
    "fn main {\n" +
    cases
    .mapi((index, _) => {
      "  println(@crypto.bytes_to_hex_string(@crypto.sha256(payload_file_" +
      index.to_string() +
      "())))"
    })
    .join("\n") +
    "\n}\n",
  )
  let output = consumer_child("moon", ["run", ".", "--target", "wasm"], stage, {
    "MOON_WORK": "off",
  })
  assert_eq(output.trim(), cases.map(digest).join("\n"))
}

///|
test "Moonx archives refuse placeholders changed source and incomplete provenance" {
  let names = [
    "bin/morphir.js", "package.json", "dist/morphir.js", "dist/connected-core.js",
    "dist/wasm-worker.js", "LICENSE", "NOTICE", "notices.json",
  ]
  let assets = names.map(name => PayloadAsset::{
    path: ModulePath::parse(name),
    bytes: b"fixture",
  })
  let source = @utf8.encode(embedded_payload_source(assets))
  let provenance : Json = {
    "profile": "morphir/moonx-payload",
    "contractVersion": "0.1.0",
    "sourceCommit": "0123456789abcdef0123456789abcdef01234567",
    "sourceSnapshotSha256": digest(b"snapshot"),
    "producerInputsArchiveSha256": digest(b"inputs"),
    "generatorSha256": digest(b"generator"),
    "producerInputs": node_producer_inputs,
    "compilerVersion": "fixture-compiler",
    "bunVersion": "1.4.4",
    "entry": "bin/morphir.js",
    "files": assets.map(payload_asset_fact),
    "embeddedSourceSha256": digest(source),
    "consumerBuildRulesRequired": false,
    "separateNpmInstallationRequired": false,
  }
  let contents = {
    "moonx/moon.pkg": b"fixture",
    "moonx/payload.mbt": source,
    "moonx/payload-provenance.json": @utf8.encode(provenance.stringify()),
  }
  require_payload_archive(contents)
  for
    kind in [
      "missing", "placeholder", "changed", "provenance", "inventory", "worker",
    ] {
    let damaged = contents.copy()
    if kind == "missing" {
      ignore(damaged.remove("moonx/payload.mbt"))
    }
    if kind == "placeholder" {
      damaged["moonx/payload.mbt"] = b"fn packaged_payload() { abort(\"not staged\") }"
    }
    if kind == "changed" {
      damaged["moonx/payload.mbt"] = source + b"\n// Changed"
    }
    if kind == "provenance" {
      damaged["moonx/payload-provenance.json"] = b"{}"
    }
    if kind == "inventory" {
      guard @json.parse(provenance.stringify()) is Object(fields) else {
        abort("Fixture")
      }
      fields["files"] = Json::array([])
      damaged["moonx/payload-provenance.json"] = @utf8.encode(
        Json(fields).stringify(),
      )
    }
    if kind == "worker" {
      guard @json.parse(provenance.stringify()) is Object(fields) else {
        abort("Fixture")
      }
      fields["files"] = Json(
        assets
        .filter(asset => asset.path.0 != "dist/wasm-worker.js")
        .map(payload_asset_fact),
      )
      damaged["moonx/payload-provenance.json"] = @utf8.encode(
        Json(fields).stringify(),
      )
    }
    let refused = try {
      require_payload_archive(damaged)
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused, msg=kind)
  }
}

///|
async fn prepare_node_payload(
  root : String,
  destination : String,
  inspection : Inspection,
  commit : CommitId,
  compiler : String,
  source_snapshot_sha256 : String,
) -> Unit {
  let stage = @fs.realpath(@fs.tmpdir(prefix="morphir-node-producer-"))
  defer @fs.rmdir(stage, recursive=true)
  if snapshot_public_sources(root, stage, inspection, commit) !=
    source_snapshot_sha256 {
    raise Refusal(CandidateMismatch("Node producer source snapshot changed"))
  }
  let archive_path = join_host(stage, "producer.zip")
  ignore(
    child(
      "git",
      [
        "-C",
        root,
        "archive",
        "--format=zip",
        "--output=" + archive_path,
        commit.0,
        "--",
        ..node_producer_inputs,
      ],
    ),
  )
  let producer_bytes = @fs.read_file(archive_path).binary()
  for file in @zipc.Archive::from_bytes(producer_bytes).to_array() {
    if !file.is_dir() || !@fs.exists(join_host(stage, file.path())) {
      write_member(stage, file)
    }
  }
  @fs.remove(archive_path)
  let bun = child("bun", ["--version"]).trim().to_owned()
  let root_package = @json.parse(
    @fs.read_file(join_host(stage, "package.json")).text(),
  )
  if required_string(root_package, "packageManager") != "bun@" + bun {
    raise Refusal(
      CandidateMismatch("Node payload requires the committed Bun pin"),
    )
  }
  let environment = { "MOON_WORK": join_host(stage, "moon.work") }
  ignore(
    consumer_child(
      "bun",
      ["install", "--frozen-lockfile", "--ignore-scripts"],
      stage,
      environment,
    ),
  )
  ignore(
    consumer_child(
      "bun",
      ["--check", "apps/morphir/scripts/build.ts"],
      stage,
      environment,
    ),
  )
  let base = join_host(stage, "apps/morphir")
  let names = [
    "package.json", "LICENSE", "NOTICE", "bin/morphir.js", "dist/morphir.js", "dist/connected-core.js",
    "dist/wasm-worker.js",
  ]
  for file in @fs.readdir(join_host(base, "build-provider")) {
    if file.has_suffix(".mjs") ||
      file.has_suffix(".cs") ||
      file.has_suffix(".ps1") {
      names.push("build-provider/" + file)
    }
  }
  let assets : Array[PayloadAsset] = []
  for name in names {
    confined_file(base, name, MissingModule("Node runtime asset: " + name))
    assets.push({
      path: ModulePath::parse(name),
      bytes: @fs.read_file(join_host(base, name)).binary(),
    })
  }
  let notices_directory = join_host(stage, "cli-notices")
  let notices = @json.parse(
    consumer_child(
      "moon",
      [
        "run", "scripts/native-cli-release.mbtx", "--", "notices", "--directory",
        notices_directory, "--json",
      ],
      stage,
      environment,
    ),
  )
  guard object_field(notices, "result") is Some(result) &&
    object_field(result, "files") is Some(Array(files)) else {
    raise Refusal(CandidateMismatch("Node dependency notices are unavailable"))
  }
  for file in files {
    let name = required_string(file, "path")
    confined_file(notices_directory, name, MissingLicense(name))
    let bytes = @fs.read_file(join_host(notices_directory, name)).binary()
    if digest(bytes) != required_string(file, "sha256") {
      raise Refusal(
        CandidateMismatch("Node dependency notice changed: " + name),
      )
    }
    assets.push({ path: ModulePath::parse(name), bytes, })
  }
  assets.push({
    path: ModulePath::parse("notices.json"),
    bytes: @fs.read_file(join_host(notices_directory, "notices.json")).binary(),
  })
  assets.sort_by((a, b) => a.path.0.lexical_compare(b.path.0))
  let paths : Map[String, Bool] = Map([])
  for asset in assets {
    if paths.contains(asset.path.0) {
      raise Refusal(DuplicatePath(asset.path.0))
    }
    paths[asset.path.0] = true
  }
  let generated = @utf8.encode(embedded_payload_source(assets))
  let provenance : Json = {
    "profile": "morphir/moonx-payload",
    "contractVersion": "0.1.0",
    "sourceCommit": commit.0,
    "sourceSnapshotSha256": source_snapshot_sha256,
    "producerInputs": node_producer_inputs,
    "producerInputsArchiveSha256": digest(producer_bytes),
    "generatorSha256": digest(
      @fs.read_file(join_host(stage, "scripts/mooncakes-release.mbtx")).binary(),
    ),
    "compilerVersion": compiler,
    "bunVersion": bun,
    "entry": "bin/morphir.js",
    "files": assets.map(payload_asset_fact),
    "embeddedSourceSha256": digest(generated),
    "consumerBuildRulesRequired": false,
    "separateNpmInstallationRequired": false,
  }
  @fs.write_file(
    join_host(destination, "apps/morphir/moonx/payload.mbt"),
    generated,
  )
  @fs.write_file(
    join_host(destination, "apps/morphir/moonx/payload-provenance.json"),
    provenance.stringify() + "\n",
    create_mode=CreateNew,
  )
}

///|
// Compile the delivered source without consumer build rules, and verify every
// reconstructed asset through the public immutable Payload API. The caller's
// compiler and environment also make this run on the minimum compiler.
async fn qualify_payload_bytes(
  stage : String,
  packages : Array[PackagedModule],
  moon : String,
  environment : Map[String, String],
) -> Unit {
  let cli = packages
    .iter()
    .filter(record => record.manifest.name == "finos/morphir")
    .next()
  guard cli is Some(cli) &&
    cli.manifest.dependencies.get("moonrockz/moon-lander-moonx")
    is Some(version) else {
    return
  }
  let base = join_host(stage, cli.manifest.path.0 + "/moonx")
  let source = @fs.read_file(join_host(base, "payload.mbt")).binary()
  let provenance = @json.parse(
    @fs.read_file(join_host(base, "payload-provenance.json")).text(),
  )
  guard object_field(provenance, "files") is Some(Array(files)) else {
    raise Refusal(ArchiveInvalid("Moonx payload inventory is unavailable"))
  }
  let probe = @fs.realpath(@fs.tmpdir(prefix="morphir-payload-consumer-"))
  defer @fs.rmdir(probe, recursive=true)
  @fs.write_file(
    join_host(probe, "moon.mod"),
    "name = \"finos/morphir-payload-consumer\"\nversion = \"0.0.0\"\nimport {\n  \"moonrockz/moon-lander-moonx@" +
    version +
    "\",\n  \"moonbitlang/x@0.5.6\",\n}\n",
  )
  @fs.write_file(
    join_host(probe, "moon.pkg"),
    "pkgtype(kind: \"executable\")\nimport {\n \"moonbitlang/x/crypto\",\n \"moonrockz/moon-lander-moonx\" @launcher,\n}\n",
  )
  @fs.write_file(join_host(probe, "payload.mbt"), source)
  let entries = files.map(file => {
    "    (" +
    Json(required_string(file, "path")).stringify() +
    ", (" +
    decimal_id(object_field(file, "bytes").unwrap_or(Json::null())) +
    ", " +
    Json(required_string(file, "sha256")).stringify() +
    ")),"
  })
  @fs.write_file(
    join_host(probe, "main.mbt"),
    "fn main raise {\n  let expected : Map[String, (Int, String)] = Map([\n" +
    entries.join("\n") +
    "\n  ])\n  let files = packaged_payload().files()\n  assert_eq(files.length(), expected.length())\n  for file in files {\n    let (size, hash) = expected[file.path().to_string()]\n    assert_eq(file.bytes().length(), size)\n    assert_eq(@crypto.bytes_to_hex_string(@crypto.sha256(file.bytes())), hash)\n  }\n  println(\"morphir-moonx-payload-ok\")\n}\n",
  )
  let environment = environment.copy()
  environment["MOON_WORK"] = "off"
  let output = consumer_child(
    moon,
    ["run", ".", "--target", "wasm"],
    probe,
    environment,
  )
  if output.trim() != "morphir-moonx-payload-ok" {
    raise Refusal(
      ArchiveInvalid("Delivered Moonx payload reconstruction failed"),
    )
  }
}

///|
async fn write_member(directory : String, entry : @zipc.Member) -> Unit {
  let raw = entry.path()
  let path = if raw.has_suffix("/") {
    raw[:raw.length() - 1].to_owned()
  } else {
    raw
  }
  ignore(ModulePath::parse(path))
  if (entry.mode() & 0o170000) == 0o120000 || forbidden_archive_path(path) {
    raise Refusal(ArchiveInvalid("Unsafe snapshot member: " + path))
  }
  let destination = join_host(directory, path)
  match entry.kind() {
    Dir => @fs.mkdir(destination, recursive=true, allow_exist=true)
    File(file) => {
      @fs.mkdir(
        @host_path.Path(destination).dirname().0,
        recursive=true,
        allow_exist=true,
      )
      @fs.write_file(
        destination,
        file.to_bytes(),
        create_mode=CreateNew,
        permission=entry.mode() & 0o777,
      )
    }
  }
}

///|
async fn verify_archive_graph(
  root : String,
  packages : Array[PackagedModule],
  moon~ : String = "moon",
  environment~ : Map[String, String] = Map([]),
  qualify~ : (async (String, Map[String, String]) -> Unit)? = None,
) -> Array[String] {
  let stage = @fs.tmpdir(prefix="morphir-release-archives-")
  defer @fs.rmdir(stage, recursive=true)
  unpack_packages(root, packages, stage)
  let targets = ["wasm", "wasm-gc", "js", "native"]
  let environment = environment.copy()
  environment["MOON_WORK"] = join_host(stage, "moon.work")
  for target in targets {
    let (status, stdout, stderr) = @process.collect_output(
      moon,
      ["-C", stage, "build", "--target", target],
      extra_env=environment,
    )
    write_diagnostic(stdout.text())
    write_diagnostic(stderr.text())
    if status != 0 {
      raise Refusal(
        ArchiveInvalid("Isolated archive graph failed on " + target),
      )
    }
  }
  // moon publish packages each module with no target option, so it checks the
  // module on the default backend unless the manifest prefers another. Run the
  // same step here, before any credential exists.
  for record in packages {
    let (status, stdout, stderr) = @process.collect_output(
      moon,
      ["-C", join_host(stage, record.manifest.path.0), "package"],
      extra_env=environment,
    )
    write_diagnostic(stdout.text())
    write_diagnostic(stderr.text())
    if status != 0 {
      raise Refusal(
        ArchiveInvalid(
          "Isolated archive cannot be packaged as moon publish does: " +
          record.manifest.name,
        ),
      )
    }
  }
  qualify_payload_bytes(stage, packages, moon, environment)
  if qualify is Some(run) {
    run(stage, environment)
  }
  targets
}

///|
async fn unpack_packages(
  root : String,
  packages : Array[PackagedModule],
  stage : String,
) -> Unit {
  for record in packages {
    let bytes = @fs.read_file(join_host(root, record.archive_path)).binary()
    if digest(bytes) != record.evidence.archive_sha256 {
      raise Refusal(
        ArchiveInvalid(
          "Package changed before isolated build: " + record.manifest.name,
        ),
      )
    }
    let directory = join_host(stage, record.manifest.path.0)
    @fs.mkdir(directory, recursive=true, allow_exist=true)
    for entry in @zipc.Archive::from_bytes(bytes).to_array() {
      write_member(directory, entry)
    }
  }
  @fs.write_file(
    join_host(stage, "moon.work"),
    "members = " +
    Json(packages.map(record => record.manifest.path.0)).stringify() +
    "\n",
  )
}

///|
async test "archive verification ignores a hostile ambient workspace override" {
  let root = @fs.tmpdir(prefix="morphir hostile workspace ")
  defer @fs.rmdir(root, recursive=true)
  let files = fixture_archive_files()
  files.push(("answer.mbt", b"pub fn answer() -> Int { 42 }\n"))
  let bytes = fixture_archive(files)
  @fs.write_file(join_host(root, "archive.zip"), bytes)
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let record : PackagedModule = {
    manifest,
    archive_path: "archive.zip",
    evidence: inspect_archive(manifest, bytes),
  }
  let previous = @env.get_env_var("MOON_WORK")
  @env.set_env_var("MOON_WORK", join_host(root, "missing/hostile/moon.work"))
  defer (match previous {
    Some(value) => @env.set_env_var("MOON_WORK", value)
    None => @env.unset_env_var("MOON_WORK")
  })
  assert_eq(verify_archive_graph(root, [record]), [
    "wasm", "wasm-gc", "js", "native",
  ])
}

///|
async fn package_sources(
  root : String,
  inspection : Inspection,
  archive_environment~ : Map[String, String] = Map([]),
) -> PackageSet {
  let commit = require_clean_sources(root, inspection)
  let (compiler, core_pin_sha256) = compiler_for(root, commit)
  let stage = @fs.tmpdir(prefix="morphir-release-sources-")
  defer @fs.rmdir(stage, recursive=true)
  let source_snapshot_sha256 = snapshot_public_sources(
    root, stage, inspection, commit,
  )
  if @fs.exists(join_host(stage, "apps/morphir/moonx/moon.pkg")) {
    prepare_node_payload(
      root, stage, inspection, commit, compiler, source_snapshot_sha256,
    )
  }
  let output = join_host(root, ".dev/mooncakes-release/build/" + commit.0)
  @fs.mkdir(output, recursive=true, allow_exist=true)
  let packages = []
  for index, manifest in inspection.ordered {
    let args = [
      "-C",
      join_host(stage, manifest.path.0),
      "package",
      "--target-dir",
      output,
    ]
    // The first package resolves the isolated public graph. Every subsequent
    // package freezes that same graph instead of resolving dependencies again.
    if index > 0 {
      args.push("--frozen")
    }
    let (status, stdout, stderr) = @process.collect_output("moon", args, extra_env={
      "MOON_WORK": join_host(stage, "moon.work"),
    })
    write_diagnostic(stdout.text())
    write_diagnostic(stderr.text())
    if status != 0 {
      raise Refusal(ArchiveInvalid("Moon packaging failed: " + manifest.name))
    }
    let filename = manifest.name.replace_all(old="/", new="-") +
      "-" +
      manifest.version +
      ".zip"
    let relative = ".dev/mooncakes-release/build/" +
      commit.0 +
      "/publish/" +
      filename
    let evidence = inspect_archive(
      manifest,
      @fs.read_file(join_host(root, relative)).binary(),
    )
    packages.push({ manifest, archive_path: relative, evidence, })
  }
  if require_clean_sources(root, inspection) != commit {
    raise Refusal(CandidateMismatch("Source commit changed during packaging"))
  }
  let isolated_targets = verify_archive_graph(
    root,
    packages,
    environment=archive_environment,
  )
  { commit, compiler, core_pin_sha256, packages, isolated_targets, }
}

///|
fn package_set_json(packages : PackageSet) -> Json {
  {
    "sha": packages.commit.0,
    "compilerVersion": packages.compiler,
    "corePinSha256": packages.core_pin_sha256,
    "isolatedTargets": packages.isolated_targets,
    "modules": packages.packages.map(fn(record : PackagedModule) -> Json {
      {
        "path": record.manifest.path.0,
        "name": record.manifest.name,
        "version": record.manifest.version,
        "archivePath": record.archive_path,
        "archiveSha256": record.evidence.archive_sha256,
        "contentSha256": record.evidence.content_sha256,
        "bytes": record.evidence.bytes,
        "files": record.evidence.files,
      }
    }),
  }
}

///|
fn require_plan(value : Json, inspection : Inspection) -> Candidate raise {
  if string_field(value, "profile") != Some("morphir/mooncakes-plan") ||
    string_field(value, "contractVersion") != Some("0.1.0") {
    raise Refusal(CandidateMismatch("Unknown release plan contract"))
  }
  let mode = match required_string(value, "mode") {
    "publish" => Publish
    "dry-run" => DryRun
    _ => raise Refusal(CandidateMismatch("Invalid release plan mode"))
  }
  Candidate::from_input(
    inspection.version.0,
    required_string(value, "tag"),
    required_string(value, "sha"),
    mode,
  )
}

///|
fn require_package_proof(plan : Json, current : PackageSet) -> Unit raise {
  guard plan is Object(fields) && fields.get("packages") is Some(expected) else {
    raise Refusal(CandidateMismatch("Plan has no package evidence"))
  }
  if expected != package_set_json(current) {
    raise Refusal(
      CandidateMismatch(
        "Candidate package, source or toolchain evidence changed since planning",
      ),
    )
  }
  if object_field(plan, "minimumConsumer") != Some(minimum_proof(current)) {
    raise Refusal(
      CandidateMismatch("Missing or mismatched minimum compiler qualification"),
    )
  }
}

///|
fn package_filename(manifest : Manifest) -> String {
  manifest.name.replace_all(old="/", new="-") + "-" + manifest.version + ".zip"
}

///|
async fn read_planned_archives(
  root : String,
  inspection : Inspection,
  plan : Json,
  compiler : String,
  core_pin_sha256 : String,
) -> PackageSet {
  let candidate = require_plan(plan, inspection)
  let packages = []
  for manifest in inspection.ordered {
    let relative = ".dev/mooncakes-release/build/" +
      candidate.commit.0 +
      "/publish/" +
      package_filename(manifest)
    confined_file(root, relative, MissingModule(relative))
    let bytes = @fs.read_file(join_host(root, relative)).binary()
    packages.push({
      manifest,
      archive_path: relative,
      evidence: inspect_archive(manifest, bytes),
    })
  }
  let result = {
    commit: candidate.commit,
    compiler,
    core_pin_sha256,
    packages,
    isolated_targets: ["wasm", "wasm-gc", "js", "native"],
  }
  require_package_proof(plan, result)
  result
}

///|
async fn retained_packages(
  root : String,
  inspection : Inspection,
  plan : Json,
) -> PackageSet {
  let candidate = require_plan(plan, inspection)
  if require_clean_sources(root, inspection) != candidate.commit {
    raise Refusal(
      CandidateMismatch("Retained archives differ from checkout SHA"),
    )
  }
  let (compiler, core_pin_sha256) = compiler_for(root, candidate.commit)
  read_planned_archives(root, inspection, plan, compiler, core_pin_sha256)
}

///|
async test "retained archive handoff refuses changed missing and redirected artifacts" {
  let root = @fs.realpath(@fs.tmpdir(prefix="morphir-retained-test-"))
  defer @fs.rmdir(root, recursive=true)
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let inspection : Inspection = {
    inventory: [fixture_entry("pkgs/core", "finos/morphir-core")],
    ordered: [manifest],
    version: ReleaseVersion::parse("0.1.0"),
  }
  let commit = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  let directory = ".dev/mooncakes-release/build/" + commit.0 + "/publish"
  @fs.mkdir(join_host(root, directory), recursive=true)
  let relative = directory + "/" + package_filename(manifest)
  let original = fixture_archive(fixture_archive_files())
  @fs.write_file(join_host(root, relative), original)
  let packages : PackageSet = {
    commit,
    compiler: "fixture-compiler",
    core_pin_sha256: "fixture-core",
    packages: [
      {
        manifest,
        archive_path: relative,
        evidence: inspect_archive(manifest, original),
      },
    ],
    isolated_targets: ["wasm", "wasm-gc", "js", "native"],
  }
  let plan : Json = {
    "profile": "morphir/mooncakes-plan",
    "contractVersion": "0.1.0",
    "tag": "v0.1.0",
    "sha": commit.0,
    "mode": "dry-run",
    "packages": package_set_json(packages),
    "minimumConsumer": minimum_proof(packages),
  }
  let retained = read_planned_archives(
    root, inspection, plan, "fixture-compiler", "fixture-core",
  )
  assert_eq(package_set_json(retained), package_set_json(packages))
  let extracted = join_host(root, "extracted")
  @fs.mkdir(extracted)
  unpack_packages(root, retained.packages, extracted)
  assert_eq(
    @fs.read_file(join_host(extracted, "pkgs/core/native.c")).binary(),
    b"/* Fixture native asset */",
  )
  for kind in ["changed", "missing", "redirected"] {
    @fs.write_file(join_host(root, relative), original)
    let redirected = @json.parse(plan.stringify())
    if kind == "changed" {
      let changed = fixture_archive_files().map(file => {
        if file.0 == "README.md" {
          (file.0, b"Changed")
        } else {
          file
        }
      })
      @fs.write_file(join_host(root, relative), fixture_archive(changed))
    } else if kind == "missing" {
      @fs.remove(join_host(root, relative))
    } else if redirected is Object(fields) &&
      fields.get("packages") is Some(Object(proof)) &&
      proof.get("modules") is Some(Array([Object(record)])) {
      record["archivePath"] = Json("../../must-not-be-read.zip")
    } else {
      abort("Invalid fixture")
    }
    let refused = try {
      ignore(
        read_planned_archives(
          root, inspection, redirected, "fixture-compiler", "fixture-core",
        ),
      )
      false
    } catch {
      Refusal(_) => true
      error => raise error
    }
    assert_true(refused, msg=kind)
  }
}

///|
async fn reproduce_archives(stage : String, packages : PackageSet) -> Unit {
  let output = join_host(stage, "reproduced")
  for index, record in packages.packages {
    let args = [
      "-C",
      join_host(stage, record.manifest.path.0),
      "package",
      "--target-dir",
      output,
    ]
    if index > 0 {
      args.push("--frozen")
    }
    let (status, stdout, stderr) = @process.collect_output("moon", args, extra_env={
      "MOON_WORK": join_host(stage, "moon.work"),
    })
    write_diagnostic(stdout.text())
    write_diagnostic(stderr.text())
    if status != 0 {
      raise Refusal(
        ArchiveInvalid(
          "Retained archive cannot be repackaged: " + record.manifest.name,
        ),
      )
    }
    let bytes = @fs.read_file(
      join_host(output, "publish/" + package_filename(record.manifest)),
    ).binary()
    if digest(bytes) != record.evidence.archive_sha256 {
      raise Refusal(
        ArchiveInvalid(
          "Repackaging changed qualified archive: " + record.manifest.name,
        ),
      )
    }
  }
}

///|
async fn check_retained_archives(root : String, packages : PackageSet) -> Unit {
  let stage = @fs.tmpdir(prefix="morphir-release-retained-")
  defer @fs.rmdir(stage, recursive=true)
  unpack_packages(root, packages.packages, stage)
  reproduce_archives(stage, packages)
}

///|
fn require_portable_support(packages : PackageSet) -> Manifest raise {
  guard packages.packages
    .iter()
    .filter(record => record.manifest.name == "finos/morphir")
    .next()
    is Some(cli) &&
    cli.manifest.dependencies.contains("moonrockz/moon-lander-moonx") else {
    raise Refusal(
      ArchiveInvalid(
        "Selected host qualification requires the generated Moonx entry",
      ),
    )
  }
  cli.manifest
}

///|
enum SourceQualificationScope {
  Workstation
  Actions(CommitId)
}

///|
fn require_source_revision(
  actual : CommitId,
  scope : SourceQualificationScope,
) -> Unit raise Refusal {
  match scope {
    Workstation => ()
    Actions(expected) if expected == actual => ()
    Actions(_) =>
      raise Refusal(
        CandidateMismatch("Source qualification HEAD differs from GITHUB_SHA"),
      )
  }
}

///|
test "source qualification cannot substitute another Actions revision" {
  let actual = CommitId::parse("0123456789abcdef0123456789abcdef01234567")
  require_source_revision(actual, Workstation)
  require_source_revision(actual, Actions(actual))
  assert_true(
    refused(() => {
      require_source_revision(
        actual,
        Actions(CommitId::parse("1123456789abcdef0123456789abcdef01234567")),
      )
    })
    is Some(_),
  )
}

///|
async fn qualify_source_cli(root : String, inspection : Inspection) -> Json {
  let scope = if @env.get_env_var("GITHUB_ACTIONS") == Some("true") {
    Actions(CommitId::parse(@env.get_env_var("GITHUB_SHA").unwrap_or("")))
  } else {
    Workstation
  }
  require_source_revision(require_clean_sources(root, inspection), scope)
  let archive_environment : Map[String, String] = Map([])
  if @env.get_env_var("OS") == Some("Windows_NT") {
    archive_environment["CL"] = @env.get_env_var("CL").unwrap_or("") +
      " /bigobj"
  }
  let packages = package_sources(root, inspection, archive_environment~)
  require_source_revision(packages.commit, scope)
  let acceptance = qualify_retained_cli(root, packages)
  {
    "profile": "morphir/moonx-source-host-qualification",
    "contractVersion": "0.1.0",
    "state": "succeeded",
    "sha": packages.commit.0,
    "acceptance": acceptance,
  }
}

///|
async fn qualify_retained_cli(root : String, packages : PackageSet) -> Json {
  let cli = require_portable_support(packages)
  let stage = @fs.realpath(@fs.tmpdir(prefix="morphir-moonx-host-"))
  let failed = Ref(false)
  defer dispose_owned_stage(stage, preserving_error=failed.val)
  errdefer {
    failed.val = true
  }
  unpack_packages(root, packages.packages, stage)
  let payload = @json.parse(
    @fs.read_file(
      join_host(stage, cli.path.0 + "/moonx/payload-provenance.json"),
    ).text(),
  )
  let environment = consumer_environment(moon_home(), stage)
  let moon = join_host(environment["MOON_HOME"], "bin/moon")
  ignore(consumer_child(moon, ["update"], stage, environment))
  qualify_payload_bytes(stage, packages.packages, moon, environment)
  qualify_portable_cli(
    moon,
    ["run", cli.path.0 + "/moonx", "--target", "wasm", "--"],
    stage,
    environment,
    ReleaseVersion::parse(cli.version),
  )
  let portable = qualify_portable_boundary(
    root,
    stage,
    environment,
    ReleaseVersion::parse(cli.version),
    ArchiveEntry(build_portable_entry(stage, environment)),
  )
  if portable is Object(fields) {
    fields["wasmWorkerGuestError"] = Json("passed")
  }
  let minimum_directory = release_file(
    root, ".dev/mooncakes-release/minimum-toolchain",
  )
  if !@fs.exists(minimum_directory) {
    ignore(bootstrap_minimum(root))
  }
  let minimum_source = minimum_compiler_source(root, minimum_directory)
  let minimum_stage = @fs.realpath(
    @fs.tmpdir(prefix="morphir-moonx-minimum-host-"),
  )
  let minimum_failed = Ref(false)
  defer dispose_owned_stage(minimum_stage, preserving_error=minimum_failed.val)
  errdefer {
    minimum_failed.val = true
  }
  unpack_packages(root, packages.packages, minimum_stage)
  let minimum_environment = consumer_environment(minimum_source, minimum_stage)
  let minimum_moon = join_host(minimum_environment["MOON_HOME"], "bin/moon")
  ignore(
    consumer_child(minimum_moon, ["update"], minimum_stage, minimum_environment),
  )
  qualify_payload_bytes(
    minimum_stage,
    packages.packages,
    minimum_moon,
    minimum_environment,
  )
  // Compilation has its own gate. The guest probe's bound covers runtime
  // startup, the guest fault and process cleanup on this selected artifact.
  let minimum_artifact = build_portable_entry(
    minimum_stage, minimum_environment,
  )
  let runner_suffix = if @env.get_env_var("OS") == Some("Windows_NT") {
    ".exe"
  } else {
    ""
  }
  qualify_worker_cli(
    join_host(minimum_environment["MOON_HOME"], "bin/moonrun" + runner_suffix),
    [minimum_artifact, "--"],
    minimum_stage,
    minimum_environment,
  )
  let minimum_portable = qualify_portable_boundary(
    root,
    minimum_stage,
    minimum_environment,
    ReleaseVersion::parse(cli.version),
    ArchiveEntry(minimum_artifact),
  )
  if minimum_portable is Object(fields) {
    fields["wasmWorkerGuestError"] = Json("passed")
  }
  let host = @json.parse(
    child("node", [
      "-p", "JSON.stringify({platform:process.platform,arch:process.arch,release:require('node:os').release()})",
    ]),
  )
  {
    "profile": "morphir/moonx-host-qualification",
    "contractVersion": "0.1.0",
    "state": "succeeded",
    "sha": packages.commit.0,
    "packages": package_set_json(packages),
    "compilerVersion": packages.compiler,
    "nodeVersion": child("node", ["--version"]).trim().to_owned(),
    "host": host,
    "runnerOS": @env.get_env_var("RUNNER_OS").unwrap_or("local"),
    "runId": @env.get_env_var("GITHUB_RUN_ID").unwrap_or("local"),
    "runAttempt": @env.get_env_var("GITHUB_RUN_ATTEMPT").unwrap_or("local"),
    "target": "wasm",
    "payloadBytes": "all-files-verified",
    "payload": payload,
    "help": "passed",
    "version": "passed",
    "worksheet": "42",
    "invalidWorksheetExitCode": 1,
    "consumers": [portable, minimum_portable],
  }
}

///|
test "selected host qualification cannot silently skip an absent portable entry" {
  let manifest = fixture_manifest("pkgs/core", "finos/morphir-core")
  let packages : PackageSet = {
    commit: CommitId::parse("0123456789abcdef0123456789abcdef01234567"),
    compiler: "fixture",
    core_pin_sha256: "fixture",
    packages: [
      {
        manifest,
        archive_path: "fixture.zip",
        evidence: inspect_archive(
          manifest,
          fixture_archive(fixture_archive_files()),
        ),
      },
    ],
    isolated_targets: ["wasm", "wasm-gc", "js", "native"],
  }
  let refused = try {
    ignore(require_portable_support(packages))
    false
  } catch {
    Refusal(_) => true
    error => raise error
  }
  assert_true(refused)
}

///|
let minimum_version = "0.10.20+65efd5b93"

///|
let minimum_core_sha256 = "e801a28a1e362b13c58ebaf432938bccec56e1de06c8667d9d8df272ee8f82ab"

///|
let minimum_core_files_count = 1916

///|
let minimum_windows_compiler_sha256 = "bdff9a3b2d7c61a3adae2fe09221d3de63effc6cab28bfa0cbeb94fb0d529d79"

///|
// Retained from the repository's approved stock 0.10.20 core pin.
let minimum_windows_core_sha256 = "d7982eed233e0c4f933f566274cc9777466447e0d5b633006e8bf18975c7c833"

///|
async fn unpack_minimum_windows_archives(
  directory : String,
  compiler : Bytes,
  core : Bytes,
) -> Unit {
  if digest(compiler) != minimum_windows_compiler_sha256 ||
    digest(core) != minimum_windows_core_sha256 {
    raise Refusal(
      CandidateMismatch("Minimum Windows toolchain archive checksum differs"),
    )
  }
  // Exclusive creation also rechecks ownership after the network awaits.
  @fs.mkdir(directory, recursive=true, allow_exist=false)
  for entry in @zipc.Archive::from_bytes(compiler).to_array() {
    write_member(directory, entry)
  }
  let library = join_host(directory, "lib")
  @fs.mkdir(library, allow_exist=true)
  for entry in @zipc.Archive::from_bytes(core).to_array() {
    write_member(library, entry)
  }
  for name in ["moon.exe", "moonc.exe", "moonrun.exe"] {
    if @fs.kind(join_host(directory, "bin/" + name), follow_symlink=false) !=
      Regular {
      raise Refusal(
        CandidateMismatch("Minimum Windows toolchain lacks " + name),
      )
    }
  }
  let executor = join_host(directory, "bin/moonx.exe")
  if !@fs.exists(executor) {
    @fs.write_file(
      executor,
      @fs.read_file(join_host(directory, "bin/moon.exe")).binary(),
      create_mode=CreateNew,
      permission=0o755,
    )
  }
}

///|
async fn bootstrap_minimum_windows(root : String, directory : String) -> Json {
  let base = "https://cli.moonbitlang.com/"
  let compiler_url = base +
    "binaries/0.10.20%2B65efd5b93/moonbit-windows-x86_64.zip"
  let core_url = base + "cores/core-0.10.20%2B65efd5b93.zip"
  let compiler = @async.with_timeout(120000, () => {
    let (response, body) = @http.get(compiler_url)
    if response.code != 200 {
      raise Refusal(
        CandidateMismatch("Official minimum Windows compiler is unavailable"),
      )
    }
    body.binary()
  })
  let core = @async.with_timeout(30000, () => {
    let (response, body) = @http.get(core_url)
    if response.code != 200 {
      raise Refusal(
        CandidateMismatch("Official minimum Windows core is unavailable"),
      )
    }
    body.binary()
  })
  unpack_minimum_windows_archives(directory, compiler, core)
  ignore(minimum_compiler_source(root, directory))
  let environment = {
    "MOON_HOME": directory,
    "MOON_TOOLCHAIN_ROOT": directory,
    "MOON_WORK": "off",
    "PATH": join_host(directory, "bin") +
    @host_path.delimiter.to_string() +
    @env.get_env_var("PATH").unwrap_or(""),
    "MOONCAKES_TOKEN": "",
  }
  let moon = join_host(directory, "bin/moon.exe")
  require_consumer_version(
    consumer_child(
      join_host(directory, "bin/moonc.exe"),
      ["-v"],
      directory,
      environment,
    ),
    minimum_version,
  )
  ignore(
    consumer_child(
      moon,
      [
        "-C",
        join_host(directory, "lib/core"),
        "bundle",
        "--warn-list",
        "-a",
        "--all",
      ],
      directory,
      environment,
    ),
  )
  {
    "compilerVersion": minimum_version,
    "path": directory,
    "bootstrap": "official-windows-archives",
    "compilerArchiveUrl": compiler_url,
    "compilerArchiveSha256": minimum_windows_compiler_sha256,
    "coreArchiveUrl": core_url,
    "coreArchiveSha256": minimum_windows_core_sha256,
    "qualification": "required-before-plan",
  }
}

///|
async fn bootstrap_minimum(root : String) -> Json {
  if @env.get_env_var("MOON_CORE_OVERRIDE") is Some(_) {
    raise Refusal(
      CandidateMismatch("Unset MOON_CORE_OVERRIDE before minimum bootstrap"),
    )
  }
  let directory = release_file(root, ".dev/mooncakes-release/minimum-toolchain")
  if @fs.exists(directory) {
    raise Refusal(
      CandidateMismatch(
        "Minimum bootstrap requires a new directory: " + directory,
      ),
    )
  }
  if @env.get_env_var("OS") == Some("Windows_NT") {
    return bootstrap_minimum_windows(root, directory)
  }
  let temporary = @fs.tmpdir(prefix="morphir-minimum-bootstrap-")
  defer @fs.rmdir(temporary, recursive=true)
  let installer = join_host(temporary, "install.sh")
  let (response, body) = @async.with_timeout(30000, () => {
    @http.get("https://cli.moonbitlang.com/install/unix.sh")
  })
  if response.code != 200 {
    raise Refusal(
      CandidateMismatch("Official minimum toolchain installer is unavailable"),
    )
  }
  let bytes = body.binary()
  @fs.write_file(installer, bytes, create_mode=CreateNew)
  ignore(
    consumer_child("bash", [installer, minimum_version], temporary, {
      "MOON_HOME": directory,
      "MOON_WORK": "off",
      "MOONCAKES_TOKEN": "",
    }),
  )
  {
    "compilerVersion": minimum_version,
    "path": directory,
    "installerSha256": digest(bytes),
    "qualification": "required-before-plan",
  }
}

///|
async test "minimum bootstrap refuses existing content before network or installer effects" {
  let root = @fs.tmpdir(prefix="morphir-minimum-refusal-")
  defer @fs.rmdir(root, recursive=true)
  let directory = release_file(root, ".dev/mooncakes-release/minimum-toolchain")
  @fs.mkdir(directory, recursive=true)
  let sentinel = join_host(directory, "keep.txt")
  @fs.write_file(sentinel, "preserved")
  let refused = try {
    ignore(bootstrap_minimum(root))
    false
  } catch {
    Refusal(CandidateMismatch(message)) =>
      message.has_prefix("Minimum bootstrap requires a new directory:")
    error => raise error
  }
  assert_true(refused)
  assert_eq(@fs.readdir(directory), ["keep.txt"])
  assert_eq(@fs.read_file(sentinel).text(), "preserved")
}

///|
async test "minimum Windows archives refuse changed bytes before creating files" {
  let root = @fs.tmpdir(prefix="morphir-minimum-windows-refusal-")
  defer @fs.rmdir(root, recursive=true)
  let directory = join_host(root, "toolchain")
  let refused = try {
    unpack_minimum_windows_archives(directory, b"changed", b"changed")
    false
  } catch {
    Refusal(CandidateMismatch(message)) =>
      message == "Minimum Windows toolchain archive checksum differs"
    error => raise error
  }
  assert_true(refused)
  assert_eq(@fs.readdir(root), [])
}

///|
fn minimum_proof(packages : PackageSet) -> Json {
  let result : Json = {
    "profile": "morphir/mooncakes-minimum-consumer",
    "contractVersion": "0.1.0",
    "state": "succeeded",
    "sha": packages.commit.0,
    "compilerVersion": minimum_version,
    "coreSourceSha256": minimum_core_sha256,
    "coreSourceFiles": minimum_core_files_count,
    "modules": packages.packages.map(record => {
      (
        {
          "name": record.manifest.name,
          "version": record.manifest.version,
          "archiveSha256": record.evidence.archive_sha256,
        } : Json)
    }),
    "archiveTargets": ["wasm", "wasm-gc", "js", "native"],
    "libraryTargets": ["wasm", "wasm-gc", "js", "native"],
    "stockCoreLongDecimal": "passed",
    "nativeHelp": "passed",
    "nativeVersion": "passed",
    "nativeWorksheet": "42",
    "nativeWasmWorkerGuestError": "passed",
    "dependencyCache": "fresh",
    "sourceInputs": "candidate-archives-only",
  }
  if packages.packages.any(record => {
      record.manifest.name == "finos/morphir" &&
      record.manifest.dependencies.contains("moonrockz/moon-lander-moonx")
    }) &&
    result is Object(fields) {
    fields["portablePackage"] = Json("finos/morphir/moonx")
    fields["portablePayloadBytes"] = Json("all-files-verified")
    fields["portableHelp"] = Json("passed")
    fields["portableVersion"] = Json("passed")
    fields["portableWorksheet"] = Json("42")
    fields["portableInvalidWorksheetExitCode"] = Json(1)
    fields["portableWasmWorkerGuestError"] = Json("passed")
  }
  result
}

///|
async fn minimum_core_files(
  root : String,
  relative : String,
  paths : Array[String],
) -> Unit {
  for name in @fs.readdir(join_host(root, relative), include_hidden=true) {
    let path = if relative.is_empty() { name } else { relative + "/" + name }
    if path == "_build" {
      continue
    }
    let file = join_host(root, path)
    match @fs.kind(file, follow_symlink=false) {
      Directory => minimum_core_files(root, path, paths)
      Regular => paths.push(path)
      SymLink => {
        let target = @fs.realpath(file)
        if !is_within(root, target) || @fs.kind(target) != Regular {
          raise Refusal(
            CandidateMismatch("Minimum core link escapes source: " + path),
          )
        }
        paths.push(path)
      }
      _ =>
        raise Refusal(
          CandidateMismatch("Unexpected minimum core entry: " + path),
        )
    }
  }
}

///|
async fn minimum_compiler_source(
  root : String,
  compiler_home : String,
) -> String {
  if @env.get_env_var("MOON_CORE_OVERRIDE") is Some(_) {
    raise Refusal(
      CandidateMismatch("Unset MOON_CORE_OVERRIDE for minimum qualification"),
    )
  }
  let requested = if @host_path.Path(compiler_home).is_absolute() {
    compiler_home
  } else {
    join_host(root, compiler_home)
  }
  if !@fs.exists(requested) {
    raise Refusal(CandidateMismatch("Minimum compiler home is unavailable"))
  }
  let source = @fs.realpath(requested)
  let core_path = join_host(source, "lib/core")
  if !@fs.exists(core_path) {
    raise Refusal(CandidateMismatch("Minimum compiler core is unavailable"))
  }
  let core = @fs.realpath(core_path)
  let paths : Array[String] = []
  minimum_core_files(core, "", paths)
  paths.sort_by((left, right) => left.lexical_compare(right))
  let facts = StringBuilder()
  for path in paths {
    facts.write_string(
      path +
      "\u0000" +
      digest(@fs.read_file(join_host(core, path)).binary()) +
      "\n",
    )
  }
  if digest(@utf8.encode(facts.to_string())) != minimum_core_sha256 ||
    paths.length() != minimum_core_files_count {
    raise Refusal(
      CandidateMismatch(
        "Minimum compiler requires the exact stock 0.10.20 core",
      ),
    )
  }
  source
}

///|
async fn qualify_minimum(
  root : String,
  packages : PackageSet,
  compiler_home : String,
) -> Json {
  let receipt_file = release_file(root, ".dev/mooncakes-release/minimum.json")
  let completed : Array[String] = []
  errdefer @async.protect_from_cancel(() => {
    write_owned_json(
      receipt_file,
      {
        "profile": "morphir/mooncakes-minimum-consumer",
        "contractVersion": "0.1.0",
        "state": "failed",
        "sha": packages.commit.0,
        "compilerVersion": minimum_version,
        "completedChecks": completed,
      },
      "morphir/mooncakes-minimum-consumer",
    )
  })
  let receipt : Json = {
    let source = minimum_compiler_source(root, compiler_home)
    let stage = @fs.tmpdir(prefix="morphir-minimum-home-")
    let failed = Ref(false)
    defer dispose_owned_stage(stage, preserving_error=failed.val)
    errdefer {
      failed.val = true
    }
    let environment = consumer_environment(source, stage)
    // Registry initialization precedes the archive workspace created below.
    environment["MOON_WORK"] = "off"
    let home = environment["MOON_HOME"]
    let moon = join_host(home, "bin/moon")
    let reported = consumer_child(
      join_host(home, "bin/moonc"),
      ["-v"],
      stage,
      environment,
    )
    if !reported.has_prefix("v" + minimum_version + " ") {
      raise Refusal(
        CandidateMismatch("Minimum compiler must be exactly " + minimum_version),
      )
    }
    completed.push("stock-core-and-compiler")
    ignore(consumer_child(moon, ["update"], stage, environment))
    ignore(
      verify_archive_graph(
        root,
        packages.packages,
        moon~,
        environment~,
        qualify=Some((workspace, environment) => {
          completed.push("four-target-archives")
          let consumer = join_host(workspace, "minimum-consumer")
          @fs.mkdir(consumer)
          @fs.write_file(
            join_host(consumer, "moon.mod"),
            "name = \"morphir-release/minimum-consumer\"\nversion = \"0.0.0\"\nimport {\"finos/morphir-scheme@" +
            packages.packages[0].manifest.version +
            "\"}\n",
          )
          @fs.write_file(
            join_host(consumer, "moon.pkg"),
            "pkgtype(kind: \"executable\")\nimport {\"finos/morphir-scheme\" @scheme, \"moonbitlang/core/bigint\"}\n",
          )
          @fs.write_file(join_host(consumer, "main.mbt"), consumer_source)
          @fs.write_file(
            join_host(workspace, "moon.work"),
            "members = " +
            Json(
              [
                ..packages.packages.map(record => record.manifest.path.0),
                "minimum-consumer",
              ],
            ).stringify() +
            "\n",
          )
          for target in ["wasm", "wasm-gc", "js", "native"] {
            let output = consumer_child(
              moon,
              ["run", "minimum-consumer", "--target", target],
              workspace,
              environment,
            )
            if output.trim() != "morphir-registry-consumer-ok" {
              raise Refusal(
                CandidateMismatch("Minimum library consumer failed: " + target),
              )
            }
            completed.push("library-" + target)
          }
          let cli = ["run", "apps/morphir", "--target", "native", "--"]
          if !consumer_child(moon, [..cli, "--help"], workspace, environment).contains(
              "Usage: morphir",
            ) {
            raise Refusal(
              CandidateMismatch("Minimum archived CLI help is unavailable"),
            )
          }
          completed.push("native-help")
          require_cli_version(
            consumer_child(
              moon,
              [..cli, "version", "--json"],
              workspace,
              environment,
            ),
            ReleaseVersion::parse(packages.packages[0].manifest.version),
          )
          completed.push("native-version")
          let worksheet = join_host(workspace, "answer.scm")
          @fs.write_file(worksheet, "(+ 40 2)")
          let answer = @json.parse(
            consumer_child(
              moon,
              [..cli, "worksheet", worksheet, "--json"],
              workspace,
              environment,
            ),
          )
          guard object_field(answer, "observations") is Some(Array([row])) &&
            string_field(row, "preview") == Some("42") &&
            object_field(answer, "completion") is Some(completion) &&
            string_field(completion, "status") == Some("returned") else {
            raise Refusal(
              CandidateMismatch(
                "Minimum archived native worksheet did not return 42",
              ),
            )
          }
          completed.push("native-worksheet")
          qualify_worker_cli(moon, cli, workspace, environment)
          completed.push("native-wasm-worker-guest-error")
          if packages.packages.any(record => {
              record.manifest.name == "finos/morphir" &&
              record.manifest.dependencies.contains(
                "moonrockz/moon-lander-moonx",
              )
            }) {
            qualify_portable_cli(
              moon,
              ["run", "apps/morphir/moonx", "--target", "wasm", "--"],
              workspace,
              environment,
              ReleaseVersion::parse(packages.packages[0].manifest.version),
            )
            completed.push("portable-help-version-worksheet-failure")
            completed.push("portable-wasm-worker-guest-error")
            let portable = qualify_portable_boundary(
              root,
              workspace,
              environment,
              ReleaseVersion::parse(packages.packages[0].manifest.version),
              ArchiveEntry(build_portable_entry(workspace, environment)),
            )
            write_owned_json(
              release_file(
                root, ".dev/mooncakes-release/moonx-archive-minimum.json",
              ),
              {
                "profile": "morphir/moonx-archive-qualification",
                "contractVersion": "0.1.0",
                "state": "succeeded",
                "sha": packages.commit.0,
                "result": portable,
              },
              "morphir/moonx-archive-qualification",
            )
            completed.push("portable-boundary-and-lifecycle")
          }
        }),
      ),
    )
    minimum_proof(packages)
  }
  write_owned_json(receipt_file, receipt, "morphir/mooncakes-minimum-consumer")
  receipt
}

///|
async fn write_owned_json(
  file : String,
  value : Json,
  profile : String,
) -> Unit {
  if @fs.exists(file) {
    if @fs.kind(file, follow_symlink=false) != Regular ||
      string_field(@json.parse(@fs.read_file(file).text()), "profile") !=
      Some(profile) {
      raise Refusal(
        CandidateMismatch("Refusing to replace an unrelated result file"),
      )
    }
  }
  let directory = @host_path.Path(file).dirname().0
  @fs.mkdir(directory, recursive=true, allow_exist=true)
  let temporary = file + ".tmp"
  let output = @fs.open(temporary, mode=WriteOnly, create_mode=CreateNew)
  defer output.close()
  errdefer @fs.remove(temporary)
  output.write(value.stringify(indent=2) + "\n")
  output.sync()
  output.close()
  @fs.rename(temporary, file, replace=true)
}

///|
fn release_file(root : String, relative : String) -> String raise {
  let path = ModulePath::parse(relative)
  if !path.0.has_prefix(".dev/mooncakes-release/") {
    raise Refusal(
      CandidateMismatch(
        "Release result files must be inside .dev/mooncakes-release/",
      ),
    )
  }
  join_host(root, path.0)
}

///|
async fn download_registry_archive(manifest : Manifest) -> RegistryDownload {
  let mut url = "https://download.mooncakes.io/user/" +
    manifest.name +
    "/" +
    manifest.version +
    ".zip"
  let visited : Array[String] = []
  for _ in 0..<4 {
    if visited.contains(url) {
      return ArchiveState(Unavailable)
    }
    visited.push(url)
    let (response, stream) = @http.get_stream(url)
    defer stream.close()
    match response.code {
      301 | 302 | 303 | 307 | 308 => {
        let location = response.headers.get("location")
        match location {
          Some(location) =>
            match registry_archive_location(manifest, location) {
              Some(next) => url = next
              None => return ArchiveState(Unavailable)
            }
          None => return ArchiveState(Unavailable)
        }
      }
      status => {
        if registry_http_status(Archive, status) is Some(state) {
          return ArchiveState(state)
        }
        let bytes = @buffer.Buffer()
        let mut size = 0
        while stream.read_some(max_len=65536) is Some(chunk) {
          size += chunk.length()
          if size > 64 * 1024 * 1024 {
            return ArchiveState(Unavailable)
          }
          bytes.write_bytes(chunk)
        }
        return ArchiveBytes(bytes.to_bytes())
      }
    }
  }
  ArchiveState(Unavailable)
}

///|
async fn registry_archive(
  manifest : Manifest,
  check~ : RegistryCheck = Resolvable,
) -> RegistryState {
  // Follow only credential-free HTTPS redirects for this exact public archive.
  // Hash actual source bytes, not descriptive API metadata.
  @async.with_timeout(20000, () => {
    let (metadata_response, metadata_body) = @http.get(
      "https://mooncakes.io/api/v0/manifest/" +
      manifest.name +
      "@" +
      manifest.version,
    )
    if registry_http_status(Metadata, metadata_response.code) is Some(state) {
      return state
    }
    let metadata = @json.parse(metadata_body.text())
    let expected_checksum = registry_checksum(metadata, manifest)
    match download_registry_archive(manifest) {
      ArchiveState(state) => state
      ArchiveBytes(bytes) => {
        let actual = digest(bytes)
        if actual != expected_checksum {
          return Unavailable
        }
        if check is EvidenceOnly {
          return Present(actual)
        }
        let (updated, _, _) = @process.collect_output("moon", ["update"])
        if updated != 0 {
          return Unavailable
        }
        let index = join_host(
          moon_home(),
          "registry/index/user/" + manifest.name + ".index",
        )
        if !@fs.exists(index) {
          return Transient(425)
        }
        let records = @fs.read_file(index).text()
        match index_checksum(records, manifest.version) {
          Some(checksum) if checksum == actual => Present(actual)
          Some(_) => Unavailable
          None => Transient(425)
        }
      }
    }
  }) catch {
    _ => Unavailable
  }
}

///|
enum PreflightDecision {
  Ready
  Refused
}

///|
async fn registry_preflight(root : String, packages : PackageSet) -> Json {
  let rows : Array[Json] = []
  let mut decision = Ready
  let by_name = Map::from_iter(
    packages.packages.iter().map(record => (record.manifest.name, record)),
  )
  for record in packages.packages {
    let observation = poll_registry(
      record.manifest.name,
      false,
      name => registry_archive(by_name[name].manifest, check=EvidenceOnly),
      delay => @async.sleep(delay),
    )
    let state = availability(record.evidence.archive_sha256, observation)
    if state is Conflict || state is Unverified {
      decision = Refused
    }
    rows.push({
      "name": record.manifest.name,
      "version": record.manifest.version,
      "candidateArchiveSha256": record.evidence.archive_sha256,
      "registryArchiveSha256": match observation {
        Present(checksum) => Json(checksum)
        _ => Json::null()
      },
      "state": match state {
        Available => "available"
        Identical => "verified-existing"
        Conflict => "conflict"
        Unverified => "unavailable"
      },
    })
  }
  let report : Json = {
    "profile": "morphir/mooncakes-registry-preflight",
    "contractVersion": "0.1.0",
    "sha": packages.commit.0,
    "compilerVersion": packages.compiler,
    "state": if decision is Ready {
      "ready"
    } else {
      "refused"
    },
    "modules": rows,
  }
  let file = release_file(root, ".dev/mooncakes-release/preflight.json")
  write_owned_json(file, report, "morphir/mooncakes-registry-preflight")
  if decision is Refused {
    raise Refusal(
      CandidateMismatch(
        "Registry version availability is conflicting or unverified; inspect " +
        file,
      ),
    )
  }
  report
}

///|
fn moon_home() -> String raise {
  match @env.get_env_var("MOON_HOME") {
    Some(home) if !home.is_empty() => home
    _ =>
      match @env.get_env_var("HOME") {
        Some(home) if !home.is_empty() => join_host(home, ".moon")
        _ => raise Refusal(CandidateMismatch("Active Moon home is unavailable"))
      }
  }
}

///|
fn registry_checksum(metadata : Json, manifest : Manifest) -> String raise {
  guard metadata is Object(fields) &&
    fields.get("metadata") is Some(nested) &&
    string_field(metadata, "module") == Some(manifest.name) &&
    string_field(metadata, "version") == Some(manifest.version) &&
    fields.get("yanked") == Some(Json(false)) &&
    string_field(nested, "name") == Some(manifest.name) &&
    string_field(nested, "version") == Some(manifest.version) &&
    string_field(nested, "checksum") is Some(checksum) &&
    checksum.length() == 64 &&
    checksum.iter().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) else {
    raise Refusal(
      CandidateMismatch(
        "Registry metadata does not prove the expected public identity and checksum",
      ),
    )
  }
  checksum
}

///|
fn index_checksum(records : String, version : String) -> String? raise {
  let mut found = None
  for line in records.split("\n") {
    if line.trim().is_empty() {
      continue
    }
    let record = @json.parse(line)
    if string_field(record, "version") == Some(version) {
      guard record is Object(fields) else { return None }
      found = if fields.get("yanked") == Some(Json(true)) {
        None
      } else {
        string_field(record, "checksum")
      }
    }
  }
  found
}

///|
fn publication_json(
  candidate : Candidate,
  packages : PackageSet,
  outcomes : Array[Publication],
) -> Json {
  {
    "profile": "morphir/mooncakes-publication",
    "contractVersion": "0.1.0",
    "sha": candidate.commit.0,
    "tag": "v" + candidate.version.0,
    "version": candidate.version.0,
    "packages": package_set_json(packages),
    "modules": outcomes.map(fn(outcome : Publication) -> Json {
      let fields : Map[String, Json] = { "name": outcome.name }
      fields["state"] = match outcome.state {
        Published => "published"
        VerifiedExisting => "verified-existing"
        Failed(message) => {
          fields["message"] = Json(message)
          "failed"
        }
        NotAttempted => "not-attempted"
      }
      Json(fields)
    }),
  }
}

///|
async fn publish_candidate(
  root : String,
  inspection : Inspection,
  plan : Json,
  report_file : String,
) -> Json {
  let candidate = require_plan(plan, inspection)
  if candidate.mode is DryRun {
    raise Refusal(CandidateMismatch("A dry-run plan cannot publish"))
  }
  if (
      @env.get_env_var("MOONCAKES_REGISTRY") is Some(registry_override) &&
      !registry_override.is_empty()
    ) ||
    @fs.exists(join_host(moon_home(), "config.json")) {
    raise Refusal(
      CandidateMismatch(
        "Publication requires the default registry without a Moon home config.json or MOONCAKES_REGISTRY override",
      ),
    )
  }
  if @env.get_env_var("GITHUB_ACTIONS") != Some("true") ||
    @env.get_env_var("GITHUB_REPOSITORY") != Some("finos/morphir-moonbit") ||
    @env.get_env_var("GITHUB_REF") != Some("refs/tags/v" + candidate.version.0) ||
    @env.get_env_var("GITHUB_SHA") != Some(candidate.commit.0) {
    raise Refusal(
      CandidateMismatch(
        "Publication requires the qualified repository workflow running on this exact release tag and SHA",
      ),
    )
  }
  if !child("git", [
      "-C", root, "status", "--porcelain=v1", "--untracked-files=normal",
    ]).is_empty() {
    raise Refusal(CandidateMismatch("Candidate checkout must be clean"))
  }
  ignore(
    child("git", [
      "-C",
      root,
      "merge-base",
      "--is-ancestor",
      candidate.commit.0,
      "origin/main",
    ]),
  )
  let packages = retained_packages(root, inspection, plan)
  let stage = @fs.tmpdir(prefix="morphir-release-publish-")
  defer @fs.rmdir(stage, recursive=true)
  unpack_packages(root, packages.packages, stage)
  reproduce_archives(stage, packages)
  let by_name = Map::from_iter(
    packages.packages.iter().map(record => (record.manifest.name, record)),
  )
  let outcomes = publish_sequence(
    candidate.mode,
    packages.packages.map(record => {
      (record.manifest.name, record.evidence.archive_sha256)
    }),
    name => registry_archive(by_name[name].manifest),
    name => {
      // Do not emit Mooncake output: publishing failures may include credential
      // or HTTP diagnostics. The bounded report retains only the exit status.
      try {
        let (code, _, _) = @process.collect_output(
          "moon",
          ["-C", join_host(stage, by_name[name].manifest.path.0), "publish"],
          extra_env={ "MOON_WORK": join_host(stage, "moon.work") },
        )
        code
      } catch {
        _ => 1
      }
    },
    states => {
      write_owned_json(
        report_file,
        publication_json(candidate, packages, states),
        "morphir/mooncakes-publication",
      )
    },
    delay => @async.sleep(delay),
  )
  if outcomes.any(outcome => outcome.state is Failed(_)) {
    raise Refusal(
      CandidateMismatch(
        "Publication stopped; inspect the partial report at " + report_file,
      ),
    )
  }
  publication_json(candidate, packages, outcomes)
}

///|
let consumer_source : String =
  #|fn main raise {
  #|  let runtime = @scheme.Runtime::new()
  #|  assert_eq(@scheme.value_preview(runtime.eval("(+ 20 22)"), 64), "42")
  #|  let decimal = "12345678901234567890123456789012345678901234567890"
  #|  assert_eq(@bigint.BigInt::from_string(decimal).to_string(), decimal)
  #|  assert_eq(@scheme.value_preview(runtime.eval(decimal), 128), decimal)
  #|  println("morphir-registry-consumer-ok")
  #|}
  #|

///|
fn consumer_manifest(inspection : Inspection) -> String {
  "name = \"morphir-release/consumer\"\nversion = \"0.0.0\"\nimport {\n" +
  inspection.ordered
  .map(manifest => {
    "  " + Json(manifest.name + "@" + inspection.version.0).stringify() + ",\n"
  })
  .join("") +
  "}\n"
}

///|
test "consumer requests every public version without local path substitutions" {
  let version = ReleaseVersion::parse("0.1.0")
  let ordered = [
    fixture_manifest("pkgs/scheme", "finos/morphir-scheme"),
    fixture_manifest("apps/morphir", "finos/morphir"),
  ]
  let inspection : Inspection = { version, ordered, inventory: [], }
  let manifest = decode_manifest(
    ModulePath::parse("consumer"),
    consumer_manifest(inspection),
  )
  assert_eq(manifest.dependencies, {
    "finos/morphir-scheme": "0.1.0",
    "finos/morphir": "0.1.0",
  })
  assert_false(consumer_manifest(inspection).contains("path"))
  let correct : Json = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "version",
    "state": "succeeded",
    "exitCode": 0,
    "diagnostics": [],
    "result": { "name": "finos/morphir", "version": "0.1.0" },
  }
  require_cli_version(correct.stringify(), version)
  for
    invalid in [
      "{}",
      "not JSON",
      correct.stringify().replace_all(old="0.1.0", new="0.2.0"),
    ] {
    let refused = try {
      require_cli_version(invalid, version)
      false
    } catch {
      _ => true
    }
    assert_true(refused)
  }
}

///|
let diagnostic_mutex : @async.Mutex = @async.Mutex()

///|
// Async stdio owns one in-flight write. Child checks may run concurrently.
async fn write_diagnostic(text : String) -> Unit {
  if text.is_empty() {
    return
  }
  diagnostic_mutex.acquire()
  defer diagnostic_mutex.release()
  @stdio.stderr.write(text)
}

///|
async test "concurrent child diagnostics finish without overlapping stdio writes" {
  let completed = Ref(0)
  @async.with_task_group(group => {
    for _ in 0..<8 {
      ignore(
        group.spawn(() => {
          write_diagnostic(".")
          completed.val += 1
        }),
      )
    }
  })
  write_diagnostic("\n")
  assert_eq(completed.val, 8)
}

///|
async fn consumer_child(
  program : String,
  args : Array[String],
  stage : String,
  environment : Map[String, String],
) -> String {
  let (code, output, stderr) = @process.collect_output(
    program,
    args,
    cwd=stage,
    extra_env=environment,
  )
  write_diagnostic(stderr.text())
  if code != 0 {
    raise Refusal(
      CandidateMismatch(
        "Clean registry consumer failed: " +
        program +
        " with status " +
        code.to_string(),
      ),
    )
  }
  output.text()
}

///|
enum PortableConsumer {
  ArchiveEntry(String)
  PublicEntry
}

///|
fn build_artifact(
  output : String,
  package_name : String,
  target : String,
) -> String raise Refusal {
  let mut result = None
  for line in output.split("\n") {
    if line.trim().is_empty() {
      continue
    }
    let value = @json.parse(line.to_owned()) catch {
      _ => raise Refusal(ArchiveInvalid("Invalid compiler artifact JSON"))
    }
    if string_field(value, "$message_type") == Some("artifact") &&
      string_field(value, "package") == Some(package_name) &&
      string_field(value, "target_backend") == Some(target) {
      let path = required_string(value, "path")
      if result is Some(_) || !@host_path.Path(path).is_absolute() {
        raise Refusal(ArchiveInvalid("Ambiguous or relative compiler artifact"))
      }
      result = Some(path)
    }
  }
  match result {
    Some(path) => path
    None =>
      raise Refusal(
        ArchiveInvalid(
          "Compiler did not report " + package_name + " for " + target,
        ),
      )
  }
}

///|
test "compiler artifacts require unique package backend and absolute path" {
  let path = if @env.get_env_var("OS") == Some("Windows_NT") {
    "C:\\owned\\entry.wasm"
  } else {
    "/owned/entry.wasm"
  }
  let value : Json = {
    "$message_type": "artifact",
    "package": "finos/morphir/moonx",
    "target_backend": "wasm",
    "path": path,
  }
  assert_eq(
    build_artifact(value.stringify(), "finos/morphir/moonx", "wasm"),
    path,
  )
  for
    output in [
      "",
      value.stringify() + "\n" + value.stringify(),
      "{\"$message_type\":\"artifact\",\"package\":\"finos/morphir/moonx\",\"target_backend\":\"wasm\",\"path\":\"relative.wasm\"}",
    ] {
    assert_true(
      refused(() => {
        ignore(build_artifact(output, "finos/morphir/moonx", "wasm"))
      })
      is Some(_),
    )
  }
  assert_true(
    refused(() => {
      ignore(build_artifact(value.stringify(), "finos/morphir/moonx", "native"))
    })
    is Some(_),
  )
}

///|
async fn build_portable_entry(
  workspace : String,
  environment : Map[String, String],
) -> String {
  let moon = join_host(environment["MOON_HOME"], "bin/moon")
  let build = join_host(workspace, "_build/moonx-product-qualification")
  @fs.mkdir(build, recursive=true, allow_exist=false)
  write_diagnostic(
    consumer_child(
      moon,
      [
        "test", "apps/morphir/moonx", "--target", "wasm", "--deny-warn", "--target-dir",
        build,
      ],
      workspace,
      environment,
    ),
  )
  let output = consumer_child(
    moon,
    [
      "build", "apps/morphir/moonx", "--target", "wasm", "--release", "--output-json",
      "--target-dir", build,
    ],
    workspace,
    environment,
  )
  let selected = build_artifact(output, "finos/morphir/moonx", "wasm")
  let artifact = @fs.realpath(selected)
  guard is_within(@fs.realpath(build), artifact) &&
    @fs.kind(artifact) is Regular else {
    raise Refusal(
      ArchiveInvalid("Portable artifact escaped the owned archive workspace"),
    )
  }
  artifact
}

///|
async fn build_console_controller(root : String, stage : String) -> String? {
  if @env.get_env_var("OS") != Some("Windows_NT") {
    return None
  }
  let environment = consumer_environment(moon_home(), stage)
  environment["MOON_WORK"] = "off"
  @fs.write_file(
    join_host(stage, "moon.mod"),
    "name = \"morphir-release/moonx-controller\"\nversion = \"0.0.0\"\nimport { \"moonbitlang/async@0.22.7\", \"moonbitlang/x@0.5.5\" }\n",
  )
  for name in ["main.mbt", "main_wbtest.mbt", "moon.pkg", "console.c"] {
    @fs.write_file(
      join_host(stage, name),
      @fs.read_file(
        join_host(
          root,
          "apps/morphir/scripts/moonx/fixtures/" + name + ".fixture",
        ),
      ).binary(),
    )
  }
  let controller_moon = join_host(environment["MOON_HOME"], "bin/moon")
  ignore(consumer_child(controller_moon, ["update"], stage, environment))
  write_diagnostic(
    consumer_child(
      controller_moon,
      ["test", ".", "--target", "native"],
      stage,
      environment,
    ),
  )
  let output = consumer_child(
    controller_moon,
    ["build", ".", "--target", "native", "--release", "--output-json"],
    stage,
    environment,
  )
  let artifact = @fs.realpath(
    build_artifact(output, "morphir-release/moonx-controller", "native"),
  )
  guard is_within(@fs.realpath(stage), artifact) &&
    @fs.kind(artifact) is Regular else {
    raise Refusal(
      ArchiveInvalid("Console controller escaped its owned workspace"),
    )
  }
  Some(artifact)
}

///|
async fn qualify_portable_boundary(
  root : String,
  stage : String,
  environment : Map[String, String],
  version : ReleaseVersion,
  consumer : PortableConsumer,
) -> Json {
  let controller_stage = @fs.tmpdir(prefix="morphir-moonx-controller-")
  let failed = Ref(false)
  defer dispose_owned_stage(controller_stage, preserving_error=failed.val)
  errdefer {
    failed.val = true
  }
  let controller = build_console_controller(root, controller_stage)
  let home = environment["MOON_HOME"]
  let suffix = if @env.get_env_var("OS") == Some("Windows_NT") {
    ".exe"
  } else {
    ""
  }
  let (kind, program, prefix) = match consumer {
    ArchiveEntry(path) =>
      ("archive", join_host(home, "bin/moonrun" + suffix), [path, "--"])
    PublicEntry =>
      (
        "public",
        join_host(home, "bin/moonx" + suffix),
        ["finos/morphir/moonx@" + version.0],
      )
  }
  let environment = environment.copy()
  environment["MOON_WORK"] = "off"
  environment["MORPHIR_MOONX_KIND"] = kind
  environment["MORPHIR_MOONX_PROGRAM"] = program
  environment["MORPHIR_MOONX_PREFIX_JSON"] = Json(prefix).stringify()
  environment["MORPHIR_MOONX_VERSION"] = version.0
  environment["MORPHIR_MOONX_COMPILER_HOME"] = home
  if controller is Some(path) {
    environment["MORPHIR_MOONX_CONTROLLER"] = path
  }
  let (code, stdout, stderr) = @process.collect_output(
    "node",
    [join_host(root, "apps/morphir/scripts/moonx/qualification.mts"), "--json"],
    cwd=stage,
    extra_env=environment,
  )
  write_diagnostic(stderr.text())
  if code != 0 {
    write_diagnostic(stdout.text())
    raise Refusal(
      CandidateMismatch(
        "Actual " +
        kind +
        " Moonx qualification failed with status " +
        code.to_string(),
      ),
    )
  }
  let document = @json.parse(stdout.text())
  guard string_field(document, "profile") == Some("morphir/command-result") &&
    string_field(document, "command") == Some("test.moonx-launcher") &&
    string_field(document, "state") == Some("succeeded") &&
    object_field(document, "result") is Some(result) &&
    string_field(result, "source") == Some(kind) else {
    raise Refusal(CandidateMismatch("Unexpected Moonx qualification result"))
  }
  result
}

///|
