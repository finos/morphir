----
import {
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/x@0.5.5/sys",
}
----

// Checks pkgs/morphir-sdk-spec/sdk.scm against pkgs/morphir-sdk/conformance/bindings.json, and checks that
// pkgs/morphir-sdk-spec/sdk_data.mbt is fresh. It runs the native `sdkgen check` tool of pkgs/morphir-typing-tools.

///|
async fn execute() -> Json {
  let code = run_step("moon", [
    "run", "pkgs/morphir-typing-tools/sdkgen", "--target", "native", "--", "check",
  ])
  if code != 0 {
    exit_child(code)
  }
  if json_mode {
    let artifacts = ["pkgs/morphir-sdk-spec/sdk_data.mbt"]
    let outputs : Array[Json] = []
    for path in artifacts {
      outputs.push({
        "path": path,
        "bytes": @fs.read_file(path).binary().length(),
      })
    }
    return {
      "operation": "check",
      "tool": "sdkgen",
      "steps": completed_steps,
      "outputs": outputs,
      "passed": true,
    }
  }
  Json::null()
}

///|
let json_mode : Bool = match @env.args() {
  [_, "--json", ..] => true
  _ => false
}

///|
let completed_steps : Array[Json] = []

///|
fn json_command() -> @argparse.Command {
  @argparse.Command(
    "sdk-spec-check",
    disable_help_flag=true,
    disable_help_subcommand=true,
    about="Opt-in JSON results. Use --json [--help] or --json -- RAW. Other argv retains legacy ignored-tail behavior. stdout is one compact command-result 0.1.0 value plus LF; progress and live child stdout go to stderr. Success has result and diagnostics; failure has error {code,message}, diagnostics and the mapped exitCode. Expected refusals and ordinary errors exit 1, JSON syntax exits 2; explicitly propagated positive child statuses are retained, negative statuses map to 1. Default abort/signal behavior is unchanged; JSON refusals use normal exit 1. Help returns result.render_help without effects. Operation result fields: operation, tool, completed steps [{program,args,exitCode}], outputs [{path,bytes}] inspected after the child succeeds, and passed.",
    flags=[@argparse.FlagArg("json"), @argparse.FlagArg("help")],
    positionals=[
      @argparse.PositionArg("legacy", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn success(result : Json) -> Unit {
  @stdio.stdout.write(
    (
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "sdk.spec.check",
        "state": "succeeded",
        "exitCode": 0,
        "result": result,
        "diagnostics": [],
      } : Json).stringify() +
    "\n",
  )
}

///|
async fn failure(code : Int32, category : String, message : String) -> Unit {
  @stdio.stdout.write(
    (
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "sdk.spec.check",
        "state": "failed",
        "exitCode": code,
        "error": { "code": category, "message": message },
        "diagnostics": [],
      } : Json).stringify() +
    "\n",
  )
}

///|
async fn exit_child(code : Int32) -> Unit {
  let mapped = if code > 0 { code } else { 1 }
  if json_mode {
    failure(mapped, "child_failed", "Child command failed")
  }
  @sys.exit(mapped)
}

///|
async fn run_step(program : String, args : Array[String]) -> Int32 {
  let code = @process.run(
    program,
    args,
    stdout=if json_mode { @stdio.stderr } else { @stdio.stdout },
    stderr=@stdio.stderr,
  )
  completed_steps.push({ "program": program, "args": args, "exitCode": code })
  code
}

///|
async fn main {
  if !json_mode {
    ignore(execute())
    return
  }
  let command = json_command()
  let matches = command.parse(argv=@env.args()[1:]) catch {
    error => {
      failure(2, "invalid_arguments", error.to_string())
      @sys.exit(2)
      panic()
    }
  }
  if matches.flags.get("help").unwrap_or(false) {
    success({ "render_help": command.render_help() })
    return
  }
  try {
    let result = execute()
    success(result)
  } catch {
    error => {
      failure(1, "command_failed", error.to_string())
      @sys.exit(1)
    }
  }
}
