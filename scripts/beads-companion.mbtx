----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}
----

// Preserve rich bead designs and capture durable knowledge without shell pipelines.
// Run from the repository root with moonx scripts/beads-companion.mbtx --help.

///|
enum WriteMode {
  Create
  Replace
}

///|
enum Command {
  Inspect(String)
  Export(String, String?, WriteMode)
  Store(String, String, WriteMode)
  Note(String, String)
  Remember(String, String)
  SelfTest
  SelfTestWrite(String, String)
  Help
}

///|
enum StoreOutcome {
  Unchanged
  Written
  Conflict
}

///|
struct Issue {
  id : String
  title : String
  status : String
  design : String
}

///|
enum Grammar {
  Controls
  Pair
  Design
  DefaultReplace
  PathReplace
}

///|
fn grammar_command(
  name : String,
  options~ : Array[@argparse.OptionArg] = [],
  subcommands~ : Array[@argparse.Command] = [],
  required~ : Bool = false,
) -> @argparse.Command {
  @argparse.Command(
    name[:],
    options~,
    subcommands~,
    subcommand_required=required,
    disable_help_flag=true,
    disable_help_subcommand=true,
  )
}

///|
fn grammar_option(
  name : String,
  required~ : Bool = true,
) -> @argparse.OptionArg {
  @argparse.OptionArg(name[:], required~)
}

///|
fn companion_grammar(grammar : Grammar) -> @argparse.Command {
  let id = grammar_option("id")
  let path = grammar_option("path")
  let replace = grammar_command("word:--replace")
  match grammar {
    Controls =>
      grammar_command("beads-companion", subcommands=[
        grammar_command("word:--help"),
        grammar_command("word:--self-test"),
      ])
    Pair =>
      grammar_command("beads-companion", required=true, subcommands=[
        grammar_command("word:note", options=[id, path]),
        grammar_command("word:remember", options=[id, path]),
        grammar_command("word:--self-test-write", options=[id, path]),
      ])
    Design | DefaultReplace | PathReplace => {
      let operations = match grammar {
        Design =>
          [
            grammar_command("word:inspect", options=[id]),
            grammar_command("word:export", options=[
              id,
              grammar_option("path", required=false),
            ]),
            grammar_command("word:store", options=[id, path]),
          ]
        DefaultReplace =>
          [
            grammar_command(
              "word:export",
              options=[id],
              subcommands=[replace],
              required=true,
            ),
          ]
        PathReplace =>
          [
            grammar_command(
              "word:export",
              options=[id, path],
              subcommands=[replace],
              required=true,
            ),
            grammar_command(
              "word:store",
              options=[id, path],
              subcommands=[replace],
              required=true,
            ),
          ]
        _ => abort("not a design grammar")
      }
      grammar_command("beads-companion", required=true, subcommands=[
        grammar_command("word:design", subcommands=operations, required=true),
      ])
    }
  }
}

///|
fn grammar_argv(args : Array[String], grammar : Grammar) -> Array[String] {
  // Each complete alternative has a fixed command/data layout. Encoding every
  // word prevents built-in option and delimiter semantics from consuming data.
  // Inline synthetic options keep literal values, including empty strings and
  // `--`, intact. The library alone recognizes command words and exact arity.
  let slots : Array[String?] = match grammar {
    Controls => []
    Pair => [None, Some("id"), Some("path")]
    Design | PathReplace => [None, None, Some("id"), Some("path")]
    DefaultReplace => [None, None, Some("id")]
  }
  args.mapi((index, value) => {
    match slots.get(index).bind(value => value) {
      Some(name) => "--\{name}=\{value}"
      None => "word:\{value}"
    }
  })
}

///|
fn parsed_value(matches : @argparse.Matches, name : String) -> String {
  matches.values.get(name).unwrap()[0]
}

///|
fn parse_command(args : Array[String]) -> Result[Command, String] {
  // Replacement alternatives precede literal export paths because the legacy
  // four-token export reserves --replace; with five tokens it is literal data.
  // Only the pure library parse is caught. Domain validation and effects never
  // participate in alternative selection.
  for grammar in [Controls, Pair, PathReplace, DefaultReplace, Design] {
    let parsed = Some(
      companion_grammar(grammar).parse(
        argv=grammar_argv(args, grammar),
        env=Map([]),
      ),
    ) catch {
      _ => None
    }
    guard parsed is Some(matches) else { continue }
    guard matches.subcommand is Some((name, selected)) else { return Ok(Help) }
    match name {
      "word:--help" => return Ok(Help)
      "word:--self-test" => return Ok(SelfTest)
      "word:--self-test-write" =>
        return Ok(
          SelfTestWrite(
            parsed_value(selected, "id"),
            parsed_value(selected, "path"),
          ),
        )
      "word:note" =>
        return Ok(
          Note(parsed_value(selected, "id"), parsed_value(selected, "path")),
        )
      "word:remember" =>
        return Ok(
          Remember(parsed_value(selected, "id"), parsed_value(selected, "path")),
        )
      "word:design" => {
        let (operation, values) = selected.subcommand.unwrap()
        let id = parsed_value(values, "id")
        let mode = if values.subcommand is Some(_) { Replace } else { Create }
        match operation {
          "word:inspect" => return Ok(Inspect(id))
          "word:export" =>
            return Ok(
              Export(id, values.values.get("path").map(paths => paths[0]), mode),
            )
          "word:store" =>
            return Ok(Store(id, parsed_value(values, "path"), mode))
          _ => abort("undeclared design command")
        }
      }
      _ => abort("undeclared companion command")
    }
  }
  Err("Unknown command or arguments; use --help.")
}

///|
fn decode_issue(source : String, expected_id : String) -> Result[Issue, String] {
  let value = @json.parse(source) catch {
    _ => return Err("bd did not return valid JSON.")
  }
  guard value is Array([Object(fields)]) else {
    return Err("Expected exactly one issue object from bd show.")
  }
  guard fields.get("id") is Some(String(id)) && id == expected_id else {
    return Err("bd returned a different issue; refusing to use its design.")
  }
  let design = match fields.get("design") {
    Some(String(value)) => value
    None | Some(Null) => ""
    _ => return Err("The issue design is not text.")
  }
  let title = match fields.get("title") {
    Some(String(value)) => value
    _ => ""
  }
  let status = match fields.get("status") {
    Some(String(value)) => value
    _ => ""
  }
  Ok({ id, title, status, design, })
}

///|
fn extension(design : String) -> String {
  let trimmed = design.trim().to_owned()
  let mut root = trimmed
  if root.has_prefix("\u{FEFF}") {
    root = root[1:].trim().to_owned()
  }
  while root.has_prefix("<!--") {
    match root.find("-->") {
      Some(end) => root = root[end + 3:].trim().to_owned()
      None => return "md"
    }
  }
  let prefix = root.to_lower()
  if prefix.has_prefix("<html>") ||
    prefix.has_prefix("<html ") ||
    prefix.has_prefix("<html\n") ||
    prefix.has_prefix("<html\t") ||
    prefix.has_prefix("<!doctype html") {
    "html"
  } else {
    // JSON is a supported boundary format, including bd's own output.
    let parsed = @json.parse(trimmed) catch { _ => return "md" }
    match parsed {
      Object(_) | Array(_) => "json"
      _ => "md"
    }
  }
}

///|
fn replacement_allowed(
  existing : String,
  incoming : String,
  mode : WriteMode,
) -> Bool {
  existing.is_empty() || existing == incoming || mode is Replace
}

///|
async fn fail(message : String) -> Unit {
  @stdio.stderr.write("beads:companion: \{message}\n")
  finish(1, message~)
}

///|
async fn bd_output(args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output("bd", args)
  if !err.text().is_empty() {
    @stdio.stderr.write(err.text())
  }
  if code != 0 {
    fail("bd failed with exit status \{code}.")
  }
  out.text()
}

///|
fn valid_id(id : String) -> Bool {
  !(id.is_empty() ||
  id.has_prefix("-") ||
  id.contains("/") ||
  id.contains("\\") ||
  id.contains("..") ||
  id.contains(":"))
}

///|
async fn issue(id : String) -> Issue {
  if !valid_id(id) {
    fail("Expected an explicit bead ID, got \{id}.")
  }
  let source = bd_output(["show", id, "--json"])
  match decode_issue(source, id) {
    Ok(value) => value
    Err(message) => {
      fail(message)
      abort(message)
    }
  }
}

///|
async fn nonempty_file(path : String) -> String {
  let content = @fs.read_file(path).text()
  if content.trim().is_empty() {
    fail("\{path} is empty; nothing was stored.")
  }
  content
}

///|
async fn export_design(value : Issue, path : String, mode : WriteMode) -> Unit {
  if value.design.is_empty() {
    fail("\{value.id} has no design. No file was written.")
  }
  if @fs.exists(path) && mode is Create {
    fail("\{path} already exists. Choose another path or use --replace.")
  }
  // No extra newline, reformatting, template replacement or HTML evaluation.
  @fs.write_file(path, value.design)
  progress(path)
  result_data.val = {
    "id": value.id,
    "path": path,
    "designFormat": extension(value.design),
  }
}

///|
async fn export_path(
  value : Issue,
  output : String?,
  directory : String,
) -> String {
  match output {
    Some(path) => path
    None => {
      if !@fs.exists(directory) {
        @fs.mkdir(directory, recursive=true)
      }
      "\{directory}/\{value.id}.\{extension(value.design)}"
    }
  }
}

///|
/// All companion writers for one bead lock the same persistent file in the shared
/// database directory. Never unlink the file: doing so can split locks by inode.
async fn store_locked(
  lock_path : String,
  incoming : String,
  mode : WriteMode,
  load : async () -> String,
  persist : async () -> Unit,
) -> StoreOutcome {
  let lock = @fs.open(lock_path, mode=ReadWrite, create_mode=OpenOrCreate)
  defer lock.close()
  @async.with_timeout(30_000, () => lock.lock(Exclusive))
  defer lock.unlock()
  let existing = load()
  if !replacement_allowed(existing, incoming, mode) {
    return Conflict
  }
  if existing == incoming {
    return Unchanged
  }
  persist()
  if load() != incoming {
    fail(
      "Stored design differs from the source. Inspect external/concurrent updates.",
    )
  }
  Written
}

///|
async fn shared_lock_path(id : String) -> String {
  if !valid_id(id) {
    fail("Expected an explicit bead ID, got \{id}.")
  }
  let location = @json.parse(bd_output(["where", "--json"]))
  guard location is Object(fields) && fields.get("path") is Some(String(path)) else {
    fail("Cannot locate the shared database for the design write lock.")
    abort("missing database location")
  }
  @fs.realpath(path) + "/companion-design-\{id}.lock"
}

///|
/// Offline subprocess fixture: the same critical section with file-backed data,
/// so CI can exercise actual competing processes without opening a tracker.
async fn self_test_write(directory : String, incoming : String) -> StoreOutcome {
  let state = directory + "/state"
  let result = store_locked(
    directory + "/writer.lock",
    incoming,
    Create,
    () => {
      let value = @fs.read_file(state).text()
      @async.sleep(200)
      value
    },
    () => @fs.write_file(state, incoming),
  )
  if result is Conflict {
    fail("Another writer stored a different design.")
  }
  result
}

///|
async fn run(command : Command) -> Unit {
  match command {
    Inspect(id) => {
      let value = issue(id)
      let summary : Json = {
        "id": value.id,
        "title": value.title,
        "status": value.status,
        "hasDesign": !value.design.is_empty(),
        "designFormat": if value.design.is_empty() {
          "none"
        } else {
          extension(value.design)
        },
        "embeddedSvgCount": value.design.split("<svg").count() - 1,
      }
      @stdio.stdout.write(summary.stringify() + "\n")
      bare_result.val = true
    }
    Export(id, output, mode) => {
      let value = issue(id)
      let path = export_path(value, output, ".dev/beads-specs")
      export_design(value, path, mode)
    }
    Store(id, path, mode) => {
      let content = nonempty_file(path)
      let lock_path = shared_lock_path(id)
      let result = store_locked(
        lock_path,
        content,
        mode,
        () => issue(id).design,
        () => {
          let snapshot = @fs.tmpdir(prefix="beads-design-store-")
          defer @fs.rmdir(snapshot, recursive=true)
          let source = snapshot + "/design"
          @fs.write_file(source, content)
          ignore(bd_output(["update", id, "--design-file", source]))
        },
      )
      result_data.val = {
        "id": id,
        "outcome": if result is Unchanged {
          "unchanged"
        } else {
          "written"
        },
      }
      match result {
        Conflict =>
          fail(
            "\{id} already has a different design. Export and merge it, then use --replace.",
          )
        Unchanged =>
          progress("\{id}: design already matches; no update needed.")
        Written =>
          progress(
            "\{id}: design stored and checked. Run bd dolt push to sync.",
          )
      }
    }
    Note(id, path) => {
      ignore(issue(id))
      ignore(nonempty_file(path))
      let source = @fs.realpath(path)
      ignore(bd_output(["note", id, "--file", source]))
      result_data.val = { "id": id, "appended": true }
      progress("\{id}: note appended. Run bd dolt push to sync.")
    }
    Remember(key, path) => {
      if key.is_empty() || key.has_prefix("-") {
        fail("Expected an explicit memory key.")
      }
      let content = nonempty_file(path)
      // The separator keeps leading dashes in memory text from becoming bd flags.
      ignore(bd_output(["remember", "--key", key, "--", content]))
      result_data.val = { "key": key, "saved": true }
      progress("\{key}: memory saved. Run bd dolt push to sync.")
    }
    Help | SelfTest | SelfTestWrite(_, _) => ()
  }
}

///|
fn parser_self_test() -> Unit raise {
  assert_true(parse_command([]) is Ok(Help))
  assert_true(parse_command(["--help"]) is Ok(Help))
  assert_true(parse_command(["--self-test"]) is Ok(SelfTest))
  assert_true(
    parse_command(["--self-test-write", "-directory", "--help"])
    is Ok(SelfTestWrite("-directory", "--help")),
  )
  assert_true(
    parse_command(["design", "inspect", "test-1"]) is Ok(Inspect("test-1")),
  )
  assert_true(
    parse_command(["design", "export", "test-1"])
    is Ok(Export("test-1", None, Create)),
  )
  assert_true(
    parse_command(["design", "export", "test-1", "path with spaces"])
    is Ok(Export("test-1", Some("path with spaces"), Create)),
  )
  assert_true(
    parse_command(["design", "export", "test-1", "--replace"])
    is Ok(Export("test-1", None, Replace)),
  )
  assert_true(
    parse_command(["design", "export", "test-1", "-path", "--replace"])
    is Ok(Export("test-1", Some("-path"), Replace)),
  )
  assert_true(
    parse_command(["design", "store", "test-1", "path"])
    is Ok(Store("test-1", "path", Create)),
  )
  assert_true(
    parse_command(["design", "store", "test-1", "path", "--replace"])
    is Ok(Store("test-1", "path", Replace)),
  )
  assert_true(
    parse_command(["note", "test-1", "--self-test"])
    is Ok(Note("test-1", "--self-test")),
  )
  assert_true(
    parse_command(["remember", "key", "--help"])
    is Ok(Remember("key", "--help")),
  )
  for
    path in [
      "-path", "--unknown", "--help", "--self-test", "--", "--replace=true", "",
      "quote'\"$; 日本語",
    ] {
    assert_true(
      parse_command(["design", "export", "test-1", path])
      is Ok(Export("test-1", Some(actual), Create)) &&
      actual == path,
    )
    assert_true(
      parse_command(["note", "test-1", path]) is Ok(Note("test-1", actual)) &&
      actual == path,
    )
  }
  // Literal delimiters and reserved words keep their legacy operand positions.
  assert_true(
    parse_command(["design", "store", "test-1", "--", "--replace"])
    is Ok(Store("test-1", "--", Replace)),
  )
  assert_true(
    parse_command(["design", "store", "test-1", "--replace"])
    is Ok(Store("test-1", "--replace", Create)),
  )
  assert_true(
    parse_command(["design", "export", "test-1", "--replace", "--replace"])
    is Ok(Export("test-1", Some("--replace"), Replace)),
  )
  assert_true(
    parse_command(["design", "store", "test-1", "--replace", "--replace"])
    is Ok(Store("test-1", "--replace", Replace)),
  )
  for
    literal in [
      "--", "--replace", "--self-test-write", "--help", "", "word:note", "--id=x",
    ] {
    assert_true(
      parse_command(["--self-test-write", literal, literal])
      is Ok(SelfTestWrite(a, b)) &&
      a == literal &&
      b == literal,
    )
    assert_true(
      parse_command(["note", literal, literal]) is Ok(Note(a, b)) &&
      a == literal &&
      b == literal,
    )
    assert_true(
      parse_command(["design", "inspect", literal]) is Ok(Inspect(actual)) &&
      actual == literal,
    )
  }
  for args in invalid_invocations() {
    assert_true(parse_command(args) is Err(_))
  }
}

///|
fn invalid_invocations() -> Array[Array[String]] {
  [
    ["unknown"],
    ["--unknown"],
    ["-h"],
    ["help"],
    ["design"],
    ["design", "help"],
    ["design", "inspect"],
    ["design", "inspect", "test-1", "extra"],
    ["design", "export"],
    ["design", "export", "test-1", "path", "extra"],
    ["design", "export", "test-1", "path", "--unknown"],
    ["design", "store", "test-1"],
    ["note", "test-1"],
    ["remember", "key"],
    ["remember", "key", "path", "extra"],
    ["--help", "--self-test"],
    ["--self-test", "extra"],
    ["--self-test-write", "directory"],
    ["--self-test-write", "directory", "content", "extra"],
    ["--help", "design", "inspect", "test-1"],
    ["--self-test", "note", "test-1", "path"],
    ["note", "test-1", "path", "--help"],
    ["design", "inspect", "test-1", "--self-test"],
    ["--self-test-write", "directory", "content", "note", "test-1", "path"],
    ["design", "export", "test-1", "path", "--replace=true"],
    ["--"],
    ["--help", "--help"],
    ["--self-test", "--self-test"],
    ["--self-test-write=directory", "content"],
    ["content", "--self-test-write", "directory"],
    ["note", "test-1", "--", "--"],
    ["design", "export", "--replace", "test-1", "path"],
    ["design", "export", "test-1", "--replace", "path"],
    ["design", "export", "test-1", "--", "path"],
    ["design", "store", "test-1", "path", "--replace", "--replace"],
    ["design", "export", "test-1", "path", "--replace", "--replace"],
  ]
}

///|
async fn self_test() -> Unit {
  parser_self_test()
  let html = "<!DOCTYPE html>\n<html><body>\"Ion\" λ &amp; 日本語<svg></svg></body></html>\n"
  let payload : Json = [
    { "id": "test-1", "title": "Test design", "status": "open", "design": html },
  ]
  let value = match decode_issue(payload.stringify(), "test-1") {
    Ok(value) => value
    Err(message) => {
      fail(message)
      return
    }
  }
  assert_eq(value.design, html)
  assert_eq(extension(html), "html")
  assert_eq(extension("<!-- intro -->\n<HTML lang=\"en\"></HTML>"), "html")
  assert_eq(extension("\u{FEFF}<!-- intro --><hTmL></hTmL>"), "html")
  assert_eq(extension("# Guide\nExample: <html></html>"), "md")
  assert_eq(extension("{\"format\":\"json\"}"), "json")
  assert_eq(extension("# Markdown\n\nText\n"), "md")
  assert_true(decode_issue(payload.stringify(), "another-issue") is Err(_))
  assert_true(decode_issue("[]", "test-1") is Err(_))
  assert_true(decode_issue("not json", "test-1") is Err(_))
  assert_true(
    decode_issue("[{\"id\":\"test-1\",\"design\":42}]", "test-1") is Err(_),
  )
  assert_true(!replacement_allowed(html, "changed", Create))
  assert_true(replacement_allowed(html, "changed", Replace))
  assert_true(replacement_allowed(html, html, Create))
  assert_true(replacement_allowed("", html, Create))
  assert_true(
    parse_command(["design", "export", "test-1", "--replace"])
    is Ok(Export("test-1", None, Replace)),
  )
  assert_true(parse_command(["design", "store", "test-1"]) is Err(_))
  let root = @fs.tmpdir(prefix="morphir-beads-companion-")
  defer @fs.rmdir(root, recursive=true)
  let directory = root + "/exports"
  let default_path = export_path(value, None, directory)
  assert_eq(default_path, directory + "/test-1.html")
  // Reusing the default directory must not fail with File exists.
  assert_eq(export_path(value, None, directory), default_path)
  let destination = root + "/design with spaces.html"
  export_design(value, destination, Create)
  assert_eq(@fs.read_file(destination).text(), html)
  @fs.write_file(destination, "older local content")
  export_design(value, destination, Replace)
  assert_eq(@fs.read_file(destination).text(), html)
  @fs.write_file(root + "/state", "")
  let script = @fs.realpath("scripts/beads-companion.mbtx")
  // A temporary cwd has no beads-check script, so even an accidental parse
  // success cannot reach a live tracker. Syntax failures must happen first.
  for args in invalid_invocations() {
    let (status, out, err) = @process.collect_output(
      "moonx",
      [script, "--", ..args],
      cwd=root,
    )
    assert_eq(status, 1)
    assert_eq(out.text(), "")
    assert_eq(
      err.text(),
      "beads:companion: Unknown command or arguments; use --help.\n",
    )
  }
  let (help_status, help_out, help_err) = @process.collect_output(
    "moonx",
    [script, "--help"],
    cwd=root,
  )
  let (empty_status, empty_out, empty_err) = @process.collect_output(
    "moonx",
    [script],
    cwd=root,
  )
  assert_eq(help_status, 0)
  assert_eq(empty_status, 0)
  assert_eq(help_out.text(), empty_out.text())
  assert_true(
    help_out.text().has_prefix("moonx scripts/beads-companion.mbtx COMMAND\n"),
  )
  assert_eq(help_err.text(), "")
  assert_eq(empty_err.text(), "")
  let results = @async.all([
    () => {
      @process.collect_output("moonx", [
        script, "--self-test-write", root, "first",
      ])
    },
    () => {
      @process.collect_output("moonx", [
        script, "--self-test-write", root, "second",
      ])
    },
  ])
  let codes = results.map(result => result.0)
  assert_true(
    (codes[0] == 0 && codes[1] == 1) || (codes[0] == 1 && codes[1] == 0),
  )
  let winner = if codes[0] == 0 { "first" } else { "second" }
  assert_eq(@fs.read_file(root + "/state").text(), winner)
  // Both the winning writer and the refusing writer must release the OS lock.
  let lock = @fs.open(root + "/writer.lock", mode=ReadWrite)
  defer lock.close()
  assert_true(lock.try_lock(Exclusive))
  lock.unlock()
  progress("beads:companion: self-test passed; no beads database was opened.")
}

///|
async fn command_main(argv : Array[String]) -> Unit {
  let command = match parse_command(argv) {
    Ok(command) => command
    Err(message) => {
      fail(message)
      return
    }
  }
  match command {
    Help =>
      progress(
        (
          #|moonx scripts/beads-companion.mbtx COMMAND
          #|  design inspect ID
          #|  design export ID [PATH] [--replace]
          #|  design store ID FILE [--replace]
          #|  note ID FILE
          #|  remember KEY FILE
          #|  --self-test
          #|
          #|Run from the repository root after bd dolt pull. Export defaults to
          #|.dev/beads-specs/ID.html, .json or .md according to the stored content.
          #|Parent directories for an explicit PATH must already exist.
          #|Writes remain local until bd dolt push; no command merges or releases.
        ),
      )
    SelfTest => {
      self_test()
      result_data.val = { "selfTest": "passed" }
      operation.val = "beads.companion.self-test"
    }
    SelfTestWrite(directory, content) => {
      let outcome = self_test_write(directory, content)
      result_data.val = {
        "path": directory + "/state",
        "written": outcome is Written,
        "outcome": if outcome is Written {
          "written"
        } else {
          "unchanged"
        },
      }
      operation.val = "beads.companion.self-test-write"
    }
    _ => {
      // Check for an existing bootstrapped DB before any bd command can create one.
      let status = @process.run(
        "moonx",
        ["scripts/beads-check.mbtx"],
        stdout=@stdio.stderr,
        stderr=@stdio.stderr,
      )
      if status != 0 {
        fail(
          "Shared database check failed. Follow beads:check's repair guidance.",
        )
      }
      operation.val = "beads.companion." +
        (match command {
          Inspect(_) => "design.inspect"
          Export(_, _, _) => "design.export"
          Store(_, _, _) => "design.store"
          Note(_, _) => "note"
          Remember(_, _) => "remember"
          _ => "control"
        })
      run(command) catch {
        error => fail(error.to_string())
      }
    }
  }
}

///|
enum Presentation {
  Text
  Json
}

///|
let presentation : Ref[Presentation] = Ref(Text)

///|
let result_data : Ref[Json] = Ref({})

///|
let operation : Ref[String] = Ref("beads.companion")

///|
/// Only this bounded root prefix is owned. Tail values are encoded for syntax
/// validation only; the original array slice is returned without reconstruction.
fn presentation_arguments(argv : Array[String]) -> Array[String] raise {
  match argv {
    ["--forward-argv", "--", .. raw] => {
      ignore(
        @argparse.Command(
          "beads.companion",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("forward-argv", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--forward-argv", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    ["--json", .. raw] => {
      presentation.val = Json
      ignore(
        @argparse.Command(
          "beads.companion",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("json", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--json", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    _ => argv
  }
}

///|
fn presentation_help() -> @argparse.Command {
  @argparse.Command(
    "beads.companion",
    about="design inspect ID | design export ID [PATH] [--replace] | design store ID FILE [--replace] | note ID FILE | remember KEY FILE | --self-test-write DIRECTORY CONTENT JSON results use profile morphir/command-result, contractVersion0.1.0, command, state, exitCode, diagnostics and result on success or error{code,message} on failure. Existing successful JSON schemas remain bare. Stdout is one compact JSON value plus LF; progress and child logs use stderr. Help has result.help and no command effects; supported self-tests report actual completion. Exit0 means success; explicit syntax/child statuses remain meaningful, new expected JSON refusals exit1; default abort behavior is unchanged.",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[
      @argparse.FlagArg(
        "json",
        about="Emit one command result; select at the root before operation data",
      ),
      @argparse.FlagArg(
        "forward-argv",
        about="Only exact --forward-argv -- RAW selects literal forwarding; unwrap once. Other text-mode tails keep their legacy meaning",
      ),
      @argparse.FlagArg("help", short='h', about="Show help without effects"),
      @argparse.FlagArg(
        "self-test",
        about="Run the existing isolated self-test",
      ),
    ],
    positionals=[
      @argparse.PositionArg("operation", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn progress(message : String) -> Unit {
  if presentation.val is Json {
    @stdio.stderr.write(message + "\n")
  } else {
    println(message)
  }
}

///|
async fn finish(code : Int32, message~ : String = "Command failed") -> Unit {
  if presentation.val is Json {
    let value : Json = if code == 0 {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "succeeded",
        "exitCode": 0,
        "result": result_data.val,
        "diagnostics": [],
      }
    } else {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "failed",
        "exitCode": code,
        "error": {
          "code": "command-failed",
          "message": if message == "Command failed" {
            "Command exited with status \{code}"
          } else {
            message
          },
        },
        "diagnostics": [],
      }
    }
    @stdio.stdout.write(value.stringify() + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = presentation_arguments(@env.args()[1:].to_owned())
  if presentation.val is Json {
    // Built-in help exits inside argparse. JSON help is an ordinary declared
    // flag in a separate grammar, with no acquisition or command effects.
    let help = Some(
      @argparse.Command(
        "beads.companion",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("help", short='h', required=true)],
      ).parse(argv=if argv.is_empty() { ["--help"] } else { argv }, env=Map([])),
    ) catch {
      _ => None
    }
    if help is Some(matches) &&
      (matches.flags.get("help") == Some(true) || argv.is_empty()) {
      result_data.val = { "help": presentation_help().render_help() }
      operation.val = "beads.companion.help"
      finish(0)
      return
    }
  }
  try {
    command_main(argv)
    if !bare_result.val {
      finish(0)
    }
  } catch {
    error =>
      if presentation.val is Json {
        @stdio.stderr.write(error.to_string() + "\n")
        finish(1, message=error.to_string())
      } else {
        raise error
      }
  }
}

///|
let bare_result : Ref[Bool] = Ref(false)

///|
test "JSON prefix preserves literal tail and unwraps escape only once" {
  let previous = presentation.val
  defer {
    presentation.val = previous
  }
  let raw = [
    "--json", "--", "--forward-argv", "--", "", "λ '$;`", "--help", "--replace",
  ]
  let escaped = presentation_arguments(["--forward-argv", "--", ..raw])
  assert_eq(escaped, raw)
  assert_true(presentation.val is Text)
  let selected = presentation_arguments(["--json", ..raw])
  assert_eq(selected, raw)
  assert_true(presentation.val is Json)
}
