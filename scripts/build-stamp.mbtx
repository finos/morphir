----
import {
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
}
----

// Writes the build stamp of the native CLI: a MoonBit file with the CLI
// version from `moon.mod` and the git commit of the checkout. The pre-build
// step of `apps/morphir` runs it; the WASM worker mode puts the stamp into its
// build identity.

///|
/// The commit when git cannot name one, as outside a checkout.
let unknown_commit : String = "unknown"

///|
fn command() -> @argparse.Command {
  @argparse.Command(
    "build-stamp",
    about="Write the build stamp of the native CLI: a MoonBit file with build_version from --version-file (a moon.mod) and build_commit from git rev-parse HEAD in the current directory (\"unknown\" when git fails). The file is written only when its text changes. With --json, stdout is one morphir/command-result 0.1.0 value with result {output, version, commit, written}; failures have error {code, message} and exit 1 (2 for invalid arguments). Without --json the command prints nothing on success.",
    disable_help_subcommand=true,
    flags=[
      @argparse.FlagArg("json", about="Write one command-result on stdout"),
    ],
    options=[
      @argparse.OptionArg("output", about="The MoonBit file to write"),
      @argparse.OptionArg(
        "version-file",
        about="The moon.mod that names the version",
      ),
    ],
  )
}

///|
/// The `version` of a moon.mod text, or `None`.
fn version_of(text : String) -> String? {
  for line in text.split("\n") {
    let line = line.trim(chars=" \t\r")
    guard line.has_prefix("version") else { continue }
    let parts = line.split("\"").to_array()
    if parts.length() >= 3 &&
      parts[0].trim(chars=" \t=").to_owned() == "version" {
      return Some(parts[1].to_owned())
    }
  }
  None
}

///|
/// The stamp file for a version and a commit.
fn stamp_text(version : String, commit : String) -> String {
  (
    $|// Generated by scripts/build-stamp.mbtx before each build of this package.
    $|// Do not edit; the file is not committed.
    $|
    $|///|
    $|/// The version of this CLI build, from moon.mod.
    $|let build_version : String = \{Json::string(version).stringify()}
    $|
    $|///|
    $|/// The git commit of this CLI build, or "unknown" outside a checkout.
    $|let build_commit : String = \{Json::string(commit).stringify()}
    $|
  )
}

///|
async fn git_commit() -> String {
  let (code, out, _) = @process.collect_output("git", ["rev-parse", "HEAD"]) catch {
    _ => return unknown_commit
  }
  let commit = out.text().trim(chars=" \t\r\n").to_owned()
  if code == 0 && commit.length() == 40 {
    commit
  } else {
    unknown_commit
  }
}

///|
async fn execute(output : String, version_file : String) -> Json {
  let version = version_of(@fs.read_file(version_file).text()).unwrap_or(
    "unknown",
  )
  let commit = git_commit()
  let text = stamp_text(version, commit)
  let current = @fs.read_file(output).text() catch { _ => "" }
  let written = current != text
  if written {
    @fs.write_file(output, text)
  }
  { "output": output, "version": version, "commit": commit, "written": written }
}

///|
fn result(state : String, code : Int32, body : (String, Json)) -> String {
  let fields : Map[String, Json] = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "build-stamp",
    "state": state,
    "exitCode": code,
    "diagnostics": [],
  }
  fields[body.0] = body.1
  Json::object(fields).stringify() + "\n"
}

///|
async fn main {
  let json = @env.args().contains("--json")
  let matches = command().parse(argv=@env.args()[1:]) catch {
    error => {
      if json {
        @stdio.stdout.write(
          result(
            "failed",
            2,
            (
              "error",
              { "code": "invalid_arguments", "message": error.to_string() },
            ),
          ),
        )
      } else {
        @stdio.stderr.write("build-stamp: \{error}\n")
      }
      @sys.exit(2)
      panic()
    }
  }
  guard matches.values.get("output") is Some([output, ..]) &&
    matches.values.get("version-file") is Some([version_file, ..]) else {
    let message = "--output and --version-file are required"
    if json {
      @stdio.stdout.write(
        result(
          "failed",
          2,
          ("error", { "code": "invalid_arguments", "message": message }),
        ),
      )
    } else {
      @stdio.stderr.write("build-stamp: \{message}\n")
    }
    @sys.exit(2)
    panic()
  }
  let stamp = execute(output, version_file) catch {
    error => {
      if json {
        @stdio.stdout.write(
          result(
            "failed",
            1,
            (
              "error",
              { "code": "command_failed", "message": error.to_string() },
            ),
          ),
        )
      } else {
        @stdio.stderr.write("build-stamp: \{error}\n")
      }
      @sys.exit(1)
      panic()
    }
  }
  if json {
    @stdio.stdout.write(result("succeeded", 0, ("result", stamp)))
  }
}

///|
test "version_of reads the version of a moon.mod" {
  assert_eq(
    version_of("name = \"morphir/morphir\"\n\nversion = \"0.1.0\"\n"),
    Some("0.1.0"),
  )
  assert_eq(version_of("name = \"x\"\n"), None)
}

///|
test "stamp_text writes both constants as MoonBit string literals" {
  let text = stamp_text("0.1.0", "abc")
  assert_true(text.contains("let build_version : String = \"0.1.0\""))
  assert_true(text.contains("let build_commit : String = \"abc\""))
}
