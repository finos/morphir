----
import {
  "moonbitlang/core/json",
  "moonbitlang/core/argparse",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

// Explicit parent-owned checking-policy client scenarios through the one shared Rust MCK.

///|
async fn checked(
  program : String,
  args : Array[String],
  environment~ : Map[String, String] = {},
) -> Unit {
  let code = run_child(program, args, extra_env=environment)
  if code != 0 {
    command_exit(1)
  }
}

///|
fn field(value : Json, name : String) -> Json {
  match value {
    Object(fields) => fields.get(name).unwrap_or(Json::null())
    _ => Json::null()
  }
}

///|
async fn execute() -> Unit {
  guard @env.get_env_var("MORPHIR_MCK_BIN") is Some(runner) &&
    @env.get_env_var("MORPHIR_WORKBENCH_KIT") is Some(kit) else {
    @stdio.stderr.write(
      "Set MORPHIR_MCK_BIN and MORPHIR_WORKBENCH_KIT to the explicit parent runner and draft.21 kit.\n",
    )
    command_exit(1)
  }
  let corpus = @fs.read_file(kit + "/cases.json").json()
  if json_output.val {
    details["kit"] = Json(kit)
    details["formatVersion"] = field(corpus, "formatVersion")
    if field(corpus, "cases") is Array(rows) {
      details["caseCount"] = Json(rows.length())
    }
  }
  guard field(corpus, "formatVersion") == Json::string("0.1.0-draft.21") &&
    field(corpus, "cases") is Array(cases) &&
    !cases.is_empty() else {
    command_exit(1)
  }
  let evidence = @env.get_env_var("MORPHIR_WORKBENCH_EVIDENCE").unwrap_or(
    ".dev/native-policy-client-mck/reports",
  )
  if !@fs.exists(evidence) {
    @fs.mkdir(evidence, recursive=true)
  }
  checked("bun", ["--check", "tools/build-native-client-mck.ts"])
  for target in ["js", "native", "wasm", "wasm-gc"] {
    checked("moon", [
      "test", "apps/morphir-workbench/executions", "--target", target,
    ])
  }
  let app = "apps/morphir-workbench/"
  let built = app + "_build/native-client-mck/"
  for runtime in ["node", "chromium"] {
    for mode in ["debug", "release"] {
      let core = app +
        "_build/js/" +
        mode +
        "/build/finos/morphir-workbench/execution-core/execution-core.js"
      let report = evidence + "/" + runtime + "-" + mode + ".json"
      checked(
        runner,
        [
          "--no-banner",
          "mck",
          "workbench",
          "run",
          "--kit",
          kit,
          "--adapter",
          "node",
          "--adapter-arg",
          built + "native-client-mck.mjs",
          "--report",
          report,
        ],
        environment={
          "MORPHIR_WORKBENCH_CLIENT_MAPPING": "capability-checks",
          "MORPHIR_WORKBENCH_CLIENT_CORE": core,
          "MORPHIR_WORKBENCH_CLIENT_DRIVER": built + "native-client-trace.js",
          "MORPHIR_WORKBENCH_CLIENT_BROWSER": if runtime == "chromium" {
            "1"
          } else {
            "0"
          },
        },
      )
      checked(runner, [
        "--no-banner", "mck", "workbench", "check", "--kit", kit, "--report", report,
      ])
      let result = read_report(report)
      guard field(result, "qualified") == Json::boolean(true) &&
        field(result, "records") is Array(records) &&
        records.length() == cases.length() else {
        command_exit(1)
      }
    }
  }
  progress().write(
    "Native client scenarios pass Node and Chromium with debug/release cores; all reports independently checked.\n",
  )
}

///|
// Presentation is selected only at the owned root. Legacy ignored tails are
// never scanned or rebuilt from argparse's variadic matches.
let json_output : Ref[Bool] = Ref(false)

///|
let checks : Array[Json] = []

///|
let reports : Array[Json] = []

///|
let details : Map[String, Json] = Map([])

///|
suberror CommandExit {
  CommandExit(Int32)
}

///|
fn command_exit(code : Int32) -> Unit raise {
  if json_output.val {
    raise CommandExit(code)
  }
  @sys.exit(code)
}

///|
fn progress() -> @stdio.Output {
  if json_output.val {
    @stdio.stderr
  } else {
    @stdio.stdout
  }
}

///|
async fn run_child(
  program : String,
  args : Array[String],
  extra_env~ : Map[String, String] = {},
  cwd? : StringView,
) -> Int32 {
  let code = if json_output.val {
    @process.run(
      program,
      args,
      extra_env~,
      cwd?,
      stdout=@stdio.stderr,
      stderr=@stdio.stderr,
    )
  } else {
    @process.run(program, args, extra_env~, cwd?)
  }
  if json_output.val {
    checks.push({ "program": program, "args": Json(args), "exitCode": code })
  }
  code
}

///|
fn json_command() -> @argparse.Command {
  @argparse.Command(
    "workbench-native-policy-client-mck --json",
    about="Opt-in morphir/command-result 0.1.0: one compact JSON value plus LF on stdout; live child output and progress on stderr. Success result contains completed checks and report metadata. Failures contain error.code/message and the mapped exitCode, without result. Expected refusals exit 1; Every checked child failure maps to 1. Default abort presentation remains unchanged. --help has no effects. Use --json -- RAW to ignore an exact legacy tail, or --forward-argv -- RAW for one-level legacy presentation. No self-test operation is defined.",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[@argparse.FlagArg("help", short='h')],
  )
}

///|
async fn emit_success(result : Json) -> Unit {
  let value : Json = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "workbench.native.policy.client.mck",
    "state": "succeeded",
    "exitCode": 0,
    "result": result,
    "diagnostics": [],
  }
  @stdio.stdout.write(value.stringify() + "\n")
}

///|
async fn emit_failure(code : Int32, kind : String, message : String) -> Unit {
  let value : Json = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "workbench.native.policy.client.mck",
    "state": "failed",
    "exitCode": code,
    "error": { "code": kind, "message": message },
    "diagnostics": [],
  }
  @stdio.stdout.write(value.stringify() + "\n")
  @sys.exit(code)
}

///|
#cfg(target="js")
fn arguments() -> Array[String] {
  @env.args()[2:].to_owned()
}

///|
#cfg(not(target="js"))
fn arguments() -> Array[String] {
  @env.args()[1:].to_owned()
}

///|
async fn main {
  let argv = arguments()
  if argv is ["--forward-argv", "--", ..] {
    execute()
    return
  }
  guard argv is ["--json", .. rest] else {
    execute()
    return
  }
  json_output.val = true
  let command = json_command()
  // The exact delimiter begins an ignored legacy segment. Do not inspect it.
  let controls = if rest is ["--", ..] { [] } else { rest.to_owned() }
  let matches = command.parse(argv=controls) catch {
    error => {
      emit_failure(1, "syntax", error.to_string())
      return
    }
  }
  if matches.flags.get("help").unwrap_or(false) {
    emit_success({ "help": command.render_help() })
    return
  }
  execute() catch {
    CommandExit(0) => ()
    CommandExit(code) => {
      let last = checks.last().unwrap_or(Json::null())
      let message = "Qualification stopped with mapped exit code \{code}. Last completed check: " +
        last.stringify()
      emit_failure(code, "qualification-failed", message)
      return
    }
    error => {
      emit_failure(1, "command-error", error.to_string())
      return
    }
  }
  details["checks"] = Json(checks)
  details["reports"] = Json(reports)
  emit_success(Json(details))
}

///|
async fn read_report(path : String) -> Json {
  let value = @fs.read_file(path).json()
  if json_output.val {
    reports.push({
      "path": path,
      "qualified": field(value, "qualified"),
      "recordCount": match field(value, "records") {
        Array(rows) => Json(rows.length())
        _ => Json::null()
      },
    })
  }
  value
}
