----
import {
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

// Select focused CI checks. Unknown paths and empty diffs select every suite.
// Use --event in Actions, BASE HEAD locally, or --self-test to check the rules;
// --json prints the selection as one JSON object.

///|
let suites : Array[String] = [
  "compiler", "frontend", "conformance", "provider", "lifecycle", "telemetry", "workbench",
]

///|
suberror AutomationPolicyError {
  LegacyAutomation(String)
} derive(Debug)

///|
fn starts_with_any(path : String, prefixes : Array[String]) -> Bool {
  prefixes.iter().any(p => path.has_prefix(p))
}

///|
fn is_docs_like(path : String) -> Bool {
  if path.has_prefix("tests/fixtures/mep-smithy/") {
    return false
  }
  !path.has_suffix(".mbt.md") &&
  (
    starts_with_any(path, ["docs/", "site/", "apps/morphir-site/"]) ||
    path == ".github/workflows/site.yml" ||
    path == ".github/workflows/site-build.yml" ||
    path.has_suffix(".md")
  )
}

///|
fn is_site_input(path : String) -> Bool {
  if path.has_prefix("tests/fixtures/mep-smithy/") {
    return false
  }
  // These directories are not imported by the site or its /try/ workbench.
  if starts_with_any(path, [
      "pkgs/morphir-host/embedding/", "pkgs/morphir-moonbit/mep/",
    ]) {
    return path.has_suffix(".md")
  }
  starts_with_any(path, [
    "docs/", "site/", "apps/morphir-site/", "apps/morphir-workbench/", "pkgs/", ".config/mise/",
    "tools/", "types/", "tests/", ".github/actions/",
  ]) ||
  (path.has_prefix("apps/") && path.has_suffix("/README.md")) ||
  path == "moon.work" ||
  path.has_prefix("tsconfig") ||
  path == "package.json" ||
  path == "bun.lock" ||
  path.has_prefix(".github/workflows/")
}

///|
/// Only proven independent components opt out. Shared inputs and unknown paths
/// keep all baseline jobs. Native/workspace backend checks still follow `code`.
fn baseline_jobs(path : String) -> Array[String] {
  if is_docs_like(path) {
    return if is_site_input(path) { ["typescript"] } else { [] }
  }
  if starts_with_any(path, [
      "pkgs/morphir-host/embedding/", "apps/morphir-extension/", "pkgs/morphir-moonbit/mep/",
    ]) ||
    [
      "scripts/package-mep-extension.mbtx", "scripts/portable-mep-check.mbtx", "scripts/portable-mep-mck.mbtx",
    ].contains(path) {
    return ["typescript", "embedding"]
  }
  // Elm/Scheme owns generated sample freshness, even though the samples ship
  // inside the Workbench app. Keep that transitive edge ahead of the app rule.
  if path == "scripts/workbench-samples.mbtx" ||
    path.has_prefix("apps/morphir-workbench/assets/samples/") {
    return ["typescript", "elm-scheme"]
  }
  if [
      "scripts/conformance-check.mbtx", "scripts/installed-lifecycle-check.mbtx",
      "scripts/llvm-setup.mbtx",
    ].contains(path) {
    return ["typescript"]
  }
  if starts_with_any(path, [
      "apps/morphir-workbench/", "pkgs/morphir-workbench-native/", "pkgs/morphir-workbench-native-session/",
      "scripts/workbench-", "apps/morphir-extension/", "pkgs/morphir-moonbit/mep/",
    ]) ||
    path == "scripts/moonbit-extension.mbtx" ||
    path == "pkgs/morphir-host/native_telemetry.mbt" ||
    path == "pkgs/morphir-host/native_telemetry_test.mbt" ||
    starts_with_any(path, ["scripts/native-otel-", "scripts/native-telemetry-"]) {
    return ["typescript"]
  }
  if starts_with_any(path, [
      "pkgs/morphir-moonbit/", "pkgs/morphir-moonbit-bindings/", "pkgs/morphir-sdk/",
      "pkgs/morphir-moonbit-frontend/",
    ]) {
    return ["typescript", "embedding", "elm-scheme"]
  }
  ["supervision", "embedding", "typescript", "elm-scheme"]
}

///|
/// Narrow rules come first. Shared IR/engine/host/config and unknown inputs
/// conservatively select all suites, including their downstream consumers.
fn affected(path : String) -> Array[String] {
  if is_docs_like(path) {
    return []
  }
  if starts_with_any(path, [
      "apps/morphir-extension/", "pkgs/morphir-moonbit/mep/",
    ]) {
    // The protocol JSON fixture owns extension process behavior too. Keep the
    // embedding baseline and add its installed Workbench consumer.
    return ["workbench"]
  }
  if path.has_prefix("pkgs/morphir-host/embedding/") ||
    path == "scripts/moonbit-extension.mbtx" ||
    path == "scripts/mep-smithy-check.mbtx" ||
    path.has_prefix("tests/fixtures/mep-smithy/") {
    return []
  }
  if starts_with_any(path, [
      "apps/morphir-workbench/", "pkgs/morphir-workbench-native/", "pkgs/morphir-workbench-native-session/",
      "scripts/workbench-",
    ]) {
    return ["workbench"]
  }
  if path == "pkgs/morphir-host/native_telemetry.mbt" ||
    path == "pkgs/morphir-host/native_telemetry_test.mbt" ||
    starts_with_any(path, ["scripts/native-otel-", "scripts/native-telemetry-"]) {
    return ["telemetry"]
  }
  if starts_with_any(path, ["apps/morphir/fixtures/authenticated-provider/"]) ||
    starts_with_any(path, [
      "scripts/ci-provider-", "scripts/installed-provider-",
    ]) {
    return ["provider"]
  }
  if path == "scripts/installed-lifecycle-check.mbtx" ||
    path == "scripts/llvm-setup.mbtx" {
    return ["lifecycle"]
  }
  if starts_with_any(path, [
      "pkgs/morphir-moonbit/", "pkgs/morphir-moonbit-bindings/", "pkgs/morphir-sdk/",
    ]) {
    return [
      "compiler", "frontend", "conformance", "provider", "lifecycle", "workbench",
    ]
  }
  if path.has_prefix("pkgs/morphir-moonbit-frontend/") ||
    path == "scripts/moonbit-frontend-check.mbtx" {
    return ["frontend", "conformance", "provider", "lifecycle", "workbench"]
  }
  if path == "scripts/conformance-check.mbtx" {
    return ["conformance"]
  }
  suites
}

///|
/// Changes to the policy/toolchain must exercise the full workflow before merge.
fn requires_full(path : String) -> Bool {
  !is_docs_like(path) &&
  (
    starts_with_any(path, [
      ".github/workflows/", ".github/actions/", "scripts/ci-",
    ]) ||
    path == ".config/mise/config.toml" ||
    path == "moon.work"
  )
}

///|
/// `mise_selection_enforced` is false while the semantic mise selection runs
/// in shadow mode: it is only logged, and the path rule decides. Task 8 of
/// morphir-ukvn.5.62 sets it to true.
let mise_selection_enforced : Bool = false

///|
let mise_config_path : String = ".config/mise/config.toml"

///|
/// The output names that a mise impact may select. Any other name selects
/// full: an impact that names a check this script does not know fails closed.
let check_names : Array[String] = [
  "code", "site", "supervision", "embedding", "typescript", "elm-scheme", ..suites,
]

///|
/// The impact that `ci-mise-impact.mbtx BASE HEAD` prints. `checks` keeps the
/// output names of the wire format; `parse` accepts only `check_names`.
/// Each reason is one line: `subject: effect (detail)`.
struct MiseImpact {
  full : Bool
  checks : Array[String]
  reasons : Array[String]
  mise : String
} derive(Eq, Debug)

///|
/// A full impact for a failure to get or read the impact.
fn MiseImpact::full_because(detail : String) -> MiseImpact {
  { full: true, checks: [], reasons: [detail], mise: "unknown", }
}

///|
/// Read the last nonempty line of the child's stdout as the wire format. A
/// check name that is not in `check_names` makes the impact full.
fn MiseImpact::parse(text : String) -> MiseImpact raise {
  let lines = text
    .split("\n")
    .map(line => line.trim().to_owned())
    .filter(line => line != "")
    .collect()
  guard lines.last() is Some(line) else {
    fail("ci-mise-impact printed nothing")
  }
  guard @json.parse(line) is Object(fields) else {
    fail("impact is not a JSON object: \{line}")
  }
  let full = match fields.get("full") {
    Some(True) => true
    Some(False) => false
    _ => fail("impact has no boolean full: \{line}")
  }
  guard fields.get("checks") is Some(Array(items)) &&
    fields.get("reasons") is Some(Array(entries)) &&
    fields.get("mise") is Some(String(mise)) else {
    fail("impact has no checks, reasons or mise: \{line}")
  }
  let reasons = entries.map(entry => {
    guard entry is Object(reason) &&
      reason.get("subject") is Some(String(subject)) &&
      reason.get("effect") is Some(String(effect)) &&
      reason.get("detail") is Some(String(detail)) else {
      fail("impact reason is not readable: \{entry.stringify()}")
    }
    "\{subject}: \{effect} (\{detail})"
  })
  let checks : Array[String] = []
  let mut full = full
  for item in items {
    match item {
      String(name) if check_names.contains(name) => checks.push(name)
      _ => {
        full = true
        reasons.push("unknown check \{item.stringify()}: full")
      }
    }
  }
  { full, checks, reasons, mise, }
}

///|
/// Select the checks for `paths`. With a mise impact, the config path is left
/// out of the path rules, and the impact adds its checks. A full impact (or
/// one with a check name this script does not know) selects every check.
fn select(paths : Array[String], mise? : MiseImpact) -> Map[String, Bool] {
  let paths = paths.filter(p => p != "")
  let all = paths.is_empty()
  let paths = if mise is Some(_) {
    paths.filter(p => p != mise_config_path)
  } else {
    paths
  }
  let result : Map[String, Bool] = {
    "code": all || paths.iter().any(p => !is_docs_like(p)),
    "site": all || paths.iter().any(is_site_input),
    "full": all || paths.iter().any(requires_full),
  }
  for suite in suites {
    result.set(suite, all || paths.iter().any(p => affected(p).contains(suite)))
  }
  for job in ["supervision", "embedding", "typescript", "elm-scheme"] {
    result.set(
      job,
      all || paths.iter().any(p => baseline_jobs(p).contains(job)),
    )
  }
  if mise is Some(impact) {
    if impact.full || impact.checks.iter().any(c => !check_names.contains(c)) {
      for name in ["full", ..check_names] {
        result.set(name, true)
      }
    }
    for name in impact.checks {
      if check_names.contains(name) {
        result.set(name, true)
      }
    }
  }
  result
}

///|
/// The output names that `selection` selects, other than `full`.
fn selected_checks(selection : Map[String, Bool]) -> String {
  Json(check_names.filter(name => selection.get(name) == Some(true))).stringify()
}

///|
/// Combine the path selection with the mise outcome, where `Err` is the
/// table drift message of `ci-mise-impact.mbtx`. Return the selection and the
/// diagnostic lines, without their prefix. In shadow mode the path rule
/// decides and drift is only logged; when enforced, the impact decides and
/// drift fails.
fn mise_decision(
  paths : Array[String],
  outcome : Result[MiseImpact, String],
  enforced~ : Bool,
) -> (Map[String, Bool], Array[String]) raise {
  match outcome {
    Err(drift) => {
      guard !enforced else { fail("mise task table drift: \{drift}") }
      (
        select(paths),
        [
          "table drift: \{drift}",
          "shadow, not enforced; would fail on table drift",
        ],
      )
    }
    Ok(impact) => {
      let semantic = select(paths, mise=impact)
      let summary = "full=\{semantic.get("full") == Some(true)} checks=" +
        selected_checks(semantic)
      if enforced {
        (semantic, [..impact.reasons, "enforced; selects " + summary])
      } else {
        (
          select(paths),
          [..impact.reasons, "shadow, not enforced; would select " + summary],
        )
      }
    }
  }
}

///|
/// The outcome of a reuse decision. `proven` lists, in the order of `own`, the
/// keys that `own` selects and `selection` leaves out. `log` has one line for
/// each proven key, without a prefix.
struct Reuse {
  selection : Map[String, Bool]
  proven : Array[String]
  log : Array[String]
}

///|
/// Leave out the checks that both a landed change and a green receipt cover.
/// A landed `full` reuses nothing. Otherwise a key stays selected unless
/// `landed` also selects it or the receipt did, so a key that `own` selects
/// and the receipt did not select re-runs. A missing key counts as false.
fn reuse_selection(
  own : Map[String, Bool],
  landed : Map[String, Bool],
  receipt : Map[String, Bool],
) -> Reuse {
  guard landed.get("full") != Some(true) else {
    { selection: own.copy(), proven: [], log: [], }
  }
  let selection : Map[String, Bool] = Map([])
  let proven = []
  let log = []
  for key, selected in own {
    let keep = selected &&
      (landed.get(key) == Some(true) || receipt.get(key) != Some(true))
    selection.set(key, keep)
    if selected && !keep {
      proven.push(key)
      log.push("\{key}: proven by the receipt, not affected by landed changes")
    }
  }
  { selection, proven, log, }
}

///|
fn required(selection : Map[String, Bool]) -> Array[String] {
  let jobs = ["changes", "lint", "format-check", "validate-config"]
  if selection.get("code") == Some(true) {
    jobs.append(["build", "test"])
  }
  for job in ["supervision", "embedding", "typescript", "elm-scheme"] {
    if selection.get(job) == Some(true) {
      jobs.push(job)
    }
  }
  if selection.get("site") == Some(true) {
    jobs.push("site")
  }
  if selection.get("full") == Some(true) {
    jobs.push("full-qualification")
  } else if selection.get("code") == Some(true) {
    jobs.push("native-qualification")
  }
  if selection.get("full") != Some(true) &&
    ["lifecycle", "telemetry", "workbench"]
    .iter()
    .any(s => selection.get(s) == Some(true)) {
    jobs.push("installed-qualification")
  }
  jobs
}

///|
fn valid_revision(value : String) -> Bool {
  (value.length() == 40 || value.length() == 64) &&
  value.iter().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) &&
  value.iter().any(c => c != '0')
}

///|
fn legacy_automation(path : String) -> Bool {
  (
    path.has_prefix(".config/mise/tasks/") &&
    !path.has_suffix(".mbtx") &&
    !path.has_suffix(".md")
  ) ||
  (
    path.has_prefix("scripts/") &&
    [".sh", ".bash", ".ps1", ".py", ".js", ".mjs", ".ts", ".mts"]
    .iter()
    .any(s => path.has_suffix(s))
  )
}

///|
async fn self_test() -> Unit {
  presentation_self_test()
  let backend = [
    "compiler", "frontend", "conformance", "provider", "lifecycle", "workbench",
  ]
  let frontend = [
    "frontend", "conformance", "provider", "lifecycle", "workbench",
  ]
  let cases : Array[(Array[String], Bool, Bool, Array[String])] = [
    (["docs/ARCHITECTURE.md"], false, true, []),
    (["apps/morphir-site/views/pages.mbt"], false, true, []),
    (["README.md", "AGENTS.md"], false, false, []),
    (["pkgs/morphir-ir/README.md"], false, true, []),
    (["pkgs/morphir-ir/README.mbt.md"], true, true, suites),
    (["pkgs/morphir-ir/ir.mbt"], true, true, suites),
    (["pkgs/morphir-engine/engine.mbt"], true, true, suites),
    (["pkgs/morphir-metadata/metadata.mbt"], true, true, suites),
    (["pkgs/morphir-host/host.mbt"], true, true, suites),
    (["apps/morphir/main.mbt"], true, false, suites),
    (["apps/morphir-extension/main.mbt"], true, false, ["workbench"]),
    (["pkgs/morphir-moonbit/mep/session.mbt"], true, false, ["workbench"]),
    (["scripts/moonbit-extension.mbtx"], true, false, []),
    (["scripts/mep-smithy-check.mbtx"], true, false, []),
    (["tests/fixtures/mep-smithy/compile-ion.md"], true, false, []),
    (["tests/fixtures/mep-smithy/missing-initialized.md"], true, false, []),
    (["tests/fixtures/mep-smithy/source.json"], true, false, []),
    (["pkgs/morphir-host/embedding/index.mts"], true, false, []),
    (["apps/morphir-workbench/browser/main.ts"], true, true, ["workbench"]),
    // Desktop remains conservative shared-code selection, including Workbench.
    (
      ["apps/morphir-workbench-desktop/app/json_presentation.mbt"],
      true,
      false,
      suites,
    ),
    (
      ["apps/morphir-workbench-desktop/app/json_presentation_io.mbt"],
      true,
      false,
      suites,
    ),
    (
      ["apps/morphir/scripts/test-native-owner-json-presentation.ts"],
      true,
      false,
      suites,
    ),
    (
      ["apps/morphir/scripts/test-protocol-json-presentation.ts"],
      true,
      false,
      suites,
    ),
    (["tools/workbench-command-json.test.ts"], true, true, suites),
    (["scripts/headless-parity-controls.mbtx"], true, false, suites),
    (
      ["pkgs/morphir-host/acceptance/protocol-fault/presentation.mbt"],
      true,
      true,
      suites,
    ),
    (
      ["pkgs/morphir-workbench-native/fixture/presentation.mbt"],
      true,
      true,
      ["workbench"],
    ),
    (
      ["apps/morphir-workbench/mck/capabilities/js/json_presentation.mbt"],
      true,
      true,
      ["workbench"],
    ),
    (
      ["apps/morphir-workbench/mck/native/json_presentation.mbt"],
      true,
      true,
      ["workbench"],
    ),
    (
      ["pkgs/morphir-workbench-native/workspace/service.mbt"],
      true,
      true,
      ["workbench"],
    ),
    (
      ["pkgs/morphir-workbench-native-session/session.mbt"],
      true,
      true,
      ["workbench"],
    ),
    (["scripts/workbench-native-workers.mbtx"], true, false, ["workbench"]),
    (["pkgs/morphir-host/native_telemetry.mbt"], true, true, ["telemetry"]),
    (["scripts/native-otel-setup.mbtx"], true, false, ["telemetry"]),
    (["scripts/ci-provider-release.mbtx"], true, false, ["provider"]),
    (
      ["apps/morphir/fixtures/authenticated-provider/provider-release.ion"],
      true,
      false,
      ["provider"],
    ),
    (["scripts/installed-lifecycle-check.mbtx"], true, false, ["lifecycle"]),
    (["pkgs/morphir-moonbit/generator.mbt"], true, true, backend),
    (["pkgs/morphir-sdk/int/int.mbt"], true, true, backend),
    (["pkgs/morphir-moonbit-frontend/library.mbt"], true, true, frontend),
    (["scripts/conformance-check.mbtx"], true, false, ["conformance"]),
    ([".github/workflows/ci.yml"], true, true, suites),
    ([".github/workflows/qualification.yml"], true, true, suites),
    ([".github/workflows/ci-packaged.yml"], true, true, suites),
    (["scripts/ci-changes.mbtx"], true, false, suites),
    (["moon.work"], true, true, suites),
    (["pkgs/morphir-moonbit/moon.mod"], true, true, backend),
    ([".config/mise/config.toml", "bun.lock"], true, true, suites),
    (["new-package/new-file.mbt"], true, false, suites),
    // Renames include the old path too. A code-to-docs move still selects code.
    (["pkgs/morphir-ir/old.mbt", "docs/new.md"], true, true, suites),
    (
      [
        "scripts/native-telemetry-check.mbtx", "scripts/workbench-native-workers.mbtx",
      ],
      true,
      false,
      ["telemetry", "workbench"],
    ),
    ([], true, true, suites),
    ([""], true, true, suites),
  ]
  for (paths, code, site, expected) in cases {
    let got = select(paths)
    guard got.get("code") == Some(code) && got.get("site") == Some(site) else {
      fail("Wrong baseline selection: " + paths.join(", "))
    }
    for suite in suites {
      guard got.get(suite) == Some(expected.contains(suite)) else {
        fail("Wrong \{suite} dependency selection: " + paths.join(", "))
      }
    }
    let jobs = required(got)
    let full = got.get("full") == Some(true)
    guard jobs.contains("native-qualification") == (code && !full) &&
      jobs.contains("full-qualification") == full &&
      jobs.contains("installed-qualification") ==
      (
        !full &&
        expected
        .iter()
        .any(s => ["lifecycle", "telemetry", "workbench"].contains(s))
      ) else {
      fail("Wrong required job set: " + paths.join(", "))
    }
  }
  for
    (path, expected) in [
      ("pkgs/morphir-ir/ir.mbt", false),
      ("apps/morphir/main.mbt", false),
      (".github/workflows/ci.yml", true),
      (".github/workflows/site.yml", false),
      ("scripts/ci-changes.mbtx", true),
      (".config/mise/config.toml", true),
      ("new-package/file.mbt", false),
    ] {
    guard requires_full(path) == expected else {
      fail("Wrong full-matrix selection: " + path)
    }
  }
  guard !valid_revision("--output=foo") &&
    !valid_revision("0000000000000000000000000000000000000000") &&
    valid_revision("06ac6045d0f06e884323974c9c1ce52597b92fec") else {
    fail("Revision validation failed")
  }
  test_note("ci-changes: \{cases.length()} dependency cases pass")
  for
    (paths, expected) in [
      (["apps/morphir-workbench/browser/main.ts"], ["typescript"]),
      (["scripts/workbench-samples.mbtx"], ["typescript", "elm-scheme"]),
      (
        ["apps/morphir-workbench/assets/samples/schema.json"],
        ["typescript", "elm-scheme"],
      ),
      (["pkgs/morphir-workbench-native/workspace/service.mbt"], ["typescript"]),
      (["pkgs/morphir-host/embedding/index.mts"], ["typescript", "embedding"]),
      (["pkgs/morphir-moonbit/mep/session.mbt"], ["typescript", "embedding"]),
      (
        ["apps/morphir-extension/frontend/adapter.mbt"],
        ["typescript", "embedding"],
      ),
      (["scripts/package-mep-extension.mbtx"], ["typescript", "embedding"]),
      (["scripts/portable-mep-check.mbtx"], ["typescript", "embedding"]),
      (["scripts/portable-mep-mck.mbtx"], ["typescript", "embedding"]),
      (
        ["pkgs/morphir-sdk/int/int.mbt"],
        ["typescript", "embedding", "elm-scheme"],
      ),
      (["scripts/conformance-check.mbtx"], ["typescript"]),
      (["scripts/installed-lifecycle-check.mbtx"], ["typescript"]),
      (
        ["pkgs/morphir-moonbit-frontend/library.mbt"],
        ["typescript", "embedding", "elm-scheme"],
      ),
      (
        ["pkgs/morphir-ir/ir.mbt"],
        ["supervision", "embedding", "typescript", "elm-scheme"],
      ),
      (
        ["pkgs/morphir-host/capabilities.mts"],
        ["supervision", "embedding", "typescript", "elm-scheme"],
      ),
      (
        ["unknown/new.mbt"],
        ["supervision", "embedding", "typescript", "elm-scheme"],
      ),
      (
        ["tools/build.ts"],
        ["supervision", "embedding", "typescript", "elm-scheme"],
      ),
      (["bun.lock"], ["supervision", "embedding", "typescript", "elm-scheme"]),
      (
        [".github/workflows/ci.yml"],
        ["supervision", "embedding", "typescript", "elm-scheme"],
      ),
      ([".github/workflows/site-build.yml"], ["typescript"]),
      (["README.md"], []),
      (["docs/ARCHITECTURE.md"], ["typescript"]),
      (
        [
          "pkgs/morphir-sdk/int/int.mbt", "pkgs/morphir-host/embedding/index.mts",
        ],
        ["typescript", "embedding", "elm-scheme"],
      ),
      ([], ["supervision", "embedding", "typescript", "elm-scheme"]),
    ] {
    let selection = select(paths)
    let jobs = required(selection)
    for job in ["supervision", "embedding", "typescript", "elm-scheme"] {
      guard selection.get(job) == Some(expected.contains(job)) &&
        jobs.contains(job) == expected.contains(job) else {
        fail(
          "Wrong baseline job or gate requirement for \{job}: " +
          paths.join(", "),
        )
      }
    }
  }
  test_note(
    "ci-changes: isolated, shared, unknown and combined baseline dependencies pass",
  )
  mise_test()
  reuse_test()
  timeout_test()
  diff_test()
}

///|
/// A selection that selects exactly `names`, over every key `select` sets.
fn selecting(names : Array[String]) -> Map[String, Bool] {
  let result = select(["README.md"], mise={
    full: false,
    checks: [],
    reasons: [],
    mise: "test",
  })
  for name in names {
    result.set(name, true)
  }
  result
}

///|
/// The reuse decision: what landed on main and what the receipt proved.
fn reuse_test() -> Unit raise {
  let own = selecting(["code", "compiler", "workbench"])
  let none = selecting([])
  let r = reuse_selection(own, none, own)
  guard selected_names(r.selection) == "" &&
    r.proven == ["code", "compiler", "workbench"] &&
    required(r.selection) ==
    ["changes", "lint", "format-check", "validate-config"] else {
    fail(
      "reuse_nothing_landed: \{selected_names(r.selection)} \{r.proven.join(",")}",
    )
  }
  let r = reuse_selection(own, selecting(["site"]), own)
  guard selected_names(r.selection) == "" && r.proven.length() == 3 else {
    fail("reuse_docs_landed: \{selected_names(r.selection)}")
  }
  let r = reuse_selection(own, selecting(["full"]), none)
  guard selected_names(r.selection) == selected_names(own) &&
    r.proven.is_empty() else {
    fail("reuse_landed_full: \{selected_names(r.selection)}")
  }
  let r = reuse_selection(
    own,
    selecting(["code", "workbench"]),
    selecting(["code", "compiler", "workbench"]),
  )
  guard selected_names(r.selection) == "code,workbench" &&
    r.proven == ["compiler"] else {
    fail(
      "reuse_intersection: \{selected_names(r.selection)} \{r.proven.join(",")}",
    )
  }
  // A key that own selects and the receipt did not select re-runs.
  let r = reuse_selection(
    selecting(["compiler", "telemetry"]),
    none,
    selecting(["compiler"]),
  )
  guard selected_names(r.selection) == "telemetry" && r.proven == ["compiler"] else {
    fail("reuse_own_key_not_in_receipt: \{selected_names(r.selection)}")
  }
  // A missing key counts as false; own full and site follow the same rule.
  let r = reuse_selection(
    selecting(["full", "site"]),
    { "site": true },
    selecting(["full", "site"]),
  )
  guard selected_names(r.selection) == "site" && r.proven == ["full"] else {
    fail("reuse_missing_and_full_key: \{selected_names(r.selection)}")
  }
  // The receipt proved code but not full: full re-runs and code is proven.
  let r = reuse_selection(
    selecting(["code", "full"]),
    none,
    selecting(["code"]),
  )
  guard selected_names(r.selection) == "full" && r.proven == ["code"] else {
    fail(
      "reuse_receipt_code_not_full: \{selected_names(r.selection)} \{r.proven.join(",")}",
    )
  }
  let r = reuse_selection(
    selecting(["code", "workbench"]),
    selecting(["code"]),
    selecting(["code", "workbench"]),
  )
  let jobs = required(r.selection)
  for job in ["changes", "lint", "format-check", "validate-config"] {
    guard jobs.contains(job) else {
      fail("reuse_required_jobs: \{jobs.join(",")}")
    }
  }
  guard jobs.contains("build") && !jobs.contains("installed-qualification") else {
    fail("reuse_required_jobs: \{jobs.join(",")}")
  }
  test_note("ci-changes: reuse decision passes")
}

///|
/// A child that runs longer than the timeout is stopped, and the impact is
/// full. The child is a script that sleeps in place of `ci-mise-impact.mbtx`.
async fn timeout_test() -> Unit {
  let root = @fs.tmpdir(prefix="morphir-ci-mise-timeout-")
  defer @fs.rmdir(root, recursive=true)
  @fs.mkdir(root + "/scripts")
  @fs.write_file(
    root + "/scripts/ci-mise-impact.mbtx",
    (
      #|import {
      #|  "moonbitlang/async@0.22.7",
      #|}
      #|
      #|///|
      #|async fn main {
      #|  @async.sleep(60000)
      #|}
    ),
  )
  let sha = "0123456789abcdef0123456789abcdef01234567"
  let got = mise_impact(sha, sha, cwd=root, timeout=1)
  guard got.full && got.reasons == ["child timed out after 1 s"] else {
    fail("child_timeout_is_full: \{got.describe()}")
  }
  test_note("ci-changes: child crash, drift marker and child timeout pass")
}

///|
/// The output keys that are true, for test messages.
fn selected_names(selection : Map[String, Bool]) -> String {
  selection.iter().filter(entry => entry.1).map(entry => entry.0).join(",")
}

///|
fn MiseImpact::describe(self : MiseImpact) -> String {
  "full=\{self.full} checks=\{self.checks.join(",")} mise=\{self.mise} reasons=" +
  self.reasons.join(" | ")
}

///|
/// The semantic mise selection and its shadow logs, without a child process.
fn mise_test() -> Unit raise {
  let empty : MiseImpact = {
    full: false,
    checks: [],
    reasons: [],
    mise: "test",
  }
  let config = [mise_config_path]
  let empty_selection = select(config, mise=empty)
  guard empty_selection.length() == 14 &&
    empty_selection.values().all(on => !on) &&
    required(empty_selection) ==
    ["changes", "lint", "format-check", "validate-config"] else {
    fail(
      "select_with_empty_impact: \{selected_names(empty_selection)} " +
      required(empty_selection).join(","),
    )
  }
  let checks = select(config, mise={ ..empty, checks: ["code", "conformance"], })
  guard selected_names(checks) == "code,conformance" &&
    required(checks).contains("native-qualification") &&
    checks.get("full") == Some(false) else {
    fail("select_with_checks: \{selected_names(checks)}")
  }
  let full = select(config, mise={ ..empty, full: true, })
  guard full.length() == 14 && full.values().all(on => on) else {
    fail("select_with_full: \{selected_names(full)}")
  }
  let unknown = select(config, mise={ ..empty, checks: ["nightly"], })
  guard unknown.values().all(on => on) else {
    fail("select_unknown_check_is_full: \{selected_names(unknown)}")
  }
  let ir = ["pkgs/morphir-ir/ir.mbt"]
  let union = select([..config, ..ir], mise=empty)
  guard union == select(ir) else {
    fail(
      "select_union_with_paths: \{selected_names(union)} vs \{selected_names(select(ir))}",
    )
  }
  let wire =
    #|{"full":false,"checks":["code","conformance"],"mise":"2026.10.15","reasons":[{"subject":"task test:conformance","effect":"checks code, conformance","detail":"called by ci-native.yml"}]}
  let parsed = MiseImpact::parse("compiling\n" + wire + "\n")
  guard parsed ==
    {
      full: false,
      checks: ["code", "conformance"],
      reasons: [
        "task test:conformance: checks code, conformance (called by ci-native.yml)",
      ],
      mise: "2026.10.15",
    } else {
    fail("parse_wire_format: \{parsed.describe()}")
  }
  let odd = MiseImpact::parse(
    wire.replace(old="\"conformance\"]", new="\"nightly\"]"),
  )
  guard odd.full && odd.checks == ["code"] && odd.reasons.length() == 2 else {
    fail("parse_unknown_check_is_full: \{odd.describe()}")
  }
  for bad in ["", "not json", "{\"full\":false}", "[]"] {
    let refused = try {
      ignore(MiseImpact::parse(bad))
      false
    } catch {
      _ => true
    }
    guard refused else { fail("parse_refuses: \{bad}") }
  }
  let (shadow, shadow_log) = mise_decision(config, Ok(empty), enforced=false)
  guard shadow == select(config) &&
    shadow_log == ["shadow, not enforced; would select full=false checks=[]"] else {
    fail("decision_shadow: \{shadow_log.join(" | ")}")
  }
  let (enforced, enforced_log) = mise_decision(
    config,
    Ok({ ..empty, checks: ["code"], reasons: ["task x: checks code (y)"], }),
    enforced=true,
  )
  guard enforced == select(config, mise={ ..empty, checks: ["code"], }) &&
    enforced_log ==
    [
      "task x: checks code (y)", "enforced; selects full=false checks=[\"code\"]",
    ] else {
    fail("decision_enforced: \{enforced_log.join(" | ")}")
  }
  let (drift, drift_log) = mise_decision(
    config,
    Err("unmapped call"),
    enforced=false,
  )
  guard drift == select(config) &&
    drift_log ==
    [
      "table drift: unmapped call", "shadow, not enforced; would fail on table drift",
    ] else {
    fail("decision_shadow_drift: \{drift_log.join(" | ")}")
  }
  let drift_fails = try {
    ignore(mise_decision(config, Err("unmapped call"), enforced=true))
    false
  } catch {
    _ => true
  }
  guard drift_fails else { fail("decision_enforced_drift: did not fail") }
  let crash_err = "Failure(ci-mise-impact.mbtx:1:1 FAILED: git exploded)\n"
  let crash = MiseImpact::from_child(1, "", crash_err)
  guard crash.full &&
    crash.reasons == ["ci-mise-impact exited 1: " + crash_err.trim().to_owned()] else {
    fail("child_crash_exit_1_is_full: \{crash.describe()}")
  }
  let (crash_shadow, _) = mise_decision(config, Ok(crash), enforced=false)
  let (crash_enforced, _) = mise_decision(config, Ok(crash), enforced=true)
  guard crash_shadow == select(config) && crash_enforced.values().all(on => on) else {
    fail("child_crash_exit_1: shadow ignores it, enforced selects full")
  }
  let drift_err =
    #|ci-mise-impact: .github/workflows/ci.yml:9 job check calls mise task build:x, which has no entry in task_table in scripts/ci-mise-impact.mbtx. Add it with the checks the task affects.
    #|Failure(ci-mise-impact.mbtx:3050:11 FAILED: table drift)
  let marked = try {
    ignore(MiseImpact::from_child(1, "", drift_err))
    ""
  } catch {
    MiseDrift(message) => message
  }
  guard marked == drift_err.trim().to_owned() else {
    fail("child_drift_needs_marker: got \{marked}")
  }
  let other = MiseImpact::from_child(2, "", "killed")
  guard other.full && other.reasons == ["ci-mise-impact exited 2: killed"] else {
    fail("child_other_exit_is_full: \{other.describe()}")
  }
  let unreadable = MiseImpact::from_child(0, "not json", "")
  guard unreadable.full else {
    fail("child_unreadable_output_is_full: \{unreadable.describe()}")
  }
  test_note("ci-changes: semantic mise selection and shadow decisions pass")
}

///|
async fn changed(
  base : String,
  head : String,
  merge_base~ : Bool = true,
  cwd~ : String = ".",
) -> Array[String] {
  guard valid_revision(base) && valid_revision(head) else {
    fail("CI diff requires full, nonzero commit SHAs")
  }
  let args = ["diff", "--name-only", "--no-renames", "-z", "--end-of-options"]
  args.append(if merge_base { ["\{base}...\{head}"] } else { [base, head] })
  let (status, out, err) = @process.collect_output("git", args, cwd~)
  guard status == 0 else { fail("git diff failed: " + err.text()) }
  let live_args = ["diff", "--diff-filter=ACMTUXB", ..args[1:]]
  let (status, live, err) = @process.collect_output("git", live_args, cwd~)
  guard status == 0 else { fail("Automation diff failed: " + err.text()) }
  for path in live.text().split("\u{0000}") {
    if legacy_automation(path.to_owned()) {
      raise LegacyAutomation(path.to_owned())
    }
  }
  out.text().split("\u{0000}").map(p => p.to_owned()).collect()
}

///|
async fn fixture_git(root : String, args : Array[String]) -> String {
  let command = [
    "-c",
    "commit.gpgsign=false",
    "-c",
    "core.autocrlf=false",
    "-c",
    "user.name=CI fixture",
    "-c",
    "user.email=ci@example.invalid",
    "-c",
    "core.hooksPath=" + root + "/no-hooks",
    ..args,
  ]
  let (status, out, err) = @process.collect_output("git", command, cwd=root)
  guard status == 0 else { fail("Git fixture failed: " + err.text()) }
  out.text().trim().to_owned()
}

///|
/// Real Git diffs exercise deletion/rename and divergent force-push semantics.
/// Child processes also check event dispatch and GITHUB_OUTPUT append behavior.
async fn diff_test() -> Unit {
  let script = @fs.realpath("scripts/ci-changes.mbtx")
  let root = @fs.tmpdir(prefix="morphir-ci-selection-")
  defer @fs.rmdir(root, recursive=true)
  ignore(fixture_git(root, ["init", "-q"]))
  @fs.write_file(root + "/README.md", "fixture\n")
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture base"]))
  let base = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.mkdir(root + "/pkgs/morphir-ir", recursive=true)
  @fs.write_file(root + "/pkgs/morphir-ir/ir.mbt", "fixture\n")
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture IR"]))
  let ir = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.mkdir(root + "/docs")
  ignore(fixture_git(root, ["mv", "pkgs/morphir-ir/ir.mbt", "docs/model.md"]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture rename"]))
  let renamed = fixture_git(root, ["rev-parse", "HEAD"])
  guard select(changed(ir, renamed, cwd=root)).get("provider") == Some(true) else {
    fail("Code-to-docs rename bypassed dependent checks")
  }
  ignore(fixture_git(root, ["checkout", "--detach", "-q", base]))
  @fs.write_file(root + "/README.md", "divergent docs\n")
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture divergent docs"]))
  let head = fixture_git(root, ["rev-parse", "HEAD"])
  guard select(changed(ir, head, cwd=root)).get("code") == Some(false) &&
    select(changed(ir, head, merge_base=false, cwd=root)).get("provider") ==
    Some(true) else {
    fail("PR and force-push diff semantics were conflated")
  }
  for event in ["pull_request", "merge_group", "push", "workflow_dispatch"] {
    let destination = root + "/output"
    @fs.write_file(destination, "existing=true\n")
    let (status, out, err) = @process.collect_output(
      "moonx",
      [script, "--event"],
      cwd=root,
      extra_env={
        "EVENT": event,
        "PR_BASE": ir,
        "PR_HEAD": head,
        "QUEUE_BASE": ir,
        "QUEUE_HEAD": head,
        "PUSH_BASE": ir,
        "GITHUB_SHA": head,
        "GITHUB_OUTPUT": destination,
      },
    )
    guard status == 0 else { fail("Event fixture failed: " + err.text()) }
    let code = event == "push" || event == "workflow_dispatch"
    guard out.text().contains("code=\{code}\n") &&
      @fs.read_file(destination)
      .text()
      .has_prefix("existing=true\ncode=\{code}\n") else {
      fail("Wrong event selection or GITHUB_OUTPUT overwrite: " + event)
    }
  }
  test_note(
    "ci-changes: real Git rename, divergent push, four events and output append pass",
  )
  @fs.mkdir(root + "/.config/mise/tasks", recursive=true)
  @fs.write_file(root + "/.config/mise/tasks/legacy.ps1", "legacy fixture\n")
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture forbidden wrapper"]))
  let legacy = fixture_git(root, ["rev-parse", "HEAD"])
  let refused = try {
    ignore(changed(head, legacy, cwd=root))
    false
  } catch {
    LegacyAutomation(_) => true
    _ => false
  }
  guard refused else {
    fail("Added platform-specific wrapper passed CI selection")
  }
  let (push_status, _, _) = @process.collect_output(
    "moonx",
    [script, "--event"],
    cwd=root,
    extra_env={
      "EVENT": "push",
      "PUSH_BASE": head,
      "GITHUB_SHA": legacy,
      "GITHUB_OUTPUT": root + "/output",
    },
  )
  guard push_status != 0 else {
    fail("Push fallback bypassed automation policy")
  }
  ignore(fixture_git(root, ["rm", "-q", ".config/mise/tasks/legacy.ps1"]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture remove wrapper"]))
  let removed = fixture_git(root, ["rev-parse", "HEAD"])
  ignore(changed(legacy, removed, cwd=root))
  guard legacy_automation("scripts/refresh-ir-fixtures.py") &&
    !legacy_automation("scripts/ci-changes.mbtx") &&
    !legacy_automation(".config/mise/tasks/README.md") &&
    !legacy_automation("apps/morphir/scripts/test.ts") else {
    fail("Wrong automation policy scope")
  }
  test_note(
    "ci-changes: legacy automation additions/pushes refuse and removals pass",
  )
  event_shadow_test(script, root)
  reuse_wiring_test(script)
}

///|
/// A minimal mise world for `ci-mise-impact.mbtx`: the workflow calls only
/// tasks of the config, by their real `task_table` names.
let fixture_workflow : String =
  #|name: CI
  #|on: push
  #|jobs:
  #|  check:
  #|    runs-on: ubuntu-latest
  #|    steps:
  #|      - run: mise run lint:yaml
  #|      - run: mise run test:conformance

///|
let fixture_config : String =
  #|[tasks."lint:yaml"]
  #|run = "echo yaml"
  #|
  #|[tasks."test:conformance"]
  #|run = "echo conformance"

///|
/// A pull request that only adds an opt-in task: the path rule still selects
/// full, and the shadow log says that the impact would not. The fixture gets
/// an untracked copy of `ci-mise-impact.mbtx`, which `ci-changes` runs from
/// the repository root as it does in CI.
async fn event_shadow_test(script : String, root : String) -> Unit {
  @fs.mkdir(root + "/.config/mise", recursive=true)
  @fs.mkdir(root + "/.github/workflows", recursive=true)
  @fs.write_file(root + "/" + mise_config_path, fixture_config)
  @fs.write_file(root + "/.github/workflows/ci.yml", fixture_workflow)
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture mise world"]))
  let world = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.write_file(
    root + "/" + mise_config_path,
    fixture_config + "\n[tasks.\"test:opt-in-only\"]\nrun = \"echo opt\"\n",
  )
  ignore(fixture_git(root, ["commit", "-qam", "fixture opt-in task"]))
  let opt_in = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.mkdir(root + "/scripts", recursive=true)
  @fs.write_file(
    root + "/scripts/ci-mise-impact.mbtx",
    @fs.read_file(@fs.realpath("scripts/ci-mise-impact.mbtx")).text(),
  )
  let destination = root + "/output"
  @fs.write_file(destination, "existing=true\n")
  let (status, out, err) = @process.collect_output(
    "moonx",
    [script, "--event"],
    cwd=root,
    extra_env={
      "EVENT": "pull_request",
      "PR_BASE": world,
      "PR_HEAD": opt_in,
      "GITHUB_OUTPUT": destination,
    },
  )
  let path_only = changed(world, opt_in, cwd=root) |> select |> render
  guard status == 0 &&
    out.text().contains("\nfull=true\n") &&
    out.text() == path_only &&
    @fs.read_file(destination).text() == "existing=true\n" + path_only &&
    shadow_log_in_order(err.text(), world, opt_in) else {
    fail(
      "event_shadow_logs: exit \{status}\nstdout:\n\{out.text()}\nstderr:\n\{err.text()}",
    )
  }
  // landed_mise_log_labelled: the mise config landed since the receipt's
  // base, and the queue run's own change is docs. The landed impact logs
  // under the reuse prefix, and the run's own mise log is absent.
  @fs.write_file(root + "/README.md", "fixture\nqueued docs\n")
  ignore(fixture_git(root, ["commit", "-qam", "fixture queued docs"]))
  let queue_head = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.write_file(root + "/scripts/ci-reuse.mbtx", fake_reuse_script)
  let run = run_event(
    script,
    root,
    {
      "EVENT": "merge_group",
      "QUEUE_REF": "refs/heads/gh-readonly-queue/main/pr-194-\{opt_in}",
      "QUEUE_BASE": opt_in,
      "QUEUE_HEAD": queue_head,
    },
    fixture_verdict(select(["README.md"]), base=Some(world)),
  )
  let queue_today = changed(opt_in, queue_head, cwd=root) |> select |> render
  let landed_header = "ci-changes: reuse: landed mise: \{mise_config_path} changed (base \{world}, head \{opt_in}, mise "
  guard run.0 == 0 &&
    run.1 == queue_today &&
    run.2.contains(landed_header) &&
    !run.2.contains("ci-changes: mise: ") else {
    fail(run_failure("landed_mise_log_labelled", run))
  }
  test_note("ci-changes: pull request shadow mise impact logs pass")
  test_note("ci-changes: landed mise impact logs under the reuse prefix")
}

///|
/// The shadow log on stderr: first the header with both revisions and a mise
/// version, later the would-select line.
fn shadow_log_in_order(err : String, base : String, head : String) -> Bool {
  let header = "ci-changes: mise: \{mise_config_path} changed (base \{base}, head \{head}, mise "
  let shadow = "ci-changes: mise: shadow, not enforced; would select full=false checks=[]\n"
  match (err.find(header), err.find(shadow)) {
    (Some(first), Some(later)) => {
      let rest = err[first + header.length():].to_owned()
      let version = match rest.find(")\n") {
        Some(end) => rest[:end].to_owned()
        None => ""
      }
      first < later && version != "" && !version.contains("\n")
    }
    _ => false
  }
}

///|
/// `ci-mise-impact.mbtx` exited 1: a workflow calls a task at head that its
/// `task_table` does not map. The message is the child's stderr.
suberror MiseDrift {
  MiseDrift(String)
} derive(Debug)

///|
/// Text that `ci-mise-impact.mbtx` prints on stderr for table drift. Exit 1
/// without it is a crash, a compile failure or another uncaught error.
let drift_marker : String = "which has no entry in task_table"

///|
/// Read one run of `ci-mise-impact.mbtx`. Exit 1 with `drift_marker` on stderr
/// is table drift and raises `MiseDrift`. Any other nonzero exit, or stdout
/// that is not the wire format, gives a full impact with a reason.
fn MiseImpact::from_child(
  status : Int32,
  out : String,
  err : String,
) -> MiseImpact raise MiseDrift {
  match status {
    0 =>
      MiseImpact::parse(out) catch {
        error => MiseImpact::full_because("ci-mise-impact output: \{error}")
      }
    1 if err.contains(drift_marker) => raise MiseDrift(err.trim().to_owned())
    _ =>
      MiseImpact::full_because("ci-mise-impact exited \{status}: \{err.trim()}")
  }
}

///|
/// Run `ci-mise-impact.mbtx BASE HEAD` from the repository root `cwd`, for at
/// most `timeout` seconds; `MiseImpact::from_child` reads the result. A child
/// that does not run or does not end in time gives a full impact with a
/// reason. On timeout `@process.run` stops the child (SIGTERM, then SIGKILL
/// after 5 s) and returns only after it has ended.
async fn mise_impact(
  base : String,
  head : String,
  cwd~ : String = ".",
  timeout~ : Int32 = 120,
) -> MiseImpact {
  let run = try {
    let script = @fs.realpath(cwd + "/scripts/ci-mise-impact.mbtx")
    @async.with_timeout_opt(timeout * 1000, () => {
      @process.collect_output("moonx", [script, base, head], cwd~)
    })
  } catch {
    err => return MiseImpact::full_because("ci-mise-impact did not run: \{err}")
  }
  match run {
    None => MiseImpact::full_because("child timed out after \{timeout} s")
    Some((status, out, err)) =>
      MiseImpact::from_child(status, out.text(), err.text())
  }
}

///|
/// The `key=value` lines that `ci-changes` prints and appends to
/// `GITHUB_OUTPUT` for `selection`.
fn render(selection : Map[String, Bool]) -> String {
  let lines = StringBuilder()
  for name in output_names {
    lines.write_string("\{name}=\{selection.get(name) == Some(true)}\n")
  }
  let lanes = Json(acceptance_lanes(selection)).stringify()
  lines.write_string("acceptance-lanes=\{lanes}\n")
  lines.write_string("required=\{Json(required(selection)).stringify()}\n")
  lines.to_string()
}

///|
/// Select from `paths`, which `changed(base, head, merge_base~)` gave. When
/// the mise config is one of them, also get its impact from `base` (the merge
/// base of `base` and `head` when `merge_base`) to `head` and log it on
/// stderr, after a line with both revisions and the mise version of the
/// child; each line starts with `log_prefix`. `mise_decision` says which
/// selection counts.
async fn select_changes(
  paths : Array[String],
  base : String,
  head : String,
  merge_base~ : Bool = true,
  cwd~ : String = ".",
  log_prefix~ : String = "ci-changes: mise: ",
) -> Map[String, Bool] {
  guard paths.contains(mise_config_path) else { return select(paths) }
  let mut compared = base
  let outcome : Result[MiseImpact, String] = try {
    let from = if merge_base {
      let (status, out, err) = @process.collect_output(
        "git",
        ["merge-base", base, head],
        cwd~,
      )
      guard status == 0 else {
        fail("git merge-base failed: \{err.text().trim()}")
      }
      out.text().trim().to_owned()
    } else {
      base
    }
    compared = from
    Ok(mise_impact(from, head, cwd~))
  } catch {
    MiseDrift(message) => Err(message)
    err => Ok(MiseImpact::full_because("mise impact failed: \{err}"))
  }
  let (selection, log) = mise_decision(
    paths,
    outcome,
    enforced=mise_selection_enforced,
  )
  let version = match outcome {
    Ok(impact) => impact.mise
    Err(_) => "unknown"
  }
  let header = "\{mise_config_path} changed (base \{compared}, head \{head}, mise \{version})"
  for entry in [header, ..log] {
    for line in entry.split("\n") {
      @stdio.stderr.write("\{log_prefix}\{line}\n")
    }
  }
  selection
}

///|
fn environment(name : String) -> String {
  @env.get_env_var(name).unwrap_or("")
}

///|
/// Queue and bypass reuse are enforced (morphir-ukvn.5.90.9): a trusted
/// receipt leaves out the checks it proved and that nothing landed since its
/// base selects. Set this to false to return to shadow mode, where the
/// decision is only logged on stderr and the run selects as today. The push
/// skip for a commit that a merge-queue run proved is always enforced.
let reuse_enforced : Bool = true

///|
/// A full commit SHA, as `valid_revision` accepts it.
struct Sha(String) derive(Eq)

///|
fn Sha::parse(text : String) -> Sha? {
  if valid_revision(text) {
    Some(Sha(text))
  } else {
    None
  }
}

///|
fn Sha::short(self : Sha) -> String {
  self.0.view(end_offset=7).to_owned()
}

///|
/// The commit whose tree the receipt's run actually tested.
struct TestedCommit(Sha) derive(Eq)

///|
fn TestedCommit::parse(text : String) -> TestedCommit? {
  Sha::parse(text).map(sha => TestedCommit(sha))
}

///|
/// A Git tree identity, distinct from a tested commit even with the same hash.
struct TreeSha(Sha) derive(Eq)

///|
fn TreeSha::parse(text : String) -> TreeSha? {
  Sha::parse(text).map(sha => TreeSha(sha))
}

///|
/// A positive decimal Actions run identity, kept as text without integer limits.
struct RunId(String) derive(Eq)

///|
fn RunId::parse(text : String) -> RunId? {
  if !text.is_empty() &&
    text.iter().all(c => c >= '0' && c <= '9') &&
    text.iter().any(c => c != '0') {
    Some(RunId(text))
  } else {
    None
  }
}

///|
/// The fields of a CI receipt that reuse reads. `base` is the base of the PR
/// run, `None` for a merge-queue receipt. `selection` keeps the outputs of the
/// receipt's `changes` job whose value is "true" or "false".
struct Receipt {
  run : RunId
  attempt : String
  tested : TestedCommit
  tree : TreeSha
  base : Sha?
  selection : Map[String, Bool]
}

///|
/// The verdict that `ci-reuse.mbtx --json` prints.
enum Verdict {
  Trusted(
    receipt~ : Receipt,
    exact~ : Bool,
    reason~ : String,
    rerun_jobs~ : Array[String]
  )
  Untrusted(reason~ : String)
}

///|
/// A text field of `fields`, or "unknown".
fn text_field(fields : Map[String, Json], key : String) -> String {
  match fields.get(key) {
    Some(String(text)) => text
    _ => "unknown"
  }
}

///|
/// Read the last nonempty line of the child's stdout as a verdict. A trusted
/// verdict must have a receipt selection and `rerunJobs`.
fn Verdict::parse(text : String) -> Verdict raise {
  let lines = text
    .split("\n")
    .map(line => line.trim().to_owned())
    .filter(line => line != "")
    .collect()
  guard lines.last() is Some(line) else { fail("ci-reuse printed nothing") }
  guard @json.parse(line) is Object(fields) &&
    fields.get("reason") is Some(String(reason)) else {
    fail("verdict has no reason: \{line}")
  }
  match fields.get("trusted") {
    Some(False) => Untrusted(reason~)
    Some(True) => {
      let exact = match fields.get("exact") {
        Some(True) => true
        Some(False) => false
        _ => fail("verdict has no boolean exact: \{line}")
      }
      guard fields.get("receipt") is Some(Object(receipt)) &&
        receipt.get("selection") is Some(Object(outputs)) &&
        fields.get("rerunJobs") is Some(Array(jobs)) else {
        fail("trusted verdict has no receipt selection or rerunJobs: \{line}")
      }
      let selection : Map[String, Bool] = Map([])
      for key, value in outputs {
        match value {
          String("true") => selection.set(key, true)
          String("false") => selection.set(key, false)
          _ => ()
        }
      }
      // Actions serializes the native lanes as a JSON array in one output,
      // without individual compiler/frontend/conformance outputs.
      let lanes = match outputs.get("acceptance-lanes") {
        Some(String(text)) => Some(@json.parse(text)) catch { _ => None }
        _ => None
      }
      if lanes is Some(Array(items)) &&
        items.iter().all(item => item is String(_)) {
        for item in items {
          if item is String(lane) &&
            ["compiler", "frontend", "conformance"].contains(lane) {
            selection.set(lane, true)
          }
        }
      }
      let base = match receipt.get("pr") {
        Some(Object(pr)) =>
          match pr.get("base") {
            Some(String(text)) => Sha::parse(text)
            _ => None
          }
        _ => None
      }
      let rerun_jobs = jobs.map(job => {
        guard job is String(name) else {
          fail("rerunJobs has an entry that is not a name: \{line}")
        }
        name
      })
      guard RunId::parse(text_field(receipt, "runId")) is Some(run) &&
        TestedCommit::parse(text_field(receipt, "testedCommit")) is Some(tested) &&
        TreeSha::parse(text_field(receipt, "testedTree")) is Some(tree) else {
        fail("trusted verdict has invalid run, tested commit or tree identity")
      }
      Trusted(
        receipt={
          run,
          attempt: text_field(receipt, "runAttempt"),
          tested,
          tree,
          base,
          selection,
        },
        exact~,
        reason~,
        rerun_jobs~,
      )
    }
    _ => fail("verdict has no boolean trusted: \{line}")
  }
}

///|
/// Read one run of `ci-reuse.mbtx`. A nonzero exit, or stdout without a
/// verdict, is an error with the reason.
fn Verdict::from_child(
  status : Int32,
  out : String,
  err : String,
) -> Result[Verdict, String] {
  guard status == 0 else {
    return Err("ci-reuse exited \{status}: \{err.trim()}")
  }
  Ok(Verdict::parse(out)) catch {
    error => Err("ci-reuse output: \{error}")
  }
}

///|
/// Write `entry` on stderr, each line with the prefix `ci-changes: reuse: `.
async fn reuse_log(entry : String) -> Unit {
  for line in entry.split("\n") {
    @stdio.stderr.write("ci-changes: reuse: \{line}\n")
  }
}

///|
/// Run `ci-reuse.mbtx ARGS --json` from the repository root `cwd`, for at most
/// `timeout` seconds, and read its verdict. The notes that a child that exits 0
/// writes on stderr go to the reuse log. A child that does not run, does not
/// end in time, exits nonzero or prints no verdict gives `None`, and the reason
/// is logged: the run selects as today. As for `mise_impact`, the self-test
/// puts a stand-in script in a fixture root; nothing else selects the child.
async fn reuse_verdict(
  args : Array[String],
  cwd~ : String = ".",
  timeout~ : Int32 = 60,
  log~ : async (String) -> Unit = reuse_log,
) -> Verdict? {
  let run = try {
    let script = @fs.realpath(cwd + "/scripts/ci-reuse.mbtx")
    @async.with_timeout_opt(timeout * 1000, () => {
      @process.collect_output("moonx", [script, ..args, "--json"], cwd~)
    })
  } catch {
    err => {
      log("ci-reuse did not run: \{err}; selects as today")
      return None
    }
  }
  let outcome = match run {
    None => Err("ci-reuse timed out after \{timeout} s")
    Some((status, out, err)) => {
      let err = err.text()
      if status == 0 {
        for line in err.split("\n") {
          if !line.trim().is_empty() {
            log(line.to_owned())
          }
        }
      }
      Verdict::from_child(status, out.text(), err)
    }
  }
  match outcome {
    Ok(verdict) => Some(verdict)
    Err(reason) => {
      log("\{reason}; selects as today")
      None
    }
  }
}

///|
/// The selected output names of `selection` in output order, or "none".
fn selected_list(selection : Map[String, Bool]) -> String {
  let names = output_names.filter(name => selection.get(name) == Some(true))
  if names.is_empty() {
    "none"
  } else {
    names.join(",")
  }
}

///|
/// A selection that selects nothing: only the always-run jobs run.
fn nothing_selected() -> Map[String, Bool] {
  Map::from_array(output_names.map(name => (name, false)))
}

///|
/// Select from what landed on main between `base`, the base of the receipt's
/// PR run, and `current`, the base of this run (two-dot), with the rules of
/// the event. Log the landed commits. An empty diff selects nothing.
async fn landed_selection(
  base : Sha,
  current : Sha,
  cwd~ : String = ".",
) -> Map[String, Bool] {
  let (status, out, err) = @process.collect_output(
    "git",
    ["log", "--format=%h %s", "\{base.0}..\{current.0}"],
    cwd~,
  )
  guard status == 0 else { fail("git log failed: \{err.text().trim()}") }
  let commits = out.text().split("\n").filter(line => line != "").collect()
  let since = "landed since receipt base \{base.short()}: "
  if commits.is_empty() {
    reuse_log(since + "none")
  }
  for commit in commits {
    reuse_log(since + commit.to_owned())
  }
  let paths = changed(base.0, current.0, merge_base=false, cwd~).filter(path => {
    path != ""
  })
  if paths.is_empty() {
    nothing_selected()
  } else {
    // The run's own mise impact logs as `ci-changes: mise: `; this one is
    // labelled as the landed changes'.
    select_changes(
      paths,
      base.0,
      current.0,
      merge_base=false,
      cwd~,
      log_prefix="ci-changes: reuse: landed mise: ",
    )
  }
}

///|
/// The selection of a queue or bypass run whose own selection is `own` and
/// whose base is `current`. A trusted verdict leaves out the checks that its
/// receipt proved and that nothing landed since the receipt's base selects;
/// `reuse_enforced` says whether that counts or is only logged. Anything that
/// cannot be proven selects `own`, and the reason is logged.
async fn reuse_or_own(
  own : Map[String, Bool],
  verdict : Verdict?,
  current : String,
  cwd~ : String = ".",
) -> Map[String, Bool] {
  let (receipt, rerun_jobs) = match verdict {
    None => return own
    Some(Untrusted(reason~)) => {
      reuse_log("untrusted: \{reason}; selects as today")
      return own
    }
    Some(Trusted(receipt~, reason~, rerun_jobs~, ..)) => {
      let tested = receipt.tested.0.short()
      let tree = receipt.tree.0.short()
      reuse_log("trusted: \{reason} (tested \{tested}, tree \{tree})")
      (receipt, rerun_jobs)
    }
  }
  guard receipt.base is Some(base) else {
    reuse_log(
      "receipt has no PR base (run \{receipt.run.0} attempt \{receipt.attempt}); selects as today",
    )
    return own
  }
  guard Sha::parse(current) is Some(current) else {
    reuse_log("this run has no valid base; selects as today")
    return own
  }
  let landed = landed_selection(base, current, cwd~) catch {
    error => {
      reuse_log("landed classification failed: \{error}; selects as today")
      return own
    }
  }
  let reuse = reuse_selection(own, landed, receipt.selection)
  let proven = if reuse.proven.is_empty() {
    "none"
  } else {
    reuse.proven.join(",")
  }
  let reran = if rerun_jobs.is_empty() { "none" } else { rerun_jobs.join(", ") }
  reuse_log("own selection: \{selected_list(own)}")
  reuse_log("landed selection: \{selected_list(landed)}")
  reuse_log("re-run: \{selected_list(reuse.selection)}")
  reuse_log("proven: \{proven}")
  for line in reuse.log {
    reuse_log(line)
  }
  reuse_log("trusted after re-run attempt: \{reran}")
  let summary = "full=\{reuse.selection.get("full") == Some(true)} checks=" +
    selected_checks(reuse.selection)
  if reuse_enforced {
    reuse_log("enforced; selects " + summary)
    reuse.selection
  } else {
    reuse_log("shadow, not enforced; would select " + summary)
    own
  }
}

///|
/// A push of a commit that a merge-queue run proved selects nothing, so only
/// the always-run jobs run. This is enforced: it is the same commit.
async fn exact_skip(reason : String) -> Map[String, Bool] {
  let selection = nothing_selected()
  reuse_log("trusted (exact): \{reason}")
  reuse_log(
    "exact push, enforced; selects no checks, required " +
    Json(required(selection)).stringify(),
  )
  selection
}

///|
/// The selection for the Actions event in EVENT. Merge-queue and push runs
/// also ask `ci-reuse.mbtx` for a verdict.
async fn event_selection() -> Map[String, Bool] {
  match environment("EVENT") {
    "pull_request" => {
      let (base, head) = (environment("PR_BASE"), environment("PR_HEAD"))
      changed(base, head) |> select_changes(base, head)
    }
    "merge_group" => {
      let (base, head) = (environment("QUEUE_BASE"), environment("QUEUE_HEAD"))
      let own = changed(base, head) |> select_changes(base, head)
      let verdict = reuse_verdict([
        "queue",
        "--ref",
        environment("QUEUE_REF"),
        "--base",
        base,
        "--head",
        head,
      ])
      reuse_or_own(own, verdict, base)
    }
    "push" => {
      let (before, after) = (
        environment("PUSH_BASE"),
        environment("GITHUB_SHA"),
      )
      let paths : Array[String]? = if valid_revision(before) {
        Some(changed(before, after, merge_base=false)) catch {
          LegacyAutomation(path) => raise LegacyAutomation(path)
          _ => None // An unreachable pre-force-push commit selects all.
        }
      } else {
        None
      }
      let verdict = reuse_verdict(["push", "--sha", after, "--before", before])
      if verdict is Some(Trusted(exact=true, reason~, ..)) {
        return exact_skip(reason)
      }
      let selected = match paths {
        Some(paths) => paths |> select_changes(before, after, merge_base=false)
        None => select([])
      }
      selected.set("site", false) // Site workflow owns main deployment.
      reuse_or_own(selected, verdict, before)
    }
    _ => select([])
  }
}

///|
/// What `ci-changes` runs: the self-test, the selection for the Actions event
/// in EVENT, or the selection for the commits BASE and HEAD.
priv enum Mode {
  SelfTest
  Event
  Range(String, String)
} derive(Eq)

///|
priv struct Invocation {
  mode : Mode
  json : Bool
}

///|
fn changes_command(json~ : Bool = false) -> @argparse.Command {
  let help = if json {
    [@argparse.FlagArg("help", short='h', about="Show help information.")]
  } else {
    []
  }
  @argparse.Command(
    "ci-changes",
    about="Select focused CI checks",
    disable_help_flag=json,
    disable_help_subcommand=json,
    flags=[
      ..help,
      @argparse.FlagArg("self-test", about="Run the built-in tests", conflicts_with=[
        "event", "base", "head",
      ]),
      @argparse.FlagArg(
        "event",
        about="Select for the Actions event in EVENT",
        conflicts_with=["base", "head"],
      ),
      @argparse.FlagArg("json", about="Print the selection as one JSON object"),
    ],
    positionals=[
      @argparse.PositionArg("base", about="Base commit", requires=["head"]),
      @argparse.PositionArg("head", about="Head commit", requires=["base"]),
    ],
  )
}

///|
fn invocation(matches : @argparse.Matches) -> Invocation raise {
  let flag = (name : String) => matches.flags.get(name).unwrap_or(false)
  let mode = if flag("self-test") {
    SelfTest
  } else if flag("event") {
    Event
  } else {
    match (matches.values.get("base"), matches.values.get("head")) {
      (Some([base]), Some([head])) => Range(base, head)
      _ =>
        fail(
          "Usage: ci-changes.mbtx --event [--json] | BASE HEAD [--json] | --self-test",
        )
    }
  }
  { mode, json: flag("json"), }
}

///|
async fn execute(argv : Array[String]) -> Unit {
  let matches = changes_command(json=output_mode.json).parse(argv~, env=Map([]))
  if output_mode.json && matches.flags.get("help").unwrap_or(false) {
    @stdio.stdout.write(
      command_result({ "help": changes_command().render_help() }).stringify() +
      "\n",
    )
    return
  }
  let invocation = invocation(matches)
  output_mode.json = output_mode.json || invocation.json
  let selection = match invocation.mode {
    SelfTest => {
      self_test()
      if output_mode.json {
        @stdio.stdout.write(
          command_result({ "passed": true }).stringify() + "\n",
        )
      }
      return
    }
    Event => event_selection()
    Range(base, head) => changed(base, head) |> select_changes(base, head)
  }
  let text = render(selection)
  if !output_mode.json {
    @stdio.stdout.write(text)
  }
  if @env.get_env_var("GITHUB_OUTPUT") is Some(path) {
    @fs.write_file(path, @fs.read_file(path).text() + text)
  }
  if output_mode.json {
    println(selection_json(selection).stringify())
  }
}

///|
/// The output names of a selection, in the order `render` prints them.
let output_names : Array[String] = [
  "code", "site", "full", "supervision", "embedding", "typescript", "elm-scheme",
  ..suites,
]

///|
fn acceptance_lanes(selection : Map[String, Bool]) -> Array[String] {
  ["compiler", "frontend", "conformance"].filter(s => {
    selection.get(s) == Some(true)
  })
}

///|
/// The outputs of `selection` as one JSON object: each output name as a
/// boolean, and `acceptance-lanes` and `required` as arrays of job names.
fn selection_json(selection : Map[String, Bool]) -> Json {
  let fields : Map[String, Json] = Map([])
  for name in output_names {
    fields.set(name, Json::boolean(selection.get(name) == Some(true)))
  }
  fields.set("acceptance-lanes", Json(acceptance_lanes(selection)))
  fields.set("required", Json(required(selection)))
  Json::object(fields)
}

///|
/// A stand-in for `ci-reuse.mbtx` in a fixture root. It writes its arguments
/// to `reuse-args` and prints the content of `reuse-verdict`, or fails when
/// that content is `crash`.
let fake_reuse_script : String =
  #|import {
  #|  "moonbitlang/async@0.22.7",
  #|  "moonbitlang/async@0.22.7/fs",
  #|  "moonbitlang/async@0.22.7/stdio",
  #|  "moonbitlang/core/env",
  #|}
  #|
  #|///|
  #|async fn main {
  #|  @fs.write_file("reuse-args", @env.args()[1:].to_owned().join(" "))
  #|  @stdio.stderr.write("ci-reuse: fixture note\n")
  #|  let verdict = @fs.read_file("reuse-verdict").text()
  #|  if verdict == "crash\n" {
  #|    fail("simulated ci-reuse crash")
  #|  }
  #|  println(verdict)
  #|}

///|
/// A trusted verdict as `ci-reuse.mbtx --json` prints it. The receipt holds
/// the `changes` outputs for `selection` as strings, and a PR with `base`, or
/// a null PR (a merge-queue receipt) when `base` is `None`.
fn fixture_verdict(
  selection : Map[String, Bool],
  base~ : String?,
  exact~ : Bool = false,
  lanes~ : String? = None,
) -> String {
  let outputs : Map[String, Json] = Map([])
  for name in output_names {
    // The workflow exposes these lanes only through acceptance-lanes.
    if ["compiler", "frontend", "conformance"].contains(name) {
      continue
    }
    outputs.set(
      name,
      Json::string((selection.get(name) == Some(true)).to_string()),
    )
  }
  outputs.set(
    "acceptance-lanes",
    Json::string(lanes.unwrap_or(Json(acceptance_lanes(selection)).stringify())),
  )
  outputs.set("required", Json::string(Json(required(selection)).stringify()))
  let pr : Json = match base {
    Some(base) =>
      {
        "number": 194,
        "head": "4046644e7e5db6ca170e8b730b040af69c354f6e",
        "base": base,
      }
    None => Json::null()
  }
  let verdict : Json = {
    "trusted": true,
    "exact": exact,
    "reason": "PR #194 head 4046644 run 39549808921 attempt 2",
    "receipt": {
      "runId": "39549808921",
      "runAttempt": "2",
      "testedCommit": "7c1e5a0b9d8c7f6e5d4c3b2a1908f7e6d5c4b3a2",
      "testedTree": "9ab3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5",
      "pr": pr,
      "selection": Json::object(outputs),
    },
    "rerunJobs": ["Elm and Scheme end to end"],
  }
  verdict.stringify()
}

///|
/// Run `ci-changes --event` in `root` with `env`, after a stand-in verdict
/// `verdict` and with an existing line in GITHUB_OUTPUT. Return the exit
/// status, stdout, stderr, GITHUB_OUTPUT and the stand-in's arguments ("" when
/// it did not run).
async fn run_event(
  script : String,
  root : String,
  env : Map[String, String],
  verdict : String,
) -> (Int32, String, String, String, String) {
  let destination = root + "/output"
  @fs.write_file(destination, "existing=true\n")
  @fs.write_file(root + "/reuse-verdict", verdict)
  @fs.write_file(root + "/reuse-args", "")
  let env = env.copy()
  env.set("GITHUB_OUTPUT", destination)
  let (status, out, err) = @process.collect_output(
    "moonx",
    [script, "--event"],
    cwd=root,
    extra_env=env,
  )
  (
    status,
    out.text(),
    err.text(),
    @fs.read_file(destination).text(),
    @fs.read_file(root + "/reuse-args").text(),
  )
}

///|
/// One failure line with the child's output.
fn run_failure(
  name : String,
  run : (Int32, String, String, String, String),
) -> String {
  let (status, out, err, output, args) = run
  "\{name}: exit \{status}\nstdout:\n\{out}\nstderr:\n\{err}\nGITHUB_OUTPUT:\n\{output}\nci-reuse args: \{args}"
}

///|
/// Queue, push, failure and CLI wiring of reuse, with a stand-in
/// `ci-reuse.mbtx`. On main, `docs/landed.md` landed after the receipt's base;
/// the PR changes the IR. Every check runs, and all failures are reported.
async fn reuse_wiring_test(script : String) -> Unit {
  let root = @fs.tmpdir(prefix="morphir-ci-reuse-")
  defer @fs.rmdir(root, recursive=true)
  ignore(fixture_git(root, ["init", "-q"]))
  @fs.write_file(root + "/README.md", "fixture\n")
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture receipt base"]))
  let receipt_base = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.mkdir(root + "/docs")
  @fs.write_file(root + "/docs/landed.md", "landed\n")
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "docs: landed note"]))
  let main_head = fixture_git(root, ["rev-parse", "HEAD"])
  let landed = fixture_git(root, ["log", "-1", "--format=%h %s", main_head])
  @fs.mkdir(root + "/pkgs/morphir-ir", recursive=true)
  @fs.write_file(root + "/pkgs/morphir-ir/ir.mbt", "fixture\n")
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "feat: change the IR"]))
  let pr_head = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.mkdir(root + "/scripts")
  @fs.write_file(root + "/scripts/ci-reuse.mbtx", fake_reuse_script)
  let failures : Array[String] = []
  let log = "ci-changes: reuse: "
  let receipt = select(["pkgs/morphir-ir/ir.mbt"])
  let trusted = fixture_verdict(receipt, base=Some(receipt_base))
  let queue_ref = "refs/heads/gh-readonly-queue/main/pr-194-\{main_head}"
  let queue_env = {
    "EVENT": "merge_group",
    "QUEUE_REF": queue_ref,
    "QUEUE_BASE": main_head,
    "QUEUE_HEAD": pr_head,
  }
  let queue_today = changed(main_head, pr_head, cwd=root) |> select |> render
  let queue_args = "queue --ref \{queue_ref} --base \{main_head} --head \{pr_head} --json"
  let push_env = {
    "EVENT": "push",
    "PUSH_BASE": main_head,
    "GITHUB_SHA": pr_head,
  }
  let push_selection = select(
    changed(main_head, pr_head, merge_base=false, cwd=root),
  )
  push_selection.set("site", false)
  let push_today = render(push_selection)
  let push_args = "push --sha \{pr_head} --before \{main_head} --json"
  let unchanged = (
    run : (Int32, String, String, String, String),
    today : String,
    args : String,
  ) => {
    run.0 == 0 &&
    run.1 == today &&
    run.3 == "existing=true\n" + today &&
    run.4 == args
  }
  let only = (keys : Array[String]) => {
    let selection = nothing_selected()
    for key in keys {
      selection.set(key, true)
    }
    render(selection)
  }
  // event_queue_enforced: the receipt proved the IR change, and only the
  // docs that landed since its base select checks again.
  let run = run_event(script, root, queue_env, trusted)
  if !(unchanged(run, only(["site", "typescript"]), queue_args) &&
    only(["site", "typescript"]) != queue_today &&
    run.2.contains(
      "\{log}trusted: PR #194 head 4046644 run 39549808921 attempt 2 (tested 7c1e5a0, tree 9ab3c4d)\n",
    ) &&
    run.2.contains(
      "\{log}landed since receipt base \{receipt_base.view(end_offset=7)}: \{landed}\n",
    ) &&
    run.2.contains("\{log}re-run: site,typescript\n") &&
    run.2.contains(
      "\{log}trusted after re-run attempt: Elm and Scheme end to end\n",
    ) &&
    run.2.contains(
      "\{log}enforced; selects full=false checks=[\"site\",\"typescript\"]\n",
    ) &&
    run.2.contains("\{log}ci-reuse: fixture note\n")) {
    failures.push(run_failure("event_queue_enforced", run))
  }
  // event_queue_enforced_nothing_landed: the receipt's base is the queue
  // base, so the receipt proves everything and every key is false.
  let run = run_event(
    script,
    root,
    queue_env,
    fixture_verdict(receipt, base=Some(main_head)),
  )
  if !(unchanged(run, only([]), queue_args) &&
    run.2.contains("\{log}enforced; selects full=false checks=[]\n")) {
    failures.push(run_failure("event_queue_enforced_nothing_landed", run))
  }
  // A missing lane stays unproven, and an unreadable list proves nothing.
  for
    case in [
      ("[\"compiler\",\"frontend\"]", ["conformance"]),
      ("[]", ["compiler", "frontend", "conformance"]),
      ("not json", ["compiler", "frontend", "conformance"]),
      ("{}", ["compiler", "frontend", "conformance"]),
      ("[\"compiler\",1]", ["compiler", "frontend", "conformance"]),
      ("[\"provider\"]", ["compiler", "frontend", "conformance"]),
    ] {
    let (lanes, expected) = case
    let run = run_event(
      script,
      root,
      queue_env,
      fixture_verdict(receipt, base=Some(main_head), lanes=Some(lanes)),
    )
    if !unchanged(run, only(expected), queue_args) {
      failures.push(run_failure("event_queue_unproven_lanes \{lanes}", run))
    }
  }
  // event_queue_exact_not_skipped: only a push skips on an exact verdict. A
  // queue run treats it as any trusted verdict, and without a PR base it
  // selects as today.
  for
    case in [
      (Some(receipt_base), only(["site", "typescript"])),
      (None, queue_today),
    ] {
    let (base, expected) = case
    let run = run_event(
      script,
      root,
      queue_env,
      fixture_verdict(receipt, base~, exact=true),
    )
    if !(unchanged(run, expected, queue_args) &&
      !run.2.contains("\{log}exact push") &&
      !run.2.contains("\{log}trusted (exact)")) {
      failures.push(run_failure("event_queue_exact_not_skipped", run))
    }
  }
  // event_push_exact_skips
  let skip = render(nothing_selected())
  let run = run_event(
    script,
    root,
    push_env,
    fixture_verdict(receipt, base=None, exact=true),
  )
  if !(unchanged(run, skip, push_args) &&
    skip.contains(
      "\nrequired=[\"changes\",\"lint\",\"format-check\",\"validate-config\"]\n",
    ) &&
    !skip.contains("=true\n") &&
    run.2.contains("\{log}exact push, enforced;")) {
    failures.push(run_failure("event_push_exact_skips", run))
  }
  // event_push_bypass_enforced: an admin-bypass push reuses its PR's
  // receipt the same way; the site workflow owns main deployment.
  let run = run_event(script, root, push_env, trusted)
  if !(unchanged(run, only(["typescript"]), push_args) &&
    push_today != only(["typescript"]) &&
    run.2.contains(
      "\{log}enforced; selects full=false checks=[\"typescript\"]\n",
    )) {
    failures.push(run_failure("event_push_bypass_enforced", run))
  }
  // reuse_child_failure_own: anything unproven selects as today.
  for
    case in [
      ("crash\n", "\{log}ci-reuse exited "),
      ("not json\n", "\{log}ci-reuse output: "),
      (
        "{\"trusted\":false,\"exact\":false,\"reason\":\"no receipt artifact for run 1\"}\n",
        "\{log}untrusted: no receipt artifact for run 1; selects as today\n",
      ),
      (
        fixture_verdict(receipt, base=Some("ab".repeat(20))),
        "\{log}landed classification failed: ",
      ),
      (fixture_verdict(receipt, base=None), "\{log}receipt has no PR base"),
    ] {
    let (verdict, phrase) = case
    let run = run_event(script, root, queue_env, verdict)
    if !(unchanged(run, queue_today, queue_args) &&
      run.2.contains(phrase) &&
      run.2.contains("selects as today")) {
      failures.push(run_failure("reuse_child_failure_own \{phrase}", run))
    }
  }
  failures.append(verdict_test(pr_head))
  failures.append(reuse_timeout_test())
  let run = run_event(
    script,
    root,
    { "EVENT": "pull_request", "PR_BASE": main_head, "PR_HEAD": pr_head },
    trusted,
  )
  if !(run.0 == 0 && run.4 == "" && !run.2.contains(log)) {
    failures.push(run_failure("reuse_child_only_queue_and_push", run))
  }
  // cli_json_selection
  let destination = root + "/output"
  @fs.write_file(destination, "")
  @fs.write_file(root + "/reuse-args", "")
  let (status, out, err) = @process.collect_output(
    "moonx",
    [script, receipt_base, pr_head, "--json"],
    cwd=root,
    extra_env={ "GITHUB_OUTPUT": destination },
  )
  let selection = changed(receipt_base, pr_head, cwd=root) |> select
  let pinned =
    #|{"code":false,"site":false,"full":false,"supervision":false,"embedding":false,"typescript":false,"elm-scheme":false,"compiler":false,"frontend":false,"conformance":false,"provider":false,"lifecycle":false,"telemetry":false,"workbench":false,"acceptance-lanes":[],"required":["changes","lint","format-check","validate-config"]}
  if !(status == 0 &&
    out.text() == selection_json(selection).stringify() + "\n" &&
    out.text().contains("\"code\":true,") &&
    out
    .text()
    .contains(
      "\"acceptance-lanes\":[\"compiler\",\"frontend\",\"conformance\"],",
    ) &&
    @fs.read_file(destination).text() == render(selection) &&
    @fs.read_file(root + "/reuse-args").text() == "" &&
    selection_json(nothing_selected()).stringify() == pinned) {
    failures.push(
      "cli_json_selection: exit \{status}\nstdout:\n\{out.text()}\nstderr:\n\{err.text()}",
    )
  }
  failures.append(cli_argparse_forms())
  failures.append(push_verdict_order_test(script))
  guard failures.is_empty() else { fail(failures.join("\n---\n")) }
  test_note(
    "ci-changes: enforced queue and bypass reuse, exact push skip, child failures and CLI pass",
  )
}

///|
/// Reading the child's result: a nonzero exit or unreadable output is an
/// error with the reason; a trusted verdict keeps the receipt's PR base and
/// its Bool selection keys only.
fn verdict_test(base : String) -> Array[String] {
  let failures = []
  let receipt = select(["pkgs/morphir-ir/ir.mbt"])
  let trusted = "compiling\n" + fixture_verdict(receipt, base=Some(base))
  let checks : Array[(String, Bool)] = [
    (
      "exit",
      Verdict::from_child(2, "", "gh: not found\n") is Err(reason) &&
      reason == "ci-reuse exited 2: gh: not found",
    ),
    (
      "unreadable",
      Verdict::from_child(0, "not json", "") is Err(reason) &&
      reason.has_prefix("ci-reuse output: "),
    ),
    (
      "no receipt",
      Verdict::from_child(
        0, "{\"trusted\":true,\"exact\":false,\"reason\":\"r\"}", "",
      )
      is Err(_),
    ),
    (
      "untrusted",
      Verdict::from_child(
        0, "{\"trusted\":false,\"exact\":false,\"reason\":\"no receipt\"}", "",
      )
      is Ok(Untrusted(reason="no receipt")),
    ),
    (
      "trusted",
      Verdict::from_child(0, trusted, "")
      is Ok(Trusted(receipt=r, exact=false, rerun_jobs=jobs, ..)) &&
      r.base == Some(Sha(base)) &&
      r.selection == receipt &&
      r.run == RunId("39549808921") &&
      r.tested == TestedCommit(Sha("7c1e5a0b9d8c7f6e5d4c3b2a1908f7e6d5c4b3a2")) &&
      r.tree == TreeSha(Sha("9ab3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5")) &&
      r.attempt == "2" &&
      jobs == ["Elm and Scheme end to end"],
    ),
  ]
  for check in checks {
    if !check.1 {
      failures.push("reuse_child_failure_shadow verdict: \{check.0}")
    }
  }
  for field in ["runId", "testedCommit", "testedTree"] {
    let missing = trusted.replace_all(old="\"\{field}\"", new="\"missing\"")
    if Verdict::from_child(0, missing, "") is Ok(_) {
      failures.push("trusted verdict accepted missing \{field}")
    }
  }
  for text in ["", "0", "000", "-1", "1.5", " 42", "４２", "unknown"] {
    let invalid = trusted.replace_all(old="39549808921", new=text)
    if Verdict::from_child(0, invalid, "") is Ok(_) {
      failures.push("trusted verdict accepted invalid run ID \{text}")
    }
  }
  for
    field in [
      "7c1e5a0b9d8c7f6e5d4c3b2a1908f7e6d5c4b3a2", "9ab3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5",
    ] {
    for text in ["", "unknown", "a".repeat(39), "0".repeat(40), "A".repeat(40)] {
      let invalid = trusted.replace_all(old=field, new=text)
      if Verdict::from_child(0, invalid, "") is Ok(_) {
        failures.push("trusted verdict accepted invalid Git identity \{text}")
      }
    }
    let sha256 = trusted.replace_all(old=field, new="a".repeat(64))
    if Verdict::from_child(0, sha256, "") is Err(_) {
      failures.push("trusted verdict refused a full SHA-256 identity")
    }
  }
  let large_run = trusted.replace_all(old="39549808921", new="9".repeat(40))
  if Verdict::from_child(0, large_run, "") is Err(_) {
    failures.push("trusted verdict narrowed the run ID to a machine integer")
  }
  failures
}

///|
/// Exact push reuse avoids the mise child, while fallback selection and legacy
/// automation validation still execute their original obligations.
async fn push_verdict_order_test(script : String) -> Array[String] {
  let root = @fs.tmpdir(prefix="morphir-ci-push-order-")
  defer @fs.rmdir(root, recursive=true)
  ignore(fixture_git(root, ["init", "-q"]))
  @fs.mkdir(root + "/.config/mise", recursive=true)
  @fs.write_file(root + "/" + mise_config_path, fixture_config)
  ignore(fixture_git(root, ["add", "."]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture config base"]))
  let base = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.write_file(
    root + "/" + mise_config_path,
    fixture_config + "\n# changed\n",
  )
  ignore(fixture_git(root, ["commit", "-qam", "fixture config change"]))
  let head = fixture_git(root, ["rev-parse", "HEAD"])
  @fs.mkdir(root + "/scripts")
  @fs.write_file(root + "/scripts/ci-reuse.mbtx", fake_reuse_script)
  @fs.write_file(
    root + "/scripts/ci-mise-impact.mbtx",
    (
      #|import {
      #|  "moonbitlang/async@0.22.7",
      #|  "moonbitlang/async@0.22.7/fs",
      #|}
      #|async fn main {
      #|  @fs.write_file("mise-invoked", "called\n")
      #|  println("unreadable fixture impact")
      #|}
    ),
  )
  let env = { "EVENT": "push", "PUSH_BASE": base, "GITHUB_SHA": head }
  let receipt = select([])
  let failures = []
  let run = run_event(
    script,
    root,
    env,
    fixture_verdict(receipt, base=None, exact=true),
  )
  if run.0 != 0 ||
    run.1 != render(nothing_selected()) ||
    @fs.exists(root + "/mise-invoked") {
    failures.push(run_failure("exact push must avoid own mise selection", run))
  }
  for
    verdict in [
      "{\"trusted\":false,\"reason\":\"fixture untrusted\"}",
      fixture_verdict(receipt, base=Some(base)),
    ] {
    let run = run_event(script, root, env, verdict)
    if run.0 != 0 || !@fs.exists(root + "/mise-invoked") {
      failures.push(run_failure("non-exact push must build own selection", run))
    }
    if @fs.exists(root + "/mise-invoked") {
      @fs.remove(root + "/mise-invoked")
    }
  }
  @fs.write_file(root + "/scripts/forbidden.sh", "fixture\n")
  ignore(fixture_git(root, ["add", "scripts/forbidden.sh"]))
  ignore(fixture_git(root, ["commit", "-qm", "fixture legacy addition"]))
  let head = fixture_git(root, ["rev-parse", "HEAD"])
  env.set("GITHUB_SHA", head)
  let run = run_event(
    script,
    root,
    env,
    fixture_verdict(receipt, base=None, exact=true),
  )
  if run.0 == 0 || run.4 != "" {
    failures.push(run_failure("exact push must retain legacy refusal", run))
  }
  failures
}

///|
/// A stand-in `ci-reuse.mbtx` that sleeps is stopped after the timeout, and
/// there is no verdict.
async fn reuse_timeout_test() -> Array[String] {
  let root = @fs.tmpdir(prefix="morphir-ci-reuse-timeout-")
  defer @fs.rmdir(root, recursive=true)
  @fs.mkdir(root + "/scripts")
  @fs.write_file(
    root + "/scripts/ci-reuse.mbtx",
    (
      #|import {
      #|  "moonbitlang/async@0.22.7",
      #|}
      #|
      #|///|
      #|async fn main {
      #|  @async.sleep(60000)
      #|}
    ),
  )
  let logs : Array[String] = []
  let verdict = reuse_verdict(["push"], cwd=root, timeout=1, log=entry => {
    logs.push(entry)
  })
  if verdict is None &&
    logs == ["ci-reuse timed out after 1 s; selects as today"] {
    []
  } else {
    ["reuse_child_failure_shadow: a child that times out gave a verdict"]
  }
}

///|
/// The command line forms and their refusals.
fn cli_argparse_forms() -> Array[String] {
  let failures = []
  let command = changes_command()
  let base = "a".repeat(40)
  let head = "b".repeat(40)
  let cases : Array[(Array[String], Mode, Bool)] = [
    (["--self-test"], SelfTest, false),
    (["--self-test", "--json"], SelfTest, true),
    (["--event"], Event, false),
    (["--event", "--json"], Event, true),
    ([base, head], Range(base, head), false),
    ([base, head, "--json"], Range(base, head), true),
    (["--json", base, head], Range(base, head), true),
  ]
  for case in cases {
    let (argv, mode, json) = case
    let parsed = try {
      let got = invocation(command.parse(argv~))
      got.mode == mode && got.json == json
    } catch {
      _ => false
    }
    if !parsed {
      failures.push("cli_argparse_forms: wrong parse of \{argv.join(" ")}")
    }
  }
  for
    argv in [
      [],
      ["--json"],
      ["--event", base, head],
      ["--self-test", "--event"],
      [base],
      [base, head, "c"],
      ["--bogus"],
    ] {
    let refused = try {
      ignore(invocation(command.parse(argv~)))
      false
    } catch {
      _ => true
    }
    if !refused {
      failures.push("cli_argparse_forms: accepted \{argv.join(" ")}")
    }
  }
  failures
}

///|
/// Output selection belongs to the command boundary, never to data operands.
priv struct OutputMode {
  mut json : Bool
}

///|
let output_mode : OutputMode = { json: false, }

///|
fn command_result(result : Json) -> Json {
  {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "ci.changes",
    "state": "succeeded",
    "exitCode": 0,
    "result": result,
    "diagnostics": [],
  }
}

///|
fn command_error(error : Error, code~ : String = "command_failed") -> Json {
  {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "ci.changes",
    "state": "failed",
    "exitCode": 1,
    "error": { "code": code, "message": error.to_string() },
    "diagnostics": [],
  }
}

///|
fn test_note(message : String) -> Unit {
  if output_mode.json {
    eprintln(message)
  } else {
    println(message)
  }
}

///|
/// Reserve one explicit prefix and unwrap it once. A literal --json is still
/// data in the legacy grammar, or after the reserved prefix's delimiter.
fn presentation_arguments(argv : Array[String]) -> Array[String] {
  match argv {
    ["--json", "--", .. raw] => {
      output_mode.json = true
      return raw.to_owned()
    }
    _ => ()
  }
  if !argv.is_empty() {
    try
      @argparse.Command(
        "json-prefix",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("json", required=true)],
      ).parse(argv=argv[:1], env=Map([]))
    catch {
      _ => ()
    } noraise {
      _ => output_mode.json = true
    }
  }
  if presentation_probe(argv) is Some(matches) {
    output_mode.json = output_mode.json ||
      matches.flags.get("json").unwrap_or(false)
    if matches.subcommand is Some((_, child)) {
      output_mode.json = output_mode.json ||
        child.flags.get("json").unwrap_or(false)
    }
  }
  argv
}

///|
async fn main {
  try {
    let argv = presentation_arguments(command_arguments())
    execute(argv)
  } catch {
    error => {
      if !output_mode.json {
        raise error
      }
      @stdio.stdout.write(command_error(error).stringify() + "\n")
      @sys.exit(1)
    }
  }
}

///|
/// Presentation recognition uses the full declared vocabulary, with requirements
/// relaxed so the real parser can report syntax errors inside the JSON boundary.
/// The parsed data is never forwarded or used to execute the command.
fn presentation_probe(argv : Array[String]) -> @argparse.Matches? {
  Some(
    @argparse.Command(
      "ci.changes",
      disable_help_flag=true,
      disable_help_subcommand=true,
      flags=[
        @argparse.FlagArg("json"),
        @argparse.FlagArg("help", short='h'),
        @argparse.FlagArg("self-test"),
        @argparse.FlagArg("event"),
      ],
      options=[],
      positionals=[
        @argparse.PositionArg(
          "arguments",
          num_args=@argparse.ValueRange(lower=0),
          allow_hyphen_values=true,
        ),
      ],
    ).parse(argv~, env=Map([])),
  ) catch {
    _ => presentation_controls(argv)
  }
}

///|
fn presentation_self_test() -> Unit raise {
  let saved = output_mode.json
  defer {
    output_mode.json = saved
  }

  for literal in ["", "λ 雪", "--", "--json", "--help", "--self-test"] {
    let raw = [literal, "--", "--json", ""]
    output_mode.json = false
    assert_eq(presentation_arguments(["--json", "--", ..raw]), raw)
    assert_true(output_mode.json)
  }
  output_mode.json = false
  assert_eq(presentation_arguments(["--json", "--", "--json", "--", "value"]), [
    "--json", "--", "value",
  ])

  output_mode.json = false
  let raw = ["--", "--json", "HEAD"]
  assert_eq(presentation_arguments(raw), raw)
  assert_true(!output_mode.json)
}

///|
#cfg(target="js")
fn command_arguments() -> Array[String] {
  match @env.args() {
    [_, _, .. rest] => rest.to_owned()
    _ => []
  }
}

///|
#cfg(not(target="js"))
fn command_arguments() -> Array[String] {
  match @env.args() {
    [_, .. rest] => rest.to_owned()
    _ => []
  }
}

///|
/// A missing option value can stop the full grammar before it reports JSON.
/// This library grammar selects presentation only; the complete command grammar
/// still diagnoses every operand and option. Its values never reach execution.
fn presentation_controls(argv : Array[String]) -> @argparse.Matches? {
  Some(
    @argparse.Command(
      "presentation",
      disable_help_flag=true,
      disable_help_subcommand=true,
      flags=[@argparse.FlagArg("json"), @argparse.FlagArg("help", short='h')],
      positionals=[
        @argparse.PositionArg(
          "data",
          num_args=@argparse.ValueRange(lower=0),
          allow_hyphen_values=true,
        ),
      ],
    ).parse(argv~, env=Map([])),
  ) catch {
    _ => None
  }
}
