----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}
----

// Keep one GitHub issue per macOS qualification breach. The nightly report job
// passes the result of the qualification call: a failure opens the issue or
// comments on the open one, and a pass closes the open one. The exit status is
// non-zero when the arguments are invalid or a `gh` call fails.
//
// With `--run-id N`, a breach body lists the jobs of run N that finished
// without passing (`gh run view N --json jobs`, which needs `actions: read`).
// A failed read does not stop the report: the body says that the list is
// missing.
//
// `--dry-run` calls no `gh` command. It takes the open issue from
// `--open-issue N` (default: none) and prints the action and the text it
// would send.

///|
let breach_label : String = "macos-breach"

///|
let breach_title : String = "macOS qualification breach"

///|
let breach_label_about : String = "Nightly macOS qualification failed"

///|
let gh_timeout_ms : Int32 = 30000

///|
/// The result of the `qualification` call, as GitHub reports it in
/// `needs.<job>.result`.
enum CallResult {
  Success
  Failure
  Cancelled
  Skipped
} derive(Eq, Debug)

///|
fn CallResult::parse(text : String) -> CallResult raise {
  match text {
    "success" => Success
    "failure" => Failure
    "cancelled" => Cancelled
    "skipped" => Skipped
    _ =>
      fail(
        "--result: expected success, failure, cancelled or skipped, got \{text}",
      )
  }
}

///|
fn CallResult::to_string(self : CallResult) -> String {
  match self {
    Success => "success"
    Failure => "failure"
    Cancelled => "cancelled"
    Skipped => "skipped"
  }
}

///|
/// A call that did not succeed is a breach. A skipped call counts: it means
/// that something upstream of the call broke, and a failure must not stay silent.
fn CallResult::is_breach(self : CallResult) -> Bool {
  !(self is Success)
}

///|
/// A full commit SHA: 40 or 64 lowercase hex digits.
struct Sha(String) derive(Eq)

///|
fn Sha::parse(text : String) -> Sha raise {
  guard (text.length() == 40 || text.length() == 64) &&
    text.iter().all(c => (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) else {
    fail("--sha: expected 40 or 64 lowercase hex digits, got \{text}")
  }
  Sha(text)
}

///|
struct RunUrl(String) derive(Eq)

///|
fn RunUrl::parse(text : String) -> RunUrl raise {
  guard text.has_prefix("https://") || text.has_prefix("http://") else {
    fail("--run-url: expected an http(s) URL, got \{text}")
  }
  RunUrl(text)
}

///|
/// The macOS mode of the run. It is empty when the evidence job failed before
/// it could choose, which is itself reported as a breach. A word that is no mode
/// is kept as `Other`: the report must still go out, and it names the word.
enum Mode {
  Run
  Reuse
  Unknown
  Other(String)
} derive(Eq, Debug)

///|
fn Mode::parse(text : String) -> Mode {
  match text {
    "run" => Run
    "reuse" => Reuse
    "" => Unknown
    other => Other(other)
  }
}

///|
fn Mode::label(self : Mode) -> String {
  match self {
    Run => "run"
    Reuse => "reuse"
    Unknown => "unknown"
    Other(text) => text
  }
}

///|
struct Report {
  result : CallResult
  run_url : RunUrl
  sha : Sha
  mode : Mode
}

///|
enum BreachAction {
  Open
  Comment(Int32)
  Close(Int32)
  Nothing
} derive(Eq, Debug)

///|
fn BreachAction::name(self : BreachAction) -> String {
  match self {
    Open => "open"
    Comment(_) => "comment"
    Close(_) => "close"
    Nothing => "nothing"
  }
}

///|
fn BreachAction::issue(self : BreachAction) -> Int32? {
  match self {
    Comment(number) | Close(number) => Some(number)
    Open | Nothing => None
  }
}

///|
/// One open issue at a time: a breach opens it only when none is open, later
/// breaches comment on it, and a pass closes it.
fn breach_action(result : CallResult, open_issue : Int32?) -> BreachAction {
  match (result.is_breach(), open_issue) {
    (true, None) => Open
    (true, Some(number)) => Comment(number)
    (false, Some(number)) => Close(number)
    (false, None) => Nothing
  }
}

///|
/// A workflow run id, as in `github.run_id`.
struct RunId(Int64) derive(Eq, Debug)

///|
fn RunId::parse(text : String) -> RunId raise {
  let id = @string.parse_int64(text) catch {
    _ => fail("--run-id: expected a run id, got \{text}")
  }
  guard id >= 1L else {
    fail("--run-id: expected a positive run id, got \{text}")
  }
  RunId(id)
}

///|
/// A job of the run that finished without passing.
struct FailedJob {
  name : String
  conclusion : String
  url : String
} derive(Eq, Debug)

///|
/// The jobs of `gh run view <id> --json jobs` that finished without passing,
/// in run order. A job that passed, was skipped or is still running (such as
/// the report job itself) is left out. Skipped jobs are expected: the macOS
/// jobs skip in reuse mode and `record` skips unless the macOS lanes ran.
fn failed_jobs(json : Json) -> Array[FailedJob] raise {
  guard json is { "jobs": Array(jobs), .. } else {
    fail("gh run view: expected an object with a jobs array")
  }
  let failed = []
  for job in jobs {
    guard job
      is {
        "name": String(name),
        "status": String(status),
        "conclusion": conclusion,
        ..
      } else {
      fail("gh run view: a job without a name or status")
    }
    let conclusion = match conclusion {
      String(text) => text
      _ => ""
    }
    guard status == "completed" &&
      !conclusion.is_empty() &&
      !(conclusion is ("success" | "skipped" | "neutral")) else {
      continue
    }
    let url = match job {
      { "url": String(url), .. } => url
      _ => ""
    }
    failed.push({ name, conclusion, url, })
  }
  failed
}

///|
/// What to do about the breach label before an issue opens.
enum LabelAction {
  CreateLabel
  KeepLabel
} derive(Eq, Debug)

///|
/// Create the label only when it is missing. Creating it again with `--force`
/// would reset the colour and description that a maintainer set.
fn label_action(existing : Bool) -> LabelAction {
  if existing {
    KeepLabel
  } else {
    CreateLabel
  }
}

///|
/// Whether the JSON that `gh label list --json name` prints has a label of
/// exactly this name. The `--search` filter is a substring match, so the name is
/// compared again here.
fn label_listed(json : Json, name : String) -> Bool raise {
  guard json is Array(items) else {
    fail("gh label list: expected a JSON array")
  }
  let mut found = false
  for item in items {
    guard item is { "name": String(label), .. } else {
      fail("gh label list: item without a name")
    }
    if label == name {
      found = true
    }
  }
  found
}

///|
/// The failed jobs that a breach body lists.
enum JobList {
  /// No run id was given, so the body has no job list.
  NotAsked
  Listed(Array[FailedJob])
  /// The read failed; the body says why instead of hiding the gap.
  Unread(String)
}

///|
fn JobList::lines(self : JobList) -> Array[String] {
  match self {
    NotAsked => []
    Listed([]) =>
      [
        "- Failed jobs: none finished without passing; see the run for the cause.",
      ]
    Listed(jobs) =>
      [
        "- Failed jobs:",
        ..jobs.map(job => {
          let link = if job.url.is_empty() { "" } else { ": \{job.url}" }
          "  - \{job.name} (\{job.conclusion})\{link}"
        }),
      ]
    Unread(reason) => ["- Failed jobs: not read (\{reason}); see the run."]
  }
}

///|
fn JobList::to_json(self : JobList) -> Json {
  match self {
    Listed(jobs) => Json::array(jobs.map(job => Json::string(job.name)))
    NotAsked | Unread(_) => Json::null()
  }
}

///|
/// The text of the issue, and of each later comment about a breach.
fn breach_body(report : Report, jobs : JobList) -> String {
  [
    "\{breach_title}: the nightly macOS qualification did not pass (\{report.result.to_string()}).",
    "",
    "- Run: \{report.run_url.0}",
    "- Commit: \{report.sha.0}",
    "- macOS mode: \{report.mode.label()}",
    ..jobs.lines(),
    "",
    "This issue is closed by the next nightly run that passes.",
  ].join("\n")
}

///|
/// The comment that closes the issue after a passing run.
fn close_body(report : Report) -> String {
  [
    "The nightly macOS qualification passed again, so this breach is over.",
    "",
    "- Run: \{report.run_url.0}",
    "- Commit: \{report.sha.0}",
    "- macOS mode: \{report.mode.label()}",
  ].join("\n")
}

///|
/// The issue number of an open breach issue, from the JSON that
/// `gh issue list --json number` prints. With several, the lowest number wins.
fn open_issue_from(json : Json) -> Int32? raise {
  guard json is Array(items) else {
    fail("gh issue list: expected a JSON array")
  }
  let mut lowest : Int32? = None
  for item in items {
    guard item is { "number": Number(number, ..), .. } else {
      fail("gh issue list: item without a number")
    }
    let number = number.to_int()
    if lowest is Some(known) && known <= number {
      continue
    }
    lowest = Some(number)
  }
  lowest
}

///|
async fn gh(args : Array[String]) -> String {
  let label = (["gh"] + args.iter().take(2).collect()).join(" ")
  let run = @async.with_timeout_opt(gh_timeout_ms, () => {
    let (status, out, err) = @process.collect_output("gh", args)
    (status, out.text(), err.text())
  }) catch {
    error => fail("\{label}: \{error}")
  }
  guard run is Some((status, out, err)) else {
    fail("\{label}: timeout after \{gh_timeout_ms} ms")
  }
  guard status == 0 else {
    fail("\{label} exited \{status}: \{err.trim().to_owned()}")
  }
  out
}

///|
async fn find_open_issue() -> Int32? {
  let out = gh([
    "issue", "list", "--label", breach_label, "--state", "open", "--json", "number",
    "--limit", "100",
  ])
  let json = @json.parse(out) catch {
    _ => fail("gh issue list returned no JSON")
  }
  open_issue_from(json)
}

///|
async fn breach_label_exists() -> Bool {
  let out = gh([
    "label", "list", "--search", breach_label, "--json", "name", "--limit", "100",
  ])
  let json = @json.parse(out) catch {
    _ => fail("gh label list returned no JSON")
  }
  label_listed(json, breach_label)
}

///|
/// The failed jobs of the run. A failed read becomes `Unread`: the breach is
/// still reported, and the body says that the list is missing.
async fn read_failed_jobs(run_id : RunId?) -> JobList {
  guard run_id is Some(RunId(id)) else { return NotAsked }
  try {
    let out = gh(["run", "view", id.to_string(), "--json", "jobs"])
    Listed(failed_jobs(@json.parse(out)))
  } catch {
    // `fail` puts the source location first; the reader needs only the cause.
    Failure(message) =>
      Unread(
        match message.find("FAILED: ") {
          Some(at) => message.view(start_offset=at + 8).to_owned()
          None => message
        },
      )
    error => Unread("\{error}")
  }
}

///|
async fn apply(action : BreachAction, report : Report, jobs : JobList) -> Unit {
  match action {
    Open => {
      // The label may not exist yet. Create it only then: an existing label
      // keeps the colour and description that a maintainer gave it.
      if label_action(breach_label_exists()) is CreateLabel {
        ignore(
          gh([
            "label", "create", breach_label, "--description", breach_label_about,
          ]),
        )
      }
      ignore(
        gh([
          "issue",
          "create",
          "--title",
          breach_title,
          "--label",
          breach_label,
          "--body",
          breach_body(report, jobs),
        ]),
      )
    }
    Comment(number) =>
      ignore(
        gh([
          "issue",
          "comment",
          number.to_string(),
          "--body",
          breach_body(report, jobs),
        ]),
      )
    Close(number) =>
      ignore(
        gh([
          "issue",
          "close",
          number.to_string(),
          "--comment",
          close_body(report),
        ]),
      )
    Nothing => ()
  }
}

///|
struct Outcome {
  action : BreachAction
  report : Report
  jobs : JobList
  dry_run : Bool
}

///|
fn Outcome::to_json(self : Outcome) -> Json {
  {
    "action": self.action.name(),
    "issue": match self.action.issue() {
      Some(number) => Json(number)
      None => Json::null()
    },
    "result": self.report.result.to_string(),
    "runUrl": self.report.run_url.0,
    "sha": self.report.sha.0,
    "mode": self.report.mode.label(),
    "failedJobs": self.jobs.to_json(),
    "dryRun": self.dry_run,
  }
}

///|
fn Outcome::summary(self : Outcome) -> String {
  let target = match self.action.issue() {
    Some(number) => " #\{number}"
    None => ""
  }
  let prefix = if self.dry_run {
    "ci-breach (dry run): "
  } else {
    "ci-breach: "
  }
  "\{prefix}\{self.action.name()}\{target} (result \{self.report.result.to_string()})"
}

///|
priv enum Invocation {
  SelfTest
  Report(
    Report,
    open_issue~ : Int32?,
    run_id~ : RunId?,
    dry_run~ : Bool,
    json~ : Bool
  )
}

///|
fn breach_command() -> @argparse.Command {
  @argparse.Command(
    "ci-breach",
    about="Open, update or close the macOS qualification breach issue",
    flags=[
      @argparse.FlagArg("self-test", about="Run the built-in tests", conflicts_with=[
        "result", "run-url", "sha", "mode", "dry-run", "json", "open-issue", "run-id",
      ]),
      @argparse.FlagArg(
        "dry-run",
        about="Print the action and call no gh command",
      ),
      @argparse.FlagArg("json", about="Print the outcome as one JSON line"),
    ],
    options=[
      @argparse.OptionArg(
        "result",
        about="Result of the qualification call: success, failure, cancelled or skipped",
      ),
      @argparse.OptionArg("run-url", about="URL of this workflow run"),
      @argparse.OptionArg("sha", about="Commit that the run qualified"),
      @argparse.OptionArg("mode", about="macOS mode of the run (may be empty)"),
      @argparse.OptionArg(
        "run-id",
        about="Id of this workflow run; a breach body then lists its failed jobs",
      ),
      @argparse.OptionArg(
        "open-issue",
        about="With --dry-run: number of the open breach issue (default: none)",
        requires=["dry-run"],
      ),
    ],
  )
}

///|
fn value(matches : @argparse.Matches, name : String) -> String raise {
  match matches.values.get(name) {
    Some([text]) => text
    _ => fail("Missing --\{name}")
  }
}

///|
fn invocation(matches : @argparse.Matches) -> Invocation raise {
  let flag = (name : String) => matches.flags.get(name).unwrap_or(false)
  if flag("self-test") {
    return SelfTest
  }
  let report : Report = {
    result: CallResult::parse(value(matches, "result")),
    run_url: RunUrl::parse(value(matches, "run-url")),
    sha: Sha::parse(value(matches, "sha")),
    mode: Mode::parse(
      matches.values.get("mode").map(v => v.join("")).unwrap_or(""),
    ),
  }
  let open_issue = match matches.values.get("open-issue") {
    Some([text]) =>
      Some(
        @string.parse_int(text) catch {
          _ => fail("--open-issue: expected an issue number, got \{text}")
        },
      )
    _ => None
  }
  let run_id = match matches.values.get("run-id") {
    Some([text]) => Some(RunId::parse(text))
    _ => None
  }
  Report(
    report,
    open_issue~,
    run_id~,
    dry_run=flag("dry-run"),
    json=flag("json"),
  )
}

///|
fn self_test() -> Unit raise {
  let report : Report = {
    result: Failure,
    run_url: RunUrl("https://github.com/finos/morphir-moonbit/actions/runs/42"),
    sha: Sha("0123456789abcdef0123456789abcdef01234567"),
    mode: Run,
  }
  let cases : Array[(String, CallResult, Int32?, BreachAction)] = [
    ("breach_first_failure_opens", Failure, None, Open),
    ("breach_second_failure_comments", Failure, Some(12), Comment(12)),
    ("breach_cancelled_counts", Cancelled, None, Open),
    ("breach_skipped_counts", Skipped, None, Open),
    ("breach_rerun_pass_closes", Success, Some(12), Close(12)),
    ("breach_pass_without_issue", Success, None, Nothing),
  ]
  for case in cases {
    let (name, result, open_issue, expected) = case
    guard breach_action(result, open_issue) == expected else {
      fail("\{name}: wrong action")
    }
  }
  let body = breach_body(report, NotAsked)
  for
    part in [
      "https://github.com/finos/morphir-moonbit/actions/runs/42", "0123456789abcdef0123456789abcdef01234567",
      "run", "macOS qualification breach",
    ] {
    guard body.contains(part) else { fail("breach_body: missing \{part}") }
  }
  guard !body.contains("Failed jobs") else {
    fail("breach_body: a job list that was not asked for")
  }
  println("ci-breach: \{cases.length() + 1} breach cases pass")
  label_self_test(report)
  jobs_self_test(report)
  // lookup_lowest_open: no issue, one issue, and several (the lowest wins).
  guard open_issue_from([]) is None &&
    open_issue_from([{ "number": 7 }]) == Some(7) &&
    open_issue_from([{ "number": 9 }, { "number": 4 }, { "number": 6 }]) ==
    Some(4) else {
    fail("lookup_lowest_open: wrong issue number")
  }
  // outcome_json: the JSON line of one outcome.
  let outcome : Outcome = {
    action: Comment(12),
    report,
    jobs: Listed([{ name: "plan", conclusion: "failure", url: "", }]),
    dry_run: true,
  }
  guard outcome.to_json() ==
    {
      "action": "comment",
      "issue": 12,
      "result": "failure",
      "runUrl": "https://github.com/finos/morphir-moonbit/actions/runs/42",
      "sha": "0123456789abcdef0123456789abcdef01234567",
      "mode": "run",
      "failedJobs": ["plan"],
      "dryRun": true,
    } else {
    fail("outcome_json: wrong shape")
  }
  println("ci-breach: issue lookup and outcome JSON pass")
  cli_self_test()
}

///|
/// `gh run view <id> --json jobs` of a nightly run while the report job runs,
/// trimmed to the fields that matter and a few that do not.
let fixture_run_jobs : String =
  #|{"jobs":[
  #|{"name":"Choose the macOS mode","status":"completed","conclusion":"success","databaseId":1,"steps":[],
  #| "url":"https://github.com/finos/morphir-moonbit/actions/runs/42/job/1"},
  #|{"name":"Full qualification / Plan macOS qualification","status":"completed","conclusion":"success",
  #| "url":"https://github.com/finos/morphir-moonbit/actions/runs/42/job/2"},
  #|{"name":"Full qualification / Native lanes (macos-15) / Native acceptance (compiler)","status":"completed",
  #| "conclusion":"failure","url":"https://github.com/finos/morphir-moonbit/actions/runs/42/job/3"},
  #|{"name":"Full qualification / Process supervision (macos-15)","status":"completed","conclusion":"cancelled",
  #| "url":"https://github.com/finos/morphir-moonbit/actions/runs/42/job/4"},
  #|{"name":"Full qualification / Headless CLI (macos-15)","status":"completed","conclusion":"timed_out",
  #| "url":"https://github.com/finos/morphir-moonbit/actions/runs/42/job/5"},
  #|{"name":"Record the macOS evidence","status":"completed","conclusion":"skipped",
  #| "url":"https://github.com/finos/morphir-moonbit/actions/runs/42/job/6"},
  #|{"name":"Report the breach issue","status":"in_progress","conclusion":"",
  #| "url":"https://github.com/finos/morphir-moonbit/actions/runs/42/job/7"}]}

///|
fn jobs_self_test(report : Report) -> Unit raise {
  // failed_jobs_from_run: finished jobs that did not pass, in run order.
  let failed = failed_jobs(@json.parse(fixture_run_jobs))
  guard failed.map(job => job.name) ==
    [
      "Full qualification / Native lanes (macos-15) / Native acceptance (compiler)",
      "Full qualification / Process supervision (macos-15)", "Full qualification / Headless CLI (macos-15)",
    ] &&
    failed.map(job => job.conclusion) == ["failure", "cancelled", "timed_out"] else {
    fail("failed_jobs_from_run: wrong jobs")
  }
  // breach_body_lists_failed_jobs: each failed job with its result and link.
  let body = breach_body(report, Listed(failed))
  for
    part in [
      "Failed jobs:", "Full qualification / Native lanes (macos-15) / Native acceptance (compiler) (failure): https://github.com/finos/morphir-moonbit/actions/runs/42/job/3",
      "Full qualification / Process supervision (macos-15) (cancelled)", "Full qualification / Headless CLI (macos-15) (timed_out)",
    ] {
    guard body.contains(part) else {
      fail("breach_body_lists_failed_jobs: missing \{part}")
    }
  }
  for
    part in [
      "Choose the macOS mode", "Record the macOS evidence", "Report the breach issue",
    ] {
    guard !body.contains(part) else {
      fail("breach_body_lists_failed_jobs: lists \{part}")
    }
  }
  // breach_body_no_failed_jobs: a breach with no failed job says so, as when the
  // evidence job output is wrong or a job of the call was skipped.
  guard breach_body(report, Listed([])).contains(
    "Failed jobs: none finished without passing",
  ) else {
    fail("breach_body_no_failed_jobs: wrong text")
  }
  // breach_body_jobs_unread: a failed read is reported, not hidden.
  guard breach_body(report, Unread("gh run view exited 1")).contains(
    "Failed jobs: not read (gh run view exited 1)",
  ) else {
    fail("breach_body_jobs_unread: wrong text")
  }
  // failed_jobs_malformed: an answer in another form is an error.
  for
    text in [
      "{}", "{\"jobs\":{}}", "{\"jobs\":[{\"status\":\"completed\"}]}", "[]",
    ] {
    let refused = try {
      ignore(failed_jobs(@json.parse(text)))
      false
    } catch {
      _ => true
    }
    guard refused else { fail("failed_jobs_malformed: accepted \{text}") }
  }
  println("ci-breach: failed-job list cases pass")
}

///|
fn label_self_test(report : Report) -> Unit raise {
  // label_created_when_missing: a label that is not listed is created.
  guard label_action(false) == CreateLabel else {
    fail("label_created_when_missing: wrong action")
  }
  // label_kept_when_present: a listed label is left alone, so a custom colour
  // or description survives.
  guard label_action(true) == KeepLabel else {
    fail("label_kept_when_present: wrong action")
  }
  // label_listed: only an exact name counts, not a name that merely contains it.
  guard !label_listed(@json.parse("[]"), "macos-breach") &&
    label_listed(@json.parse("[{\"name\":\"macos-breach\"}]"), "macos-breach") &&
    !label_listed(
      @json.parse("[{\"name\":\"macos-breach-old\"},{\"name\":\"bug\"}]"),
      "macos-breach",
    ) else {
    fail("label_listed: wrong answer")
  }
  for text in ["{}", "[1]", "[{}]"] {
    let refused = try {
      ignore(label_listed(@json.parse(text), "macos-breach"))
      false
    } catch {
      _ => true
    }
    guard refused else { fail("label_listed: accepted \{text}") }
  }
  // run_url_names_attempt: the attempts form is a valid run URL, and the breach
  // and close texts show it, so a re-run links to its own attempt.
  let url = "https://github.com/finos/morphir-moonbit/actions/runs/42/attempts/2"
  let attempt : Report = { ..report, run_url: RunUrl::parse(url), }
  for text in [breach_body(attempt, NotAsked), close_body(attempt)] {
    guard text.contains("- Run: \{url}") else {
      fail("run_url_names_attempt: missing the attempt link")
    }
  }
  println("ci-breach: label and run link cases pass")
}

///|
fn cli_self_test() -> Unit raise {
  let command = breach_command()
  let base = [
    "--result", "failure", "--run-url", "https://example.com/run/1", "--sha", "0123456789abcdef0123456789abcdef01234567",
    "--mode", "run",
  ]
  let self_test = command.parse(argv=["--self-test"]) |> invocation
  guard self_test is SelfTest else { fail("cli_argparse_forms: --self-test") }
  let dry = command.parse(
      argv=base + ["--dry-run", "--json", "--open-issue", "12"],
    )
    |> invocation
  guard dry
    is Report(r, open_issue=Some(12), dry_run=true, json=true, run_id=None) &&
    r.result == Failure else {
    fail("cli_argparse_forms: full dry run")
  }
  let with_run = command.parse(argv=base + ["--run-id", "42"]) |> invocation
  guard with_run is Report(_, run_id=Some(RunId(42L)), dry_run=false, ..) else {
    fail("cli_argparse_forms: --run-id")
  }
  for
    argv in [
      base.map(a => if a == "failure" { "bogus" } else { a }),
      base + ["--open-issue", "12"],
      base + ["--dry-run", "--open-issue", "x"],
      base + ["--run-id", "x"],
      base + ["--run-id", "0"],
      base.map(a => if a.has_prefix("0123") { "XYZ" } else { a }),
      base.map(a => if a.has_prefix("https") { "ftp://x" } else { a }),
      ["--result", "success"],
      ["--self-test", "--dry-run"],
    ] {
    let refused = try {
      ignore(command.parse(argv~) |> invocation)
      false
    } catch {
      _ => true
    }
    guard refused else {
      fail("cli_argparse_forms: accepted \{argv.join(" ")}")
    }
  }
  println("ci-breach: argparse forms and refusals pass")
}

///|
async fn main {
  let invocation = breach_command().parse() |> invocation
  guard invocation is Report(report, open_issue~, run_id~, dry_run~, json~) else {
    self_test()
    return
  }
  let open_issue = if dry_run { open_issue } else { find_open_issue() }
  let action = breach_action(report.result, open_issue)
  // Only a breach body lists jobs, and a dry run calls no gh command.
  let jobs = if dry_run || !(action is (Open | Comment(_))) {
    NotAsked
  } else {
    read_failed_jobs(run_id)
  }
  let outcome : Outcome = { action, report, jobs, dry_run, }
  if !dry_run {
    apply(action, report, jobs)
  }
  println(if json { outcome.to_json().stringify() } else { outcome.summary() })
}
