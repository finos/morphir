----
import {
  "moonbitlang/core/json",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Portable build, test and repository housekeeping tasks.

///|
suberror TaskError {
  Failed(Int32)
  InvalidTask(String)
} derive(Debug)

///|
enum Invocation {
  SelfTest
  Task(String)
}

///|
fn invocation(argv : Array[String]) -> Invocation raise {
  // A complete, one-value grammar keeps this control exact, including repeats.
  let control = @argparse.Command(
    "repository-tasks",
    disable_help_flag=true,
    disable_help_subcommand=true,
    subcommand_required=true,
    subcommands=[
      @argparse.Command("control:--self-test", disable_help_flag=true),
    ],
  )
  let self_test = try {
    ignore(control.parse(argv=argv.map(token => "control:" + token)))
    true
  } catch {
    _ => false
  }
  if self_test {
    return SelfTest
  }
  let command = @argparse.Command(
    "repository-tasks",
    disable_help_flag=true,
    disable_help_subcommand=true,
    subcommands=[
      for
        task in [
          "build", "build:wasi", "build:browser", "build:js", "build:native", "test",
          "format", "lint:moonbit", "lint", "lint:yaml", "validate", "clean", "list-tasks",
        ] => {
        @argparse.Command(task[:], disable_help_flag=true, positionals=[
          @argparse.PositionArg(
            "ignored",
            num_args=@argparse.ValueRange(lower=0),
            hidden=true,
          ),
        ])
      }
    ],
  )
  // The first token has always been the command; every later token is data.
  // Insert the library delimiter at that fixed boundary without inspecting data.
  let normalized = if argv.is_empty() {
    []
  } else {
    [argv[0], "--", ..argv[1:]]
  }
  let parsed = command.parse(argv=normalized) catch {
    _ => raise InvalidTask(argv.get(0).unwrap_or("missing task"))
  }
  match parsed.subcommand {
    Some((task, _)) => Task(task)
    None => raise InvalidTask(argv.get(0).unwrap_or("missing task"))
  }
}

///|
fn commands(task : String) -> Array[(String, Array[String])] raise {
  match task {
    "build" =>
      ["build:wasi", "build:browser", "build:js", "build:native"].map(t => {
        ("mise", ["run", t])
      })
    "build:wasi" => [("moon", ["build", "--target", "wasm"])]
    "build:browser" => [("moon", ["build", "--target", "wasm-gc"])]
    "build:js" => [("moon", ["build", "--target", "js"])]
    "build:native" => [("moon", ["build", "--target", "native", "--release"])]
    "test" =>
      [
        ..["wasm", "wasm-gc", "js", "native"].map(t => {
          ("moon", ["test", "--target", t])
        }),
        ("mise", ["run", "test:cli"]),
        ("mise", ["run", "test:compiler"]),
      ]
    "format" => [("moon", ["fmt"])]
    "lint:moonbit" => [("moon", ["fmt", "--check"])]
    "lint" =>
      [
        ("mise", ["run", "lint:yaml"]),
        ("mise", ["run", "lint:moonbit"]),
        ("mise", ["run", "lint:engine-boundaries"]),
      ]
    "validate" =>
      [("mise", ["run", "lint:yaml"]), ("mise", ["run", "validate:packages"])]
    "list-tasks" => [("mise", ["tasks"])]
    _ => raise InvalidTask(task)
  }
}

///|
fn messages(task : String) -> (String, String) {
  match task {
    "build" => ("🔨 Building all packages...", "✅ All builds complete")
    "build:wasi" =>
      ("🔨 Building for WASI target...", "✅ WASI build complete")
    "build:browser" =>
      (
        "🔨 Building for browser (WASM-GC) target...", "✅ Browser build complete",
      )
    "test" => ("🧪 Running tests...", "✅ All tests passed")
    "format" =>
      (
        "🎨 Formatting Moonbit code...", "✅ Moonbit code formatting complete",
      )
    "lint" =>
      ("🔍 Running all linting tasks...", "✅ All linting tasks complete")
    "lint:moonbit" =>
      (
        "🔍 Checking Moonbit code formatting...", "✅ Moonbit code formatting check complete",
      )
    "validate" =>
      ("🔍 Running all validation checks...", "\n✅ All validations passed")
    "list-tasks" => ("📋 Available mise tasks:\n", "")
    _ => ("", "")
  }
}

///|
async fn run(program : String, args : Array[String]) -> Int32 {
  let status = if presentation.val is Json &&
    program == "mise" &&
    args == ["tasks"] {
    let (status, out, err) = @process.collect_output(
      program,
      args,
      stdin=@stdio.stdin,
    )
    listing.val = out.text()
    @stdio.stderr.write(out)
    @stdio.stderr.write(err)
    status
  } else {
    @process.run(
      program,
      args,
      stdin=@stdio.stdin,
      stdout=if presentation.val is Json {
        @stdio.stderr
      } else {
        @stdio.stdout
      },
      stderr=@stdio.stderr,
    )
  }
  child_steps.push({
    "program": program,
    "args": Json::array(args.map(Json::string)),
    "exitCode": status,
  })
  status
}

///|
async fn execute(
  task : String,
  invoke : async (String, Array[String]) -> Int32,
) -> Unit {
  let steps = commands(task)
  let (before, after) = messages(task)
  if before != "" {
    progress(before)
  }
  for (program, args) in steps {
    if task == "validate" {
      progress(
        if args == ["run", "lint:yaml"] {
          "\n=== Validating YAML files ==="
        } else {
          "\n=== Verifying package structure ==="
        },
      )
    }
    let code = invoke(program, args)
    if code != 0 {
      if task == "lint:moonbit" {
        progress("❌ Formatting issues found. Run 'moon fmt' to fix.")
      }
      raise Failed(if task == "lint:moonbit" || code < 0 { 1 } else { code })
    }
  }
  if after != "" {
    progress(after)
  }
}

///|
/// Match directory components, include hidden YAML, and do not follow links.
async fn yaml_files(root : String, paths : Array[String]) -> Unit {
  for name in @fs.readdir(root, include_hidden=true) {
    if ["node_modules", ".git", "target", "build", "_build"].contains(name) {
      continue
    }
    let path = root + "/" + name
    match @fs.kind(path, follow_symlink=false) {
      Directory => yaml_files(path, paths)
      Regular =>
        if name.has_suffix(".yaml") || name.has_suffix(".yml") {
          paths.push(path)
        }
      _ => ()
    }
  }
}

///|
async fn lint_yaml(
  root : String,
  invoke : async (String, Array[String]) -> Int32,
) -> Unit {
  progress("🔍 Linting YAML files...")
  let paths : Array[String] = []
  yaml_files(root, paths)
  yaml_paths.append(paths)
  paths.sort_by((a, b) => a.lexical_compare(b))
  // One argument per path preserves whitespace on Windows and Unix. Batches
  // bound command size while avoiding one process per YAML document.
  for start = 0; start < paths.length(); start = start + 40 {
    let end = if start + 40 < paths.length() {
      start + 40
    } else {
      paths.length()
    }
    let status = invoke("yamllint", paths[start:end].to_owned())
    if status != 0 {
      raise Failed(if status > 0 { status } else { 1 })
    }
  }
  progress("✅ YAML linting complete")
}

///|
async fn clean(
  root : String,
  invoke : async (String, Array[String]) -> Int32,
) -> Int32 {
  let path = root + "/_build"
  // moon clean follows a root build-directory link. Unlink it before handing
  // control to the compiler, so an external target cannot be cleaned.
  let before = @fs.kind(path, follow_symlink=false) catch { _ => @fs.Unknown }
  if before == @fs.SymLink {
    @fs.remove(path)
  }
  // The legacy Unix task intentionally tolerates moon clean failing.
  ignore(invoke("moon", ["clean"])) catch {
    _ => ()
  }
  let kind = @fs.kind(path, follow_symlink=false) catch { _ => @fs.Unknown }
  match kind {
    Directory => @fs.rmdir(path, recursive=true)
    Unknown => ()
    _ => @fs.remove(path)
  }
  if before != @fs.Unknown {
    removed_paths.push(path)
  }
  0
}

///|
/// Exercise the real dispatch/process boundary with a small independent module.
async fn entrypoint_test() -> Unit {
  let script = @fs.realpath("scripts/repository-tasks.mbtx")
  let root = @fs.tmpdir(prefix="morphir task entrypoints ")
  defer @fs.rmdir(root, recursive=true)
  @fs.write_file(
    root + "/moon.mod",
    "name = \"fixture/automation\"\nversion = \"0.1.0\"\n",
  )
  @fs.write_file(root + "/moon.pkg", "")
  @fs.write_file(root + "/example.mbt", "pub fn example()->Int{1}\n")
  @fs.write_file(root + "/sentinel", "preserve")
  let invoke = async fn(task) {
    @process.collect_output("moonx", [script, task], cwd=root)
  }
  for argv in [[], ["unknown"], ["--unknown"], ["--help"], ["help", "clean"]] {
    let (status, _, _) = @process.collect_output(
      "moonx",
      [script, ..argv],
      cwd=root,
    )
    guard status == 1 && @fs.read_file(root + "/sentinel").text() == "preserve" else {
      raise InvalidTask("invalid entrypoint status or effects changed")
    }
  }
  let (build, build_out, build_err) = invoke("build:wasi")
  guard build == 0 &&
    @fs.exists(root + "/_build") &&
    build_out.text().contains("✅ WASI build complete") else {
    raise InvalidTask("entrypoint build failed: " + build_err.text())
  }
  let (bad_format, out, _) = invoke("lint:moonbit")
  guard bad_format == 1 &&
    out.text().contains("Formatting issues found") &&
    !out.text().contains("check complete") else {
    raise InvalidTask("entrypoint formatting failure not preserved")
  }
  let (formatted, _, format_err) = invoke("format")
  let (good_format, _, _) = invoke("lint:moonbit")
  guard formatted == 0 && good_format == 0 else {
    raise InvalidTask(
      "entrypoint format did not repair source: " + format_err.text(),
    )
  }
  let (cleaned, _, _) = invoke("clean")
  guard cleaned == 0 &&
    !@fs.exists(root + "/_build") &&
    @fs.read_file(root + "/sentinel").text() == "preserve" else {
    raise InvalidTask("entrypoint clean touched wrong files")
  }
  if @env.get_env_var("OS") != Some("Windows_NT") {
    let outside = @fs.tmpdir(prefix="morphir clean outside ")
    defer @fs.rmdir(outside, recursive=true)
    @fs.write_file(outside + "/sentinel", "external")
    @fs.symlink(target=outside, root + "/_build")
    let (link_cleaned, _, _) = invoke("clean")
    guard link_cleaned == 0 &&
      @fs.read_file(outside + "/sentinel").text() == "external" else {
      raise InvalidTask("real moon clean followed external _build link")
    }
  }
  @fs.write_file(
    root + "/mise.toml",
    "[tasks.fixture]\nrun = \"moon version\"\n",
  )
  let (listed, tasks, _) = @process.collect_output(
    "moonx",
    [script, "list-tasks"],
    cwd=root,
    extra_env={ "MISE_YES": "1", "MISE_TRUSTED_CONFIG_PATHS": root },
  )
  guard listed == 0 && tasks.text().contains("fixture") else {
    raise InvalidTask("entrypoint task listing lost caller cwd")
  }
}

///|
async fn self_test() -> Unit {
  for
    task in [
      "build", "build:wasi", "build:browser", "build:js", "build:native", "test",
      "format", "lint:moonbit", "lint", "lint:yaml", "validate", "clean", "list-tasks",
    ] {
    for
      argv in [
        [task],
        [
          task, "tail", "--unknown", "-path", "", "--", "--self-test", "--help",
          "--help=x", "help", "ü 雨", "$ ` ;",
        ],
      ] {
      guard invocation(argv) is Task(actual) && actual == task else {
        abort("task parsing changed")
      }
    }
  }
  guard invocation(["--self-test"]) is SelfTest else {
    abort("self-test parsing changed")
  }
  for
    argv in [
      [],
      ["unknown"],
      ["--unknown"],
      ["--help"],
      ["help", "build"],
      ["--", "build"],
      ["--self-test", "--self-test"],
      ["--self-test=true"],
      ["--self-test", "build"],
      ["--self-test", "tail"],
    ] {
    let rejected = try {
      ignore(invocation(argv))
      false
    } catch {
      _ => true
    }
    guard rejected else { abort("invalid task accepted") }
  }
  for
    task in [
      "build", "test", "build:wasi", "build:browser", "build:js", "build:native",
      "format", "lint", "lint:moonbit", "validate", "list-tasks",
    ] {
    let recorded : Array[(String, Array[String])] = []
    execute(task, fn(program, args) {
      recorded.push((program, args))
      0
    })
    guard recorded == commands(task) else {
      abort("dispatch command boundaries changed")
    }
  }
  for child_status in [-15, -1, 23] {
    let count = Ref(0)
    let status = try {
      execute("test", fn(_, _) {
        count.val += 1
        child_status
      })
      0
    } catch {
      Failed(code) => code
      _ => -1
    }
    guard status == (if child_status < 0 { 1 } else { child_status }) &&
      count.val == 1 else {
      abort("child status or short circuit changed")
    }
  }
  guard commands("build") ==
    [
      ("mise", ["run", "build:wasi"]),
      ("mise", ["run", "build:browser"]),
      ("mise", ["run", "build:js"]),
      ("mise", ["run", "build:native"]),
    ] else {
    abort("build ordering changed")
  }
  guard commands("test") ==
    [
      ("moon", ["test", "--target", "wasm"]),
      ("moon", ["test", "--target", "wasm-gc"]),
      ("moon", ["test", "--target", "js"]),
      ("moon", ["test", "--target", "native"]),
      ("mise", ["run", "test:cli"]),
      ("mise", ["run", "test:compiler"]),
    ] else {
    abort("test coverage/order changed")
  }
  let calls : Array[String] = []
  let status = try {
    execute("build", fn(program, args) {
      calls.push(program + " " + args.join(" "))
      if calls.length() == 2 {
        37
      } else {
        0
      }
    })
    0
  } catch {
    Failed(code) => code
    _ => -1
  }
  guard status == 37 && calls.length() == 2 else {
    abort("child failure must propagate and stop later tasks")
  }
  let formatting = try {
    execute("lint:moonbit", fn(_, _) { 23 })
    0
  } catch {
    Failed(code) => code
    _ => -1
  }
  guard formatting == 1 else { abort("format diagnostic status changed") }
  for
    (task, expected) in [
      ("build:wasi", [("moon", ["build", "--target", "wasm"])]),
      ("build:browser", [("moon", ["build", "--target", "wasm-gc"])]),
      ("build:js", [("moon", ["build", "--target", "js"])]),
      ("build:native", [("moon", ["build", "--target", "native", "--release"])]),
      ("format", [("moon", ["fmt"])]),
      (
        "lint",
        [
          ("mise", ["run", "lint:yaml"]),
          ("mise", ["run", "lint:moonbit"]),
          ("mise", ["run", "lint:engine-boundaries"]),
        ],
      ),
      (
        "validate",
        [("mise", ["run", "lint:yaml"]), ("mise", ["run", "validate:packages"])],
      ),
      ("list-tasks", [("mise", ["tasks"])]),
    ] {
    guard commands(task) == expected else { abort("wrong command for " + task) }
  }
  let root = @fs.tmpdir(prefix="morphir repository tasks ")
  defer @fs.rmdir(root, recursive=true)
  for
    dir in [
      ".github", "node_modules", ".git", "target", "build", "_build", "nested/node_modules",
      "nested/building",
    ] {
    @fs.mkdir(root + "/" + dir, recursive=true)
    @fs.write_file(root + "/" + dir + "/case.yaml", "key: value\n")
  }
  @fs.write_file(root + "/space name.yml", "key: value\n")
  @fs.write_file(root + "/ignore.txt", "not yaml")
  let paths : Array[String] = []
  yaml_files(root, paths)
  paths.sort_by((a, b) => a.lexical_compare(b))
  let expected = [
    root + "/.github/case.yaml",
    root + "/nested/building/case.yaml",
    root + "/space name.yml",
  ]
  guard paths == expected else { raise InvalidTask("YAML exclusions changed") }
  let lint_calls : Array[(String, Array[String])] = []
  lint_yaml(root, fn(program, args) {
    lint_calls.push((program, args))
    0
  })
  guard lint_calls == [("yamllint", expected)] else {
    raise InvalidTask("YAML paths were split or changed")
  }
  for i in 0..<42 {
    @fs.write_file(root + "/batch-\{i}.yaml", "key: value\n")
  }
  let lint_count = Ref(0)
  let failed_lint = try {
    lint_yaml(root, fn(_, _) {
      lint_count.val += 1
      19
    })
    0
  } catch {
    Failed(code) => code
    _ => -1
  }
  guard failed_lint == 19 && lint_count.val == 1 else {
    raise InvalidTask("YAML failure was swallowed or later batches executed")
  }
  let empty = @fs.tmpdir(prefix="morphir empty yaml ")
  defer @fs.rmdir(empty, recursive=true)
  lint_yaml(empty, fn(_, _) { abort("empty tree invoked yamllint") })
  // clean intentionally tolerates moon clean failure and removes stale _build.
  let code = clean(root, fn(_, _) { 41 })
  guard code == 0 &&
    !@fs.exists(root + "/_build") &&
    @fs.exists(root + "/space name.yml") else {
    abort("clean failed to remove only its build directory")
  }
  if @env.get_env_var("OS") != Some("Windows_NT") {
    let missing = root + "/missing target"
    @fs.symlink(target=missing, root + "/_build")
    ignore(clean(root, fn(_, _) { 0 }))
    guard (@fs.kind(root + "/_build", follow_symlink=false) catch {
        _ => @fs.Unknown
      }) ==
      @fs.Unknown else {
      raise InvalidTask("clean retained dangling _build link")
    }
    @fs.symlink(target=empty, root + "/_build")
    @fs.write_file(empty + "/sentinel", "preserve")
    ignore(clean(root, fn(_, _) { 0 }))
    guard @fs.read_file(empty + "/sentinel").text() == "preserve" else {
      raise InvalidTask("clean followed _build link")
    }
  }
  entrypoint_test()
  progress("Repository task self-tests passed.")
}

///|
async fn command_main(argv : Array[String]) -> Unit {
  let selected = invocation(argv) catch {
    error => {
      @stdio.stderr.write("\{error}\n")
      finish(1, message=error.to_string())
      return
    }
  }
  if selected is Task(task) {
    operation.val = "repository.tasks." + task
  }
  try {
    match selected {
      SelfTest => {
        self_test()
        result_data.val = { "selfTest": "passed" }
        operation.val = "repository.tasks.self-test"
      }
      Task("lint:yaml") => lint_yaml(".", run)
      Task("clean") => {
        progress("🧹 Cleaning build artifacts...")
        ignore(clean(".", run))
        progress("✅ Clean complete")
      }
      Task(task) => execute(task, run)
    }
    if selected is Task(task) {
      operation.val = "repository.tasks." + task
      result_data.val = {
        "task": task,
        "steps": Json::array(child_steps),
        "passed": true,
        "yamlFiles": Json::array(yaml_paths.map(Json::string)),
        "removedPaths": Json::array(removed_paths.map(Json::string)),
        "listing": listing.val,
      }
    }
  } catch {
    Failed(code) => finish(code)
    error => {
      @stdio.stderr.write("\{error}\n")
      finish(1)
    }
  }
}

///|
enum Presentation {
  Text
  Json
}

///|
let presentation : Ref[Presentation] = Ref(Text)

///|
let result_data : Ref[Json] = Ref({})

///|
let operation : Ref[String] = Ref("repository.tasks")

///|
/// Only this bounded root prefix is owned. Tail values are encoded for syntax
/// validation only; the original array slice is returned without reconstruction.
fn presentation_arguments(argv : Array[String]) -> Array[String] raise {
  match argv {
    ["--forward-argv", "--", .. raw] => {
      ignore(
        @argparse.Command(
          "repository.tasks",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("forward-argv", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--forward-argv", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    ["--json", .. raw] => {
      presentation.val = Json
      ignore(
        @argparse.Command(
          "repository.tasks",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("json", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--json", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    _ => argv
  }
}

///|
fn presentation_help() -> @argparse.Command {
  @argparse.Command(
    "repository.tasks",
    about="build | build:wasi | build:browser | build:js | build:native | test | format | lint:moonbit | lint | lint:yaml | validate | clean | list-tasks; tail ignored JSON results use profile morphir/command-result, contractVersion0.1.0, command, state, exitCode, diagnostics and result on success or error{code,message} on failure. Existing successful JSON schemas remain bare. Stdout is one compact JSON value plus LF; progress and child logs use stderr. Help has result.help and no command effects; supported self-tests report actual completion. Exit0 means success; explicit syntax/child statuses remain meaningful, new expected JSON refusals exit1; default abort behavior is unchanged.",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[
      @argparse.FlagArg(
        "json",
        about="Emit one command result; select at the root before operation data",
      ),
      @argparse.FlagArg(
        "forward-argv",
        about="Only exact --forward-argv -- RAW selects literal forwarding; unwrap once. Other text-mode tails keep their legacy meaning",
      ),
      @argparse.FlagArg("help", short='h', about="Show help without effects"),
      @argparse.FlagArg(
        "self-test",
        about="Run the existing isolated self-test",
      ),
    ],
    positionals=[
      @argparse.PositionArg("operation", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn progress(message : String) -> Unit {
  if presentation.val is Json {
    @stdio.stderr.write(message + "\n")
  } else {
    println(message)
  }
}

///|
async fn finish(code : Int32, message~ : String = "Command failed") -> Unit {
  if presentation.val is Json {
    let value : Json = if code == 0 {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "succeeded",
        "exitCode": 0,
        "result": result_data.val,
        "diagnostics": [],
      }
    } else {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "failed",
        "exitCode": code,
        "error": {
          "code": "command-failed",
          "message": if message == "Command failed" {
            "Command exited with status \{code}"
          } else {
            message
          },
        },
        "diagnostics": [],
      }
    }
    @stdio.stdout.write(value.stringify() + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = presentation_arguments(@env.args()[1:].to_owned())
  if presentation.val is Json {
    // Built-in help exits inside argparse. JSON help is an ordinary declared
    // flag in a separate grammar, with no acquisition or command effects.
    let help = Some(
      @argparse.Command(
        "repository.tasks",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("help", short='h', required=true)],
      ).parse(argv~, env=Map([])),
    ) catch {
      _ => None
    }
    if help is Some(matches) && matches.flags.get("help") == Some(true) {
      result_data.val = { "help": presentation_help().render_help() }
      operation.val = "repository.tasks.help"
      finish(0)
      return
    }
  }
  try {
    command_main(argv)
    finish(0)
  } catch {
    error =>
      if presentation.val is Json {
        @stdio.stderr.write(error.to_string() + "\n")
        finish(1, message=error.to_string())
      } else {
        raise error
      }
  }
}

///|
let child_steps : Array[Json] = []

///|
let yaml_paths : Array[String] = []

///|
test "JSON prefix preserves literal tail and unwraps escape only once" {
  let previous = presentation.val
  defer {
    presentation.val = previous
  }
  let raw = [
    "--json", "--", "--forward-argv", "--", "", "λ '$;`", "--help", "--replace",
  ]
  let escaped = presentation_arguments(["--forward-argv", "--", ..raw])
  assert_eq(escaped, raw)
  assert_true(presentation.val is Text)
  let selected = presentation_arguments(["--json", ..raw])
  assert_eq(selected, raw)
  assert_true(presentation.val is Json)
}

