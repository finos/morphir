// Runs pinned morphir-elm make on every project in pkgs/morphir-elm/conformance/projects, writes each
// expected/morphir-ir.json as compact JSON, and regenerates pkgs/morphir-elm/conformance/parity_data_wbtest.mbt
// with the same compact JSON (with line breaks in long lines), and pkgs/morphir-engine/acceptance/elm/projects.mbt
// with the Elm sources.
//
// Run it from the repository root with `mise run elm:parity-refresh` or
// `moon run scripts/elm-parity-refresh.mbtx`.

///|
import {
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/async@0.22.1/stdio",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
let root : String = "pkgs/morphir-elm/conformance"

///|
/// The generated file is a white-box test file: only the white-box tests use `parity_projects`.
let output : String = root + "/parity_data_wbtest.mbt"

///|
/// The project data of the end-to-end executable: the Elm sources, without the expected IR.
let acceptance_output : String = "pkgs/morphir-engine/acceptance/elm/projects.mbt"

///|
async fn fail(message : String) -> Unit {
  @stdio.stderr.write("elm-parity-refresh: \{message}\n")
  if json_mode {
    failure(1, "validation_failed", message)
  }
  @sys.exit(1)
}

///|
async fn run(program : String, args : Array[String]) -> Unit {
  let code = @process.run(
    program,
    args,
    stdout=if json_mode { @stdio.stderr } else { @stdio.stdout },
    stderr=@stdio.stderr,
  )
  if code != 0 {
    exit_child(code)
  }
}

///|
/// Compares by code unit, so `custom-types` comes before `modules`. `String::compare` compares the length
/// first.
fn lexical(a : String, b : String) -> Int32 {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    let c = a[i].compare(b[i])
    if c != 0 {
      return c
    }
  }
  a.length().compare(b.length())
}

///|
/// The entries of `dir` in code unit order.
async fn entries(dir : String) -> Array[String] {
  let names = @fs.readdir(dir)
  names.sort_by(lexical)
  names
}

///|
/// Adds every `.elm` file under `dir` to `out`, as (path relative to the source directory, content), in
/// sorted path order.
async fn elm_sources(
  dir : String,
  prefix : String,
  out : Array[(String, String)],
) -> Unit {
  for entry in entries(dir) {
    let path = dir + "/" + entry
    match @fs.kind(path) {
      Directory => elm_sources(path, prefix + entry + "/", out)
      _ =>
        if entry.has_suffix(".elm") {
          out.push((prefix + entry, @fs.read_file(path).text()))
        }
    }
  }
}

///|
/// A MoonBit string literal for `text`. JSON string escapes are valid MoonBit string escapes.
fn quoted(text : String) -> String {
  Json::string(text).stringify()
}

///|
/// Adds `text` to `lines` as the lines of a raw multiline string literal (`#|`), so that no line of the
/// generated file is longer than a line of `text`. A raw line cannot hold a carriage return.
async fn push_raw(
  lines : Array[String],
  indent : String,
  text : String,
  origin : String,
) -> Unit {
  if text.contains("\r") {
    fail("\{origin} has a carriage return; use LF line endings")
  }
  for line in text.split("\n") {
    lines.push(indent + "#|" + line.to_owned())
  }
}

///|
/// The longest line of JSON that `wrap_json` leaves alone. MoonBit warns (0033) when a line of a source file is
/// longer than 65535 characters, and a large expected IR is one line of compact JSON.
let json_line_width : Int32 = 60000

///|
/// `json` with a line break after the first comma outside a string once a line has `width` characters. A JSON
/// reader takes the line break as whitespace, so the text holds the same JSON.
fn wrap_json(json : String, width : Int32) -> String {
  let out = StringBuilder::new()
  let mut column = 0
  let mut in_string = false
  let mut escaped = false
  for c in json {
    out.write_char(c)
    column += 1
    if in_string {
      if escaped {
        escaped = false
      } else if c == '\\' {
        escaped = true
      } else if c == '"' {
        in_string = false
      }
    } else if c == '"' {
      in_string = true
    } else if c == ',' && column >= width {
      out.write_char('\n')
      column = 0
    }
  }
  out.to_string()
}

///|
async fn execute() -> Json {
  run("bun", [
    "install", "--frozen-lockfile", "--cwd", "pkgs/morphir-elm/scripts",
  ])
  let make = "pkgs/morphir-elm/scripts/node_modules/.bin/morphir-elm"
  let lines = [
    "// GENERATED by scripts/elm-parity-refresh.mbtx. Do not edit.", "// Sources: pkgs/morphir-elm/conformance/projects. Expected IR: morphir-elm 2.100.0.",
    "", "///|", "fn parity_projects() -> Array[ParityProject] {", "  [",
  ]
  let acceptance = [
    "// GENERATED by scripts/elm-parity-refresh.mbtx. Do not edit.", "// Sources: pkgs/morphir-elm/conformance/projects.",
    "", "///|", "fn elm_projects() -> Array[ElmProject] {", "  [",
  ]
  let projects : Array[Json] = []
  let written : Array[Json] = []
  for name in entries(root + "/projects") {
    let dir = root + "/projects/" + name
    guard @fs.kind(dir) is Directory else { continue }
    // A stale hash file makes morphir-elm build incrementally from an old output.
    if @fs.exists(dir + "/morphir-hashes.json") {
      @fs.remove(dir + "/morphir-hashes.json")
    }
    if !@fs.exists(dir + "/expected") {
      @fs.mkdir(dir + "/expected")
    }
    let expected_path = dir + "/expected/morphir-ir.json"
    run(make, ["make", "-p", dir, "-o", expected_path])
    if @fs.exists(dir + "/morphir-hashes.json") {
      @fs.remove(dir + "/morphir-hashes.json")
    }
    let config = @json.parse(@fs.read_file(dir + "/morphir.json").text()) catch {
      _ => {
        fail("morphir.json in \{dir} is not valid JSON")
        panic()
      }
    }
    guard config is Object(fields) &&
      fields.get("name") is Some(String(package_name)) &&
      fields.get("exposedModules") is Some(Array(exposed)) else {
      fail("morphir.json in \{dir} needs name and exposedModules")
      panic()
    }
    let source_dir = match fields.get("sourceDirectory") {
      Some(String(s)) => s
      _ => "src"
    }
    let sources : Array[(String, String)] = []
    elm_sources(dir + "/" + source_dir, "", sources)
    // Compact JSON keeps the corpus small: the expected file and the generated data file hold the same IR.
    let expected = (@json.parse(@fs.read_file(expected_path).text()) catch {
      _ => {
        fail("\{expected_path} is not valid JSON")
        panic()
      }
    }).stringify()
    @fs.write_file(expected_path, expected + "\n")
    projects.push(Json::string(name))
    written.push(Json::string(expected_path))
    lines.push("    {")
    lines.push("      name: \{quoted(name)},")
    lines.push("      package_name: \{quoted(package_name)},")
    lines.push(
      "      exposed: [\{exposed.map(e => e.stringify()).join(", ")}],",
    )
    lines.push("      sources: [")
    for s in sources {
      lines.push("        (")
      lines.push("          \{quoted(s.0)},")
      lines.push("          (")
      push_raw(lines, "            ", s.1, dir + "/" + source_dir + "/" + s.0)
      lines.push("          ),")
      lines.push("        ),")
    }
    lines.push("      ],")
    lines.push("      expected: (")
    push_raw(
      lines,
      "        ",
      wrap_json(expected, json_line_width),
      expected_path,
    )
    lines.push("      ),")
    lines.push("    },")
    acceptance.push("    {")
    acceptance.push("      name: \{quoted(name)},")
    acceptance.push("      manifest: (")
    push_raw(
      acceptance,
      "        ",
      @fs.read_file(dir + "/morphir.json").text(),
      dir + "/morphir.json",
    )
    acceptance.push("      ),")
    acceptance.push("      sources: [")
    for s in sources {
      acceptance.push("        (")
      acceptance.push("          \{quoted(s.0)},")
      acceptance.push("          (")
      push_raw(
        acceptance,
        "            ",
        s.1,
        dir + "/" + source_dir + "/" + s.0,
      )
      acceptance.push("          ),")
      acceptance.push("        ),")
    }
    acceptance.push("      ],")
    acceptance.push("    },")
  }
  lines.push("  ]")
  lines.push("}")
  @fs.write_file(output, lines.join("\n") + "\n")
  acceptance.push("  ]")
  acceptance.push("}")
  @fs.write_file(acceptance_output, acceptance.join("\n") + "\n")
  run("moon", ["fmt"])
  (
    {
      "projects": projects,
      "writtenFiles": Json::array(
        written + [Json::string(output), Json::string(acceptance_output)],
      ),
      "generator": "morphir-elm",
      "version": "2.100.0",
      "formatted": true,
    } : Json)
}

///|
let json_mode : Bool = match @env.args() {
  [_, "--json", ..] => true
  _ => false
}

///|
fn json_command() -> @argparse.Command {
  @argparse.Command(
    "elm-parity-refresh",
    disable_help_flag=true,
    disable_help_subcommand=true,
    about="Opt-in JSON results. Use --json [--help] or --json -- RAW. Other argv retains legacy ignored-tail behavior. stdout is one compact command-result 0.1.0 value plus LF; progress and live child stdout go to stderr. Success has result and diagnostics; failure has error {code,message}, diagnostics and the mapped exitCode. Expected refusals and ordinary errors exit 1, JSON syntax exits 2; explicitly propagated positive child statuses are retained, negative statuses map to 1. Default abort/signal behavior is unchanged; JSON refusals use normal exit 1. Help returns result.render_help without effects. Operation result fields: projects, writtenFiles, generator, version and formatted, after generation and formatting finish.",
    flags=[@argparse.FlagArg("json"), @argparse.FlagArg("help")],
    positionals=[
      @argparse.PositionArg("legacy", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn success(result : Json) -> Unit {
  @stdio.stdout.write(
    (
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "elm.parity.refresh",
        "state": "succeeded",
        "exitCode": 0,
        "result": result,
        "diagnostics": [],
      } : Json).stringify() +
    "\n",
  )
}

///|
async fn failure(code : Int32, category : String, message : String) -> Unit {
  @stdio.stdout.write(
    (
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "elm.parity.refresh",
        "state": "failed",
        "exitCode": code,
        "error": { "code": category, "message": message },
        "diagnostics": [],
      } : Json).stringify() +
    "\n",
  )
}

///|
async fn exit_child(code : Int32) -> Unit {
  let mapped = if code > 0 { code } else { 1 }
  if json_mode {
    failure(mapped, "child_failed", "Child command failed")
  }
  @sys.exit(mapped)
}

///|
async fn main {
  if !json_mode {
    ignore(execute())
    return
  }
  let command = json_command()
  let matches = command.parse(argv=@env.args()[1:]) catch {
    error => {
      failure(2, "invalid_arguments", error.to_string())
      @sys.exit(2)
      panic()
    }
  }
  if matches.flags.get("help").unwrap_or(false) {
    success({ "render_help": command.render_help() })
    return
  }
  try {
    let result = execute()
    success(result)
  } catch {
    error => {
      failure(1, "command_failed", error.to_string())
      @sys.exit(1)
    }
  }
}
