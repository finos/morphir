///|
/// Install the managed Git pre-push dispatcher without replacing custom hooks.
import {
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/async@0.22.1/stdio",
  "moonbitlang/core/json",
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
}

///|
fn setup_command() -> @argparse.Command {
  @argparse.Command(
    "setup:hooks",
    about="Install the managed Git pre-push dispatcher",
    disable_help_flag=true,
    flags=[
      @argparse.FlagArg(
        "self-test",
        about="Run isolated hook installation tests",
        required=true,
      ),
    ],
  )
}

///|
fn setup_arguments(argv : Array[String]) -> @argparse.Matches raise {
  // Only the first token can be a control. The fixed delimiter makes every
  // trailing raw token an excess operand, including another delimiter.
  let control_argv = if argv.is_empty() {
    []
  } else {
    [argv[0], "--", ..argv[1:]]
  }
  // Catch syntax failure only, before installation or self-test effects.
  // Every other array, including help, remains historical ignored data.
  let controls = Some(setup_command().parse(argv=control_argv, env=Map([]))) catch {
    _ => None
  }
  match controls {
    Some(args) => args
    None =>
      @argparse.Command("setup:hooks", disable_help_flag=true, positionals=[
        @argparse.PositionArg("ignored", num_args=@argparse.ValueRange(lower=0)),
      ]).parse(argv=["--", ..argv], env=Map([]))
  }
}

///|
let dispatcher =
  #|#!/bin/sh
  #|# morphir-moonbit managed pre-push dispatcher v1
  #|exec mise exec -- moonx scripts/pre-push.mbtx "$@"
  #|

///|
/// Exact legacy signature: user additions must never be overwritten.
let legacy_dispatcher =
  #|#!/usr/bin/env bash
  #|# Pre-push hook: Runs lint, format check, and validation before allowing push
  #|set -e
  #|
  #|echo ""
  #|echo "🔍 Running pre-push validation checks..."
  #|echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  #|echo ""
  #|
  #|# Check if mise is available
  #|if ! command -v mise &> /dev/null; then
  #|    echo "❌ Error: mise is not installed or not in PATH"
  #|    echo "   Please install mise: https://mise.jdx.dev/"
  #|    exit 1
  #|fi
  #|
  #|# Run linting
  #|echo "📝 Running lint checks..."
  #|if ! mise run lint; then
  #|    echo ""
  #|    echo "❌ Linting failed! Please fix the issues and try again."
  #|    echo "   Run: mise run lint"
  #|    exit 1
  #|fi
  #|
  #|# Run format check
  #|echo ""
  #|echo "✨ Checking code formatting..."
  #|if ! mise run lint:moonbit; then
  #|    echo ""
  #|    echo "❌ Format check failed! Please format your code and try again."
  #|    echo "   Run: mise run format"
  #|    exit 1
  #|fi
  #|
  #|# Run validation
  #|echo ""
  #|echo "🔍 Running validation checks..."
  #|if ! mise run validate; then
  #|    echo ""
  #|    echo "❌ Validation failed! Please fix the issues and try again."
  #|    echo "   Run: mise run validate"
  #|    exit 1
  #|fi
  #|
  #|echo ""
  #|echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  #|echo "✅ All pre-push checks passed! Proceeding with push..."
  #|echo ""

///|
async fn install(root : String, skip~ : Bool = false) -> Unit {
  if skip {
    result_data.val = { "outcome": "skipped", "reason": "CI environment" }
    return
  }
  let (status, out, _) = @process.collect_output(
    "git",
    ["rev-parse", "--path-format=absolute", "--git-path", "hooks"],
    cwd=root,
  )
  if status != 0 {
    result_data.val = {
      "outcome": "skipped",
      "reason": "Git hooks directory unavailable",
      "gitExitCode": status,
    }
    return
  }
  let directory = out.text().trim().to_owned()
  if !@fs.exists(directory) {
    @fs.mkdir(directory, recursive=true)
  }
  let hook = directory + "/pre-push"
  let kind = @fs.kind(hook, follow_symlink=false) catch { _ => @fs.Unknown }
  if kind != @fs.Unknown {
    if kind != @fs.Regular {
      result_data.val = { "hookPath": hook, "outcome": "custom-preserved" }
      progress("setup:hooks: preserving custom hook at \{hook}")
      return
    }
    let old = @fs.read_file(hook).text()
    if old == dispatcher {
      result_data.val = { "hookPath": hook, "outcome": "unchanged" }
      if @env.get_env_var("OS") != Some("Windows_NT") {
        @fs.chmod(hook, 0o755)
      }
      return
    }
    let legacy = old.replace(old="\r\n", new="\n").trim_end() ==
      legacy_dispatcher.trim_end()
    if !legacy {
      result_data.val = { "hookPath": hook, "outcome": "custom-preserved" }
      progress("setup:hooks: preserving custom hook at \{hook}")
      return
    }
  }
  progress("🔧 Setting up git hooks...")
  @fs.write_file(hook, dispatcher)
  if @env.get_env_var("OS") != Some("Windows_NT") {
    @fs.chmod(hook, 0o755)
  }
  result_data.val = { "hookPath": hook, "outcome": "installed" }
  progress("✅ Git hooks installed successfully!")
  progress("")
  progress("Pre-push hook will now run the following checks before every push:")
  progress("  • Linting (mise run lint)")
  progress("  • Format checking (mise run lint:moonbit)")
  progress("  • Validation (mise run validate)")
  progress("")
  progress("To bypass the hook (not recommended), use: git push --no-verify")
}

///|
async fn git(root : String, args : Array[String]) -> String {
  let (status, out, err) = @process.collect_output("git", args, cwd=root)
  guard status == 0 else { fail(err.text()) }
  out.text().trim().to_owned()
}

///|
async fn self_test() -> Unit {
  guard !setup_arguments([]).flags.get("self-test").unwrap_or(false) &&
    setup_arguments(["--self-test"]).flags.get("self-test") == Some(true) else {
    fail("Hook setup invocation changed")
  }
  for
    argv in [
      ["extra"],
      ["--unknown"],
      ["--help"],
      ["-h"],
      ["-hh"],
      ["--help=true"],
      ["--self-test=true"],
      ["--self-test", "--"],
      ["--self-test", "--self-test"],
      ["--"],
      [""],
      ["--self-test", "extra"],
      ["--", "extra"],
      ["--", "--self-test"],
      ["--help", "extra"],
      ["--help", "--self-test"],
      ["", "--", "--help", "--", "λ ' $;`"],
    ] {
    let args = setup_arguments(argv)
    guard args.flags.is_empty() && args.values.get("ignored") == Some(argv) else {
      fail("Ignored setup argv changed")
    }
  }
  let tokens = [
    "--self-test", "--", "--help", "-h", "-hh", "--help=true", "--self-test=true",
    "--unknown", "", "λ ' $;`", "origin", "location",
  ]
  for first in tokens {
    for second in tokens {
      let argv = [first, second]
      let args = setup_arguments(argv)
      guard args.flags.is_empty() && args.values.get("ignored") == Some(argv) else {
        fail("Ignored setup pair changed")
      }
    }
  }
  let fixture = @fs.tmpdir(prefix="morphir-hooks-")
  defer @fs.rmdir(fixture, recursive=true)
  let repo = fixture + "/repo's space"
  @fs.mkdir(repo)
  install(repo) // Non-repositories are harmless.
  ignore(git(repo, ["init", "-q"]))
  let hook = repo + "/.git/hooks/pre-push"
  install(repo, skip=true)
  guard !@fs.exists(hook) else { fail("CI installed a hook") }
  install(repo)
  guard @fs.read_file(hook).text() == dispatcher else {
    fail("Dispatcher missing")
  }
  let before = @fs.mtime(hook)
  install(repo)
  guard @fs.mtime(hook) == before else { fail("Setup is not idempotent") }
  if @env.get_env_var("OS") != Some("Windows_NT") {
    @fs.chmod(hook, 0o644)
    install(repo)
    guard @fs.can_execute(hook) else {
      fail("Hook executable mode not repaired")
    }
  }
  // Linked worktrees share the hook, and Git resolves custom hook paths itself.
  let linked = fixture + "/linked worktree"
  // An orphan worktree exercises the shared hook path without creating Git
  // objects, whose read-only attribute prevents portable Windows temp cleanup.
  ignore(
    git(repo, [
      "worktree", "add", "--orphan", "-b", "hook-fixture", "-q", linked,
    ]),
  )
  let objects = git(repo, ["count-objects", "-v"]).replace(old="\r\n", new="\n")
  guard objects.has_prefix("count: 0\n") && objects.contains("\nin-pack: 0\n") else {
    fail("Hook fixture created read-only Git objects")
  }
  install(linked)
  guard @fs.read_file(hook).text() == dispatcher else {
    fail("Linked worktree hook differs")
  }
  let custom = fixture + "/custom's hooks"
  @fs.mkdir(custom)
  ignore(git(repo, ["config", "core.hooksPath", custom]))
  @fs.write_file(custom + "/pre-push", "#!/bin/sh\n# unrelated hook\n")
  install(linked)
  guard @fs.read_file(custom + "/pre-push").text().contains("unrelated hook") else {
    fail("Custom hook overwritten")
  }
  @fs.remove(custom + "/pre-push")
  install(linked)
  guard @fs.read_file(custom + "/pre-push").text() == dispatcher else {
    fail("Configured hooksPath ignored")
  }
  if @env.get_env_var("OS") != Some("Windows_NT") {
    @fs.remove(custom + "/pre-push")
    let target = custom + "/missing custom target"
    @fs.symlink(target~, custom + "/pre-push")
    install(repo)
    guard !@fs.exists(target) &&
      @fs.kind(custom + "/pre-push", follow_symlink=false) == @fs.SymLink else {
      fail("Dangling custom hook symlink overwritten")
    }
    @fs.remove(custom + "/pre-push")
  }
  // Customized legacy hooks remain custom, even if they retain the old header.
  let customized = legacy_dispatcher + "\n# Custom step\nexit 7\n"
  @fs.write_file(custom + "/pre-push", customized)
  install(repo)
  guard @fs.read_file(custom + "/pre-push").text() == customized else {
    fail("Customized legacy hook overwritten")
  }
  // Exact legacy content upgrades on Windows line endings too.
  @fs.write_file(
    custom + "/pre-push",
    legacy_dispatcher.replace(old="\n", new="\r\n"),
  )
  install(repo)
  guard @fs.read_file(custom + "/pre-push").text() == dispatcher else {
    fail("Legacy managed hook not upgraded")
  }
  progress("setup:hooks: Git/worktree/idempotence/custom-hook tests passed")
}

///|
async fn command_main(argv : Array[String]) -> Unit {
  let args = setup_arguments(argv)
  if args.flags.get("self-test").unwrap_or(false) {
    {
      self_test()
      result_data.val = { "selfTest": "passed" }
      operation.val = "setup.hooks.self-test"
    }
    return
  }
  install(
    ".",
    skip=@env.get_env_var("CI") == Some("true") ||
      @env.get_env_var("GITHUB_ACTIONS") == Some("true"),
  )
}

///|
enum Presentation {
  Text
  Json
}

///|
let presentation : Ref[Presentation] = Ref(Text)

///|
let result_data : Ref[Json] = Ref({})

///|
let operation : Ref[String] = Ref("setup.hooks")

///|
/// Only this bounded root prefix is owned. Tail values are encoded for syntax
/// validation only; the original array slice is returned without reconstruction.
fn presentation_arguments(argv : Array[String]) -> Array[String] raise {
  match argv {
    ["--forward-argv", "--", .. raw] => {
      ignore(
        @argparse.Command(
          "setup.hooks",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("forward-argv", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--forward-argv", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    ["--json", .. raw] => {
      presentation.val = Json
      ignore(
        @argparse.Command(
          "setup.hooks",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("json", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--json", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    _ => argv
  }
}

///|
fn presentation_help() -> @argparse.Command {
  @argparse.Command(
    "setup.hooks",
    about="Install the managed Git pre-push hook while preserving custom hooks JSON results use profile morphir/command-result, contractVersion0.1.0, command, state, exitCode, diagnostics and result on success or error{code,message} on failure. Existing successful JSON schemas remain bare. Stdout is one compact JSON value plus LF; progress and child logs use stderr. Help has result.help and no command effects; supported self-tests report actual completion. Exit0 means success; explicit syntax/child statuses remain meaningful, new expected JSON refusals exit1; default abort behavior is unchanged.",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[
      @argparse.FlagArg(
        "json",
        about="Emit one command result; select at the root before operation data",
      ),
      @argparse.FlagArg(
        "forward-argv",
        about="Only exact --forward-argv -- RAW selects literal forwarding; unwrap once. Other text-mode tails keep their legacy meaning",
      ),
      @argparse.FlagArg("help", short='h', about="Show help without effects"),
      @argparse.FlagArg(
        "self-test",
        about="Run the existing isolated self-test",
      ),
    ],
    positionals=[
      @argparse.PositionArg("operation", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn progress(message : String) -> Unit {
  if presentation.val is Json {
    @stdio.stderr.write(message + "\n")
  } else {
    println(message)
  }
}

///|
async fn finish(code : Int32, message~ : String = "Command failed") -> Unit {
  if presentation.val is Json {
    let value : Json = if code == 0 {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "succeeded",
        "exitCode": 0,
        "result": result_data.val,
        "diagnostics": [],
      }
    } else {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "failed",
        "exitCode": code,
        "error": {
          "code": "command-failed",
          "message": if message == "Command failed" {
            "Command exited with status \{code}"
          } else {
            message
          },
        },
        "diagnostics": [],
      }
    }
    @stdio.stdout.write(value.stringify() + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = presentation_arguments(@env.args()[1:].to_owned())
  if presentation.val is Json {
    // Built-in help exits inside argparse. JSON help is an ordinary declared
    // flag in a separate grammar, with no acquisition or command effects.
    let help = Some(
      @argparse.Command(
        "setup.hooks",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("help", short='h', required=true)],
      ).parse(argv~, env=Map([])),
    ) catch {
      _ => None
    }
    if help is Some(matches) && matches.flags.get("help") == Some(true) {
      result_data.val = { "help": presentation_help().render_help() }
      operation.val = "setup.hooks.help"
      finish(0)
      return
    }
  }
  try {
    command_main(argv)
    finish(0)
  } catch {
    error =>
      if presentation.val is Json {
        @stdio.stderr.write(error.to_string() + "\n")
        finish(1, message=error.to_string())
      } else {
        raise error
      }
  }
}

///|
test "JSON prefix preserves literal tail and unwraps escape only once" {
  let previous = presentation.val
  defer {
    presentation.val = previous
  }
  let raw = [
    "--json", "--", "--forward-argv", "--", "", "λ '$;`", "--help", "--replace",
  ]
  let escaped = presentation_arguments(["--forward-argv", "--", ..raw])
  assert_eq(escaped, raw)
  assert_true(presentation.val is Text)
  let selected = presentation_arguments(["--json", ..raw])
  assert_eq(selected, raw)
  assert_true(presentation.val is Json)
}
