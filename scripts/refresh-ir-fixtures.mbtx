----
import {
  "moonbitlang/core/env",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.5/sys",
}
----

// Vendor pinned Morphir JSON examples and regenerate the portable codec tests.
// --morphir and --morphir-elm read the recorded commits, never checkout contents.

///|
let morphir_pin = "5c5307d89f34d876e8f1ebf561ec55efbadf9fa0"

///|
let elm_pin = "bc99af69a8b24d391311fae3822a87eafef3c334"

///|
let destination = "pkgs/morphir-ir/conformance"

///|
let provenance = "// Generated by scripts/refresh-ir-fixtures.mbtx."

///|
suberror FixtureError {
  InvalidFixture(String)
} derive(Debug)

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(result) else {
    raise InvalidFixture("Missing fixture field: \{key}")
  }
  result
}

///|
fn text(value : Json) -> String raise {
  guard value is String(s) else {
    raise InvalidFixture("Expected fixture string")
  }
  s
}

///|
fn string_field(value : Json, key : String) -> String raise {
  text(field(value, key))
}

///|
fn items(value : Json) -> Array[Json] raise {
  guard value is Array(xs) else {
    raise InvalidFixture("Expected fixture array")
  }
  xs
}

///|
fn quoted(value : String) -> String {
  Json::string(value).stringify()
}

///|
fn metadata(header : String) -> Map[String, String] {
  let result : Map[String, String] = Map([])
  // Metadata and fence options are whitespace-separated key=value fields.
  for word in header.split(" ") {
    let word = word
      .trim()
      .to_owned()
      .replace(old="{", new="")
      .replace(old="}", new="")
    if word.find("=") is Some(index) {
      result[word[:index].to_owned()] = word[index + 1:].to_owned()
    }
  }
  result
}

///|
enum Role {
  Canonical
  Accepted
  Rejected
} derive(Eq, Debug)

///|
fn Role::parse(s : String) -> Role? {
  match s {
    "canonical" => Some(Canonical)
    "accepted" => Some(Accepted)
    "rejected" => Some(Rejected)
    _ => None
  }
}

///|
fn Role::name(self : Role) -> String {
  match self {
    Canonical => "canonical"
    Accepted => "accepted"
    Rejected => "rejected"
  }
}

///|
struct Fence {
  role : Role
  options : String
  body : String
} derive(Eq, Debug)

///|
fn Fence::to_json(self : Fence) -> Json {
  {
    "role": Json::string(self.role.name()),
    "options": Json::string(self.options),
    "text": Json::string(self.body),
  }
}

///|
struct Case {
  id : String
  node : String
  version : Int32
  source : String
  fences : Array[Fence]
} derive(Eq, Debug)

///|
fn Case::to_json(self : Case) -> Json {
  {
    "id": Json::string(self.id),
    "node": Json::string(self.node),
    "version": Json::number(self.version.to_double()),
    "source": Json::string(self.source),
    "fences": Json::array(self.fences.map(f => f.to_json())),
  }
}

///|
/// Only level-two sections and fenced JSON examples participate in the corpus.
fn parse_cases(source : String, markdown : String) -> Array[Case] raise {
  let sections : Array[Array[String]] = []
  for line in markdown.split("\n") {
    let line = line.to_owned()
    if line.has_prefix("## ") {
      sections.push([line[3:].to_owned()])
    } else if sections.length() > 0 {
      sections[sections.length() - 1].push(line)
    }
  }
  let cases = []
  for section in sections {
    let header = section[0]
    let meta = metadata(header)
    if meta.get("status") == Some("pending") {
      continue
    }
    let fences = []
    let mut index = 1
    while index < section.length() {
      let line = section[index]
      index += 1
      if !line.has_prefix("```json ") {
        continue
      }
      let declaration = line[8:].to_owned()
      let role_text = declaration.split(" ").next().unwrap_or("").to_owned()
      guard Role::parse(role_text) is Some(role) else { continue }
      let body = []
      while index < section.length() && section[index] != "```" {
        body.push(section[index])
        index += 1
      }
      if index < section.length() {
        fences.push({
          role,
          options: declaration[role_text.length():].trim().to_owned(),
          body: body.join("\n").trim().to_owned(),
        })
        index += 1
      }
    }
    if fences.is_empty() {
      continue
    }
    guard meta.get("node") is Some(node) else {
      raise InvalidFixture("Missing node in \{source}: \{header}")
    }
    let version = @string.parse_int(meta.get("version").unwrap_or("4"))
    let id = header.split(":").next().unwrap_or("").to_owned()
    cases.push({ id, node, version, source, fences, })
  }
  cases
}

///|
fn decode_cases(corpus : Json) -> Array[Case] raise {
  items(field(corpus, "cases")).map(c => {
    guard field(c, "version") is Number(number, ..) else {
      raise InvalidFixture("Expected fixture version number")
    }
    let version = number.to_int()
    let fences = items(field(c, "fences")).map(f => {
      let role_text = string_field(f, "role")
      guard Role::parse(role_text) is Some(role) else {
        raise InvalidFixture("Unknown fence role: \{role_text}")
      }
      Fence::{
        role,
        options: string_field(f, "options"),
        body: string_field(f, "text"),
      }
    })
    Case::{
      id: string_field(c, "id"),
      node: string_field(c, "node"),
      version,
      source: string_field(c, "source"),
      fences,
    }
  })
}

///|
/// Explicit codec selection rejects unsupported corpus nodes instead of emitting bad tests.
fn codec(node : String, version : Int32) -> (String, String) raise {
  let prefix = "@v\{version}"
  match node {
    "Name" => ("@wire.read_name(INPUT)", "@wire.write_name(VALUE)")
    "Path" => ("@wire.read_path(INPUT)", "@wire.write_path(VALUE)")
    "FQName" => ("@wire.read_fqname(INPUT)", "@wire.write_fqname(VALUE)")
    "FormatVersion" => ("read_version(INPUT)", "@wire.write_version(VALUE)")
    "Distribution" => ("\{prefix}.from_json(INPUT)", "\{prefix}.to_json(VALUE)")
    "AccessControlledTypeDefinition" | "AccessControlledValueDefinition" => {
      let kind = if node == "AccessControlledTypeDefinition" {
        "type_definition"
      } else {
        "definition"
      }
      (
        "\{prefix}.read_access(INPUT, j => \{prefix}.read_documented(j, \{prefix}.read_\{kind}))",
        "\{prefix}.write_access(VALUE, v => \{prefix}.write_documented(v, \{prefix}.write_\{kind}))",
      )
    }
    _ => {
      let suffix = match node {
        "ValueDefinition" => "definition"
        "Literal" => "literal"
        "Pattern" => "pattern"
        "Type" => "type"
        "Value" => "value"
        "ModuleSpecification" => "module_specification"
        "TypeDefinition" => "type_definition"
        "TypeSpecification" => "type_specification"
        "ValueSpecification" => "value_specification"
        _ => raise InvalidFixture("Unsupported fixture node: \{node}")
      }
      let arguments = if version != 3 || node == "Literal" {
        ("", "")
      } else if node == "Value" {
        (", read_unit, read_unit", ", write_unit, write_unit")
      } else {
        (", read_unit", ", write_unit")
      }
      (
        "\{prefix}.read_\{suffix}(INPUT\{arguments.0})",
        "\{prefix}.write_\{suffix}(VALUE\{arguments.1})",
      )
    }
  }
}

///|
fn generate_mck(cases : Array[Case]) -> String raise {
  let lines = [
    "// Generated by scripts/refresh-ir-fixtures.mbtx; do not edit.", "// Upstream JSON examples: FINOS, Apache-2.0.",
  ]
  for case in cases {
    let (read, write) = codec(case.node, case.version)
    let canonical = case.fences
      .iter()
      .find_first(f => f.role == Canonical)
      .map(f => f.body)
    for index, fence in case.fences {
      lines.push(
        "\n///|\ntest \{quoted("\{case.id} \{index} \{fence.role.name()}")} {",
      )
      let expression = read.replace(
        old="INPUT",
        new="@wire.parse(\{quoted(fence.body)})",
      )
      let options = metadata(fence.options)
      match fence.role {
        Rejected =>
          if options.get("expect") is Some(expected) {
            lines.push("  let value = \{expression}")
            lines.push(
              "  assert_true(@wire.object(\{write.replace(old="VALUE", new="value")}).contains(\{quoted(expected)}))",
            )
          } else {
            guard options.get("diagnostic") is Some(diagnostic) else {
              raise InvalidFixture("Missing rejected diagnostic: \{case.id}")
            }
            lines.push(
              "  let result = try { ignore(\{expression}); \"accepted\" } catch { error => @wire.diagnostic(error) }\n  assert_eq(result, \{quoted(diagnostic)})",
            )
          }
        _ => {
          lines.push("  let value = \{expression}")
          if canonical is Some(expected) && fence.role == Accepted {
            lines.push(
              "  assert_eq(value, \{read.replace(old="INPUT", new="@wire.parse(\{quoted(expected)})")})",
            )
          }
          lines.push(
            "  let encoded = \{write.replace(old="VALUE", new="value")}",
          )
          lines.push(
            "  assert_eq(\{read.replace(old="INPUT", new="encoded")}, value)",
          )
          if fence.role == Canonical {
            lines.push(
              "  assert_eq(encoded, @wire.parse(\{quoted(fence.body)}))",
            )
          }
        }
      }
      lines.push("}")
    }
  }
  lines.join("\n") + "\n"
}

///|
fn scalar_tests(corpus : Json, names : Json) -> String raise {
  let lines = [provenance]
  for c in items(field(corpus, "scalarCases")) {
    let value = field(c, "value")
    let source = quoted(value.stringify())
    let normalization = field(c, "normalization")
    lines.push("\n///|\ntest \{quoted("format: " + string_field(c, "name"))} {")
    if normalization is Object(fields) &&
      fields.get("diagnostic") is Some(diagnostic) {
      lines.push(
        " let result = try { ignore(@wire.read_version(@wire.parse(\{source}))); \"accepted\" } catch { error => @wire.diagnostic(error) }",
      )
      lines.push(" assert_eq(result, \{diagnostic.stringify()})")
    } else {
      lines.push(" let version = @wire.read_version(@wire.parse(\{source}))")
      lines.push(
        " assert_eq(version.to_release_string(), \{field(normalization, "normalized").stringify()})",
      )
      lines.push(
        " assert_eq(@wire.write_version(version), @wire.parse(\{quoted(field(normalization, "canonical").stringify())}))",
      )
      let expected = if value == Json::number(1) || value == Json::number(2) {
        "supported"
      } else {
        string_field(c, "compatibility")
      }
      lines.push(
        " let result = try { version.check_supported(); \"supported\" } catch { error => @wire.diagnostic(error) }",
      )
      lines.push(" assert_eq(result, \{quoted(expected)})")
    }
    lines.push("}")
  }
  for c in items(field(corpus, "rootDiagnosticCases")) {
    if string_field(c, "format") != "json" {
      continue
    }
    lines.push("\n///|\ntest \{quoted(string_field(c, "name"))} {")
    lines.push(
      " let result = try { ignore(@any_json.read(\{quoted(string_field(c, "source"))})); \"accepted\" } catch { error => @wire.diagnostic(error) }",
    )
    lines.push(" assert_eq(result, \{field(c, "diagnostic").stringify()})\n}")
  }
  for index, c in items(field(names, "legacyDecodeCases")) {
    lines.push("\n///|\ntest \"legacy name \{index}\" {")
    let legacy = "[" +
      items(field(c, "legacyArray")).map(v => v.stringify()).join(", ") +
      "]"
    lines.push(
      " assert_eq(@wire.read_name(@wire.parse(\{quoted(legacy)})).to_canonical(), \{field(field(c, "canonical"), "uppercase").stringify()})\n}",
    )
  }
  for index, c in items(field(names, "roundTripCases")) {
    let canonical = field(field(c, "canonical"), "uppercase")
    lines.push("\n///|\ntest \"canonical name \{index}\" {")
    lines.push(
      " assert_eq(@wire.read_name(@wire.parse(\{quoted(canonical.stringify())})).to_canonical(), \{canonical.stringify()})\n}",
    )
  }
  for index, c in items(field(names, "rejectCases")) {
    if field(field(c, "validAs"), "uppercase") == Json::boolean(true) {
      continue
    }
    lines.push("\n///|\ntest \"invalid name \{index}\" {")
    lines.push(
      " let result = try { ignore(@wire.read_name(@wire.parse(\{quoted(field(c, "input").stringify())}))); \"accepted\" } catch { error => @wire.diagnostic(error) }",
    )
    lines.push(" assert_eq(result, \"invalid_name\")\n}")
  }
  lines.join("\n") + "\n"
}

///|
async fn upstream(source : String, pin : String, path : String) -> String {
  let (code, stdout, stderr) = @process.collect_output("git", [
    "-C",
    source,
    "show",
    "\{pin}:\{path}",
  ])
  if code != 0 {
    fail("git show \{pin}:\{path} failed: \{stderr.text()}")
  }
  stdout.text()
}

///|
async fn refresh(source : String) -> Unit {
  let cases = []
  for
    name in [
      "names", "types", "values", "patterns-and-literals", "definitions", "distributions",
      "versions",
    ] {
    let path = "spec/ir/mck/\{name}.md"
    cases.append(parse_cases(path, upstream(source, morphir_pin, path)))
  }
  let corpus : Json = {
    "repository": Json::string("https://github.com/finos/morphir"),
    "commit": Json::string(morphir_pin),
    "cases": Json::array(cases.map(c => c.to_json())),
  }
  @fs.write_file(
    "\{destination}/fixtures/mck.json",
    corpus.stringify(indent=2) + "\n",
  )
  @fs.write_file(
    "\{destination}/fixtures/v3-greeting.json",
    upstream(
      source, morphir_pin, "spec/ir/mck/node-address-fixtures/v3-greeting.json",
    ),
  )
  for name in ["naming-conformance", "format-version-conformance"] {
    @fs.write_file(
      "\{destination}/fixtures/\{name}.json",
      upstream(source, morphir_pin, "docs/spec/ir/fixtures/\{name}.json"),
    )
  }
}

///|
async fn generate() -> Unit {
  let corpus = @json.parse(
    @fs.read_file("\{destination}/fixtures/mck.json").text(),
  )
  let cases = decode_cases(corpus)
  @fs.write_file("\{destination}/mck_test.mbt", generate_mck(cases))
  let greeting = @fs.read_file("\{destination}/fixtures/v3-greeting.json").text()
  @fs.write_file(
    "\{destination}/greeting_test.mbt",
    "\{provenance}\n///|\nfn greeting() -> String {\n  \{quoted(greeting)}\n}\n",
  )
  for version in [1, 2] {
    let rentals = @json.parse(
      @fs.read_file("\{destination}/fixtures/v\{version}-rentals.json").text(),
    )
    @fs.write_file(
      "\{destination}/rentals_v\{version}_test.mbt",
      "\{provenance}\n///|\nfn rentals_v\{version}() -> String {\n  \{quoted(rentals.stringify())}\n}\n",
    )
  }
  let scalars = @json.parse(
    @fs.read_file("\{destination}/fixtures/format-version-conformance.json").text(),
  )
  let names = @json.parse(
    @fs.read_file("\{destination}/fixtures/naming-conformance.json").text(),
  )
  @fs.write_file(
    "\{destination}/scalars_test.mbt",
    scalar_tests(scalars, names),
  )
  let count = cases.fold(init=0, (n, c) => n + c.fences.length())
  result_data.val = {
    "jsonCaseCount": count,
    "refreshedFixtures": Json::array(refreshed_files.map(Json::string)),
    "sourceRevision": morphir_pin,
    "elmSourceRevision": elm_pin,
    "upstreamExamples": cases.length(),
    "writtenFiles": Json::array(
      [
        "mck_test.mbt", "greeting_test.mbt", "rentals_v1_test.mbt", "rentals_v2_test.mbt",
        "scalars_test.mbt",
      ].map(path => Json::string(destination + "/" + path)),
    ),
    "formatted": true,
  }
  progress(
    "Generated \{count} JSON cases from \{cases.length()} upstream examples",
  )
}

///|
async fn self_test() -> Unit {
  let sample =
    #|# ignored title
    #|```json canonical
    #|"not in a case"
    #|```
    #|## a: default version {node=Name}
    #|```yaml canonical
    #|ignored
    #|```
    #|```json canonical
    #| "a"
    #|```
    #|### nested heading
    #|```json accepted note=legacy
    #|["a"]
    #|```
    #|## pending: excluded {node=Value status=pending}
    #|```json canonical
    #|null
    #|```
    #|## b: explicit version {node=Value version=3}
    #|```json rejected diagnostic=invalid_value
    #|[null]
    #|```
    #|## no-json: ignored {node=Type}
    #|```yaml canonical
    #|value
    #|```
  let cases = parse_cases("test.md", sample)
  assert_eq(cases.length(), 2)
  assert_eq(cases[0].id, "a")
  assert_eq(cases[0].version, 4)
  assert_eq(cases[0].fences, [
    { role: Canonical, options: "", body: "\"a\"", },
    { role: Accepted, options: "note=legacy", body: "[\"a\"]", },
  ])
  assert_eq(cases[1].version, 3)
  assert_eq(
    decode_cases({ "cases": Json::array(cases.map(c => c.to_json())) }),
    cases,
  )
  assert_eq(
    codec("Value", 3),
    (
      "@v3.read_value(INPUT, read_unit, read_unit)", "@v3.write_value(VALUE, write_unit, write_unit)",
    ),
  )
  assert_eq(
    codec("Literal", 3),
    ("@v3.read_literal(INPUT)", "@v3.write_literal(VALUE)"),
  )
  assert_eq(
    codec("AccessControlledTypeDefinition", 4).0,
    "@v4.read_access(INPUT, j => @v4.read_documented(j, @v4.read_type_definition))",
  )
  let generated = generate_mck(cases)
  assert_true(
    generated.contains(
      "assert_eq(value, @wire.read_name(@wire.parse(\"\\\"a\\\"\")))",
    ),
  )
  assert_true(generated.contains("assert_eq(result, \"invalid_value\")"))
  let expected_case : Case = {
    id: "retain",
    node: "Value",
    version: 4,
    source: "test.md",
    fences: [{ role: Rejected, options: "expect=retained", body: "{}", }],
  }
  assert_true(generate_mck([expected_case]).contains(".contains(\"retained\")"))
  progress(
    "refresh-ir-fixtures: parser, codec selection, roundtrip and generation tests passed",
  )
}

///|
async fn command_main(argv : Array[String]) -> Unit {
  let matches = @argparse.Command(
    "refresh-ir-fixtures",
    about="Regenerate pinned IR fixture tests; optionally refresh from local upstream clones",
    options=[@argparse.OptionArg("morphir"), @argparse.OptionArg("morphir-elm")],
    disable_help_flag=presentation.val is Json,
    disable_help_subcommand=presentation.val is Json,
    flags=if presentation.val is Json {
      [
        @argparse.FlagArg("help", short='h', about="Show help without effects"),
        @argparse.FlagArg("self-test", conflicts_with=["morphir", "morphir-elm"]),
      ]
    } else {
      [
        @argparse.FlagArg("self-test", conflicts_with=["morphir", "morphir-elm"]),
      ]
    },
  ).parse(argv~) catch {
    error => {
      @stdio.stderr.write(error.to_string() + "\n")
      finish(2, message=error.to_string())
      abort("unreachable after exit")
    }
  }
  if presentation.val is Json && matches.flags.get("help").unwrap_or(false) {
    result_data.val = { "help": presentation_help().render_help() }
    operation.val = "refresh.ir.fixtures.help"
    return
  }
  if matches.flags.get("self-test").unwrap_or(false) {
    {
      self_test()
      result_data.val = { "selfTest": "passed" }
      operation.val = "refresh.ir.fixtures.self-test"
    }
    return
  }
  if matches.values.get("morphir") is Some([source]) {
    refresh(source)
    refreshed_files.append(
      [
        "mck.json", "v3-greeting.json", "naming-conformance.json", "format-version-conformance.json",
      ].map(file => destination + "/fixtures/" + file),
    )
  }
  if matches.values.get("morphir-elm") is Some([source]) {
    for version in [1, 2] {
      let suffix = if version == 1 { "-v1" } else { "" }
      let path = "tests-integration/cli/test-data/rentals/expected-morphir-ir\{suffix}.json"
      @fs.write_file(
        "\{destination}/fixtures/v\{version}-rentals.json",
        upstream(source, elm_pin, path),
      )
      refreshed_files.push(destination + "/fixtures/v\{version}-rentals.json")
    }
  }
  generate()
  let code = @process.run(
    "moon",
    ["fmt"],
    stdout=if presentation.val is Json { @stdio.stderr } else { @stdio.stdout },
    stderr=@stdio.stderr,
  )
  if code != 0 {
    finish(if code > 0 { code } else { 1 })
  }
}

///|
enum Presentation {
  Text
  Json
}

///|
let presentation : Ref[Presentation] = Ref(Text)

///|
let result_data : Ref[Json] = Ref({})

///|
let operation : Ref[String] = Ref("refresh.ir.fixtures")

///|
/// Only this bounded root prefix is owned. Tail values are encoded for syntax
/// validation only; the original array slice is returned without reconstruction.
fn presentation_arguments(argv : Array[String]) -> Array[String] raise {
  match argv {
    ["--forward-argv", "--", .. raw] => {
      ignore(
        @argparse.Command(
          "refresh.ir.fixtures",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("forward-argv", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--forward-argv", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    ["--json", .. raw] => {
      presentation.val = Json
      ignore(
        @argparse.Command(
          "refresh.ir.fixtures",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("json", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--json", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    _ => argv
  }
}

///|
fn presentation_help() -> @argparse.Command {
  @argparse.Command(
    "refresh.ir.fixtures",
    about="Regenerate pinned IR fixtures; --morphir CHECKOUT and --morphir-elm CHECKOUT refresh local sources JSON results use profile morphir/command-result, contractVersion0.1.0, command, state, exitCode, diagnostics and result on success or error{code,message} on failure. Existing successful JSON schemas remain bare. Stdout is one compact JSON value plus LF; progress and child logs use stderr. Help has result.help and no command effects; supported self-tests report actual completion. Exit0 means success; explicit syntax/child statuses remain meaningful, new expected JSON refusals exit1; default abort behavior is unchanged.",
    disable_help_flag=true,
    disable_help_subcommand=true,
    options=[@argparse.OptionArg("morphir"), @argparse.OptionArg("morphir-elm")],
    flags=[
      @argparse.FlagArg(
        "json",
        about="Emit one command result; select at the root before operation data",
      ),
      @argparse.FlagArg(
        "forward-argv",
        about="Only exact --forward-argv -- RAW selects literal forwarding; unwrap once. Other text-mode tails keep their legacy meaning",
      ),
      @argparse.FlagArg("help", short='h', about="Show help without effects"),
      @argparse.FlagArg(
        "self-test",
        about="Run the existing isolated self-test",
      ),
    ],
    positionals=[
      @argparse.PositionArg("operation", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn progress(message : String) -> Unit {
  if presentation.val is Json {
    @stdio.stderr.write(message + "\n")
  } else {
    println(message)
  }
}

///|
async fn finish(code : Int32, message~ : String = "Command failed") -> Unit {
  if presentation.val is Json {
    let value : Json = if code == 0 {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "succeeded",
        "exitCode": 0,
        "result": result_data.val,
        "diagnostics": [],
      }
    } else {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "failed",
        "exitCode": code,
        "error": {
          "code": "command-failed",
          "message": if message == "Command failed" {
            "Command exited with status \{code}"
          } else {
            message
          },
        },
        "diagnostics": [],
      }
    }
    @stdio.stdout.write(value.stringify() + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = presentation_arguments(@env.args()[1:].to_owned())
  try {
    command_main(argv)
    finish(0)
  } catch {
    error =>
      if presentation.val is Json {
        @stdio.stderr.write(error.to_string() + "\n")
        finish(1, message=error.to_string())
      } else {
        raise error
      }
  }
}

///|
test "JSON prefix preserves literal tail and unwraps escape only once" {
  let previous = presentation.val
  defer {
    presentation.val = previous
  }
  let raw = [
    "--json", "--", "--forward-argv", "--", "", "λ '$;`", "--help", "--replace",
  ]
  let escaped = presentation_arguments(["--forward-argv", "--", ..raw])
  assert_eq(escaped, raw)
  assert_true(presentation.val is Text)
  let selected = presentation_arguments(["--json", ..raw])
  assert_eq(selected, raw)
  assert_true(presentation.val is Json)
}

///|
let refreshed_files : Array[String] = []
