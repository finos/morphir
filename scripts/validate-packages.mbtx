///|
/// Check that the package structure of the workspace is valid.
///
/// - `moon.work` exists.
/// - Each package has `moon.mod` and `moon.pkg`, and is an active member of `moon.work`.
/// - Each module whose root directory is not a package has `moon.mod`, and is an active member of `moon.work`.
///
/// A member is active when its line starts, after whitespace, with the quoted path (`"pkgs/x"` or
/// `"./pkgs/x"`). A commented-out entry starts with `#`, so it does not count.
///
/// Run it from the repository root with `mise run validate:packages`, `moonx scripts/validate-packages.mbtx` or
/// `moon run scripts/validate-packages.mbtx`. It exits with 0 when the structure is valid, else with 1.
import {
  "moonbitlang/async@0.22.1/stdio",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/x@0.5.5/sys",
}

///|
let packages : Array[String] = [
  "pkgs/morphir-sdk", "pkgs/morphir-ir", "pkgs/morphir-scheme", "pkgs/morphir-execution",
  "pkgs/morphir-toml-edit", "pkgs/morphir-engine", "pkgs/morphir-host", "pkgs/morphir-core",
  "pkgs/morphir-moonbit-bindings", "pkgs/morphir-metadata", "pkgs/morphir-moonbit",
  "pkgs/morphir-typing", "pkgs/morphir-sdk-spec", "apps/morphir", "apps/morphir-workbench",
  "apps/morphir-extension",
]

///|
/// Modules whose root directory is not a package: they need `moon.mod` and a `moon.work` entry, but no
/// `moon.pkg`.
let modules : Array[String] = [
  "pkgs/morphir-elm", "pkgs/morphir-typing-tools", "pkgs/morphir-conceptual", "apps/morphir-site",
]

///|
/// Whether `path` is an active member of the workspace manifest `work`.
fn is_member(work : String, path : String) -> Bool {
  for line in work.split("\n") {
    let entry = line.trim_start(chars=" \t\r").to_owned()
    if entry.has_prefix("\"\{path}\"") || entry.has_prefix("\"./\{path}\"") {
      return true
    }
  }
  false
}

///|
async fn command_main(_argv : Array[String]) -> Unit {
  progress("🔍 Verifying package structure...")
  let mut errors = 0
  let problems : Array[String] = []
  let checked : Array[Json] = []
  let error = async fn(message : String) {
    progress("❌ ERROR: \{message}")
    errors += 1
    problems.push(message)
  }

  // The workspace manifest must exist and register every member module.
  let work = if @fs.exists("moon.work") {
    @fs.read_file("moon.work").text()
  } else {
    error("moon.work workspace manifest missing")
    ""
  }

  for pkg in packages {
    let start = problems.length()
    let has_mod = @fs.exists("\{pkg}/moon.mod")
    let has_pkg = @fs.exists("\{pkg}/moon.pkg")
    if !has_mod {
      error("moon.mod missing for \{pkg}")
    }
    if !has_pkg {
      error("moon.pkg missing for \{pkg}")
    }
    if !is_member(work, pkg) {
      error("\{pkg} is not an active member in moon.work")
    }
    if has_mod && has_pkg {
      progress("✓ \{pkg} package configuration found")
    }
    checked.push({
      "path": pkg,
      "kind": "package",
      "valid": start == problems.length(),
      "errors": Json::array(problems[start:].map(Json::string)),
    })
  }

  for module_ in modules {
    let start = problems.length()
    let has_mod = @fs.exists("\{module_}/moon.mod")
    if !has_mod {
      error("moon.mod missing for \{module_}")
    }
    if !is_member(work, module_) {
      error("\{module_} is not an active member in moon.work")
    }
    if has_mod {
      progress("✓ \{module_} module configuration found")
    }
    checked.push({
      "path": module_,
      "kind": "module",
      "valid": start == problems.length(),
      "errors": Json::array(problems[start:].map(Json::string)),
    })
  }

  if errors == 0 {
    progress("✅ All package configurations valid")
    result_data.val = {
      "members": Json::array(checked),
      "errors": [],
      "valid": true,
    }
  } else {
    progress("❌ Found \{errors} configuration error(s)")
    finish(1, message=problems.join("; "))
  }
}

///|
enum Presentation {
  Text
  Json
}

///|
let presentation : Ref[Presentation] = Ref(Text)

///|
let result_data : Ref[Json] = Ref({})

///|
let operation : Ref[String] = Ref("validate.packages")

///|
/// Only this bounded root prefix is owned. Tail values are encoded for syntax
/// validation only; the original array slice is returned without reconstruction.
fn presentation_arguments(argv : Array[String]) -> Array[String] raise {
  match argv {
    ["--forward-argv", "--", .. raw] => {
      ignore(
        @argparse.Command(
          "validate.packages",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("forward-argv", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--forward-argv", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    ["--json", .. raw] => {
      presentation.val = Json
      ignore(
        @argparse.Command(
          "validate.packages",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("json", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--json", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    _ => argv
  }
}

///|
fn presentation_help() -> @argparse.Command {
  @argparse.Command(
    "validate.packages",
    about="Validate package and module declarations against moon.work JSON results use profile morphir/command-result, contractVersion0.1.0, command, state, exitCode, diagnostics and result on success or error{code,message} on failure. Existing successful JSON schemas remain bare. Stdout is one compact JSON value plus LF; progress and child logs use stderr. Help has result.help and no command effects; supported self-tests report actual completion. Exit0 means success; explicit syntax/child statuses remain meaningful, new expected JSON refusals exit1; default abort behavior is unchanged.",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[
      @argparse.FlagArg(
        "json",
        about="Emit one command result; select at the root before operation data",
      ),
      @argparse.FlagArg(
        "forward-argv",
        about="Only exact --forward-argv -- RAW selects literal forwarding; unwrap once. Other text-mode tails keep their legacy meaning",
      ),
      @argparse.FlagArg("help", short='h', about="Show help without effects"),
    ],
    positionals=[
      @argparse.PositionArg("operation", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn progress(message : String) -> Unit {
  if presentation.val is Json {
    @stdio.stderr.write(message + "\n")
  } else {
    println(message)
  }
}

///|
async fn finish(code : Int32, message~ : String = "Command failed") -> Unit {
  if presentation.val is Json {
    let value : Json = if code == 0 {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "succeeded",
        "exitCode": 0,
        "result": result_data.val,
        "diagnostics": [],
      }
    } else {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "failed",
        "exitCode": code,
        "error": {
          "code": "command-failed",
          "message": if message == "Command failed" {
            "Command exited with status \{code}"
          } else {
            message
          },
        },
        "diagnostics": [],
      }
    }
    @stdio.stdout.write(value.stringify() + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = presentation_arguments(@env.args()[1:].to_owned())
  if presentation.val is Json {
    // Built-in help exits inside argparse. JSON help is an ordinary declared
    // flag in a separate grammar, with no acquisition or command effects.
    let help = Some(
      @argparse.Command(
        "validate.packages",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("help", short='h', required=true)],
      ).parse(argv~, env=Map([])),
    ) catch {
      _ => None
    }
    if help is Some(matches) && matches.flags.get("help") == Some(true) {
      result_data.val = { "help": presentation_help().render_help() }
      operation.val = "validate.packages.help"
      finish(0)
      return
    }
  }
  try {
    command_main(argv)
    finish(0)
  } catch {
    error =>
      if presentation.val is Json {
        @stdio.stderr.write(error.to_string() + "\n")
        finish(1, message=error.to_string())
      } else {
        raise error
      }
  }
}

///|
test "JSON prefix preserves literal tail and unwraps escape only once" {
  let previous = presentation.val
  defer {
    presentation.val = previous
  }
  let raw = [
    "--json", "--", "--forward-argv", "--", "", "λ '$;`", "--help", "--replace",
  ]
  let escaped = presentation_arguments(["--forward-argv", "--", ..raw])
  assert_eq(escaped, raw)
  assert_true(presentation.val is Text)
  let selected = presentation_arguments(["--json", ..raw])
  assert_eq(selected, raw)
  assert_true(presentation.val is Json)
}
