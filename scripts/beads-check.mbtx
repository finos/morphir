----
import {
  "moonbitlang/core/env",
  "moonbitlang/core/argparse",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}
----

// Check that this checkout or worktree uses the bootstrapped shared beads database.
//
// Every worktree must use the database in the main checkout's .beads. Any bd command (the
// SessionStart `bd prime` hook too) creates an empty local database when it finds none, and that
// database then hides the shared one. This check only reads; it never calls a bd command that
// opens the database before it knows that one exists, so it cannot create one.
//
// Run it with `mise run beads:check`, `moonx scripts/beads-check.mbtx` or
// `moon run scripts/beads-check.mbtx`.

///|
async fn fail(message : String, hints : Array[String]) -> Unit {
  let text = StringBuilder()
  text.write_string("beads:check: \{message}\n")
  for hint in hints {
    text.write_string("  \{hint}\n")
  }
  @stdio.stderr.write(text.to_string())
  finish(1, message~)
}

///|
/// Run a command and return its trimmed stdout, or None if it fails. Stderr is discarded, so bd
/// warnings (for example about .beads permissions) do not hide the result.
async fn output(program : String, args : Array[String]) -> String? {
  let (code, stdout, _) = @process.collect_output(program, args)
  if code != 0 {
    return None
  }
  Some(stdout.text().trim().to_owned())
}

///|
/// Resolve symlinks, so that /tmp and /private/tmp (macOS) compare equal.
async fn canonical(path : String) -> String {
  @fs.realpath(path) catch {
    _ => path
  }
}

///|
fn parent(path : String) -> String {
  match path.rev_find("/") {
    Some(index) => path[:index].to_owned()
    None => "."
  }
}

///|
async fn json_field(
  program : String,
  args : Array[String],
  field : String,
) -> Json? {
  guard output(program, args) is Some(text) else { return None }
  let json = @json.parse(text) catch { _ => return None }
  match json {
    Object(fields) => fields.get(field)
    _ => None
  }
}

///|
async fn command_main(_argv : Array[String]) -> Unit {
  guard output("git", ["rev-parse", "--show-toplevel"]) is Some(top) else {
    fail("this is not a git checkout.", [])
    return
  }
  guard output("git", [
      "rev-parse", "--path-format=absolute", "--git-common-dir",
    ])
    is Some(common) else {
    fail("git cannot find the common directory.", [])
    return
  }
  let top = canonical(top)
  let main = canonical(parent(common))
  let main_beads = "\{main}/.beads"

  if !@fs.exists("\{main_beads}/embeddeddolt") {
    fail("the main checkout has no beads database (\{main_beads}).", [
      "Run in the main checkout: cd \"\{main}\" && bd bootstrap --yes",
    ])
  }

  if top != main && @fs.exists("\{top}/.beads/embeddeddolt") {
    fail(
      "this worktree has its own beads database, which hides the shared one.",
      ["Move \{top}/.beads/embeddeddolt aside, then run this check again."],
    )
  }

  let active = match json_field("bd", ["where", "--json"], "path") {
    Some(String(path)) => canonical(path)
    _ => "no database"
  }
  if active != main_beads {
    fail("bd uses \{active}, not \{main_beads}.", [
      "Remove any .beads/redirect or BEADS_DIR that points somewhere else.",
    ])
  }

  let count = match json_field("bd", ["count", "--json"], "count") {
    Some(Number(n, ..)) => n.to_int()
    _ => 0
  }
  if count == 0 {
    fail(
      "the shared beads database is empty, so it was not cloned from the remote.",
      [
        "Move \{main_beads}/embeddeddolt and \{main_beads}/backup aside,",
        "then run in the main checkout: bd bootstrap --yes",
      ],
    )
  }

  progress("beads:check: OK: \{count} issues in \{main_beads}")
  result_data.val = {
    "database": main_beads,
    "issueCount": count,
    "shared": true,
  }
}

///|
enum Presentation {
  Text
  Json
}

///|
let presentation : Ref[Presentation] = Ref(Text)

///|
let result_data : Ref[Json] = Ref({})

///|
let operation : Ref[String] = Ref("beads.check")

///|
/// Only this bounded root prefix is owned. Tail values are encoded for syntax
/// validation only; the original array slice is returned without reconstruction.
fn presentation_arguments(argv : Array[String]) -> Array[String] raise {
  match argv {
    ["--forward-argv", "--", .. raw] => {
      ignore(
        @argparse.Command(
          "beads.check",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("forward-argv", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--forward-argv", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    ["--json", .. raw] => {
      presentation.val = Json
      ignore(
        @argparse.Command(
          "beads.check",
          disable_help_flag=true,
          flags=[@argparse.FlagArg("json", required=true)],
          positionals=[
            @argparse.PositionArg("raw", num_args=@argparse.ValueRange(lower=0)),
          ],
        ).parse(
          argv=["--json", ..raw.map(value => "literal:" + value)],
          env=Map([]),
        ),
      )
      raw.to_owned()
    }
    _ => argv
  }
}

///|
fn presentation_help() -> @argparse.Command {
  @argparse.Command(
    "beads.check",
    about="Check the existing shared beads database without creating one JSON results use profile morphir/command-result, contractVersion0.1.0, command, state, exitCode, diagnostics and result on success or error{code,message} on failure. Existing successful JSON schemas remain bare. Stdout is one compact JSON value plus LF; progress and child logs use stderr. Help has result.help and no command effects; supported self-tests report actual completion. Exit0 means success; explicit syntax/child statuses remain meaningful, new expected JSON refusals exit1; default abort behavior is unchanged.",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[
      @argparse.FlagArg(
        "json",
        about="Emit one command result; select at the root before operation data",
      ),
      @argparse.FlagArg(
        "forward-argv",
        about="Only exact --forward-argv -- RAW selects literal forwarding; unwrap once. Other text-mode tails keep their legacy meaning",
      ),
      @argparse.FlagArg("help", short='h', about="Show help without effects"),
    ],
    positionals=[
      @argparse.PositionArg("operation", num_args=@argparse.ValueRange(lower=0)),
    ],
  )
}

///|
async fn progress(message : String) -> Unit {
  if presentation.val is Json {
    @stdio.stderr.write(message + "\n")
  } else {
    println(message)
  }
}

///|
async fn finish(code : Int32, message~ : String = "Command failed") -> Unit {
  if presentation.val is Json {
    let value : Json = if code == 0 {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "succeeded",
        "exitCode": 0,
        "result": result_data.val,
        "diagnostics": [],
      }
    } else {
      {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": operation.val,
        "state": "failed",
        "exitCode": code,
        "error": {
          "code": "command-failed",
          "message": if message == "Command failed" {
            "Command exited with status \{code}"
          } else {
            message
          },
        },
        "diagnostics": [],
      }
    }
    @stdio.stdout.write(value.stringify() + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = presentation_arguments(@env.args()[1:].to_owned())
  if presentation.val is Json {
    // Built-in help exits inside argparse. JSON help is an ordinary declared
    // flag in a separate grammar, with no acquisition or command effects.
    let help = Some(
      @argparse.Command(
        "beads.check",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("help", short='h', required=true)],
      ).parse(argv~, env=Map([])),
    ) catch {
      _ => None
    }
    if help is Some(matches) && matches.flags.get("help") == Some(true) {
      result_data.val = { "help": presentation_help().render_help() }
      operation.val = "beads.check.help"
      finish(0)
      return
    }
  }
  try {
    command_main(argv)
    finish(0)
  } catch {
    error =>
      if presentation.val is Json {
        @stdio.stderr.write(error.to_string() + "\n")
        finish(1, message=error.to_string())
      } else {
        raise error
      }
  }
}

///|
test "JSON prefix preserves literal tail and unwraps escape only once" {
  let previous = presentation.val
  defer {
    presentation.val = previous
  }
  let raw = [
    "--json", "--", "--forward-argv", "--", "", "λ '$;`", "--help", "--replace",
  ]
  let escaped = presentation_arguments(["--forward-argv", "--", ..raw])
  assert_eq(escaped, raw)
  assert_true(presentation.val is Text)
  let selected = presentation_arguments(["--json", ..raw])
  assert_eq(selected, raw)
  assert_true(presentation.val is Json)
}
