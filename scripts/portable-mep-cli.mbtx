----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}
----

// Primary-CLI acceptance for the saved core-Wasm extension route. The real
// `morphir extension` command dispatches the packaged guest through the pinned
// Node host; the independent shared kit owns the source and consumer verdict.

///|
let host_modules : Array[String] = [
  "node-mep-cli.mjs", "node-mep-stdio.mjs", "node-mep-adapter.mjs", "node-mep-worker.mjs",
  "mep-adapter.mjs", "mep-frames.mjs", "wasm-memory.mjs", "node-artifacts.mjs", "artifacts.mjs",
  "assembly.mjs", "index.mjs", "dist/bridge.mjs",
]

///|
fn sha256(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
async fn digest(path : String) -> String {
  sha256(@fs.read_file(path).binary())
}

///|
fn field(value : Json, name : String) -> Json {
  match value {
    Object(fields) => fields.get(name).unwrap_or(Json::null())
    _ => Json::null()
  }
}

///|
async fn checked(
  program : String,
  args : Array[String],
  cwd~ : String = ".",
) -> String {
  let (code, out, err) = @process.collect_output(program, args, cwd~)
  guard code == 0 else {
    if json_output.val {
      @stdio.stderr.write(out.text() + err.text())
      raise ChildFailed(
        if code > 0 {
          code
        } else {
          1
        },
        "Child process failed: " + program,
      )
    }
    @stdio.stderr.write(out.text() + err.text())
    fail(
      "Portable MEP CLI acceptance failed: " + program + " " + args.join(" "),
    )
  }
  out.text()
}

///|
/// One primary CLI build: the npm launcher or the native executable.
priv struct CliHost {
  name : String
  program : String
  prefix : Array[String]
  controls : Array[String]
}

///|
priv struct Run {
  code : Int32
  report : Json
  stderr : String
}

///|
/// Every invocation uses an owned TMPDIR, which must be empty afterwards: the
/// command removes its session files and the guest wrote nothing of its own.
async fn cli(host : CliHost, scratch : String, args : Array[String]) -> Run {
  let tmp = scratch + "/tmp"
  let (code, out, err) = @process.collect_output(
    host.program,
    host.prefix + ["--json"] + args + host.controls,
    extra_env={ "TMPDIR": tmp },
    cwd=scratch,
  )
  guard @fs.readdir(tmp, include_hidden=true).is_empty() else {
    fail(host.name + " left session files: " + args.join(" "))
  }
  let report = @json.parse(out.text()) catch {
    _ =>
      fail(host.name + " returned no JSON report: " + out.text() + err.text())
  }
  { code, report, stderr: err.text(), }
}

///|
fn expect(
  run : Run,
  code : Int32,
  error : String,
  label : String,
) -> Unit raise {
  let observed = match field(run.report, "error") {
    String(text) => text
    _ => ""
  }
  guard run.code == code && observed.contains(error) else {
    fail(
      label +
      ": expected exit " +
      code.to_string() +
      " and error '" +
      error +
      "', observed " +
      run.code.to_string() +
      " " +
      run.report.stringify() +
      run.stderr,
    )
  }
}

///|
fn expect_completed_session(run : Run, label : String) -> Unit raise {
  expect(run, 0, "", label)
  guard field(run.report, "state") == Json("completed") &&
    field(field(run.report, "lifecycle"), "exitCode") == Json(0) &&
    field(field(run.report, "lifecycle"), "workDirectoryEmpty") == Json(true) else {
    fail(label + ": incomplete lifecycle " + run.report.stringify())
  }
}

///|
async fn write_pin(
  path : String,
  node : String,
  host_root : String,
  artifacts : String,
  binding~ : String = "core-wasm-process",
  wasm~ : String? = None,
) -> Json {
  let modules : Map[String, Json] = Map([])
  for name in host_modules {
    modules[name] = Json::string(digest(host_root + "/" + name))
  }
  let pin : Json = {
    "contractVersion": "0.1.0-draft.1",
    "binding": binding,
    "executionProfile": {
      "id": "morphir/mep-bytes-v1/v1-draft",
      "sha256": "6ed5e96fa9c7f7dcaa179efc88e517307463cfeddc5e2eeae854f0395e7a4ec6",
    },
    "runtime": {
      "name": "node",
      "version": "v24.22.1",
      "executable": node,
      "sha256": digest(node),
    },
    "host": { "root": host_root, "modules": Json::object(modules) },
    "artifact": {
      "directory": artifacts,
      "wasmSha256": wasm.unwrap_or(digest(artifacts + "/model.wasm")),
      "manifestSha256": digest(artifacts + "/manifest.ion"),
    },
    "origin": "local package:mep-extension output qualified by portable-mep-cli.mbtx",
  }
  @fs.write_file(path, pin.stringify() + "\n")
  pin
}

///|
/// The Boolean source comes from the shared kit, unchanged.
fn kit_source(kit : Json) -> (String, String) raise {
  let source = field(kit, "source")
  guard field(field(source, "package"), "name") is String(package_name) &&
    field(field(source, "sources"), "documents") is Array(documents) &&
    documents.length() == 1 &&
    field(documents[0], "text") is String(text) else {
    fail("Shared kit has no single-document source")
  }
  (package_name, text)
}

///|
/// A Morphir JSON envelope around the kit's independent plain IR.
fn json_envelope(kit : Json) -> Json {
  let bytes = @utf8.encode(field(kit, "plainIr").stringify())
  let hash = sha256(bytes)
  {
    "envelopeVersion": "0.1.0-draft.1",
    "modelId": "urn:morphir:mck:bool",
    "revision": "sha256:" + hash,
    "irVersion": "4.0.0",
    "profile": "morphir-ir",
    "payload": {
      "codec": "morphir-json",
      "layout": "single-document",
      "decodedByteLength": bytes.length(),
      "sha256": hash,
      "content": @base64.encode(bytes[:]),
    },
  }
}

///|
async fn expect_artifacts(
  directory : String,
  expected : Json,
  label : String,
) -> Unit {
  guard expected is Object(files) && !files.is_empty() else {
    fail("Shared kit lacks " + label)
  }
  for name, content in files {
    guard content is String(text) &&
      @fs.read_file(directory + "/" + name).text() == text else {
      fail(label + " differs from the shared kit: " + name)
    }
  }
}

///|
/// The shared kit owns consumer source and expected stdout; the pinned
/// compiler builds the exact library returned through the CLI.
async fn consumer(
  root : String,
  scratch : String,
  generated : String,
  kit : Json,
) -> String {
  guard field(field(kit, "consumer"), "files") is Object(files) &&
    field(field(kit, "consumer"), "expectedStdout") is String(expected) else {
    fail("Missing independent consumer fixture")
  }
  let directory = scratch + "/consumer"
  @fs.mkdir(directory)
  for name, content in files {
    guard content is String(text) else { fail("Invalid consumer source") }
    @fs.write_file(directory + "/" + name, text)
  }
  @fs.write_file(
    scratch + "/moon.work",
    "members = " +
    Json([generated, directory, root + "/pkgs/morphir-sdk"]).stringify() +
    "\n",
  )
  let result = checked("moon", [
    "-C", scratch, "run", "--target", "native", "consumer",
  ])
  guard result == expected else {
    fail("Shared consumer expected stdout differs")
  }
  result
}

///|
async fn exercise(
  root : String,
  evidence : String,
  host : CliHost,
  kit : Json,
  pins : Map[String, String],
) -> Json {
  let scratch = evidence + "/" + host.name
  @fs.mkdir(scratch)
  @fs.mkdir(scratch + "/tmp")
  @fs.mkdir(scratch + "/src")
  let (package_name, text) = kit_source(kit)
  @fs.write_file(scratch + "/src/main.mbt", text)
  @fs.write_file(scratch + "/src/broken.mbt", "pub fn {")
  @fs.write_file(
    scratch + "/json-envelope.json",
    json_envelope(kit).stringify(),
  )
  let pin = pins.get("valid").unwrap()
  let cases : Array[Json] = []
  let record = fn(name : String, run : Run) {
    cases.push({
      "case": name,
      "exitCode": run.code,
      "state": field(run.report, "state"),
      "error": field(run.report, "error"),
    })
  }
  let compile = fn(source : String, output : String, extra : Array[String]) {
    [
      "extension", "compile", source, "--extension-pin", pin, "--package", package_name,
      "--output", output,
    ] +
    extra
  }
  // Discovery: identity, claims and truthful runtime access.
  let described = cli(host, scratch, [
    "extension", "describe", "--extension-pin", pin,
  ])
  expect_completed_session(described, "describe")
  guard field(field(described.report, "extension"), "id") ==
    Json("morphir-moonbit") &&
    field(
      field(field(described.report, "result"), "capabilities"),
      "cancellation",
    ) ==
    Json(false) &&
    field(field(described.report, "access"), "wireCancellation") == Json(false) else {
    fail("describe claims differ: " + described.report.stringify())
  }
  record("describe", described)
  // Guest-level refusals keep exact diagnostics and publish nothing.
  let lossy = cli(
    host,
    scratch,
    compile("src/main.mbt", "lossy", ["--model-format", "json"]),
  )
  expect(lossy, 1, "extension.operation_unsuccessful", "lossy JSON compile")
  guard field(lossy.report, "result")
    .stringify()
    .contains("data.lossy_conversion") &&
    !@fs.exists(scratch + "/lossy") else {
    fail("JSON compile did not refuse lossy conversion explicitly")
  }
  record("compile-json-lossy-refusal", lossy)
  let broken = cli(host, scratch, compile("src/broken.mbt", "broken", []))
  expect(broken, 1, "extension.operation_unsuccessful", "malformed source")
  guard !@fs.exists(scratch + "/broken") else {
    fail("Failed compilation published output")
  }
  record("compile-malformed-source", broken)
  let retired = cli(
    host,
    scratch,
    compile("src/main.mbt", "retired", [
      "--frontend-profile", "moonbit-model-bool-library-v1",
    ]),
  )
  expect(retired, 1, "extension.operation_unsuccessful", "retired profile")
  guard field(retired.report, "result")
    .stringify()
    .contains("moonbit_frontend.unsupported_profile") else {
    fail("Retired profile was not refused by the guest")
  }
  record("compile-retired-profile", retired)
  // A fresh session after those failures compiles and generates end to end.
  let compiled = cli(host, scratch, compile("src/main.mbt", "model", []))
  expect_completed_session(compiled, "compile")
  guard field(field(field(compiled.report, "negotiated"), "tuple"), "codec") ==
    Json("ion-binary") &&
    field(field(compiled.report, "lifecycle"), "shutdown") ==
    Json("acknowledged") else {
    fail("compile did not negotiate the Ion tuple")
  }
  record("compile-ion", compiled)
  let generated = cli(host, scratch, [
    "extension", "generate", "model/model-envelope.json", "--extension-pin", pin,
    "--output", "generated",
  ])
  expect_completed_session(generated, "generate")
  guard @fs.read_file(scratch + "/generated/mep/source-model.ionb").binary() ==
    @fs.read_file(scratch + "/model/model.ionb").binary() else {
    fail("Generation did not retain the exact Ion model bytes")
  }
  record("generate-ion-retained", generated)
  let result = consumer(root, scratch, scratch + "/generated", kit)
  // Supported Morphir JSON generation matches the kit's expected artifacts.
  let json = cli(host, scratch, [
    "extension", "generate", "json-envelope.json", "--extension-pin", pin, "--output",
    "json-generated",
  ])
  expect_completed_session(json, "generate JSON")
  expect_artifacts(
    scratch + "/json-generated",
    field(kit, "expectedJsonArtifacts"),
    "JSON generation",
  )
  record("generate-json", json)
  // Integrity: the guest refuses a payload whose digest does not match.
  let envelope = @fs.read_file(scratch + "/model/model-envelope.json").text()
  let digest_text = match
    field(field(@json.parse(envelope), "payload"), "sha256") {
    String(text) => text
    _ => fail("Missing payload digest")
  }
  @fs.write_file(
    scratch + "/tampered.json",
    envelope.replace(old=digest_text, new="0".repeat(64)),
  )
  let tampered = cli(host, scratch, [
    "extension", "generate", "tampered.json", "--extension-pin", pin, "--output",
    "tampered",
  ])
  guard tampered.code == 1 && !@fs.exists(scratch + "/tampered") else {
    fail("Tampered model was not refused: " + tampered.report.stringify())
  }
  record("generate-digest-refusal", tampered)
  // Local refusals happen before any process starts.
  @fs.write_file(
    scratch + "/mixed.json",
    envelope.replace(
      old="\"profile\":\"morphir-model\"",
      new="\"profile\":\"morphir-ir\"",
    ),
  )
  let mixed = cli(host, scratch, [
    "extension", "generate", "mixed.json", "--extension-pin", pin, "--output", "mixed",
  ])
  expect(mixed, 2, "extension.unsupported_model_tuple", "mixed tuple")
  record("generate-unsupported-tuple", mixed)
  let exists = cli(host, scratch, compile("src/main.mbt", "model", []))
  expect(exists, 2, "extension.output_exists", "existing output")
  record("existing-output-refusal", exists)
  for
    (name, error) in [
      ("wrong-wasm", "extension.identity_mismatch"),
      ("component", "extension.unsupported_binding"),
    ] {
    let refused = cli(host, scratch, [
      "extension",
      "describe",
      "--extension-pin",
      pins.get(name).unwrap(),
    ])
    expect(refused, 2, error, name)
    record("pin-" + name, refused)
  }
  @fs.write_file(scratch + "/cancel", "")
  let cancelled = cli(host, scratch, [
    "extension", "describe", "--extension-pin", pin, "--cancel-file", "cancel",
  ])
  expect(cancelled, 130, "execution.cancelled", "cancel file")
  record("cancelled", cancelled)
  let deadline = cli(host, scratch, [
    "extension", "describe", "--extension-pin", pin, "--timeout", "1",
  ])
  expect(deadline, 124, "execution.deadline", "deadline")
  record("deadline", deadline)
  {
    "host": host.name,
    "cases": Json::array(cases),
    "consumerResult": result,
    "modelSha256": digest(scratch + "/model/model.ionb"),
    "librarySha256": digest(scratch + "/generated/library.mbt"),
  }
}

///|
async fn execute() -> Json {
  guard @env.get_env_var("MORPHIR_MEP_KIT") is Some(kit_path) &&
    @env.get_env_var("MORPHIR_MEP_KIT_SHA256") is Some(kit_digest) else {
    fail(
      "Set MORPHIR_MEP_KIT and MORPHIR_MEP_KIT_SHA256 to the shared guest kit",
    )
  }
  let kit_path = @fs.realpath(kit_path)
  guard digest(kit_path) == kit_digest else {
    fail("Shared kit does not match its SHA-256 pin")
  }
  let kit = @json.parse(@fs.read_file(kit_path).text())
  let root = @fs.realpath(".")
  let artifacts = @fs.realpath(
    @env.get_env_var("MORPHIR_MEP_ARTIFACTS").unwrap_or(".dev/portable-mep") +
    "/extension",
  )
  let evidence = @env.get_env_var("MORPHIR_MEP_CLI_EVIDENCE").unwrap_or(
    ".dev/portable-mep-cli",
  )
  guard !@fs.exists(evidence) else {
    fail("Choose a new CLI evidence directory to preserve earlier results")
  }
  let compiler = checked("moon", ["version", "--all"])
  guard compiler.contains("0.10.18+6c83a7f62") else {
    fail("Pinned MoonBit 0.10.18 is required")
  }
  let node = @fs.realpath(
    checked("node", ["-p", "process.execPath"]).trim().to_owned(),
  )
  guard checked(node, ["--version"]).trim() == "v24.22.1" else {
    fail("Node 24.22.1 is required")
  }
  // Build every host byte first; the pin is taken over the final outputs.
  ignore(
    checked("bun", ["run", "--cwd", "pkgs/morphir-host/embedding", "build"]),
  )
  ignore(checked("bun", ["run", "--cwd", "apps/morphir", "build"]))
  ignore(
    checked("moon", ["build", "apps/morphir", "--target", "native", "--release"]),
  )
  @fs.mkdir(evidence, recursive=true)
  let evidence = @fs.realpath(evidence)
  let host_root = root + "/pkgs/morphir-host/embedding"
  let pin = write_pin(evidence + "/pin.json", node, host_root, artifacts)
  ignore(
    write_pin(
      evidence + "/pin-wrong-wasm.json",
      node,
      host_root,
      artifacts,
      wasm=Some("0".repeat(64)),
    ),
  )
  ignore(
    write_pin(
      evidence + "/pin-component.json",
      node,
      host_root,
      artifacts,
      binding="component-model",
    ),
  )
  let pins : Map[String, String] = {
    "valid": evidence + "/pin.json",
    "wrong-wasm": evidence + "/pin-wrong-wasm.json",
    "component": evidence + "/pin-component.json",
  }
  let launcher = root + "/apps/morphir/bin/morphir.js"
  let native = root + "/_build/native/release/build/morphir/morphir/morphir.exe"
  let helper = root + "/apps/morphir/build-provider/extension.mjs"
  let identities : Json = {
    "launcher": digest(launcher),
    "compiledCli": digest(root + "/apps/morphir/dist/morphir.js"),
    "nativeCli": digest(native),
    "helper": digest(helper),
    "supervision": digest(root + "/apps/morphir/build-provider/supervision.mjs"),
    "identity": digest(root + "/apps/morphir/build-provider/identity.mjs"),
  }
  let hosts = [
    { name: "js", program: node, prefix: [launcher], controls: [], },
    {
      name: "native",
      program: native,
      prefix: [],
      controls: ["--extension-helper", helper, "--node", node],
    },
  ]
  let results : Array[Json] = []
  for host in hosts {
    results.push(exercise(root, evidence, host, kit, pins))
  }
  // The same pinned bytes produced the same model and library on both hosts.
  guard field(results[0], "modelSha256") == field(results[1], "modelSha256") &&
    field(results[0], "librarySha256") == field(results[1], "librarySha256") else {
    fail("JS and native CLI hosts returned different results")
  }
  guard write_pin(evidence + "/pin-after.json", node, host_root, artifacts) ==
    pin &&
    digest(kit_path) == kit_digest else {
    fail("Pinned inputs changed during qualification")
  }
  @fs.remove(evidence + "/pin-after.json")
  let receipt : Json = {
    "scope": "primary MoonBit CLI explicit-fixture extension route; installed bundle selection is separate",
    "route": "core-wasm-process: saved core Wasm guest in the pinned Node process host; not a Component Model binding",
    "sourceRevision": checked("git", ["rev-parse", "HEAD"]).trim().to_owned(),
    "sourceDirty": checked("git", ["status", "--porcelain"]).trim() != "",
    "compiler": compiler,
    "kitSha256": kit_digest,
    "pin": pin,
    "cli": identities,
    "hosts": Json::array(results),
  }
  @fs.write_file(
    evidence + "/receipt.ion",
    "portable_mep_cli::" + receipt.stringify() + "\n",
  )
  (if json_output.val { @stdio.stderr } else { @stdio.stdout }).write(
    "Primary CLI extension route passed on JS and native hosts with the shared consumer" +
    "\n",
  )
  receipt
}

///|
let json_output : Ref[Bool] = Ref(false)

///|
suberror CommandFailure {
  ChildFailed(Int32, String)
}

///|
fn legacy_command() -> @argparse.Command {
  @argparse.Command(
    "portable-mep-cli.mbtx",
    about="Run the saved MEP guest through the primary MoonBit CLI extension command",
  )
}

///|
fn json_command() -> @argparse.Command {
  @argparse.Command(
    "portable-mep-cli.mbtx",
    about="Run the saved MEP guest through the primary MoonBit CLI extension command. Leading --json selects JSON mode. JSON emits one compact morphir/command-result 0.1.0 value plus LF on stdout after completion; progress goes to stderr. Success has result and diagnostics; failure has error.code/message and exitCode matching process status. Expected refusals and legacy child-failure branches exit 1; error.message retains the child status. Default abort presentation is unchanged. Result fields scope, route, sourceRevision, sourceDirty, compiler, kitSha256, pin, cli and hosts describe completed primary CLI acceptance. A leading -- protects a literal --json in legacy argv.",
    disable_help_flag=true,
    disable_help_subcommand=true,
    subcommands=[
      @argparse.Command(
        "help",
        disable_help_flag=true,
        disable_help_subcommand=true,
        flags=[@argparse.FlagArg("help", short='h')],
      ),
    ],
    flags=[
      @argparse.FlagArg("json", about="Emit the completed command result"),
      @argparse.FlagArg(
        "help",
        short='h',
        about="Return render_help without effects",
      ),
    ],
  )
}

///|
fn wants_json(argv : ArrayView[String]) -> Bool {
  // Only the leading control is reserved. The library owns its syntax; all
  // other legacy argv stays untouched, including literal --json after --.
  let prefix = argv[:if argv.is_empty() { 0 } else { 1 }]
  let matches = @argparse.Command(
    "portable-mep-cli.mbtx",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[@argparse.FlagArg("json", required=true)],
  ).parse(argv=prefix) catch {
    _ => return false
  }
  matches.flags.get_or_default("json", false)
}

///|
fn success(result : Json) -> Json {
  {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "portable.mep.cli",
    "state": "succeeded",
    "exitCode": 0,
    "result": result,
    "diagnostics": [],
  }
}

///|
async fn main {
  let argv = @env.args()[1:]
  json_output.val = wants_json(argv)
  if !json_output.val {
    ignore(
      @argparse.Command(
        "portable-mep-cli.mbtx",
        about="Run the saved MEP guest through the primary MoonBit CLI extension command",
      ).parse(argv=@env.args()[1:], env=Map([])),
    ) catch {
      error => fail(error.to_string())
    }
    ignore(execute())
    return
  }
  let result : Json = try {
    let matches = json_command().parse(argv~)
    if matches.flags.get_or_default("help", false) ||
      matches.subcommand is Some(_) {
      {
        "render_help": legacy_command().render_help(),
        "json_help": json_command().render_help(),
      }
    } else {
      execute()
    }
  } catch {
    error => {
      let (code, message, kind) = match error {
        ChildFailed(code, message) =>
          (
            1,
            message + " (child exit " + code.to_string() + ")",
            "child.failed",
          )
        _ => (1, error.to_string(), "command.failed")
      }
      let failure : Json = {
        "profile": "morphir/command-result",
        "contractVersion": "0.1.0",
        "command": "portable.mep.cli",
        "state": "failed",
        "exitCode": code,
        "error": { "code": kind, "message": message },
        "diagnostics": [],
      }
      @stdio.stdout.write(failure.stringify() + "\n")
      @sys.exit(code)
      return
    }
  }
  @stdio.stdout.write(success(result).stringify() + "\n")
}
