///|
import {
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/process",
  "moonbitlang/async@0.22.1/stdio",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn main {
  // These development gates consume portable provider modules on a fresh checkout.
  let (runtime_status, _, runtime_error) = @process.collect_output("bun", [
    "run", "build:runtimes",
  ])
  guard runtime_status == 0 else {
    fail("Runtime JavaScript build failed: " + runtime_error.text())
  }

  let code = @process.run(
    "node",
    ["apps/morphir/scripts/test-moonbit-frontend.ts"],
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if code != 0 {
    @sys.exit(if code > 0 { code } else { 1 })
  }
}
