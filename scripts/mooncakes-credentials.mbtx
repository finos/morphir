----
import {
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/percent",
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/http",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/path",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
#derive(Eq)
struct Scope(String)

///|
fn Scope::parse(text : String) -> Scope raise {
  if text.is_empty() ||
    text.length() > 128 ||
    !text
    .iter()
    .all(c => {
      (c >= 'a' && c <= 'z') ||
      (c >= 'A' && c <= 'Z') ||
      (c >= '0' && c <= '9') ||
      c == '-' ||
      c == '_' ||
      c == '.'
    }) {
    raise Failure(
      "Scope must contain 1 to 128 ASCII letters, digits, dots, underscores or hyphens",
    )
  }
  Scope(text)
}

///|
fn join(directory : String, name : String) -> String {
  @path.Path(directory).join(@path.Path(name)).0
}

///|
fn checksum(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
fn credential_json(token : String) -> Json raise {
  if token.trim().is_empty() {
    raise Failure("MOONCAKES_TOKEN must be nonempty")
  }
  // Moon's username is local login metadata. The registry enforces token
  // authority when publishing under finos; whoami does not authenticate it.
  {
    "token": token,
    "username": "finos",
    "registry_api": "https://mooncakes.io",
  }
}

///|
fn is_finos_account(status : Int32, value : Json) -> Bool {
  guard value is Object(fields) else { return false }
  status == 200 &&
  fields.get("ok") == Some(Json(true)) &&
  fields.get("username") == Some(Json("finos"))
}

///|
async fn check_account(token : String) -> Bool {
  // This is the same read-only check endpoint used by the pinned Mooncake
  // login implementation. It accepts token as a query parameter. Keep the
  // URL inside this process and never render request or response exceptions.
  @async.with_timeout(15000, () => {
    let (response, body) = @http.get(
      "https://mooncakes.io/api/v0/api_token/check?token=" +
      @percent.encode(token),
    )
    is_finos_account(response.code, @json.parse(body.text()))
  })
}

///|
fn marker_json(scope : Scope, bytes : Bytes) -> Json {
  {
    "profile": "morphir/mooncakes-credential-owner",
    "contractVersion": "0.1.0",
    "scope": scope.0,
    "sha256": checksum(bytes),
  }
}

///|
fn owns(marker : Json, scope : Scope, bytes : Bytes?) -> Bool {
  guard marker is Object(fields) else { return false }
  fields.get("profile") == Some(Json("morphir/mooncakes-credential-owner")) &&
  fields.get("contractVersion") == Some(Json("0.1.0")) &&
  fields.get("scope") == Some(Json(scope.0)) &&
  (match bytes {
    Some(bytes) => fields.get("sha256") == Some(Json(checksum(bytes)))
    None => true
  })
}

///|
enum Created {
  Marker
  Both
}

///|
async fn setup(
  directory : String,
  scope : Scope,
  token : String,
  account_check : async (String) -> Bool,
  whoami : async () -> Bool,
) -> Unit {
  let credentials = join(directory, "credentials.json")
  let marker = join(directory, ".morphir-release-credential-owner.json")
  let bytes = @utf8.encode(credential_json(token).stringify() + "\n")
  if !account_check(token) {
    raise Failure("Mooncakes token must authenticate as finos")
  }
  // Both writes use CreateNew. A preexisting login is never overwritten.
  let marker_file = @fs.open(
    marker,
    mode=WriteOnly,
    create_mode=CreateNew,
    permission=0o600,
  )
  let mut created = Marker
  errdefer {
    if created is Both {
      @fs.remove(credentials)
    }
    @fs.remove(marker)
  }
  defer marker_file.close()
  marker_file.write(marker_json(scope, bytes).stringify() + "\n")
  marker_file.sync()
  marker_file.close()
  let credential_file = @fs.open(
    credentials,
    mode=WriteOnly,
    create_mode=CreateNew,
    permission=0o600,
  )
  created = Both
  defer credential_file.close()
  credential_file.write(bytes)
  credential_file.sync()
  credential_file.close()
  if !whoami() {
    raise Failure("Moon did not report the finos login")
  }
}

///|
async fn clean(directory : String, scope : Scope) -> Bool {
  let credentials = join(directory, "credentials.json")
  let marker = join(directory, ".morphir-release-credential-owner.json")
  if !@fs.exists(marker) {
    return false
  }
  if @fs.kind(marker, follow_symlink=false) != Regular {
    raise Failure("Credential ownership marker must be a regular file")
  }
  let value = @json.parse(@fs.read_file(marker).text()) catch {
    _ => raise Failure("Invalid credential ownership marker")
  }
  let bytes = if @fs.exists(credentials) {
    if @fs.kind(credentials, follow_symlink=false) != Regular {
      raise Failure("Credential file must be a regular file")
    }
    Some(@fs.read_file(credentials).binary())
  } else {
    None
  }
  if !owns(value, scope, bytes) {
    raise Failure("Credentials belong to another scope or changed since setup")
  }
  if bytes is Some(_) {
    @fs.remove(credentials)
  }
  @fs.remove(marker)
  true
}

///|
async fn prepare_home(base : String, source : String, scope : Scope) -> String {
  let base = @fs.realpath(base)
  let source = @fs.realpath(source)
  if @fs.exists(join(source, "credentials.json")) ||
    @fs.exists(join(source, ".morphir-release-credential-owner.json")) ||
    @fs.exists(join(source, ".morphir-release-home.json")) {
    raise Failure(
      "Private release home requires a compiler installation without credentials or another private-home marker",
    )
  }
  let directory = join(base, "morphir-mooncakes-" + scope.0)
  @fs.mkdir(directory, permission=0o700)
  errdefer @fs.rmdir(directory, recursive=true)
  for name in ["bin", "lib", "include", "share"] {
    let original = join(source, name)
    if @fs.exists(original) {
      @fs.symlink(target=original, join(directory, name))
    } else if name != "share" {
      raise Failure("Pinned compiler layout is incomplete")
    }
  }
  let marker : Json = {
    "profile": "morphir/mooncakes-private-home",
    "contractVersion": "0.1.0",
    "scope": scope.0,
    "compilerHome": source,
  }
  @fs.write_file(
    join(directory, ".morphir-release-home.json"),
    marker.stringify() + "\n",
    create_mode=CreateNew,
    permission=0o600,
  )
  directory
}

///|
async fn dispose_home(base : String, scope : Scope) -> Bool {
  let base = @fs.realpath(base)
  let directory = join(base, "morphir-mooncakes-" + scope.0)
  if !@fs.exists(directory) {
    return false
  }
  if @fs.kind(directory, follow_symlink=false) != Directory {
    raise Failure("Private Moon home must be an owned directory")
  }
  let file = join(directory, ".morphir-release-home.json")
  if @fs.kind(file, follow_symlink=false) != Regular {
    raise Failure("Private Moon home has no regular ownership marker")
  }
  guard @json.parse(@fs.read_file(file).text()) is Object(fields) &&
    fields.get("profile") == Some(Json("morphir/mooncakes-private-home")) &&
    fields.get("contractVersion") == Some(Json("0.1.0")) &&
    fields.get("scope") == Some(Json(scope.0)) else {
    raise Failure("Private Moon home belongs to another scope")
  }
  // async/fs removes directory symlinks themselves. It must never follow the
  // compiler links and delete the shared installation.
  @fs.rmdir(directory, recursive=true)
  true
}

///|
async test "private home keeps credentials outside compiler cache and disposal preserves compiler links" {
  let base = @fs.tmpdir(prefix="morphir private home ")
  defer @fs.rmdir(base, recursive=true)
  let source = join(base, "cached-compiler")
  @fs.mkdir(source)
  for name in ["bin", "lib", "include", "share"] {
    @fs.mkdir(join(source, name))
    @fs.write_file(join(join(source, name), "keep.txt"), "compiler content")
  }
  let scope = Scope::parse("private-test")
  let directory = prepare_home(base, source, scope)
  setup(directory, scope, "test-only-token", _ => true, () => true)
  assert_true(@fs.exists(join(directory, "credentials.json")))
  assert_false(@fs.exists(join(source, "credentials.json")))
  assert_false(
    @fs.exists(join(source, ".morphir-release-credential-owner.json")),
  )
  assert_false(@fs.exists(join(directory, "registry")))
  assert_false(@fs.exists(join(directory, "cache")))
  @fs.write_file(join(directory, "credentials.json"), "changed job credential")
  assert_true(dispose_home(base, scope))
  assert_false(dispose_home(base, scope))
  for name in ["bin", "lib", "include", "share"] {
    assert_eq(
      @fs.read_file(join(join(source, name), "keep.txt")).text(),
      "compiler content",
    )
  }
}

///|
async test "private home refuses existing directories and mismatched ownership" {
  let base = @fs.tmpdir(prefix="morphir private ownership ")
  defer @fs.rmdir(base, recursive=true)
  let scope = Scope::parse("existing")
  let directory = join(base, "morphir-mooncakes-existing")
  @fs.mkdir(directory)
  @fs.write_file(join(directory, "keep.txt"), "unrelated")
  let create_refused = try {
    ignore(prepare_home(base, base, scope))
    false
  } catch {
    _ => true
  }
  assert_true(create_refused)
  let delete_refused = try {
    ignore(dispose_home(base, scope))
    false
  } catch {
    _ => true
  }
  assert_true(delete_refused)
  assert_eq(@fs.read_file(join(directory, "keep.txt")).text(), "unrelated")
}

///|
fn cli() -> @argparse.Command {
  @argparse.Command(
    "mooncakes-credentials.mbtx",
    disable_help_flag=true,
    disable_help_subcommand=true,
    disable_version_flag=true,
    about="Prepare a private release Moon home, create or remove its Mooncakes login, and dispose the owned home. Prepare uses RUNNER_TEMP and --scope, links only compiler bin/lib/include/share from active MOON_HOME, tests the compiler and appends MOON_HOME to GITHUB_ENV when present. It never links registry, cache or credentials. Dispose removes only its marked private directory and does not follow compiler symlinks. These environment commands qualify the Linux publisher; symlink privileges are required. Setup and clean use the active MOON_HOME, otherwise HOME/.moon. Setup alone reads MOONCAKES_TOKEN, JSON-escapes it and uses exclusive mode-0600 writes. It refuses existing files. Clean only removes unchanged files owned by the supplied scope. Setup first verifies the token account with the registry read-only check endpoint, then verifies local finos login metadata with Moon whoami. Authentication errors are never retried. --json emits one morphir/command-result 0.1.0 document on stdout with state, exitCode, diagnostics and result or error{code,message}. No child output or secret is emitted. Help has no file or credential effects. Syntax exits 2; validation or effects exit 1.",
    flags=[
      @argparse.FlagArg("json", global=true),
      @argparse.FlagArg("help", short='h', global=true),
    ],
    subcommands=["setup", "clean", "prepare", "dispose"].map(name => {
      @argparse.Command(
        name,
        disable_help_flag=true,
        disable_help_subcommand=true,
        disable_version_flag=true,
        flags=[@argparse.FlagArg("help", short='h', global=true)],
        options=[@argparse.OptionArg("scope")],
        groups=[
          @argparse.ArgGroup("scope-or-help", required=true, multiple=true, args=[
            "scope", "help",
          ]),
        ],
      )
    }),
  )
}

///|
fn wants_json(argv : Array[String]) -> Bool {
  let probe = @argparse.Command(
    "presentation",
    disable_help_flag=true,
    disable_help_subcommand=true,
    flags=[@argparse.FlagArg("json")],
    positionals=[
      @argparse.PositionArg(
        "opaque",
        allow_hyphen_values=true,
        num_args=@argparse.ValueRange(lower=0),
      ),
    ],
  )
  let parsed = probe.parse(argv~, env=Map([])) catch { _ => return false }
  parsed.flags.get_or_default("json", false)
}

///|
async fn emit(
  name : String,
  json_mode : Bool,
  code : Int32,
  result : Json,
  message? : String,
) -> Unit {
  let fields : Map[String, Json] = {
    "profile": "morphir/command-result",
    "contractVersion": "0.1.0",
    "command": "release.credentials." + name,
    "state": if code == 0 {
      "succeeded"
    } else {
      "failed"
    },
    "exitCode": code,
    "diagnostics": [],
  }
  if message is Some(message) {
    fields["error"] = {
      "code": if code == 2 {
        "invalid_arguments"
      } else {
        "credentials_refused"
      },
      "message": message,
    }
  } else {
    fields["result"] = result
  }
  if json_mode {
    @stdio.stdout.write(Json(fields).stringify() + "\n")
  } else if message is Some(message) {
    @stdio.stderr.write(message + "\n")
  } else {
    @stdio.stdout.write(result.stringify(indent=2) + "\n")
  }
  if code != 0 {
    @sys.exit(code)
  }
}

///|
async fn main {
  let argv = @env.args()[1:].to_owned()
  let json_mode = wants_json(argv)
  let parsed = cli().parse(argv~, env=Map([])) catch {
    error => {
      emit("mooncakes", json_mode, 2, Json::null(), message=error.to_string())
      return
    }
  }
  let (name, args) = parsed.subcommand.unwrap_or(("help", parsed))
  if parsed.subcommand is None ||
    parsed.flags.get_or_default("help", false) ||
    args.flags.get_or_default("help", false) {
    emit(name, json_mode, 0, { "help": cli().render_help() })
    return
  }
  let result : Json = try {
    let scope = Scope::parse(args.values["scope"][0])
    if name == "dispose" {
      let base = @env.get_env_var("RUNNER_TEMP").unwrap_or("")
      if base.is_empty() {
        raise Failure("RUNNER_TEMP is required")
      }
      let removed = dispose_home(base, scope)
      emit(name, json_mode, 0, { "removed": removed, "scope": scope.0 })
      return
    }
    let directory = match @env.get_env_var("MOON_HOME") {
      Some(value) if !value.is_empty() => value
      _ =>
        match @env.get_env_var("HOME") {
          Some(value) if !value.is_empty() => join(value, ".moon")
          _ => raise Failure("Moon home is unavailable")
        }
    }
    let directory = @fs.realpath(directory)
    if name == "prepare" {
      let base = @env.get_env_var("RUNNER_TEMP").unwrap_or("")
      if base.is_empty() {
        raise Failure("RUNNER_TEMP is required")
      }
      let private_home = prepare_home(base, directory, scope)
      errdefer @async.protect_from_cancel(() => {
        ignore(dispose_home(base, scope))
      })
      if private_home.contains("\n") || private_home.contains("\r") {
        raise Failure("Private Moon home cannot contain line separators")
      }
      let (code, _, _) = @process.collect_output(
        "moon",
        ["version", "--all", "--json"],
        extra_env={ "MOON_HOME": private_home },
      )
      if code != 0 {
        raise Failure("Private Moon home could not run the compiler")
      }
      if @env.get_env_var("GITHUB_ENV") is Some(file) && !file.is_empty() {
        @fs.write_file(
          file,
          "MOON_HOME=" + private_home + "\n",
          create_mode=OpenExisting,
          append=true,
        )
      }
      emit(name, json_mode, 0, {
        "path": private_home,
        "compilerHome": directory,
        "scope": scope.0,
      })
      return
    } else if name == "setup" {
      let token = @env.get_env_var("MOONCAKES_TOKEN").unwrap_or("")
      setup(directory, scope, token, check_account, () => {
        let (status, output, _) = @process.collect_output("moon", ["whoami"])
        status == 0 && output.text().trim() == "Logged in as finos"
      })
      { "configured": true, "owner": "finos", "scope": scope.0 }
    } else {
      { "removed": clean(directory, scope), "scope": scope.0 }
    }
  } catch {
    // Underlying JSON, process and I/O exceptions can contain secret data.
    // This boundary deliberately emits a fixed diagnostic.
    _ => {
      emit(
        name,
        json_mode,
        1,
        Json::null(),
        message="Credential operation refused; check the scope, active Moon home and setup ownership. Existing or changed credentials are preserved.",
      )
      return
    }
  }
  emit(name, json_mode, 0, result)
}

///|
test "credential encoding preserves special token characters without disclosure" {
  let token = "test-only-\"\\\nsecret"
  let value = credential_json(token)
  assert_eq(@json.parse(value.stringify()), value)
  guard value is Object(fields) else { fail("Expected credential object") }
  assert_eq(fields.get("token"), Some(Json(token)))
  let bytes = @utf8.encode(value.stringify())
  let marker = marker_json(Scope::parse("job-1.2"), bytes).stringify()
  assert_false(marker.contains(token))
  assert_false(owns(@json.parse(marker), Scope::parse("other"), Some(bytes)))
  assert_false(
    owns(@json.parse(marker), Scope::parse("job-1.2"), Some(b"changed")),
  )
}

///|
async test "setup and idempotent cleanup only own exclusive unchanged credentials" {
  let directory = @fs.tmpdir(prefix="morphir credentials test ")
  defer @fs.rmdir(directory, recursive=true)
  let scope = Scope::parse("test-1")
  let credentials = join(directory, "credentials.json")
  setup(directory, scope, "test-only-token", _ => true, () => true)
  assert_true(@fs.exists(credentials))
  let wrong_scope = try {
    ignore(clean(directory, Scope::parse("other")))
    false
  } catch {
    _ => true
  }
  assert_true(wrong_scope)
  assert_true(@fs.exists(credentials))
  assert_true(clean(directory, scope))
  assert_false(clean(directory, scope))
  @fs.write_file(credentials, "existing user login")
  let refused = try {
    setup(directory, scope, "test-only-token", _ => true, () => true)
    false
  } catch {
    _ => true
  }
  assert_true(refused)
  assert_eq(@fs.read_file(credentials).text(), "existing user login")
  assert_false(
    @fs.exists(join(directory, ".morphir-release-credential-owner.json")),
  )
}

///|
async test "failed local login check rolls back only this setup" {
  let directory = @fs.tmpdir(prefix="morphir credentials failure ")
  defer @fs.rmdir(directory, recursive=true)
  let scope = Scope::parse("test-2")
  let refused = try {
    setup(directory, scope, "test-only-token", _ => true, () => false)
    false
  } catch {
    _ => true
  }
  assert_true(refused)
  assert_false(@fs.exists(join(directory, "credentials.json")))
  assert_false(clean(directory, scope))
}

///|
async test "changed credentials are preserved for inspection" {
  let directory = @fs.tmpdir(prefix="morphir credentials changed ")
  defer @fs.rmdir(directory, recursive=true)
  let scope = Scope::parse("test-3")
  setup(directory, scope, "test-only-token", _ => true, () => true)
  @fs.write_file(join(directory, "credentials.json"), "changed login")
  let refused = try {
    ignore(clean(directory, scope))
    false
  } catch {
    _ => true
  }
  assert_true(refused)
  assert_eq(
    @fs.read_file(join(directory, "credentials.json")).text(),
    "changed login",
  )
}

///|
async test "empty and wrong-account tokens never create files or retry authentication" {
  let directory = @fs.tmpdir(prefix="morphir credentials account ")
  defer @fs.rmdir(directory, recursive=true)
  let mut account_calls = 0
  let mut whoami_calls = 0
  for token in ["", "test-only-other-account"] {
    let refused = try {
      setup(
        directory,
        Scope::parse("account-test"),
        token,
        _ => {
          account_calls += 1
          false
        },
        () => {
          whoami_calls += 1
          true
        },
      )
      false
    } catch {
      _ => true
    }
    assert_true(refused)
    assert_false(@fs.exists(join(directory, "credentials.json")))
    assert_false(
      @fs.exists(join(directory, ".morphir-release-credential-owner.json")),
    )
  }
  assert_eq(account_calls, 1)
  assert_eq(whoami_calls, 0)
  assert_true(is_finos_account(200, { "ok": true, "username": "finos" }))
  assert_false(is_finos_account(401, { "ok": true, "username": "finos" }))
  assert_false(is_finos_account(200, { "ok": false, "username": Json::null() }))
  assert_false(is_finos_account(200, { "ok": true, "username": "other" }))
  assert_false(is_finos_account(200, { "username": "finos" }))
}

///|
async test "JSON help syntax and empty-token failures preserve channels and status" {
  let script = @fs.realpath("mooncakes-credentials.mbtx")
  for
    (args, expected) in [
      (["--json", "--help"], 0),
      (["setup", "--json", "--help"], 0),
      (["clean", "--help", "--json"], 0),
      (["setup", "--json"], 2),
      (["clean", "--unknown", "--json"], 2),
      (["setup", "--scope", "test-empty-token", "--json"], 1),
    ] {
    let (code, output, stderr) = @process.collect_output(
      "moonx",
      [script, ..args],
      extra_env={ "MOONCAKES_TOKEN": "" },
    )
    assert_eq(code, expected, msg=stderr.text())
    guard @json.parse(output.text()) is Object(fields) else {
      fail("Expected JSON result")
    }
    assert_eq(fields.get("exitCode"), Some(Json(expected)))
    assert_eq(
      fields.get("state"),
      Some(Json(if expected == 0 { "succeeded" } else { "failed" })),
    )
    assert_false(output.text().contains("test-only"))
    assert_false(stderr.text().contains("test-only"))
  }
}
