    {
      "id": "union-0001",
      "description": "Compact Union preserves existing member types.",
      "input": {
        "operation": "wireDecode",
        "wire": {
          "Union": [
            "morphir/SDK:string#string",
            "morphir/SDK:basics#int"
          ]
        }
      },
      "expected": {
        "outcome": "accepted",
        "canonical": {
          "Union": [
            "morphir/SDK:string#string",
            "morphir/SDK:basics#int"
          ]
        },
        "node": "Union"
      }
    },
    {
      "id": "union-0002",
      "description": "Expanded empty attributes canonicalize to compact Union.",
      "input": {
        "operation": "wireDecode",
        "wire": {
          "Union": {
            "attributes": {},
            "alternatives": [
              "morphir/SDK:string#string",
              "morphir/SDK:basics#int"
            ]
          }
        }
      },
      "expected": {
        "outcome": "accepted",
        "canonical": {
          "Union": [
            "morphir/SDK:string#string",
            "morphir/SDK:basics#int"
          ]
        }
      }
    },
    {
      "id": "union-0003",
