      "input": {
        "operation": "wireDecode",
        "wire": {
          "Union": {
            "attributes": {
              "source": {
                "startLine": 1,
                "startColumn": 1,
                "endLine": 1,
                "endColumn": 20
              },
              "extensions": {
                "example/union:provenance#note": "preserve union"
              }
            },
            "alternatives": [
              {
                "Reference": {
                  "attributes": {
                    "extensions": {
                      "example/union:provenance#note": "first member"
                    }
                  },
                  "fqname": "morphir/SDK:string#string",
                  "args": []
                }
              },
              "morphir/SDK:basics#int"
            ]
          }
        }
      },
      "expected": {
        "outcome": "accepted",
        "canonical": {
          "Union": {
            "attributes": {
              "source": {
                "startLine": 1,
                "startColumn": 1,
                "endLine": 1,
                "endColumn": 20
              },
              "extensions": {
                "example/union:provenance#note": "preserve union"
              }
            },
            "alternatives": [
              {
