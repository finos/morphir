                    }
                  },
                  "fqname": "morphir/SDK:string#string",
                  "args": []
                }
              },
              "morphir/SDK:basics#int"
            ]
          }
        },
        "preserve": [
          "order",
          "attributes",
          "member-attributes"
        ]
      }
