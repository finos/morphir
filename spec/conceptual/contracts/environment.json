          }
        ],
        "result": "string"
      },
      "requirementRefs": [],
      "clauses": [
        "shout-post"
      ]
    }
  },
  "clauses": {
    "quantity-nonnegative": {
      "id": "urn:example:contracts:clause:quantity-nonnegative",
      "kind": "refinement",
      "subjectType": "quantity",
      "binders": [
        {
          "name": "self",
          "role": "self",
          "type": "int"
        }
      ],
      "text": "self >= 0",
      "expression": {
        "gte": [
          {
            "binder": "self"
          },
          {
            "int": "0"
          }
        ]
      },
      "modelClauseRef": "urn:example:clause:quantity"
    },
    "interval-ordered": {
      "id": "urn:example:contracts:clause:interval-ordered",
      "kind": "invariant",
      "subjectType": "interval",
      "binders": [
        {
          "name": "self",
          "role": "self",
          "type": "interval"
        }
      ],
      "text": "self.lower <= self.upper",
      "expression": {
        "lte": [
          {
            "field": [
              {
                "binder": "self"
              },
              "lower"
            ]
          },
          {
            "field": [
              {
                "binder": "self"
              },
              "upper"
            ]
          }
        ]
      },
      "modelClauseRef": "urn:example:clause:interval"
    },
    "return-balance": {
      "id": "urn:example:contracts:clause:return-balance",
      "kind": "postcondition",
      "contract": "acceptReturn",
      "binders": [
        {
          "name": "loan",
          "role": "argument",
          "position": 0,
          "type": "loan"
        },
        {
          "name": "returned",
          "role": "argument",
          "position": 1,
          "type": "quantity"
        },
        {
          "name": "result",
          "role": "result",
          "type": "returnResult"
        }
      ],
      "text": "an Ok result reduces the outstanding quantity by the returned quantity; the balance clause makes no claim about an OverReturn result",
      "expression": {
        "match": [
          {
            "binder": "result"
          },
          {
            "Ok": {
              "equal": [
                {
                  "field": [
                    {
                      "binder": "resultValue"
                    },
                    "outstanding"
                  ]
                },
                {
                  "subtract": [
                    {
                      "field": [
                        {
                          "binder": "loan"
                        },
                        "outstanding"
                      ]
                    },
                    {
                      "binder": "returned"
                    }
                  ]
                }
              ]
            },
            "OverReturn": {
              "bool": true
            }
          }
        ]
      },
      "matchBinder": {
        "name": "resultValue",
        "role": "constructor-payload",
        "type": "loan"
      }
    },
    "return-rejection": {
      "id": "urn:example:contracts:clause:return-rejection",
      "kind": "postcondition",
      "contract": "acceptReturn",
      "binders": [
        {
          "name": "loan",
          "role": "argument",
          "position": 0,
          "type": "loan"
        },
        {
          "name": "returned",
          "role": "argument",
          "position": 1,
          "type": "quantity"
        },
        {
          "name": "result",
          "role": "result",
          "type": "returnResult"
        }
      ],
      "text": "a return larger than the outstanding quantity is rejected as OverReturn, and only then",
      "expression": {
        "match": [
          {
            "binder": "result"
          },
          {
            "Ok": {
              "lte": [
                {
                  "binder": "returned"
                },
                {
                  "field": [
                    {
                      "binder": "loan"
                    },
                    "outstanding"
                  ]
                }
              ]
            },
            "OverReturn": {
              "gt": [
                {
                  "binder": "returned"
                },
                {
                  "field": [
                    {
                      "binder": "loan"
                    },
                    "outstanding"
                  ]
                }
              ]
            }
          }
        ]
      },
      "matchBinder": {
        "name": "resultValue",
        "role": "constructor-payload",
        "type": "loan"
      }
    },
    "return-frame": {
      "id": "urn:example:contracts:clause:return-frame",
      "kind": "frame",
      "contract": "acceptReturn",
      "binders": [
        {
          "name": "loan",
          "role": "argument",
          "position": 0,
          "type": "loan"
        },
        {
          "name": "returned",
          "role": "argument",
          "position": 1,
          "type": "quantity"
        },
        {
          "name": "result",
          "role": "result",
          "type": "returnResult"
        }
      ],
      "text": "an Ok result preserves the loan id and asset; no other field is implicitly preserved",
      "expression": {
        "match": [
          {
            "binder": "result"
          },
          {
            "Ok": {
              "and": [
                {
                  "equal": [
                    {
                      "field": [
                        {
                          "binder": "resultValue"
                        },
                        "id"
                      ]
                    },
                    {
                      "field": [
                        {
                          "binder": "loan"
                        },
                        "id"
                      ]
                    }
                  ]
                },
                {
                  "equal": [
                    {
                      "field": [
                        {
                          "binder": "resultValue"
                        },
                        "asset"
                      ]
                    },
                    {
                      "field": [
                        {
                          "binder": "loan"
                        },
                        "asset"
                      ]
                    }
                  ]
                }
              ]
            },
            "OverReturn": {
              "bool": true
            }
          }
        ]
      },
      "matchBinder": {
        "name": "resultValue",
        "role": "constructor-payload",
        "type": "loan"
      }
    },
    "remaining-pre": {
      "id": "urn:example:contracts:clause:remaining-pre",
      "kind": "precondition",
      "contract": "remaining",
      "binders": [
        {
          "name": "outstanding",
          "role": "argument",
          "position": 0,
          "type": "int"
        },
        {
          "name": "returned",
          "role": "argument",
          "position": 1,
          "type": "int"
        }
      ],
      "text": "returned <= outstanding",
      "expression": {
        "lte": [
          {
            "binder": "returned"
          },
          {
            "binder": "outstanding"
          }
        ]
      },
      "modelClauseRef": "urn:example:clause:remaining-pre"
    },
    "remaining-post": {
      "id": "urn:example:contracts:clause:remaining-post",
      "kind": "postcondition",
      "contract": "remaining",
      "binders": [
        {
          "name": "outstanding",
          "role": "argument",
          "position": 0,
          "type": "int"
        },
        {
          "name": "returned",
          "role": "argument",
          "position": 1,
          "type": "int"
        },
        {
          "name": "result",
          "role": "result",
          "type": "int"
        }
      ],
      "text": "result == outstanding - returned",
      "expression": {
        "equal": [
          {
            "binder": "result"
          },
          {
            "subtract": [
              {
                "binder": "outstanding"
              },
              {
                "binder": "returned"
              }
            ]
          }
        ]
      },
      "modelClauseRef": "urn:example:clause:remaining-post"
    },
    "label-pre": {
      "id": "urn:example:contracts:clause:label-pre",
      "kind": "precondition",
      "contract": "requireLabel",
      "binders": [
        {
          "name": "name",
          "role": "argument",
          "position": 0,
          "type": "string"
        }
      ],
      "text": "the name is not empty",
      "expression": {
        "stringNotEmpty": [
          {
            "binder": "name"
          }
        ]
      }
    },
    "label-post": {
      "id": "urn:example:contracts:clause:label-post",
      "kind": "postcondition",
      "contract": "requireLabel",
      "binders": [
        {
          "name": "name",
          "role": "argument",
          "position": 0,
          "type": "string"
        },
        {
          "name": "result",
          "role": "result",
          "type": "string"
        }
      ],
      "text": "result == name",
      "expression": {
        "equal": [
          {
            "binder": "result"
          },
          {
            "binder": "name"
          }
        ]
      }
    },
    "float-post": {
      "id": "urn:example:contracts:clause:float-post",
      "kind": "postcondition",
      "contract": "floatRemaining",
      "expressionProfile": "morphir-contracts/expressions/float/0.1.0-draft.1",
      "binders": [
        {
          "name": "outstanding",
          "role": "argument",
          "position": 0,
          "type": "float"
        },
        {
          "name": "returned",
          "role": "argument",
          "position": 1,
          "type": "float"
        },
        {
          "name": "result",
          "role": "result",
          "type": "float"
        }
      ],
      "text": "result == outstanding - returned, under a floating-point profile this draft does not support",
      "expression": {
        "equal": [
          {
            "binder": "result"
          },
          {
            "subtract": [
              {
                "binder": "outstanding"
              },
              {
                "binder": "returned"
              }
            ]
          }
        ]
      }
    },
    "shout-post": {
      "id": "urn:example:contracts:clause:shout-post",
      "kind": "postcondition",
      "contract": "shout",
      "binders": [
        {
          "name": "name",
          "role": "argument",
          "position": 0,
          "type": "string"
        },
        {
          "name": "result",
          "role": "result",
          "type": "string"
        }
      ],
      "text": "result is the upper-case form of name, under a foreign call this profile does not evaluate",
      "expression": {
        "call": [
          "urn:example:foreign#upper",
          {
            "binder": "name"
          }
        ]
      }
    }
  },
  "supportedProfiles": [
