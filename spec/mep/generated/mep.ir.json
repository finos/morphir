                "method": {
                  "Public": {
                    "doc": "A MEP method. The wire value is the JSON-RPC 2.0 `method` string:\n\n| Constructor         | Wire value                       |\n| ------------------- | -------------------------------- |\n| `Initialize`        | `morphir.initialize`             |\n| `Describe`          | `morphir.extension.describe`     |\n| `Initialized`       | `morphir.initialized`            |\n| `Ping`              | `morphir.ping`                   |\n| `Info`              | `morphir.extension.info`         |\n| `Capabilities`      | `morphir.extension.capabilities` |\n| `Compile`           | `morphir.frontend.compile`       |\n| `Generate`          | `morphir.backend.generate`       |\n| `Validate`          | `morphir.validator.validate`     |\n| `Transform`         | `morphir.transform.transform`    |\n| `WorkspaceDiscover` | `morphir.workspace.discover`     |\n| `Shutdown`          | `morphir.shutdown`               |\n| `Exit`              | `morphir.exit`                   |\n\n`morphir.initialized` and `morphir.exit` are notifications: they carry no\nrequest id and get no response. All other methods are requests.",
                    "CustomTypeDefinition": {
                      "typeParams": [],
                      "access": "Public",
                      "constructors": {
                        "initialize": [],
                        "describe": [],
                        "initialized": [],
                        "ping": [],
                        "info": [],
                        "capabilities": [],
                        "compile": [],
                        "generate": [],
                        "validate": [],
                        "transform": [],
                        "workspace-discover": [],
                        "shutdown": [],
                        "exit": []
                      }
                    }
                  }
                },
                "error-code": {
                  "Public": {
                    "doc": "An error code in a JSON-RPC 2.0 error object. The wire value is the\ninteger code:\n\n| Constructor               | Code   |\n| ------------------------- | ------ |\n| `ParseError`              | -32700 |\n| `InvalidRequest`          | -32600 |\n| `MethodNotFound`          | -32601 |\n| `InvalidParams`           | -32602 |\n| `InternalError`           | -32603 |\n| `ExtensionError`          | -32000 |\n| `CompilationError`        | -32001 |\n| `GenerationError`         | -32002 |\n| `ValidationError`         | -32003 |\n| `TransformationError`     | -32004 |\n| `ExtensionFailure`        | -32010 |\n| `ProtocolVersionMismatch` | -32011 |\n| `PermissionDenied`        | -32012 |\n| `CapabilityUnavailable`   | -32013 |\n| `NotInitialized`          | -32014 |\n\nThe first five are the JSON-RPC 2.0 standard codes. The others are MEP\ncodes in the server-defined range, -32000 to -32099.",
                    "CustomTypeDefinition": {
                      "typeParams": [],
                      "access": "Public",
                      "constructors": {
                        "parse-error": [],
                        "invalid-request": [],
                        "method-not-found": [],
                        "invalid-params": [],
                        "internal-error": [],
                        "extension-error": [],
                        "compilation-error": [],
                        "generation-error": [],
                        "validation-error": [],
                        "transformation-error": [],
                        "extension-failure": [],
                        "protocol-version-mismatch": [],
                        "permission-denied": [],
                        "capability-unavailable": [],
                        "not-initialized": []
                      }
                    }
                  }
                },
                "rpc-error": {
                  "Public": {
                    "doc": "The JSON-RPC 2.0 error object. `code` is an `ErrorCode` value or a\nJSON-RPC 2.0 standard code. `data` is left out of the message when absent.",
                    "CustomTypeDefinition": {
                      "typeParams": [],
                      "access": "Public",
                      "constructors": {
                        "rpc-error": [
                          [
                            "code",
                            {
