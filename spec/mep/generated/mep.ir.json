                        "invalid-request": [],
                        "method-not-found": [],
                        "invalid-params": [],
                        "internal-error": [],
                        "extension-error": [],
                        "compilation-error": [],
                        "generation-error": [],
                        "validation-error": [],
                        "transformation-error": [],
                        "extension-failure": [],
                        "protocol-version-mismatch": [],
                        "permission-denied": [],
                        "capability-unavailable": [],
                        "not-initialized": []
                      }
                    }
