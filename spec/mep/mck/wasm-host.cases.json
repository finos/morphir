	"cases": [
		{
			"caseId": "classification/unknown-namespace",
			"module": "env-open-socket",
			"declaredAbi": "extism-kernel-v1",
			"tests": {
				"requirements": ["Classification before instantiation"],
				"scenarios": ["Import from an unknown namespace"],
				"contract": ["refusal:extension.abi_unsupported"]
			},
			"runs": [
				{
					"frames": ["initialize"],
					"expect": {
						"exitCode": 3,
						"stdoutBytes": 0,
						"events": [{ "event": "refused", "code": "extension.abi_unsupported", "messageIncludes": ["open_socket"] }],
						"noEvents": ["fault"]
					}
				}
			],
			"gaps": [
				"The contract says the refusal names the import but not how, so the message must contain only open_socket.",
				"The contract does not say how a runner observes that the module was not instantiated; exit status 3 with no fault is the observable part."
			]
		},
