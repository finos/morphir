	"assembler": { "package": "wabt", "version": "1.0.39", "features": ["threads", "memory64", "multi_memory"] },
	"deadlineMarginSeconds": 2,
	"conventions": {
		"expectations": "Every expectation is written by hand from the profile contract and the profile spec. None is recorded from a host run.",
		"worker": "Each run starts a new worker process: <host> extension worker --module <wasm> --json, with --abi <declaredAbi> when the case declares one, and --request-bytes and --response-bytes from the case's worker limits.",
		"frames": "A run writes its frames in order, each as a Content-Length framed message whose body is the UTF-8 of the frame's value serialized compactly with members in the order written. After the last frame, stdin stays open until the worker exits.",
		"exitCode": "The worker's exit status: 0 served until exit; 1 a fault, an invalid frame, or stdin ended before exit; 2 bad arguments; 3 a refusal before any request. Absent means not constrained.",
		"stdout": "stdoutBytes is the byte count of all of stdout. stdoutFrames lists every frame on stdout, in order. A frame matches when its body parses to a JSON value equal to json, or equal to the body of the run's frame sameAsFrame, or satisfying every pointers entry (an RFC 6901 pointer with equals, a JSON value, or type, a JSON type name).",
		"events": "events lists stderr events that must appear in this order, possibly among others. A matcher names the event and may fix abi (started), code and messageIncludes (refused; each string must occur in error.message) or kind (fault; absent means any kind). noEvents names events that must not appear. eventText lists strings that some stderr line must contain. Every started event's moduleSha256 must equal the module's sha256.",
		"guestOutput": "guestOutput lists strings that must occur, in order, in the text of the run's output events joined in their order.",
		"timing": "withinSeconds.range is measured from the end of the write of the run's last frame to the first fault event (until: fault) or to the worker's exit (until: exit).",
		"alternatives": "A run with alternatives uses the one whose when matches what the started event's bounds declare for that bound.",
		"bounds": "A case's bounds are the bounds it exercises. When the host declares one of them not enforced, the case is recorded as not_enforced, not as passed or failed.",
		"gaps": "A case's gaps say what the contract leaves open about the observation; the expectation stops there."
	},
	"frames": {
		"initialize": { "jsonrpc": "2.0", "id": 1, "method": "morphir.initialize", "params": { "protocolVersion": "0.2.0-draft.1" } },
		"initialize-id-4": { "jsonrpc": "2.0", "id": 4, "method": "morphir.initialize", "params": { "protocolVersion": "0.2.0-draft.1" } },
		"initialized": { "jsonrpc": "2.0", "method": "morphir.initialized", "params": {} },
		"shutdown": { "jsonrpc": "2.0", "id": 2, "method": "morphir.shutdown" },
		"exit": { "jsonrpc": "2.0", "method": "morphir.exit" }
	},
