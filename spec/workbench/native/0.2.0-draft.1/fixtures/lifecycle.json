        {
          "type": "trusted_context",
          "window": "other",
          "origin": "app",
          "page": "page-X"
        },
        {
          "type": "call",
          "operation": "session.open"
        },
        {
          "type": "expect",
          "assertions": [
            "Reject with unauthorized and effect none.",
            "No session, grant, capture, or worker is created."
          ]
        },
        {
          "type": "trusted_context",
          "window": "main",
          "origin": "remote",
          "page": "page-X"
        },
        {
          "type": "call",
          "operation": "session.open"
        },
        {
          "type": "expect",
          "assertions": [
            "Reject with unauthorized and effect none even if payload claims a bundled origin."
          ]
        },
        {
          "type": "trusted_context",
          "window": "main",
          "origin": "app",
          "page": null
        },
        {
          "type": "call",
          "operation": "session.open"
        },
        {
          "type": "expect",
          "assertions": [
            "Reject with unauthorized and effect none; a missing trusted page identity cannot open a session."
          ]
        }
      ]
    },
