{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/native/0.2.0-draft.1/descriptor.schema.json",
  "title": "Native Workbench session descriptor",
  "description": "Exact page-bound native capabilities. Trusted caller identity and nested session equality require runtime validation",
  "examples": [
    {
      "profile": "morphir/workbench/native",
      "contractVersion": "0.2.0-draft.1",
      "sessionId": "native-session",
      "operations": [ "workspace" ]
    }
  ],
  "type": "object",
  "if": {
    "properties": {
      "operations": {
        "contains": {
          "const": "executions"
        }
      }
    }
  },
  "then": {
    "required": [ "offer" ]
  },
  "else": {
    "not": {
      "required": [ "offer" ]
    }
  },
  "required": [ "profile", "contractVersion", "sessionId", "operations" ],
  "properties": {
    "profile": {
      "const": "morphir/workbench/native"
    },
    "contractVersion": {
      "const": "0.2.0-draft.1"
    },
    "sessionId": {
      "type": "string",
      "not": {
        "pattern": "[^A-Za-z0-9_.-]"
      },
      "maxLength": 128,
      "minLength": 1
    },
    "operations": {
      "enum": [
        [],
        [ "executions" ],
        [ "workspace" ],
        [ "executions", "workspace" ]
      ]
    },
    "offer": {
      "$ref": "https://morphir.finos.org/spec/workbench/executions/0.2.0-draft.1/offer.schema.json"
    }
  },
  "additionalProperties": false
}
