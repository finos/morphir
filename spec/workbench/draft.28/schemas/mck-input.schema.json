              },
              "state": {
                "enum": [ "held", "success", "failure" ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [ "action", "connection", "prefix", "size" ],
            "properties": {
              "action": {
                "const": "raw-sized"
              },
              "connection": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "prefix": {
                "type": "string",
                "maxLength": 16384,
                "minLength": 1
              },
              "size": {
