            "properties": {
              "action": {
                "const": "generate"
              },
              "connection": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "generation": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "params": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "action",
              "connection",
              "generation",
              "requestId",
              "params"
            ],
            "properties": {
              "action": {
                "const": "start-generate"
              },
              "connection": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "generation": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "params": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [ "action", "connection", "generation" ],
            "properties": {
              "action": {
                "const": "receive-generate"
              },
              "connection": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "generation": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "action",
              "connection",
              "generation",
              "artifactIndex",
              "requestId",
              "offset",
              "maxBytes"
            ],
            "properties": {
              "action": {
                "const": "read"
              },
              "connection": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "generation": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "artifactIndex": {
                "type": "integer",
                "maximum": 255,
                "minimum": 0
              },
              "requestId": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              },
              "offset": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              },
              "maxBytes": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "action",
              "connection",
              "generation",
              "artifactIndex",
              "maxBytes"
            ],
            "properties": {
              "action": {
                "const": "read-all"
              },
              "connection": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "generation": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "artifactIndex": {
                "type": "integer",
                "maximum": 255,
                "minimum": 0
              },
              "maxBytes": {
                "type": "integer",
                "maximum": 65536,
                "minimum": 1
