              "connection": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "generation": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "requestId": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [ "action", "connection", "frame" ],
            "properties": {
              "action": {
                "const": "raw"
              },
              "connection": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "frame": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [ "action", "connection" ],
            "properties": {
              "action": {
