{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.28/mck-capabilities.schema.json",
  "title": "Artifact transfer mck-capabilities",
  "description": "Exact separately scoped artifact-server and artifact-client evidence. Semantic byte, work, authority and lifecycle rules are normative in README.html.",
  "examples": [
    {
      "suite": "workbench",
      "contractVersion": "0.1.0-draft.28",
      "binding": "example-rust-artifact-host",
      "language": "rust",
      "operations": [
        "artifact-server"
      ],
      "formats": [
        "json"
      ]
    }
  ],
  "type": "object",
  "required": [
    "suite",
    "contractVersion",
    "binding",
    "language",
    "operations",
    "formats"
  ],
  "properties": {
    "suite": {
      "const": "workbench"
    },
    "contractVersion": {
      "const": "0.1.0-draft.28"
    },
    "binding": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "language": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "artifact-server",
          "artifact-client"
        ]
      }
    },
    "formats": {
      "const": [
        "json"
      ]
    }
  },
  "additionalProperties": false
}
