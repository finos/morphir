{
  "target": "https://morphir.finos.org/spec/workbench/model-originals/0.1.0-draft.1/capture-params.schema.json",
  "tests": [
    {
      "description": "Independent literal shape from the approved49-case proposal",
      "data": {
        "contractVersion": "0.1.0-draft.1",
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders"
        },
        "projectId": "[\"provider-A\",\"workspace:orders\",\"packages/orders\"]",
        "scope": "complete",
        "semantic": "projection"
      },
      "valid": true
    },
    {
      "description": "An unlisted member cannot add authority",
      "data": {
        "contractVersion": "0.1.0-draft.1",
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders"
        },
        "projectId": "[\"provider-A\",\"workspace:orders\",\"packages/orders\"]",
        "scope": "complete",
        "semantic": "projection",
        "unexpected": true
      },
      "valid": false
    },
    {
      "description": "Exact wire contract does not accept another draft",
      "data": {
        "contractVersion": "0.1.0-draft.2",
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders"
        },
        "projectId": "[\"provider-A\",\"workspace:orders\",\"packages/orders\"]",
        "scope": "complete",
        "semantic": "projection"
      },
      "valid": false
    },
    {
      "description": "Contract version is required",
      "data": {
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders"
        },
        "projectId": "[\"provider-A\",\"workspace:orders\",\"packages/orders\"]",
        "scope": "complete",
        "semantic": "projection"
      },
      "valid": false
    },
    {
      "description": "Caller companion paths cannot authorize reads",
      "data": {
        "contractVersion": "0.1.0-draft.1",
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders"
        },
        "projectId": "[\"provider-A\",\"workspace:orders\",\"packages/orders\"]",
        "scope": "complete",
        "semantic": "projection",
        "companions": [
          "outside"
        ]
      },
      "valid": false
    },
    {
      "description": "Source identity is closed",
      "data": {
        "contractVersion": "0.1.0-draft.1",
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders",
          "path": "/private"
        },
        "projectId": "[\"provider-A\",\"workspace:orders\",\"packages/orders\"]",
        "scope": "complete",
        "semantic": "projection"
      },
      "valid": false
    }
  ]
}
