    {
      "id": "connected-inventory-single-file-json-v3",
      "requirement": "OR-4",
      "materialization": "requires-valid-storage-layout-byte-inventory-before-MCK-freeze",
      "input": {
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders",
          "displayName": "Orders"
        },
        "projectPath": "packages/orders",
        "compileDescriptor": {
          "layout": "single-file",
          "format": "json",
          "version": "v3",
          "path": "model.json"
        },
        "inventoryIncludes": [
          "compile.json",
          "all-selected-root-files",
          {
            "path": "notes/opaque-sidecar.bin",
            "byteLength": 256,
            "sha256": "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880"
          }
        ],
        "snapshot": "same-confined-compile-lock"
      },
      "expected": {
        "original": {
          "kind": "retained-inventory",
          "entrySet": "exact-selected-root-files-plus-record",
          "unknownSidecars": "byte-identical",
          "allEntryDigests": "match-independent-input"
        },
        "layout": "single-file",
        "format": "json",
        "sourceVersion": "v3",
        "semanticVersion": "4.0.0",
        "provenance": "compiled-inventory",
        "v1MethodChanged": false
      }
    },
