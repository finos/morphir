{
  "kind": "independently-authored-contract-scenarios",
  "wireOrMckSchema": false,
  "adapterExecuted": false,
  "cases": [
    {
      "id": "identity-provider-separation",
      "requirement": "ID-1",
      "materialization": "fixed",
      "input": {
        "sources": [
          {
            "providerId": "provider-A",
            "locator": "workspace:orders",
            "displayName": "Orders"
          },
          {
            "providerId": "provider-B",
            "locator": "workspace:orders",
            "displayName": "Orders"
          }
        ],
        "projects": [
          {
            "source": {
              "providerId": "provider-A",
              "locator": "workspace:orders",
              "displayName": "Orders"
            },
            "path": "packages/orders",
            "name": "Orders"
          },
          {
            "source": {
              "providerId": "provider-B",
              "locator": "workspace:orders",
              "displayName": "Orders"
            },
            "path": "packages/orders",
            "name": "Orders"
          }
        ]
      },
      "expected": {
        "sourceKeys": [
          "[\"provider-A\",\"workspace:orders\"]",
          "[\"provider-B\",\"workspace:orders\"]"
        ],
        "projectKeys": [
          "[\"provider-A\",\"workspace:orders\",\"packages/orders\"]",
          "[\"provider-B\",\"workspace:orders\",\"packages/orders\"]"
        ],
        "distinct": true,
        "hostAuthority": "none"
      }
    },
    {
      "id": "identity-label-and-persistence-do-not-rekey",
      "requirement": "ID-1",
      "materialization": "fixed",
      "input": {
        "first": {
          "providerId": "provider-A",
          "locator": "workspace:orders",
          "displayName": "Orders"
        },
        "second": {
          "providerId": "provider-A",
          "locator": "workspace:orders",
          "displayName": "Renamed",
          "persistence": "session"
        }
      },
      "expected": {
        "sourceKey": "[\"provider-A\",\"workspace:orders\"]",
        "sameLocation": true,
        "doesNotProveSameRevision": true
      }
    },
    {
      "id": "identity-same-name-distinct-project-paths",
      "requirement": "ID-2",
      "materialization": "fixed",
      "input": {
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders",
          "displayName": "Orders"
        },
        "projects": [
          {
            "name": "Orders",
            "relativePath": "a"
          },
          {
            "name": "Orders",
            "relativePath": "b"
          }
        ]
      },
      "expected": {
        "projectKeys": [
          "[\"provider-A\",\"workspace:orders\",\"a\"]",
          "[\"provider-A\",\"workspace:orders\",\"b\"]"
        ],
        "distinct": true
      }
    },
    {
      "id": "identity-reopened-location-has-new-local-opening",
      "requirement": "ID-3",
      "materialization": "fixed",
      "input": {
        "source": {
          "providerId": "provider-A",
          "locator": "workspace:orders",
          "displayName": "Orders"
        },
        "actions": [
          "open-A",
          "close-A",
          "open-A-again"
        ]
      },
      "expected": {
        "locationEqual": true,
        "openingEqual": false,
        "oldReplyAdopted": false,
        "oldBackEntryRestored": false,
        "hostAuthority": "none"
      }
    },
