                "status": "pending"
              }
            }
          ],
          "cleanup": null,
          "extensions": null
        },
        "failure": null
      },
      "valid": false
    },
    {
      "description": "Completion refusal retains captured boundary",
      "data": {
        "mode": "validate-completion",
        "policy": "permissive",
        "runtime": "scheme",
        "boundary": "{\"definitions\":[],\"entries\":[]}",
        "outcomes": null,
        "failure": {
          "stage": "complete",
          "code": "execution.call_identity"
