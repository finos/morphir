  "tests": [
    {
      "description": "Closed valid infrastructure",
      "data": {
        "mode": "execute",
        "policy": "permissive",
        "runtime": "scheme",
        "boundary": "{\"definitions\":[],\"entries\":[]}",
        "outcomes": {
          "contractVersion": "0.1.0-draft.5",
          "calls": [
            {
              "id": "first",
              "outcome": {
                "status": "returned",
                "value": {
                  "type": "int",
                  "value": "42"
                }
              }
            }
          ],
          "cleanup": null,
          "extensions": null
        },
        "failure": null
      },
      "valid": true
    },
    {
      "description": "Reject extra top-level field",
      "data": {
        "mode": "execute",
        "policy": "permissive",
        "runtime": "scheme",
        "boundary": "{\"definitions\":[],\"entries\":[]}",
        "outcomes": {
          "contractVersion": "0.1.0-draft.5",
          "calls": [
            {
              "id": "first",
              "outcome": {
                "status": "returned",
                "value": {
                  "type": "int",
                  "value": "42"
                }
              }
            }
          ],
          "cleanup": null,
          "extensions": null
        },
        "failure": null,
        "unexpected": true
      },
      "valid": false
    },
    {
      "description": "Reject nonterminal production result",
      "data": {
        "mode": "execute",
        "policy": "permissive",
        "runtime": "scheme",
        "boundary": "{\"definitions\":[],\"entries\":[]}",
        "outcomes": {
          "contractVersion": "0.1.0-draft.5",
          "calls": [
            {
