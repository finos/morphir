          "const": "scheme"
        },
        "boundary": {
          "type": "string",
          "maxLength": 1048576,
          "minLength": 1
        },
        "outcomes": {
          "type": "null"
        },
        "failure": {
          "type": "object",
          "required": [ "stage", "code" ],
          "properties": {
            "stage": {
              "const": "complete"
            },
            "code": {
              "type": "string",
