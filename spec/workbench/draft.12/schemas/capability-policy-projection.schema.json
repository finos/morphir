{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.12/capability-policy-projection.schema.json",
  "title": "Runtime capability policy capability-policy-projection",
  "description": "Closed capability-policy infrastructure and captured selected-context evidence",
  "examples": [
    {
      "mode": "execute",
      "policy": "permissive",
      "runtime": "scheme",
      "boundary": "{\"definitions\":[],\"entries\":[]}",
      "outcomes": {
        "contractVersion": "0.1.0-draft.5",
        "calls": [
          {
            "id": "first",
            "outcome": {
              "status": "returned",
              "value": {
                "type": "int",
                "value": "42"
              }
            }
          }
        ],
        "cleanup": null,
        "extensions": null
      },
      "failure": null
    }
  ],
  "oneOf": [
