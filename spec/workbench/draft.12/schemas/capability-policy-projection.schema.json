        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "mode",
        "policy",
        "runtime",
        "boundary",
        "outcomes",
        "failure"
      ],
      "properties": {
        "mode": {
          "enum": [ "execute", "validate-completion" ]
        },
        "policy": {
          "enum": [ "strict", "permissive" ]
        },
        "runtime": {
          "const": "scheme"
        },
        "boundary": {
          "type": "null"
        },
        "outcomes": {
          "type": "null"
        },
        "failure": {
          "type": "object",
          "required": [ "stage", "code" ],
          "properties": {
            "stage": {
              "enum": [ "decode", "plan" ]
            },
            "code": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
