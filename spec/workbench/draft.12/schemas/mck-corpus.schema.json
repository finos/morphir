{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.12/mck-corpus.schema.json",
  "title": "Runtime capability policy mck-corpus",
  "description": "Exact capability-policy execution and captured-context completion verification; no host, job, provider, UI or platform qualification",
  "examples": [
    {
      "formatVersion": "0.1.0-draft.12",
      "cases": [
        {
          "id": "fixed-first",
          "operation": "run-capability-policy",
          "format": "json",
          "input": {
            "model": "opaque complete model source",
            "calls": [
              {
                "id": "first",
                "entry": "selected:main#answer",
                "inputs": {
                  "format": "json",
                  "source": "[]"
                }
              }
            ],
            "runtime": "scheme",
            "extensions": null
          },
          "expected": {
            "status": "ok",
            "value": {
              "mode": "execute",
              "policy": "permissive",
              "runtime": "scheme",
              "boundary": "{\"definitions\":[],\"entries\":[]}",
              "outcomes": {
                "contractVersion": "0.1.0-draft.5",
                "calls": [
                  {
                    "id": "first",
                    "outcome": {
                      "status": "returned",
                      "value": {
                        "type": "int",
                        "value": "42"
                      }
                    }
                  }
                ],
                "cleanup": null,
                "extensions": null
              },
              "failure": null
            }
          }
        }
      ]
    }
  ],
  "type": "object",
  "required": [ "formatVersion", "cases" ],
  "properties": {
    "formatVersion": {
      "const": "0.1.0-draft.12"
    },
    "cases": {
      "type": "array",
      "maxItems": 1024,
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [ "id", "operation", "format", "input", "expected" ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "operation": {
            "const": "run-capability-policy"
          },
          "format": {
            "const": "json"
          },
          "input": {
            "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.12/mck-input.schema.json"
          },
          "expected": {
            "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.12/mck-observation.schema.json"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
