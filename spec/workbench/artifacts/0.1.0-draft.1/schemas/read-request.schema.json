{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/artifacts/0.1.0-draft.1/read-request.schema.json",
  "title": "Artifact read request",
  "description": "Exact negotiated artifact transfer draft; complete semantic rules and encoded bounds are normative in README.html",
  "examples": [
    {
      "contractVersion": "0.1.0-draft.1",
      "generationId": "generation-1",
      "artifactId": "artifact-1",
      "offset": 0,
      "maxBytes": 65536
    }
  ],
  "type": "object",
  "required": [
    "contractVersion",
    "generationId",
    "artifactId",
    "offset",
    "maxBytes"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0-draft.1"
    },
    "generationId": {
      "type": "string",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "maxLength": 128,
      "minLength": 1
    },
    "artifactId": {
      "type": "string",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "maxLength": 128,
      "minLength": 1
    },
    "offset": {
      "type": "integer",
      "maximum": 16777216,
      "minimum": 0
    },
    "maxBytes": {
      "type": "integer",
      "maximum": 65536,
      "minimum": 1
    }
  },
  "additionalProperties": false
}
