        "format": "json",
        "input": {
          "encoding": "utf8",
          "source": "{\"profile\":\"morphir/workbench/native\",\"contractVersion\":\"0.1.0-draft.1\",\"operation\":\"session.open\"}"
        }
      },
      "valid": true
    },
    {
      "description": "Capabilities request",
      "data": {
        "id": 1,
        "op": "capabilities",
        "suite": "workbench",
        "contractVersion": "0.1.0-draft.7"
      },
      "valid": true
    },
    {
      "description": "Exit",
      "data": {
        "id": 2,
        "op": "exit"
      },
      "valid": true
    },
    {
      "description": "No caseId",
      "data": {
        "id": 1,
        "op": "validate-native-frame",
        "suite": "workbench",
        "contractVersion": "0.1.0-draft.7",
        "format": "json",
        "input": {
          "encoding": "utf8",
          "source": "{\"profile\":\"morphir/workbench/native\",\"contractVersion\":\"0.1.0-draft.1\",\"operation\":\"session.open\"}"
