{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.7/mck-input.schema.json",
  "title": "Offline Workbench native frame mck-input",
  "description": "Closed exact draft.7 JSON validate-native-frame contract. Shape validation alone does not qualify native decoding, caller provenance, authority or lifecycle behavior",
  "examples": [
    {
      "encoding": "utf8",
      "source": "{\"profile\":\"morphir/workbench/native\",\"contractVersion\":\"0.1.0-draft.1\",\"operation\":\"session.open\"}"
    }
  ],
  "type": "object",
  "if": {
    "properties": {
      "encoding": {
        "const": "hex"
      }
    }
  },
  "then": {
    "properties": {
      "source": {
        "not": {
          "pattern": "[^0-9A-Fa-f]"
        },
        "pattern": "^(?:[0-9A-Fa-f]{2})*$"
      }
    }
  },
  "required": [ "encoding", "source" ],
  "properties": {
    "encoding": {
      "enum": [ "utf8", "hex" ]
    },
    "source": {
      "type": "string"
    },
    "generate": {
      "type": "object",
      "required": [ "prefix" ],
      "properties": {
        "prefix": {
          "type": "object",
          "required": [ "repeat", "count" ],
          "properties": {
            "repeat": {
              "const": " "
            },
            "count": {
              "type": "integer",
              "maximum": 1048576,
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
