{
  "target": "https://morphir.finos.org/spec/workbench/0.1.0-draft.26/mck-corpus.schema.json",
  "tests": [
    {
      "description": "Accepted fixed shape",
      "data": {
        "formatVersion": "0.1.0-draft.26",
        "cases": [
          {
            "id": "scalar-json-to-json",
            "operation": "transcode-invocations",
            "format": "json",
            "input": {
              "sourceFormat": "json",
              "source": {
                "utf8": "{\"profile\":\"morphir-invocations-v1\",\"calls\":[{\"id\":\"call\",\"entry\":\"fixture:main#echo\",\"arguments\":[{\"type\":\"int\",\"value\":\"42\"}]}]}"
              },
              "targetFormat": "json"
            },
            "expected": {
              "status": "ok",
              "value": {
                "targetFormat": "json",
                "invocations": {
                  "profile": "morphir-invocations-v1",
                  "calls": [
                    {
                      "id": "call",
                      "entry": "fixture:main#echo",
                      "arguments": [
                        {
                          "type": "int",
                          "value": "42"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "valid": true
    },
    {
