{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.26/mck-capabilities.schema.json",
  "title": "Workbench codec and comparison mck-capabilities draft.26",
  "description": "Exact offline codec-transcoding and typed-value comparison qualification. Input source decoding, reverse encoding and comparison belong to an explicit production adapter; fixed expected projections belong to the parent kit. This draft adds no live runtime claim",
  "examples": [
    {
      "suite": "workbench",
      "contractVersion": "0.1.0-draft.26",
      "binding": "fixed",
      "language": "test",
      "operations": [ "transcode-invocations", "compare-values" ],
      "formats": [ "json" ]
    }
  ],
  "type": "object",
  "required": [
    "suite",
    "contractVersion",
    "binding",
    "language",
    "operations",
    "formats"
  ],
  "properties": {
    "suite": {
      "const": "workbench"
    },
    "contractVersion": {
      "const": "0.1.0-draft.26"
    },
    "binding": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "language": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [ "transcode-invocations", "compare-values" ]
      }
    },
    "formats": {
      "const": [ "json" ]
    }
  },
  "additionalProperties": false
}
