{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.29/mck-report.schema.json",
  "title": "Local model parity report, exact offline draft.29",
  "type": "object",
  "required": [
    "formatVersion",
    "suite",
    "corpusHash",
    "capabilities",
    "records",
    "errors",
    "qualified"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1.0-draft.29"
    },
    "suite": {
      "const": "workbench"
    },
    "corpusHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilities": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.29/mck-capabilities.schema.json"
        }
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "operation",
          "format",
          "result",
          "observed"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "operation": {
            "enum": [
              "inspect-model",
              "export-model-original"
            ]
          },
          "format": {
            "const": "json"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unsupported",
              "error"
            ]
          },
          "observed": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.29/mck-observation.schema.json"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "message"
        ],
        "properties": {
          "phase": {
            "enum": [
              "spawn",
              "capabilities",
              "exchange",
              "shutdown"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "additionalProperties": false
      }
    },
    "qualified": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
