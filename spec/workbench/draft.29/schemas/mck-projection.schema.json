{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.29/mck-projection.schema.json",
  "title": "Local model parity projection, exact offline draft.29",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "providerId",
        "inputFormat",
        "irVersion",
        "distribution",
        "packageName",
        "modules",
        "normalizedIr"
      ],
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "inputFormat": {
          "enum": [
            "json",
            "yaml",
            "ion-text",
            "ion-binary"
          ]
        },
        "irVersion": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128
        },
        "distribution": {
          "enum": [
            "Library",
            "Specs",
            "Application"
          ]
        },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "modules": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "normalizedIr": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1048576
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "providerId",
        "kind",
        "format",
        "hex",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "const": "original"
        },
        "format": {
          "enum": [
            "json",
            "yaml",
            "ion-text",
            "ion-binary"
          ]
        },
        "hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "maxLength": 2097154
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  ]
}
