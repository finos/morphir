{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.29/mck-capabilities.schema.json",
  "title": "Local model parity capabilities, exact offline draft.29",
  "type": "object",
  "required": [
    "suite",
    "contractVersion",
    "binding",
    "language",
    "operations",
    "formats"
  ],
  "properties": {
    "suite": {
      "const": "workbench"
    },
    "contractVersion": {
      "const": "0.1.0-draft.29"
    },
    "binding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operations": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect-model",
          "export-model-original"
        ]
      }
    },
    "formats": {
      "const": [
        "json"
      ]
    }
  },
  "additionalProperties": false
}
