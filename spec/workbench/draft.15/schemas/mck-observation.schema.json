{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.15/mck-observation.schema.json",
  "title": "Offline Workbench native frame mck-observation",
  "description": "Closed exact draft.15 JSON validate-native-frame contract. Shape validation alone does not qualify native decoding, caller provenance, authority or lifecycle behavior",
  "examples": [
    {
      "status": "ok",
      "value": {
        "frameAccepted": true
      }
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "required": [ "status", "value" ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "value": {
          "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.15/native-frame-projection.schema.json"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "status", "code" ],
      "properties": {
        "status": {
          "const": "invalid"
        },
        "code": {
          "enum": [
            "native.frame.limit",
            "native.frame.utf8",
            "native.frame.json",
            "native.frame.shape",
            "native.frame.model",
            "native.frame.arguments"
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}
