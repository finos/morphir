{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.13/mck-response.schema.json",
  "title": "Scheme job policy mck-response",
  "description": "Exact immutable Scheme job selection and accepted context; frozen receipt envelopes remain unchanged",
  "examples": [
    {
      "id": 1,
      "status": "ok",
      "value": {
        "jobs": [
          {
            "plan": {
              "profile": "morphir/workbench/job-plan",
              "contractVersion": "0.1.0-draft.1",
              "identity": {
                "hostId": "host",
                "sessionId": "session",
                "providerId": "scheme",
                "jobId": "job-1",
                "snapshotId": "snapshot-1"
              },
              "planId": "plan-1",
              "runtime": "scheme",
              "evaluator": "scheme-portable-v1/shared-sdk/bounded",
              "admission": {
                "profile": "morphir/workbench/admission",
                "contractVersion": "0.1.0-draft.1",
                "policy": "permissive"
              },
              "boundary": {
                "entries": [
                  {
                    "name": "selected:main#answer",
                    "inputs": [],
                    "output": {
                      "type": "int"
                    }
                  }
                ],
                "definitions": []
              }
            },
            "receipt": {
              "contractVersion": "0.1.0-draft.1",
              "identity": {
                "hostId": "host",
                "sessionId": "session",
                "providerId": "scheme",
                "jobId": "job-1",
                "snapshotId": "snapshot-1"
              },
              "sequence": 0,
              "state": "submitted",
              "cancelRequested": false,
              "outcomes": null
            },
            "released": false
          }
        ],
        "observations": [
          {
            "op": "inspect",
            "job": 0,
            "status": "ok",
            "code": null,
            "view": {
              "planId": "plan-1",
              "policy": "permissive",
              "runtime": "scheme",
              "sequence": 0,
              "state": "submitted",
              "cancelRequested": false
            }
          }
        ],
        "failure": null
      }
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "suite",
        "contractVersion",
        "binding",
        "language",
        "operations",
        "formats"
      ],
      "properties": {
        "suite": {
          "const": "workbench"
        },
        "contractVersion": {
          "const": "0.1.0-draft.13"
        },
        "binding": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "language": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "operations": {
          "enum": [
            [],
            [ "run-capability-jobs" ]
          ]
        },
        "formats": {
          "const": [ "json" ]
        },
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "id", "status", "value" ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.13/capability-jobs-projection.schema.json"
        }
      },
      "additionalProperties": false
    }
  ]
}
