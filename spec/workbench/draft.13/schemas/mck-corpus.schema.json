                {
                  "plan": {
                    "profile": "morphir/workbench/job-plan",
                    "contractVersion": "0.1.0-draft.1",
                    "identity": {
                      "hostId": "host",
                      "sessionId": "session",
                      "providerId": "scheme",
                      "jobId": "job-1",
                      "snapshotId": "snapshot-1"
                    },
                    "planId": "plan-1",
                    "runtime": "scheme",
                    "evaluator": "scheme-portable-v1/shared-sdk/bounded",
                    "admission": {
                      "profile": "morphir/workbench/admission",
                      "contractVersion": "0.1.0-draft.1",
                      "policy": "permissive"
                    },
                    "boundary": {
                      "entries": [
                        {
                          "name": "selected:main#answer",
                          "inputs": [],
                          "output": {
                            "type": "int"
                          }
                        }
                      ],
                      "definitions": []
                    }
                  },
                  "receipt": {
                    "contractVersion": "0.1.0-draft.1",
                    "identity": {
                      "hostId": "host",
                      "sessionId": "session",
                      "providerId": "scheme",
                      "jobId": "job-1",
                      "snapshotId": "snapshot-1"
                    },
                    "sequence": 0,
                    "state": "submitted",
                    "cancelRequested": false,
                    "outcomes": null
                  },
                  "released": false
                }
              ],
              "observations": [
                {
                  "op": "inspect",
                  "job": 0,
                  "status": "ok",
                  "code": null,
                  "view": {
                    "planId": "plan-1",
                    "policy": "permissive",
                    "runtime": "scheme",
                    "sequence": 0,
                    "state": "submitted",
                    "cancelRequested": false
                  }
                }
              ],
              "failure": null
            }
          }
        }
      ]
    }
  ],
  "type": "object",
  "required": [ "formatVersion", "cases" ],
  "properties": {
    "formatVersion": {
      "const": "0.1.0-draft.13"
    },
    "cases": {
      "type": "array",
      "maxItems": 1024,
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [ "id", "operation", "format", "input", "expected" ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "operation": {
            "const": "run-capability-jobs"
          },
          "format": {
            "const": "json"
          },
          "input": {
            "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.13/mck-input.schema.json"
          },
          "expected": {
            "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.13/mck-observation.schema.json"
          }
