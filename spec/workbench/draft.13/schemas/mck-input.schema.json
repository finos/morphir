{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.13/mck-input.schema.json",
  "title": "Scheme job policy mck-input",
  "description": "Exact immutable Scheme job selection and accepted context; frozen receipt envelopes remain unchanged",
  "examples": [
    {
      "offer": {
        "profile": "morphir/workbench/jobs",
        "contractVersion": "0.1.0-draft.1",
        "hostId": "host",
        "sessionId": "session",
        "providerId": "scheme",
        "operations": [ "query", "cancel" ]
      },
      "submission": {
        "model": "{\"formatVersion\":4,\"distribution\":{\"Library\":{\"packageName\":\"selected\",\"dependencies\":{},\"def\":{\"modules\":{\"main\":{\"Public\":{\"types\":{},\"values\":{\"answer\":{\"Public\":{\"doc\":\"Selected public Int42\",\"ExpressionBody\":{\"inputTypes\":{},\"outputType\":\"morphir/SDK:basics#int\",\"body\":{\"Literal\":{\"IntegerLiteral\":42}}}}}}}}}}}}}",
        "calls": [
          {
            "id": "first",
            "entry": "selected:main#answer",
            "inputs": {
              "format": "json",
              "source": "[]"
            }
          }
        ],
        "runtime": "scheme",
        "extensions": null,
        "admission": {
          "profile": "morphir/workbench/admission",
          "contractVersion": "0.1.0-draft.1",
          "policy": "permissive"
        }
      },
      "actions": [
        {
          "op": "inspect",
          "job": 0
        }
      ]
