{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.8/mck-response.schema.json",
  "title": "Offline Workbench native reply mck-response",
  "description": "Closed exact draft.8 JSON validate-native-reply contract. Shape validation alone does not qualify native decoding, caller provenance, authority or lifecycle behavior",
  "examples": [
    {
      "id": 1,
      "status": "ok",
      "value": {
        "replyAccepted": true,
        "ok": true,
        "operation": "session.open"
      }
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "suite",
        "contractVersion",
        "binding",
        "language",
        "operations",
        "formats"
      ],
      "properties": {
        "suite": {
          "const": "workbench"
        },
        "contractVersion": {
          "const": "0.1.0-draft.8"
        },
        "binding": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "language": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "operations": {
          "const": [ "validate-native-reply" ]
        },
        "formats": {
          "const": [ "json" ]
        },
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "id", "status", "value" ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.8/native-reply-projection.schema.json"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "id", "status", "code" ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "status": {
          "const": "invalid"
        },
        "code": {
          "enum": [
            "native.reply.limit",
            "native.reply.utf8",
            "native.reply.json",
            "native.reply.shape",
            "native.reply.operation",
            "native.reply.authority"
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}
