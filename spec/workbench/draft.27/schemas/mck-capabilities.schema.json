{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.27/mck-capabilities.schema.json",
  "title": "Worksheet mck-capabilities draft.27",
  "description": "Independent exact worksheet qualification. Supplied-report validation is distinct from actual evaluation; no remote execution or host-lifecycle claim",
  "examples": [
    {
      "suite": "workbench",
      "contractVersion": "0.1.0-draft.27",
      "binding": "fixture",
      "language": "test",
      "operations": [ "worksheet-evaluate", "worksheet-validate" ],
      "formats": [ "json" ]
    }
  ],
  "type": "object",
  "required": [
    "suite",
    "contractVersion",
    "binding",
    "language",
    "operations",
    "formats"
  ],
  "properties": {
    "suite": {
      "const": "workbench"
    },
    "contractVersion": {
      "const": "0.1.0-draft.27"
    },
    "binding": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "language": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [ "worksheet-evaluate", "worksheet-validate" ]
      }
    },
    "formats": {
      "const": [ "json" ]
    }
  },
  "additionalProperties": false
}
