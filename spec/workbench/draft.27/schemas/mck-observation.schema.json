{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.27/mck-observation.schema.json",
  "title": "Worksheet MCK observations",
  "description": "Exact local Scheme worksheet source capture, UTF-16 ranges and existing typed terminal payloads; semantic rules remain normative in the profile",
  "examples": [
    {
      "status": "ok",
      "value": {
        "profile": "morphir/workbench/worksheet",
        "contractVersion": "0.1.0-draft.1",
        "source": {
          "id": "worksheet-source",
          "revision": 4,
          "text": "7"
        },
        "observations": [
          {
            "id": "form-0",
            "range": {
              "start": 0,
              "end": 1
            },
            "expression": "7",
            "preview": "7",
            "outcome": {
              "status": "returned",
              "value": {
                "type": "int",
                "value": "7"
              }
            }
          }
        ],
        "completion": {
          "status": "returned",
          "value": {
            "type": "unit"
          }
        },
        "diagnostic": null
      }
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "required": [ "status", "value" ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "value": {
          "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.27/mck-projection.schema.json"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "status", "code" ],
      "properties": {
        "status": {
          "const": "invalid"
        },
        "code": {
          "enum": [
            "worksheet.invalid_json",
            "worksheet.invalid_request",
            "worksheet.input_limit",
            "worksheet.invalid_report",
            "worksheet.source_mismatch",
            "worksheet.invalid_range",
            "worksheet.invalid_identity",
            "worksheet.output_limit"
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}
