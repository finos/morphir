{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.19/mck-capabilities.schema.json",
  "title": "Scheme execution policy mck-capabilities",
  "description": "Exact immutable Scheme execution selection and accepted context; frozen receipt envelopes remain unchanged",
  "examples": [
    {
      "suite": "workbench",
      "contractVersion": "0.1.0-draft.19",
      "binding": "scheme-execution-policy-adapter",
      "language": "moonbit",
      "operations": [ "run-capability-executions" ],
      "formats": [ "json" ]
    }
  ],
  "type": "object",
  "required": [
    "suite",
    "contractVersion",
    "binding",
    "language",
    "operations",
    "formats"
  ],
  "properties": {
    "suite": {
      "const": "workbench"
    },
    "contractVersion": {
      "const": "0.1.0-draft.19"
    },
    "binding": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "language": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "operations": {
      "enum": [
        [],
        [ "run-capability-executions" ]
      ]
    },
    "formats": {
      "const": [ "json" ]
    }
  },
  "additionalProperties": false
}
