{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.19/mck-request.schema.json",
  "title": "Scheme execution policy mck-request",
  "description": "Exact immutable Scheme execution selection and accepted context; frozen receipt envelopes remain unchanged",
  "examples": [
    {
      "id": 1,
      "op": "run-capability-executions",
      "suite": "workbench",
      "contractVersion": "0.1.0-draft.19",
      "format": "json",
      "input": {
        "offer": {
          "profile": "morphir/workbench/executions",
          "contractVersion": "0.2.0-draft.1",
          "hostId": "host",
          "sessionId": "session",
          "providerId": "scheme",
          "operations": [ "query", "cancel" ]
        },
        "submission": {
          "model": "{\"formatVersion\":4,\"distribution\":{\"Library\":{\"packageName\":\"selected\",\"dependencies\":{},\"def\":{\"modules\":{\"main\":{\"Public\":{\"types\":{},\"values\":{\"answer\":{\"Public\":{\"doc\":\"Selected public Int42\",\"ExpressionBody\":{\"inputTypes\":{},\"outputType\":\"morphir/SDK:basics#int\",\"body\":{\"Literal\":{\"IntegerLiteral\":42}}}}}}}}}}}}}",
          "calls": [
            {
              "id": "first",
              "entry": "selected:main#answer",
              "inputs": {
                "format": "json",
                "source": "[]"
              }
            }
          ],
          "runtime": "scheme",
          "extensions": null,
          "admission": {
            "profile": "morphir/workbench/admission",
            "contractVersion": "0.1.0-draft.1",
            "policy": "permissive"
          }
        },
        "actions": [
          {
            "op": "inspect",
            "execution": 0
          }
        ]
      }
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "required": [ "id", "op", "suite", "contractVersion" ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "op": {
          "const": "capabilities"
        },
        "suite": {
          "const": "workbench"
        },
        "contractVersion": {
          "const": "0.1.0-draft.19"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "id", "op", "suite", "contractVersion", "format", "input" ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "op": {
          "const": "run-capability-executions"
        },
        "suite": {
          "const": "workbench"
        },
        "contractVersion": {
          "const": "0.1.0-draft.19"
        },
        "format": {
          "const": "json"
        },
        "input": {
          "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.19/mck-input.schema.json"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "id", "op" ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "op": {
          "const": "exit"
        }
      },
      "additionalProperties": false
    }
  ]
}
