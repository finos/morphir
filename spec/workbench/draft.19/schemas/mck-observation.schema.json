{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.19/mck-observation.schema.json",
  "title": "Scheme execution policy mck-observation",
  "description": "Exact immutable Scheme execution selection and accepted context; frozen receipt envelopes remain unchanged",
  "examples": [
    {
      "status": "ok",
      "value": {
        "executions": [
          {
            "plan": {
              "profile": "morphir/workbench/execution-plan",
              "contractVersion": "0.2.0-draft.1",
              "identity": {
                "hostId": "host",
                "sessionId": "session",
                "providerId": "scheme",
                "executionId": "execution-1",
                "snapshotId": "snapshot-1"
              },
              "planId": "plan-1",
              "runtime": "scheme",
              "evaluator": "scheme-portable-v1/shared-sdk/bounded",
              "admission": {
                "profile": "morphir/workbench/admission",
                "contractVersion": "0.1.0-draft.1",
                "policy": "permissive"
              },
              "boundary": {
                "entries": [
                  {
                    "name": "selected:main#answer",
                    "inputs": [],
                    "output": {
                      "type": "int"
                    }
                  }
                ],
                "definitions": []
              }
            },
            "receipt": {
              "contractVersion": "0.2.0-draft.1",
              "identity": {
                "hostId": "host",
                "sessionId": "session",
                "providerId": "scheme",
                "executionId": "execution-1",
                "snapshotId": "snapshot-1"
              },
              "sequence": 0,
              "state": "submitted",
              "cancelRequested": false,
              "outcomes": null
            },
            "released": false
          }
        ],
        "observations": [
          {
            "op": "inspect",
            "execution": 0,
            "status": "ok",
            "code": null,
            "view": {
              "planId": "plan-1",
              "policy": "permissive",
              "runtime": "scheme",
              "sequence": 0,
              "state": "submitted",
              "cancelRequested": false
            }
          }
        ],
        "failure": null
      }
    }
  ],
  "type": "object",
  "required": [ "status", "value" ],
  "properties": {
    "status": {
      "const": "ok"
    },
    "value": {
      "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.19/capability-executions-projection.schema.json"
    }
  },
  "additionalProperties": false
}
