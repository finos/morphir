{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.1/mck-corpus.schema.json",
  "title": "Draft Workbench MCK corpus",
  "description": "Independent codec inputs and expected projections; only inputs are sent to adapters",
  "examples": [
    {
      "formatVersion": "0.1.0-draft.1",
      "cases": [
        {
          "id": "unit-json",
          "format": "json",
          "input": {
            "type": "unit"
          },
          "expected": {
            "status": "ok",
            "value": {
              "type": "unit"
            }
          }
        }
      ]
    }
  ],
  "type": "object",
  "required": [ "formatVersion", "cases" ],
  "properties": {
    "formatVersion": {
      "const": "0.1.0-draft.1"
    },
    "cases": {
      "type": "array",
      "maxItems": 1024,
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [ "id", "format", "input", "expected" ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "format": {
                "const": "json"
              },
              "input": true,
              "expected": {
                "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.1/mck-observation.schema.json"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [ "id", "format", "input", "expected" ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "format": {
                "const": "ion-text"
              },
              "input": {
                "type": "string"
              },
              "expected": {
                "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.1/mck-observation.schema.json"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
