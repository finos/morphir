{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/workbench/0.1.0-draft.1/mck-response.schema.json",
  "title": "Draft Workbench MCK response",
  "description": "Adapter capability claims or codec observations; the transport removes the correlation identifier before engine admission",
  "examples": [
    {
      "id": 1,
      "suite": "workbench",
      "contractVersion": "0.1.0-draft.1",
      "binding": "morphir-moonbit",
      "language": "moonbit",
      "operations": [ "decode-value" ],
      "formats": [ "json", "ion-text" ]
    }
  ],
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "suite",
        "contractVersion",
        "binding",
        "language",
        "operations",
        "formats"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "suite": {
          "const": "workbench"
        },
        "contractVersion": {
          "const": "0.1.0-draft.1"
        },
        "binding": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "language": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "const": "decode-value"
          }
        },
        "formats": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [ "json", "ion-text" ]
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "id", "status", "value" ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "status": {
          "const": "ok"
        },
        "value": {
          "$ref": "https://morphir.finos.org/spec/workbench/0.1.0-draft.1/outcome-value.schema.json"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "id", "status", "code" ],
      "properties": {
        "id": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "status": {
          "const": "invalid"
        },
        "code": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
