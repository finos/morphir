{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/package/0.1.0-draft.3/library-lock.schema.json",
  "title": "Candidate local Library lock",
  "$comment": "Experimental draft.3 wire contract and signed fixture approved on 2026-09-17 for runtime implementation. Cross-document, ordering, uniqueness and authorization rules are defined in local-library-contract.md.",
  "type": "object",
  "required": [
    "formatVersion",
    "kind",
    "resolution",
    "graph",
    "registries",
    "acquisitions",
    "evidence"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1.0-draft.3"
    },
    "kind": {
      "const": "LibraryLock"
    },
    "resolution": {
      "type": "object",
      "required": [ "policy", "profile", "requiredCapabilities" ],
      "properties": {
        "policy": {
          "const": "flat-library:0.1.0-draft.2"
        },
        "profile": {
          "const": "local-library"
        },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 3,
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [ "dsse-ed25519", "local-directory", "tuf-1.0.36" ]
          }
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "$ref": "https://morphir.finos.org/spec/package/0.1.0-draft.2/resolution-input.schema.json#/$defs/LockedGraph"
    },
    "registries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Registry"
      }
    },
    "acquisitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Acquisition"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "LocalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "RegistryRelativePath": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*(/[a-z0-9]+([.-][a-z0-9]+)*)*$",
      "maxLength": 240
    },
    "Digest": {
      "$ref": "https://morphir.finos.org/spec/package/0.1.0-draft.1/library-manifest.schema.json#/$defs/Digest"
    },
    "ObjectReference": {
      "type": "object",
      "required": [ "path", "digest" ],
      "properties": {
        "path": {
          "$ref": "#/$defs/RegistryRelativePath"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "DirectorySource": {
      "type": "object",
      "required": [ "kind", "path" ],
      "properties": {
        "kind": {
          "const": "registry-directory"
        },
        "path": {
          "$ref": "#/$defs/RegistryRelativePath"
        }
      },
      "additionalProperties": false
    },
    "Registry": {
      "type": "object",
      "required": [ "id", "snapshot" ],
      "properties": {
        "id": {
          "$ref": "#/$defs/LocalId"
        },
        "snapshot": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "additionalProperties": false
    },
    "Acquisition": {
      "type": "object",
      "required": [ "release", "registry", "record", "source", "statement" ],
      "properties": {
        "release": {
          "$ref": "https://morphir.finos.org/spec/package/0.1.0-draft.2/resolution-input.schema.json#/$defs/ReleaseId"
        },
        "registry": {
          "$ref": "#/$defs/LocalId"
        },
        "record": {
          "$ref": "#/$defs/ObjectReference"
        },
        "source": {
          "$ref": "#/$defs/DirectorySource"
        },
        "statement": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "required": [ "id", "registry", "kind", "path", "digest" ],
      "properties": {
        "id": {
          "$ref": "#/$defs/LocalId"
        },
        "registry": {
          "$ref": "#/$defs/LocalId"
        },
        "kind": {
          "enum": [
            "tuf-root",
            "tuf-timestamp",
            "tuf-snapshot",
            "tuf-targets",
            "release-statement"
          ]
        },
        "path": {
          "$ref": "#/$defs/RegistryRelativePath"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "additionalProperties": false
    }
  }
}
