{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/mck/restore-filesystem-assurance/0.1.0-draft.1/protocol.schema.json",
  "title": "Internal restore filesystem assurance preflight request",
  "description": "Source-only preflight, not a public adapter protocol. Provider qualification is a trusted host attestation; structural validation does not verify evidence or qualify a backend.",
  "type": "object",
  "required": [ "selection", "provider" ],
  "properties": {
    "selection": {
      "$ref": "#/$defs/Selection"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Selection": {
      "type": "object",
      "required": [ "profile", "profileVersion", "mode" ],
      "properties": {
        "profile": {
          "const": "restore-filesystem-assurance"
        },
        "profileVersion": {
          "const": "0.1.0-draft.1"
        },
        "mode": {
          "enum": [ "portable", "hardened" ]
        }
      },
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "required": [ "id", "version" ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Platform": {
      "type": "object",
      "required": [ "name", "version" ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Environment": {
      "type": "object",
      "required": [
        "runtime",
        "os",
        "architecture",
        "filesystem",
        "assumptions"
      ],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/Platform"
        },
        "os": {
          "$ref": "#/$defs/Platform"
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "Qualification": {
      "type": "object",
      "required": [ "mode", "environment", "evidence" ],
      "properties": {
        "mode": {
          "enum": [ "portable", "hardened" ]
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "Provider": {
      "type": "object",
      "required": [ "identity", "qualification" ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "qualification": {
          "oneOf": [
            {
              "type": "object",
              "required": [ "kind" ],
              "properties": {
                "kind": {
                  "const": "unqualified"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [ "kind", "entries" ],
              "properties": {
                "kind": {
                  "const": "qualified"
                },
                "entries": {
                  "type": "array",
                  "allOf": [
                    {
                      "maxContains": 1,
                      "minContains": 0,
                      "contains": {
                        "type": "object",
                        "required": [ "mode" ],
                        "properties": {
                          "mode": {
                            "const": "portable"
                          }
                        }
                      }
                    },
                    {
                      "maxContains": 1,
                      "minContains": 0,
                      "contains": {
                        "type": "object",
                        "required": [ "mode" ],
                        "properties": {
                          "mode": {
                            "const": "hardened"
                          }
                        }
                      }
                    }
                  ],
                  "maxItems": 2,
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/Qualification"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
