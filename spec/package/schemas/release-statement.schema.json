{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/spec/package/0.1.0-draft.3/release-statement.schema.json",
  "title": "Candidate Library release statement payload",
  "$comment": "This schema describes the decoded statement payload only, not a DSSE envelope, signature validity or publisher authorization. Canonical payload bytes have no trailing LF.",
  "type": "object",
  "required": [
    "formatVersion",
    "kind",
    "release",
    "irPackageName",
    "dependencies",
    "manifestDigest",
    "contentDigest"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1.0-draft.3"
    },
    "kind": {
      "const": "LibraryReleaseStatement"
    },
    "release": {
      "$ref": "https://morphir.finos.org/spec/package/0.1.0-draft.2/resolution-input.schema.json#/$defs/ReleaseId"
    },
    "irPackageName": {
      "$ref": "https://morphir.finos.org/spec/package/0.1.0-draft.1/library-manifest.schema.json#/$defs/IRPath"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://morphir.finos.org/spec/package/0.1.0-draft.2/resolution-input.schema.json#/$defs/Requirement"
      }
    },
    "manifestDigest": {
      "$ref": "https://morphir.finos.org/spec/package/0.1.0-draft.1/library-manifest.schema.json#/$defs/Digest"
    },
    "contentDigest": {
      "$ref": "https://morphir.finos.org/spec/package/0.1.0-draft.1/library-manifest.schema.json#/$defs/Digest"
    }
  },
  "additionalProperties": false
}
