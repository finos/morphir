{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/mck/restore-filesystem-assurance/0.1.0-draft.1/report.schema.json",
  "title": "Internal restore filesystem assurance preflight receipt",
  "description": "Selection receipts report preflight only. They do not establish authentication, graph readiness, compatibility, backend qualification, durability, or authorization for later package access.",
  "oneOf": [
    {
      "type": "object",
      "required": [ "kind", "context" ],
      "properties": {
        "kind": {
          "const": "selected"
        },
        "context": {
          "oneOf": [
            {
              "type": "object",
              "required": [ "selection", "provider", "qualification" ],
              "properties": {
                "selection": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/Selection"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "const": "portable"
                        }
                      }
                    }
                  ]
                },
                "provider": {
                  "$ref": "#/$defs/Identity"
                },
                "qualification": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/Qualification"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "const": "portable"
                        }
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [ "selection", "provider", "qualification" ],
              "properties": {
                "selection": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/Selection"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "const": "hardened"
                        }
                      }
                    }
                  ]
                },
                "provider": {
                  "$ref": "#/$defs/Identity"
                },
                "qualification": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/Qualification"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "const": "hardened"
                        }
                      }
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [ "kind", "selection", "provider", "reason" ],
      "properties": {
        "kind": {
          "const": "rejected"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "provider": {
          "$ref": "#/$defs/Identity"
        },
        "reason": {
          "enum": [ "provider-unqualified", "mode-unavailable" ]
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "Selection": {
      "type": "object",
      "required": [ "profile", "profileVersion", "mode" ],
      "properties": {
        "profile": {
          "const": "restore-filesystem-assurance"
        },
        "profileVersion": {
          "const": "0.1.0-draft.1"
        },
        "mode": {
          "enum": [ "portable", "hardened" ]
        }
      },
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "required": [ "id", "version" ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Platform": {
      "type": "object",
      "required": [ "name", "version" ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Environment": {
      "type": "object",
      "required": [
        "runtime",
        "os",
        "architecture",
        "filesystem",
        "assumptions"
      ],
      "properties": {
        "runtime": {
          "$ref": "#/$defs/Platform"
        },
        "os": {
          "$ref": "#/$defs/Platform"
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "Qualification": {
      "type": "object",
      "required": [ "mode", "environment", "evidence" ],
      "properties": {
        "mode": {
          "enum": [ "portable", "hardened" ]
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
