      "setup": {
        "registries": [
          {
            "id": "finance",
            "tree": {
              "asset": "view-one"
            },
            "publisher": "explicitly-initialize"
          }
        ],
        "actors": [
          {
            "id": "machine-a",
            "configuration": {
              "asset": "configuration-one"
            },
            "policy": {
              "kind": "asset",
              "asset": "policy-one"
            },
            "security": "explicitly-initialize",
            "cache": {
              "asset": "empty-cache"
            },
            "staging": "empty",
            "destination": "empty"
