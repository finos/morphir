{
  "formatVersion": "0.1.0-draft.3",
  "cases": [
    {
      "kind": "scenario",
      "id": "local-registry.publication.two-writers-one-predecessor",
      "family": "publication",
      "description": "Writer A holds the lock first. Distinct release requests share the exact predecessor; B conflicts after A commits, with no automatic retry.",
      "required": true,
      "setup": {
        "registries": [
          {
            "id": "finance",
            "tree": {
              "asset": "view-one"
            },
            "publisher": "explicitly-initialize"
          }
        ],
        "actors": [
          {
            "id": "machine-a",
            "configuration": {
              "asset": "configuration-one"
            },
            "policy": {
              "kind": "asset",
              "asset": "policy-one"
            },
            "security": "explicitly-initialize",
            "cache": {
              "asset": "empty-cache"
            },
            "staging": "empty",
            "destination": "empty"
          },
          {
            "id": "machine-b",
            "configuration": {
              "asset": "configuration-one"
            },
            "policy": {
              "kind": "asset",
              "asset": "policy-one"
            },
            "security": "explicitly-initialize",
            "cache": {
              "asset": "empty-cache"
            },
            "staging": "empty",
            "destination": "empty"
          }
        ]
      },
      "operations": [
        {
          "id": "writer-a",
          "actor": "machine-a",
          "at": "2027-01-01T00:00:00Z",
          "policy": {
            "kind": "asset",
            "asset": "policy-one"
          },
          "limits": [],
          "expected": {
            "kind": "asset",
            "asset": "result-writer-a",
            "assertions": [
              {
                "pointer": "/ok",
                "equals": true
              },
              {
                "pointer": "/kind",
                "equals": "publication"
              },
              {
                "pointer": "/outcome",
                "equals": "committed"
              }
            ]
          },
          "name": "publish-library",
          "input": {
            "registry": "finance",
            "bundle": {
              "asset": "bundle-publish-a"
            },
            "record": {
              "kind": "asset",
              "asset": "record-publish-a"
            },
            "envelope": {
              "kind": "asset",
              "asset": "envelope-publish-a"
            },
            "predecessor": {
              "kind": "asset",
              "asset": "predecessor-one"
            },
            "proposal": {
              "asset": "proposal-publish-a"
            }
          }
        },
        {
          "id": "writer-b",
          "actor": "machine-b",
          "at": "2027-01-01T00:00:00Z",
          "policy": {
            "kind": "asset",
            "asset": "policy-one"
          },
          "limits": [],
          "expected": {
            "kind": "asset",
            "asset": "result-writer-b",
            "assertions": [
              {
                "pointer": "/ok",
                "equals": false
              },
              {
                "pointer": "/diagnostic/category",
                "equals": "domain-rejection"
              },
              {
                "pointer": "/diagnostic/code",
                "equals": "publication-conflict"
              },
              {
                "pointer": "/diagnostic/phase",
                "equals": "publication"
              },
              {
                "pointer": "/diagnostic/witnesses/0/kind",
                "equals": "revision"
              }
            ]
          },
          "name": "publish-library",
          "input": {
            "registry": "finance",
            "bundle": {
              "asset": "bundle-publish-b"
            },
            "record": {
              "kind": "asset",
              "asset": "record-publish-b"
            },
            "envelope": {
              "kind": "asset",
              "asset": "envelope-publish-b"
            },
            "predecessor": {
              "kind": "asset",
              "asset": "predecessor-one"
            },
            "proposal": {
              "asset": "proposal-publish-b"
            }
          }
        }
      ],
      "actions": [
        {
          "kind": "start",
          "operation": "writer-a",
          "barriers": [
            {
              "operation": "writer-a",
              "boundary": "after",
              "step": "predecessor-check",
              "subject": {
                "kind": "repository",
                "registry": "finance"
              }
            }
          ]
        },
        {
          "kind": "await",
          "checkpoint": {
            "operation": "writer-a",
            "boundary": "after",
            "step": "predecessor-check",
            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          }
        },
        {
          "kind": "start",
          "operation": "writer-b",
          "barriers": [
            {
              "operation": "writer-b",
              "boundary": "before",
              "step": "writer-lock",
              "subject": {
                "kind": "repository",
                "registry": "finance"
              }
            }
          ]
        },
        {
          "kind": "await",
          "checkpoint": {
            "operation": "writer-b",
            "boundary": "before",
            "step": "writer-lock",
            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          }
        },
        {
          "kind": "release",
          "checkpoint": {
            "operation": "writer-a",
            "boundary": "after",
            "step": "predecessor-check",
            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          }
        },
        {
          "kind": "join",
          "operation": "writer-a"
        },
        {
          "kind": "release",
          "checkpoint": {
            "operation": "writer-b",
            "boundary": "before",
            "step": "writer-lock",
            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          }
        },
        {
          "kind": "join",
          "operation": "writer-b"
        }
      ],
      "expectedObservations": {
        "asset": "observations-publication-two-writers-one-predecessor",
        "assertions": [
          {
            "pointer": "/readyGraphs",
            "equals": []
          },
          {
            "pointer": "/registries/0/reserved",
            "equals": {
              "targets": "2",
              "snapshot": "2",
              "timestamp": "2"
            }
          }
        ]
      },
      "observe": {
        "at": "2027-01-01T00:00:00Z",
        "policies": [
          {
            "actor": "machine-a",
            "policy": {
              "kind": "asset",
              "asset": "policy-one"
            }
          },
          {
            "actor": "machine-b",
            "policy": {
              "kind": "asset",
              "asset": "policy-one"
            }
          }
        ]
      }
    },
