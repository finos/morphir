            "asset": "view-revoked"
          }
        },
        {
          "kind": "start",
          "operation": "learn",
          "barriers": [
            {
              "operation": "learn",
              "boundary": "after",
              "step": "security-update-marker",
              "subject": {
                "kind": "repository",
                "registry": "finance"
              }
            },
            {
              "operation": "learn",
              "boundary": "before",
              "step": "security-state-commit",
              "subject": {
                "kind": "repository",
                "registry": "finance"
              }
            }
          ]
        },
        {
          "kind": "await",
          "checkpoint": {
            "operation": "learn",
            "boundary": "after",
            "step": "security-update-marker",
            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          }
        },
