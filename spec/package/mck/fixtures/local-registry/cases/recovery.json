          "kind": "release",
          "checkpoint": {
            "operation": "learn",
            "boundary": "after",
            "step": "security-update-marker",
            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          }
        },
        {
          "kind": "await",
          "checkpoint": {
            "operation": "learn",
            "boundary": "before",
            "step": "security-state-commit",
            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          }
        },
        {
          "kind": "inject-fault",
          "checkpoint": {
            "operation": "learn",
            "boundary": "before",
