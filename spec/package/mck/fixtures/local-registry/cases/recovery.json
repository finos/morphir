            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          },
          "action": "state-write",
          "reason": "no-space"
        },
        {
          "kind": "release",
          "checkpoint": {
            "operation": "learn",
            "boundary": "before",
            "step": "security-state-commit",
            "subject": {
              "kind": "repository",
              "registry": "finance"
            }
          }
        },
        {
          "kind": "join",
          "operation": "learn"
        },
        {
          "kind": "withhold-registry",
          "registry": "finance"
        },
        {
          "kind": "restart-client",
          "actor": "machine-a"
        },
        {
          "kind": "start",
          "operation": "restarted",
          "barriers": []
        },
        {
          "kind": "join",
          "operation": "restarted"
        }
