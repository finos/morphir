                    "bindings": []
                  }
                ]
              },
              "verified": [
                {
                  "packagePath": "example.com/finance/loan-rules",
                  "version": "1.0.0"
                },
                {
                  "packagePath": "example.com/finance/eligibility",
                  "version": "1.2.0"
                }
              ]
            }
          },
          "name": "replay-library",
          "input": {
            "lock": {
              "kind": "asset",
              "asset": "lock-two"
            },
            "authorizationView": {
              "kind": "supplied",
              "tree": {
                "asset": "view-two"
              }
