      "required": true,
      "setup": {
        "registries": [
          {
            "id": "finance",
            "tree": {
              "asset": "view-fs-symlink"
            },
            "publisher": "explicitly-initialize"
          }
        ],
        "actors": [
          {
            "id": "machine-a",
            "configuration": {
              "asset": "configuration-one"
            },
            "policy": {
              "kind": "asset",
              "asset": "policy-one"
            },
            "security": "explicitly-initialize",
            "cache": {
              "asset": "empty-cache"
            },
            "staging": "empty",
            "destination": "empty"
          }
        ]
      },
      "operations": [
        {
          "id": "restore",
          "actor": "machine-a",
          "at": "2027-01-01T00:00:00Z",
