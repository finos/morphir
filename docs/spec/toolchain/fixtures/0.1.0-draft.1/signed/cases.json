  "recipeChecks": [
    {
      "name": "the offering recipe binds authenticated artifacts of each offering",
      "recipe": "toolchains/recipes/fsharp-builtin/1.0.0.json",
      "expected": "valid"
    },
    {
      "name": "the F# recipe binds its host, frontend and backend descriptors and artifacts",
      "recipe": "toolchains/recipes/fsharp/1.0.0.json",
      "expected": "valid"
    },
    {
      "name": "a substituted host digest is refused",
      "recipe": "toolchains/recipes/negative-digest-substituted/1.0.0.json",
      "expected": {
        "code": "target_digest_mismatch",
        "path": "hosts[0].platforms.win-x64.sha256"
      }
    },
    {
      "name": "another platform's host artifact is refused",
      "recipe": "toolchains/recipes/negative-platform-substituted/1.0.0.json",
      "expected": {
        "code": "artifact_platform_mismatch",
        "path": "hosts[0].platforms.win-x64.target"
