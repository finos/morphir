      "platform": "win-x64",
      "expected": {
        "hostTarget": "artifacts/morphir-dotnet-native-aot/1.2.3/win-x64.zip",
        "providers": [
          {
            "operation": "generate",
            "target": "fsharp",
            "delivery": "built-in",
            "extensionId": "morphir.fsharp"
          }
        ]
      }
