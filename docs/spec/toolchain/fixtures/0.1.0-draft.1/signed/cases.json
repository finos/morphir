  "trust": [
    {
      "name": "altered targets metadata breaks the snapshot link",
      "metadata": "metadata",
      "mutations": [
        {
          "op": "set-signed-member",
          "role": "targets",
          "pointer": "/targets/toolchains~1recipes~1fsharp~11.0.0.json/hashes/sha256",
          "value": "3333333333333333333333333333333333333333333333333333333333333333"
        }
      ],
      "action": {
        "op": "load"
      },
      "expected": {
        "code": "metadata_link_mismatch",
        "path": ""
      }
    },
    {
      "name": "re-linked but unsigned targets metadata fails its signature",
      "metadata": "metadata",
      "mutations": [
        {
          "op": "set-signed-member",
          "role": "targets",
          "pointer": "/targets/toolchains~1recipes~1fsharp~11.0.0.json/hashes/sha256",
          "value": "3333333333333333333333333333333333333333333333333333333333333333"
        },
        {
          "op": "relink"
        }
      ],
      "action": {
        "op": "load"
      },
      "expected": {
        "code": "metadata_signature_invalid",
        "path": ""
      }
    },
    {
      "name": "an expired timestamp is refused",
      "metadata": "metadata",
      "mutations": [
        {
          "op": "replace-role",
          "role": "timestamp",
          "from": "rejectionMetadata.expiredTimestamp"
        }
      ],
      "action": {
        "op": "load"
      },
      "expected": {
        "code": "metadata_expired",
        "path": ""
      }
    },
    {
      "name": "a learned revocation keeps the release descriptor bytes",
      "metadata": "learnedRevocation",
      "mutations": [],
      "action": {
        "op": "read",
        "target": "releases/morphir-dotnet-native-aot/1.2.3.json"
      },
      "expected": "valid"
    },
    {
      "name": "a learned revocation refuses the native-aot binding",
      "metadata": "learnedRevocation",
      "mutations": [],
      "action": {
        "op": "check-recipe",
        "recipe": "toolchains/recipes/fsharp/1.0.0.json"
      },
      "expected": {
        "code": "release_revoked",
        "path": "hosts[0].version"
      }
    },
    {
      "name": "a substituted archive of another length is refused",
      "metadata": "metadata",
      "mutations": [
        {
          "op": "replace-target-bytes",
          "target": "artifacts/morphir-dotnet-native-aot/1.2.3/win-x64.zip",
          "with": "artifacts/morphir-dotnet-self-contained/1.2.3/win-x64.zip"
        }
      ],
      "action": {
        "op": "read",
        "target": "artifacts/morphir-dotnet-native-aot/1.2.3/win-x64.zip"
      },
      "expected": {
        "code": "target_length_mismatch",
        "path": ""
      }
    },
    {
      "name": "a substituted archive of the same length is refused",
      "metadata": "metadata",
      "mutations": [
        {
          "op": "replace-target-bytes",
          "target": "artifacts/morphir-dotnet-native-aot/1.2.3/win-x64.zip",
          "with": "artifacts/morphir-dotnet-native-aot/1.2.3/osx-x64.tar.gz"
        }
      ],
      "action": {
        "op": "read",
        "target": "artifacts/morphir-dotnet-native-aot/1.2.3/win-x64.zip"
      },
      "expected": {
        "code": "target_digest_mismatch",
        "path": ""
      }
    },
    {
      "name": "tampered descriptor bytes are refused",
      "metadata": "metadata",
      "mutations": [
        {
          "op": "replace-target-text",
          "target": "extensions/fsharp-frontend/0.6.0/release.json",
          "find": "\"platformDifferences\":\"none\"",
          "replace": "\"platformDifferences\":\"nonE\""
        }
      ],
      "action": {
        "op": "check-recipe",
        "recipe": "toolchains/recipes/fsharp/1.0.0.json"
      },
      "expected": {
        "code": "target_digest_mismatch",
        "path": ""
      }
    },
    {
      "name": "an unsigned developer artifact is not an authenticated target",
      "metadata": "metadata",
      "mutations": [],
      "action": {
        "op": "authenticate",
        "target": "extensions/fsharp-frontend/0.6.0-dev/win-x64.zip",
        "text": "TEST-ONLY local developer build\n"
      },
      "expected": {
        "code": "target_not_authenticated",
        "path": ""
      }
    },
    {
      "name": "a recipe cannot bind an unsigned developer artifact",
      "metadata": "metadata",
      "mutations": [],
      "action": {
        "op": "check-recipe-bindings",
        "recipe": "toolchains/recipes/fsharp/1.0.0.json",
        "documentMutations": [
          {
            "pointer": "/providers/0/platforms/win-x64/artifactTarget",
            "value": "extensions/fsharp-frontend/0.6.0-dev/win-x64.zip"
          }
        ]
      },
      "expected": {
        "code": "target_not_authenticated",
        "path": "providers[0].platforms.win-x64.artifactTarget"
      }
    }
  ],
