  "bindings": [
    {
      "name": "a lock binds the exact request bytes",
      "kind": "lock-request",
      "lock": "lock/two-platforms-bound.json",
      "request": "request/approved.toml",
      "expected": "valid"
    },
    {
      "name": "a changed request is refused",
      "kind": "lock-request",
      "lock": "lock/two-platforms-bound.json",
      "request": "request/exact-host-version.toml",
      "expected": {
        "code": "request_changed",
        "path": "requestSha256"
      }
    },
    {
      "name": "reformatting the request changes its identity",
      "kind": "lock-request",
      "lock": "lock/two-platforms-bound.json",
      "request": "request/reformatted-approved.toml",
      "expected": {
        "code": "request_changed",
        "path": "requestSha256"
      }
    },
    {
      "name": "frozen restore selects a locked platform",
      "kind": "lock-platform",
      "lock": "lock/two-platforms-bound.json",
      "platform": "osx-arm64",
      "expected": "valid"
    },
    {
      "name": "frozen restore refuses an unlocked platform",
      "kind": "lock-platform",
      "lock": "lock/two-platforms-bound.json",
      "platform": "linux-x64",
      "expected": {
        "code": "platform_not_locked",
        "path": "platforms"
      }
    },
    {
      "name": "a musl machine never takes a glibc closure",
      "kind": "lock-platform",
      "lock": "lock/two-platforms-bound.json",
      "platform": "linux-musl-x64",
      "expected": {
        "code": "platform_not_locked",
        "path": "platforms"
      }
    },
    {
      "name": "a receipt binds the exact lock bytes and its platform closure",
      "kind": "receipt-lock",
      "receipt": "receipt/win-x64-qualified.json",
      "lock": "lock/two-platforms-bound.json",
      "expected": "valid"
    },
    {
      "name": "a receipt refuses different lock bytes",
      "kind": "receipt-lock",
      "receipt": "receipt/win-x64-qualified.json",
      "lock": "lock/approved-fragment.json",
      "expected": {
        "code": "lock_changed",
        "path": "lockSha256"
      }
    },
    {
      "name": "a receipt refuses a substituted provider artifact",
      "kind": "receipt-lock",
      "receipt": "receipt/binding/provider-substituted.json",
      "lock": "lock/two-platforms-bound.json",
      "expected": {
        "code": "receipt_lock_mismatch",
        "path": "providers[0].identity"
      }
    },
    {
      "name": "a receipt refuses a substituted host deployment",
      "kind": "receipt-lock",
      "receipt": "receipt/binding/host-deployment-substituted.json",
      "lock": "lock/two-platforms-bound.json",
      "expected": {
        "code": "receipt_lock_mismatch",
        "path": "host.identity"
      }
    }
  ]
}
