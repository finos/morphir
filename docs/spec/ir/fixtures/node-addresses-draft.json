  "resolutionCases": [
    {
      "id": "node-resolve-0001",
      "purpose": "A named current target follows the current artifact",
      "subject": "V4 Library acme/orders with domain type order",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/order",
      "expectedOutcome": "resolved"
    },
    {
      "id": "node-resolve-0002",
      "purpose": "Deleting a named target makes an unpinned address stale",
      "subject": "V4 Library acme/orders without domain type order",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/order",
      "expectedOutcome": "stale_target"
    },
    {
      "id": "node-resolve-0003",
      "purpose": "Two matching current package releases are not chosen arbitrarily",
      "subject": "Resolver context contains two releases of acme/orders",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/order",
      "expectedOutcome": "ambiguous_artifact"
    },
    {
      "id": "node-resolve-0004",
      "purpose": "A pinned revision does not fall back to the current one",
      "subject": "Only current revision bbbb is available",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0&rev=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa#/module/domain/type/order",
      "expectedOutcome": "revision_unavailable"
    },
    {
      "id": "node-resolve-0005",
      "purpose": "A V3 address cannot be silently rebound to a V4 artifact",
      "subject": "Resolver context selects V4 Library acme/orders",
      "uri": "morphir://ir/pkg/acme/orders?format=3.0.0#/module/domain/type/order",
      "expectedOutcome": "format_version_mismatch"
    },
    {
      "id": "node-resolve-0006",
      "purpose": "A changed constructor makes a typed child path stale",
      "subject": "V4 value calculate-total body is a Variable, not Apply",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/value/calculate-total/body/apply/argument",
      "expectedOutcome": "stale_target"
    },
    {
      "id": "node-resolve-0007",
      "purpose": "Changing an ordered child makes its unpinned lineage guard stale",
      "subject": "V4 type pair has an inserted first tuple element; the selected ordered-step lineage has a different semantic fingerprint",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0&guard=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb#/module/domain/type/pair/type-exp/tuple/element/1",
      "expectedOutcome": "stale_target"
    },
    {
      "id": "node-resolve-0008",
      "purpose": "An unchanged ordered-step lineage resolves in the current artifact",
      "subject": "V4 type pair second tuple element has the recorded ordered-step lineage fingerprint",
      "uri": "morphir://ir/pkg/acme/orders?format=4.0.0&guard=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb#/module/domain/type/pair/type-exp/tuple/element/1",
      "expectedOutcome": "resolved"
    },
    {
      "id": "node-resolve-0009",
