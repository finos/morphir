      "expectedAddress": {
        "artifact": {
          "kind": "package",
          "packagePath": "acme/orders"
        },
        "formatVersion": "4.0.0",
        "root": {
          "kind": "type",
          "module": "domain",
          "name": "order",
          "owner": {
            "kind": "own-package"
          }
        },
        "steps": [
          {
            "kind": "type-expression"
          },
          {
            "kind": "record-field",
            "name": "customer-id"
          }
        ],
        "revision": {
          "kind": "current"
        },
        "guard": null
      },
      "profiles": [
        "json",
        "yaml",
        "document-tree"
      ],
      "expectedCanonicalUri": "morphir://ir/pkg/acme/orders?format=4.0.0#/module/domain/type/order/type-exp/record/field/customer-id"
    },
    {
