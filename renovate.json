{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Chicago",
  "schedule": ["* 0-5 * * 1"],
  "updateNotScheduled": false,
  "prHourlyLimit": 1,
  "prConcurrentLimit": 3,
  "separateMajorMinor": true,
  "vulnerabilityAlerts": {
    "groupName": null,
    "schedule": [],
    "dependencyDashboardApproval": false
  },
  "packageRules": [
    {
      "description": "Group dependency updates across all managers",
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "groupSingleUpdates": true
    },
    {
      "description": "Require dashboard approval for the major dependency batch",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
