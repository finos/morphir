{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/mep-guest-kit/0.1.0-draft.1/report.schema.json",
  "title": "MEP guest kit report 0.1.0-draft.1",
  "description": "One run of the generic JSON Library guest kit against one guest through one host. The plan rebuild, the request rebuild, the comparisons and the verdict rule are checks of the report check, stated in spec/mep/mck/guest-report.md.",
  "type": "object",
  "required": [
    "$schema",
    "suite",
    "runner",
    "host",
    "artifacts",
    "plan",
    "cases",
    "unmatched",
    "totals",
    "verdict"
  ],
  "properties": {
    "$schema": {
      "const": "https://morphir.finos.org/schemas/mep-guest-kit/0.1.0-draft.1/report.schema.json"
    },
    "suite": {
      "type": "object",
      "required": [ "kit", "profile", "contractVersion", "sha256" ],
      "properties": {
        "kit": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "const": "generic-json-library-v1"
        },
        "contractVersion": {
          "const": "0.1.0-draft.1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "runner": {
      "type": "object",
      "required": [ "name", "version" ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "host": {
      "type": "object",
      "required": [ "executable", "sha256", "arguments" ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "offering": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [ "path", "sha256" ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "plan": {
      "description": "What the recorded describe observation selects. null when it selects nothing.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [ "language", "irVersions" ],
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1
            },
            "irVersions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [ "3.0.0", "4.0.0" ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [ "caseId", "outcome", "request", "observed" ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [ "passed", "failed", "not_run" ]
          },
          "failure": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "description": "The actual outer JSON-RPC message, or null when unattempted. A not_run guest check with withheld or unknown delivery retains any actual outer message.",
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/$defs/observation"
              },
              {
                "type": "null"
              }
            ]
          },
          "delivery": {
            "description": "Required notification delivery. Withheld or unknown cannot pass, even without a call request. Actual outer observations remain recorded when the guest check is not_run.",
            "enum": [ "delivered", "withheld", "unknown" ]
          }
        }
      }
    },
    "unmatched": {
      "description": "Every message the runner read that answers no request of the case during which it arrived.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "duringCase", "message" ],
        "properties": {
          "duringCase": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "required": [ "cases", "passed", "failed", "notRun" ],
      "properties": {
        "cases": {
          "$ref": "#/$defs/count"
        },
        "passed": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "notRun": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "required": [ "qualified", "reasons" ],
      "properties": {
        "qualified": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [ "code", "caseId" ],
            "properties": {
              "code": {
                "enum": [ "case_failed", "case_not_run" ]
              },
              "caseId": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "required": [ "kind", "message" ],
          "properties": {
            "kind": {
              "const": "response"
            },
            "message": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "kind" ],
          "properties": {
            "kind": {
              "const": "silent"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "kind", "exitCode", "stdoutClosed" ],
          "properties": {
            "kind": {
              "const": "exit"
            },
            "exitCode": {
              "type": "integer"
            },
            "stdoutClosed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "kind", "reason" ],
          "properties": {
            "kind": {
              "const": "incomplete"
            },
            "reason": {
              "enum": [
                "timeout",
                "end-of-stream",
                "invalid-frame",
                "process-exited"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
