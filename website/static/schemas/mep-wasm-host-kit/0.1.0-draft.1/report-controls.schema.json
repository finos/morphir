{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/mep-wasm-host-kit/0.1.0-draft.1/report-controls.schema.json",
  "title": "WASM host qualification report controls 0.1.0-draft.1",
  "description": "Fixed controls for the verdict rule of the WASM host qualification report. Each control describes a report by its difference from one base report and gives the verdict, or the refusals, a report check must produce. The meaning of each member is stated in spec/mep/mck/wasm-host-report.md.",
  "type": "object",
  "required": ["$schema", "corpus", "contract", "rule", "base", "controls"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://morphir.finos.org/schemas/mep-wasm-host-kit/0.1.0-draft.1/report-controls.schema.json"
    },
    "corpus": { "type": "string", "minLength": 1 },
    "contract": { "type": "string", "minLength": 1 },
    "rule": {
      "type": "object",
      "required": ["boundOrder", "profileOrder", "reasons", "rejections", "scenarios"],
      "additionalProperties": false,
      "properties": {
        "boundOrder": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/bound" }
        },
        "profileOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        },
        "reasons": { "$ref": "#/$defs/names" },
        "rejections": { "$ref": "#/$defs/names" },
        "scenarios": { "$ref": "#/$defs/names" }
      }
    },
    "base": {
      "type": "object",
      "required": ["runner", "host", "bounds", "guestKitCitations"],
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "host": {
          "type": "object",
          "required": ["sha256", "profiles", "offering", "platform", "engine"],
          "additionalProperties": false,
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "profiles": { "$ref": "#/$defs/profiles" },
            "offering": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 },
            "engine": { "type": "string", "minLength": 1 }
          }
        },
        "bounds": {
          "type": "object",
          "required": ["memoryCeiling", "instructionBudget", "callDeadline"],
          "additionalProperties": false,
          "properties": {
            "memoryCeiling": { "$ref": "#/$defs/declaration" },
            "instructionBudget": { "$ref": "#/$defs/declaration" },
            "callDeadline": { "$ref": "#/$defs/declaration" }
          }
        },
        "guestKitCitations": { "$ref": "#/$defs/citations" }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "covers", "says", "change", "expect"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "covers": { "type": "string", "minLength": 1 },
          "says": { "type": "string", "minLength": 1 },
          "change": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runner": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": { "type": ["string", "null"] },
                  "version": { "type": ["string", "null"] }
                }
              },
              "host": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sha256": { "type": ["string", "null"] },
                  "profiles": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "offering": { "type": ["string", "null"] },
                  "platform": { "type": ["string", "null"] },
                  "engine": { "type": ["string", "null"] }
                }
              },
              "bounds": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "memoryCeiling": { "$ref": "#/$defs/declaration" },
                  "instructionBudget": { "$ref": "#/$defs/declaration" },
                  "callDeadline": { "$ref": "#/$defs/declaration" }
                }
              },
              "guestKitCitations": { "$ref": "#/$defs/citations" },
              "corpusSha256": { "$ref": "#/$defs/sha256" },
              "outcomes": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/outcome" }
              },
              "deviations": { "$ref": "#/$defs/caseIds" },
              "removeCases": { "$ref": "#/$defs/caseIds" },
              "duplicateCases": { "$ref": "#/$defs/caseIds" },
              "swapCases": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "string", "minLength": 1 }
              },
              "storedTotals": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 }
              },
              "storedVerdict": { "$ref": "#/$defs/verdict" }
            }
          },
          "expect": {
            "oneOf": [
              { "$ref": "#/$defs/verdict" },
              {
                "type": "object",
                "required": ["rejected"],
                "additionalProperties": false,
                "properties": {
                  "rejected": { "$ref": "#/$defs/names" }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profile": { "enum": ["extism-kernel-v1", "morphir-bytes-v1"] },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profile" }
    },
    "bound": { "enum": ["memoryCeiling", "instructionBudget", "callDeadline"] },
    "declaration": { "enum": ["enforced", "not-enforced", "inconsistent", "undeclared"] },
    "outcome": {
      "enum": ["passed", "failed", "error", "refused", "not_applicable", "not_enforced"]
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$" }
    },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile", "hostSha256"],
        "additionalProperties": false,
        "properties": {
          "profile": { "$ref": "#/$defs/profile" },
          "hostSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["qualified", "reasons"],
      "additionalProperties": false,
      "properties": {
        "qualified": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "bound": { "$ref": "#/$defs/bound" },
              "caseId": { "type": "string", "minLength": 1 },
              "profile": { "$ref": "#/$defs/profile" }
            }
          }
        }
      }
    }
  }
}
