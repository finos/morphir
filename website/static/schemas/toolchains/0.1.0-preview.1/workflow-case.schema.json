{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/toolchains/0.1.0-preview.1/workflow-case.schema.json",
  "title": "Morphir toolchain readiness workflow case 0.1.0-preview.1",
  "description": "A fixed compile-and-generate case with fixed expectations that a conformance runner executes through its adapters. Unknown members are ignored unless critical names them",
  "type": "object",
  "required": [
    "$schema",
    "workflow",
    "preset",
    "basis",
    "package",
    "sources",
    "steps"
  ],
  "properties": {
    "$schema": {
      "const": "https://morphir.finos.org/schemas/toolchains/0.1.0-preview.1/workflow-case.schema.json"
    },
    "critical": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "$schema",
          "critical",
          "workflow",
          "preset",
          "basis",
          "package",
          "sources",
          "steps"
        ]
      }
    },
    "workflow": {
      "$ref": "#/$defs/token"
    },
    "preset": {
      "$ref": "#/$defs/token"
    },
    "basis": {
      "type": "object",
      "required": [
        "kind",
        "repository",
        "commit",
        "case",
        "feature",
        "featureBlob",
        "vocabulary",
        "variant"
      ],
      "properties": {
        "kind": {
          "const": "corpus-case"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "case": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*-[0-9]{4}$"
        },
        "feature": {
          "$ref": "#/$defs/relativePath"
        },
        "featureBlob": {
          "$ref": "#/$defs/gitObject"
        },
        "vocabulary": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "variant": {
          "type": "object",
          "required": [
            "input",
            "version"
          ],
          "properties": {
            "input": {
              "$ref": "#/$defs/input"
            },
            "version": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "name",
        "exposedModules"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)+$"
        },
        "exposedModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*(?:\\.[A-Z][A-Za-z0-9]*)*$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "uri",
          "file",
          "sha256"
        ],
        "properties": {
          "uri": {
            "$ref": "#/$defs/relativePath"
          },
          "file": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/compileStep"
        }
      ],
      "items": {
        "$ref": "#/$defs/generateStep"
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "extensionIdentity": {
      "$ref": "https://morphir.finos.org/schemas/extensions/0.1.0-preview.1/release.schema.json#/$defs/id"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*/$)[^\\u0000-\\u001F<>:\"\\\\|?*\\u2028\\u2029]+$",
      "maxLength": 240,
      "minLength": 1
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})\\.(0|[1-9][0-9]{0,14})(?:-(?:0|[1-9][0-9]{0,14}|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]{0,14}|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 256
    },
    "input": {
      "enum": [
        "files",
        "directory",
        "project file"
      ]
    },
    "comparison": {
      "enum": [
        "json-member-order-insensitive",
        "exact-bytes"
      ]
    },
    "modelTuple": {
      "type": "object",
      "required": [
        "operation",
        "profile",
        "codec",
        "envelopeVersion",
        "irVersion"
      ],
      "properties": {
        "operation": {
          "enum": [
            "morphir.frontend.compileModel",
            "morphir.backend.generateModel"
          ]
        },
        "profile": {
          "$ref": "#/$defs/token"
        },
        "codec": {
          "$ref": "#/$defs/token"
        },
        "envelopeVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "irVersion": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "modelInput": {
      "type": "object",
      "required": [
        "profile",
        "codec",
        "irVersion"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/token"
        },
        "codec": {
          "$ref": "#/$defs/token"
        },
        "irVersion": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "provenance": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "generated"
              }
            }
          },
          "then": {
            "required": [
              "pullRequest",
              "released",
              "observedOn",
              "producers",
              "blob"
            ]
          },
          "else": {
            "required": [
              "commit",
              "path",
              "blob"
            ]
          }
        }
      ],
      "required": [
        "kind",
        "repository"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hand-authored",
            "spec-derived",
            "reviewed-candidate",
            "generated"
          ]
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "blob": {
          "$ref": "#/$defs/gitObject"
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1
        },
        "released": {
          "type": "boolean"
        },
        "observedOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "producers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "delivery",
              "host"
            ],
            "properties": {
              "delivery": {
                "enum": [
                  "built-in",
                  "process",
                  "wasm",
                  "dotnet-tool"
                ]
              },
              "host": {
                "enum": [
                  "jit",
                  "native-aot",
                  "dotnet-tool"
                ]
              }
            }
          }
        }
      }
    },
    "compileStep": {
      "type": "object",
      "required": [
        "id",
        "operation",
        "language",
        "input",
        "providers",
        "expected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "operation": {
          "const": "compile"
        },
        "language": {
          "$ref": "#/$defs/token"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "expected": {
          "type": "object",
          "required": [
            "outcome",
            "ir"
          ],
          "properties": {
            "outcome": {
              "const": "success-without-error-diagnostics"
            },
            "ir": {
              "type": "object",
              "required": [
                "file",
                "sha256",
                "formatVersion",
                "comparison",
                "provenance"
              ],
              "properties": {
                "file": {
                  "$ref": "#/$defs/relativePath"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "formatVersion": {
                  "type": "integer",
                  "maximum": 9007199254740991,
                  "minimum": 1
                },
                "comparison": {
                  "const": "json-member-order-insensitive"
                },
                "provenance": {
                  "$ref": "#/$defs/provenance"
                }
              }
            }
          }
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/caseProvider",
            "if": {
              "properties": {
                "delivery": {
                  "const": "built-in"
                }
              }
            },
            "then": {
              "required": [
                "modelOutput"
              ]
            }
          }
        }
      }
    },
    "generatedSet": {
      "type": "object",
      "required": [
        "files",
        "comparison",
        "provenance"
      ],
      "properties": {
        "appliesTo": {
          "type": "object",
          "required": [
            "delivery"
          ],
          "properties": {
            "delivery": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "built-in",
                  "process",
                  "wasm",
                  "dotnet-tool"
                ]
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "file",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "file": {
                "$ref": "#/$defs/relativePath"
              },
              "bytes": {
                "type": "integer",
                "maximum": 9007199254740991,
                "minimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "generateStep": {
      "type": "object",
      "required": [
        "id",
        "operation",
        "target",
        "input",
        "providers",
        "expected",
        "formatting"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "operation": {
          "const": "generate"
        },
        "target": {
          "$ref": "#/$defs/token"
        },
        "input": {
          "type": "object",
          "required": [
            "step",
            "model"
          ],
          "properties": {
            "step": {
              "$ref": "#/$defs/token"
            },
            "model": {
              "const": "expected-ir"
            }
          }
        },
        "expected": {
          "type": "object",
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "sets": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "sets": {
                "minItems": 1
              }
            }
          },
          "required": [
            "status",
            "sets"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "frozen"
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "sets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/generatedSet"
              }
            }
          }
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/caseProvider",
            "if": {
              "properties": {
                "delivery": {
                  "const": "built-in"
                }
              }
            },
            "then": {
              "required": [
                "modelInput"
              ]
            }
          }
        },
        "formatting": {
          "description": "Generation runs with formatting explicitly off, however the host spells it.",
          "const": "off"
        }
      }
    },
    "caseProvider": {
      "type": "object",
      "if": {
        "properties": {
          "delivery": {
            "const": "built-in"
          }
        }
      },
      "then": {
        "required": [
          "extensionId"
        ]
      },
      "else": {
        "required": [
          "protocolVersion",
          "modelTuple"
        ]
      },
      "required": [
        "delivery"
      ],
      "properties": {
        "delivery": {
          "enum": [
            "built-in",
            "process",
            "wasm",
            "dotnet-tool"
          ]
        },
        "extensionId": {
          "$ref": "#/$defs/extensionIdentity"
        },
        "protocolVersion": {
          "$ref": "#/$defs/mepVersion"
        },
        "modelTuple": {
          "$ref": "#/$defs/modelTuple"
        },
        "modelInput": {
          "$ref": "#/$defs/modelInput"
        },
        "modelOutput": {
          "$ref": "#/$defs/modelInput"
        }
      }
    },
    "mepVersion": {
      "description": "A MEP version on the supported 0.2 line: every prerelease of 0.2.0 and every final 0.2.x, in canonical SemVer spelling without build metadata.",
      "type": "string",
      "pattern": "^0\\.2\\.(?:0-(?:0|[1-9][0-9]{0,14}|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]{0,14}|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*|0|[1-9][0-9]{0,14})$",
      "maxLength": 256
    }
  },
  "not": {
    "required": [
      "schemaVersion"
    ]
  }
}
