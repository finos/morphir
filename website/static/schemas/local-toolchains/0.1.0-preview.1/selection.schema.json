{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/local-toolchains/0.1.0-preview.1/selection.schema.json",
  "title": "Local developer toolchain selection",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://morphir.finos.org/schemas/local-toolchains/0.1.0-preview.1/selection.schema.json"
    },
    "origin": {
      "const": "local-developer"
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receiptPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  },
  "required": [
    "$schema",
    "origin",
    "candidateSha256",
    "receiptSha256",
    "receiptPath"
  ],
  "additionalProperties": false
}
