{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/local-toolchains/0.1.0-preview.2/receipt.schema.json",
  "title": "Local developer composed toolchain receipt",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://morphir.finos.org/schemas/local-toolchains/0.1.0-preview.2/receipt.schema.json"
    },
    "origin": {
      "const": "local-developer"
    },
    "implementation": {
      "const": "dotnet"
    },
    "deployment": {
      "const": "self-contained"
    },
    "platform": {
      "const": "win-x64"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "buildIdentity": {
      "type": "string",
      "minLength": 1
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archiveSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installationPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "entryPoint": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "owner": {
      "const": "manager-owned"
    },
    "readiness": {
      "const": "workflow-verified"
    },
    "generationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "$schema",
    "origin",
    "implementation",
    "deployment",
    "platform",
    "version",
    "sourceCommit",
    "buildIdentity",
    "candidateSha256",
    "archiveSha256",
    "installationPath",
    "entryPoint",
    "owner",
    "readiness",
    "generationSha256"
  ],
  "additionalProperties": false
}
