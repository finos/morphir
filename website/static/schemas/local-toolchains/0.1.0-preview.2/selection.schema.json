{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/local-toolchains/0.1.0-preview.2/selection.schema.json",
  "title": "Local developer composed toolchain selection",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://morphir.finos.org/schemas/local-toolchains/0.1.0-preview.2/selection.schema.json"
    },
    "origin": {
      "const": "local-developer"
    },
    "generationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receiptPath": {
      "type": "string",
      "pattern": "^toolchains/generations/[0-9a-f]{64}/receipt\\.json$"
    }
  },
  "required": [
    "$schema",
    "origin",
    "generationSha256",
    "receiptSha256",
    "receiptPath"
  ],
  "additionalProperties": false
}
