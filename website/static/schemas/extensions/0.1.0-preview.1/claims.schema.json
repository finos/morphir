{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/extensions/0.1.0-preview.1/claims.schema.json",
  "title": "Extension capability claims",
  "type": "object",
  "not": {
    "anyOf": [
      {
        "required": [ "claimsVersion" ]
      },
      {
        "required": [ "statementVersion" ]
      }
    ]
  },
  "required": [ "$schema", "protocolVersions", "extension", "capabilities" ],
  "properties": {
    "$schema": {
      "const": "https://morphir.finos.org/schemas/extensions/0.1.0-preview.1/claims.schema.json"
    },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$"
      }
    },
    "extension": {
      "type": "object",
      "required": [ "id", "name", "version", "types" ],
      "properties": {
        "id": {
          "type": "string",
          "not": {
            "pattern": "^(con|prn|aux|nul|com[1-9]|lpt[1-9])(\\.|$)"
          },
          "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?(\\.[a-z]([a-z0-9-]*[a-z0-9])?)*$",
          "maxLength": 238
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "frontend",
              "backend",
              "transform",
              "validator",
              "workspace"
            ]
          }
        },
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": [],
      "properties": {
        "frontend": {
          "type": "object",
          "required": [ "languages", "irVersions", "compile" ],
          "properties": {
            "languages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [ "id", "fileExtensions" ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fileExtensions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "irVersions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "compile": {
              "type": "boolean"
            },
            "incremental": {
              "type": "boolean"
            },
            "fragments": {
              "type": "boolean"
            },
            "multiDocument": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "backend": {
          "type": "object",
          "required": [ "targets", "irVersions", "generate" ],
          "properties": {
            "targets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "irVersions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "generate": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "workspace": {
          "type": "object"
        },
        "validator": {
          "type": "object"
        },
        "transform": {
          "type": "object"
        },
        "modelTransport": {
          "type": "object"
        },
        "streaming": {
          "type": "boolean"
        },
        "incremental": {
          "type": "boolean"
        },
        "cancellation": {
          "type": "boolean"
        },
        "progress": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "critical": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires": {
      "type": "object",
      "required": [ "host" ],
      "properties": {
        "host": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "embedded": {
      "type": "object",
      "not": {
        "anyOf": [
          {
            "required": [ "$schema" ]
          },
          {
            "required": [ "claimsVersion" ]
          },
          {
            "required": [ "statementVersion" ]
          }
        ]
      },
      "required": [ "protocolVersions", "extension", "capabilities" ],
      "properties": {
        "protocolVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$"
          }
        },
        "extension": {
          "type": "object",
          "required": [ "id", "name", "version", "types" ],
          "properties": {
            "id": {
              "type": "string",
              "not": {
                "pattern": "^(con|prn|aux|nul|com[1-9]|lpt[1-9])(\\.|$)"
              },
              "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?(\\.[a-z]([a-z0-9-]*[a-z0-9])?)*$",
              "maxLength": 238
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$"
            },
            "types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "frontend",
                  "backend",
                  "transform",
                  "validator",
                  "workspace"
                ]
              }
            },
            "description": {
              "type": "string"
            },
            "license": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "capabilities": {
          "type": "object",
          "required": [],
          "properties": {
            "frontend": {
              "type": "object",
              "required": [ "languages", "irVersions", "compile" ],
              "properties": {
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [ "id", "fileExtensions" ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fileExtensions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "irVersions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "compile": {
                  "type": "boolean"
                },
                "incremental": {
                  "type": "boolean"
                },
                "fragments": {
                  "type": "boolean"
                },
                "multiDocument": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "backend": {
              "type": "object",
              "required": [ "targets", "irVersions", "generate" ],
              "properties": {
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "irVersions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "generate": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "workspace": {
              "type": "object"
            },
            "validator": {
              "type": "object"
            },
            "transform": {
              "type": "object"
            },
            "modelTransport": {
              "type": "object"
            },
            "streaming": {
              "type": "boolean"
            },
            "incremental": {
              "type": "boolean"
            },
            "cancellation": {
              "type": "boolean"
            },
            "progress": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "critical": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires": {
          "type": "object",
          "required": [ "host" ],
          "properties": {
            "host": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
