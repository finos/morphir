{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://morphir.finos.org/schemas/morphir-ir-v3.json",
  "title": "Morphir IR Distribution",
  "description": "A Morphir IR distribution represents a complete, self-contained package of business logic\nwith all its dependencies. It captures the semantics of functional programs in a\nlanguage-independent, platform-agnostic format.\n",
  "type": "object",
  "required": [ "formatVersion", "distribution" ],
  "properties": {
    "formatVersion": {
      "description": "The version of the IR format. Must be 3 for this schema.",
      "type": "integer",
      "const": 3
    },
    "distribution": {
      "description": "The distribution data, currently only Library distributions are supported.",
      "type": "array",
      "maxItems": 4,
      "minItems": 4,
      "items": [
        {
          "description": "The type of distribution. Currently only Library is supported.",
          "type": "string",
          "const": "Library"
        },
        {
          "$ref": "#/definitions/PackageName"
        },
        {
          "$ref": "#/definitions/Dependencies"
        },
        {
          "$ref": "#/definitions/PackageDefinition"
        }
      ]
    }
  },
  "definitions": {
    "Name": {
      "description": "A Name is a list of lowercase words that represents a human-readable identifier.\nEach word is either a lowercase letter followed by lowercase letters/digits,\nor a standalone numeric sequence.\n",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9]*|[0-9]+)$"
      }
    },
    "Path": {
      "description": "A Path is a list of Names representing a hierarchical location in the IR structure.\n",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Name"
      }
    },
    "PackageName": {
      "description": "Globally unique identifier for a package.",
      "$ref": "#/definitions/Path"
    },
    "ModuleName": {
      "description": "Unique identifier for a module within a package.",
      "$ref": "#/definitions/Path"
    },
    "FQName": {
      "description": "Fully-Qualified Name that provides a globally unique identifier for any type or value.\nConsists of [packagePath, modulePath, localName].\n",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "$ref": "#/definitions/PackageName"
        },
        {
          "$ref": "#/definitions/ModuleName"
        },
        {
          "$ref": "#/definitions/Name"
        }
      ]
    },
    "Attributes": {
      "description": "Attributes can be attached to various nodes in the IR for extensibility.\nIn many distributions (like those from morphir-elm), expressions are annotated\nwith their inferred types in the attributes field.\n",
      "oneOf": [
        {
          "type": "object"
        },
        {
          "$ref": "#/definitions/Type"
        }
      ]
    },
    "AccessLevel": {
      "description": "Controls visibility. Strictly PascalCase to match morphir-elm output.",
      "type": "string",
      "enum": [ "Public", "Private" ]
    },
    "AccessControlled": {
      "description": "Wrapper that manages visibility. Strictly object {access, value} form in V3.",
      "type": "object",
      "required": [ "access", "value" ],
      "properties": {
        "access": {
          "$ref": "#/definitions/AccessLevel"
        },
        "value": {
          "description": "The value being access controlled."
        }
      }
    },
    "Dependencies": {
      "description": "Dictionary of package dependencies, contains only type signatures.",
      "type": "array",
      "items": {
        "type": "array",
        "maxItems": 2,
        "minItems": 2,
        "items": [
          {
            "$ref": "#/definitions/PackageName"
          },
          {
            "$ref": "#/definitions/PackageSpecification"
          }
        ]
      }
    },
    "PackageDefinition": {
      "description": "Complete implementation of a package with all details.",
      "type": "object",
      "required": [ "modules" ],
      "properties": {
        "modules": {
          "description": "All modules in the package (public and private).",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "items": [
              {
                "$ref": "#/definitions/ModuleName"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/definitions/AccessControlled"
                  },
                  {
                    "properties": {
                      "value": {
                        "$ref": "#/definitions/ModuleDefinition"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "PackageSpecification": {
      "description": "Public interface of a package, contains only type signatures.",
      "type": "object",
      "required": [ "modules" ],
      "properties": {
        "modules": {
          "description": "Public modules only.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "items": [
              {
                "$ref": "#/definitions/ModuleName"
              },
              {
                "$ref": "#/definitions/ModuleSpecification"
              }
            ]
          }
        }
      }
    },
    "ModuleDefinition": {
      "description": "Complete implementation of a module.",
      "type": "object",
      "required": [ "types", "values" ],
      "properties": {
        "types": {
          "description": "All type definitions (public and private).",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "items": [
              {
                "$ref": "#/definitions/Name"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/definitions/AccessControlled"
                  },
                  {
                    "properties": {
                      "value": {
                        "type": "object",
                        "required": [ "doc", "value" ],
                        "properties": {
                          "doc": {
                            "type": [ "string", "null" ]
                          },
                          "value": {
                            "$ref": "#/definitions/TypeDefinition"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "values": {
          "description": "All value definitions (public and private).",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "items": [
              {
                "$ref": "#/definitions/Name"
              },
              {
                "allOf": [
                  {
                    "$ref": "#/definitions/AccessControlled"
                  },
                  {
                    "properties": {
                      "value": {
                        "type": "object",
                        "required": [ "doc", "value" ],
                        "properties": {
                          "doc": {
                            "type": [ "string", "null" ]
                          },
                          "value": {
                            "$ref": "#/definitions/ValueDefinition"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "doc": {
          "description": "Optional documentation for the module.",
          "type": [ "string", "null" ]
        }
      }
    },
    "ModuleSpecification": {
      "description": "Public interface of a module.",
      "type": "object",
      "required": [ "types", "values" ],
      "properties": {
        "types": {
          "description": "Public type specifications only.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "items": [
              {
                "$ref": "#/definitions/Name"
              },
              {
                "type": "object",
                "required": [ "doc", "value" ],
                "properties": {
                  "doc": {
                    "type": [ "string", "null" ]
                  },
                  "value": {
                    "$ref": "#/definitions/TypeSpecification"
                  }
                }
              }
            ]
          }
        },
        "values": {
          "description": "Public value specifications only.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "items": [
              {
                "$ref": "#/definitions/Name"
              },
              {
                "type": "object",
                "required": [ "doc", "value" ],
                "properties": {
                  "doc": {
                    "type": [ "string", "null" ]
                  },
                  "value": {
                    "$ref": "#/definitions/ValueSpecification"
                  }
                }
              }
            ]
          }
        },
        "doc": {
          "description": "Optional documentation for the module.",
          "type": [ "string", "null" ]
        }
      }
    },
    "Type": {
      "description": "A Type is a recursive tree structure representing type expressions.\nEach type can be one of: Variable, Reference, Tuple, Record, ExtensibleRecord, Function, or Unit.\n",
      "oneOf": [
        {
          "$ref": "#/definitions/VariableType"
        },
        {
          "$ref": "#/definitions/ReferenceType"
        },
        {
          "$ref": "#/definitions/TupleType"
        },
        {
          "$ref": "#/definitions/RecordType"
        },
        {
          "$ref": "#/definitions/ExtensibleRecordType"
        },
        {
          "$ref": "#/definitions/FunctionType"
        },
        {
          "$ref": "#/definitions/UnitType"
        }
      ]
    },
    "VariableType": {
      "description": "A type variable (e.g., 'a' in List a).",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Variable"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Name"
        }
      ]
    },
    "ReferenceType": {
      "description": "Reference to a named type (e.g., String or List Int).",
      "type": "array",
      "maxItems": 4,
      "minItems": 4,
      "items": [
        {
          "const": "Reference"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/FQName"
        },
        {
          "description": "Type arguments for generic types.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Type"
          }
        }
      ]
    },
    "TupleType": {
      "description": "A composition of multiple types in a fixed order (product type).",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Tuple"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "description": "Element types in order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Type"
          }
        }
      ]
    },
    "RecordType": {
      "description": "A composition of named fields with their types.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Record"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "description": "List of field definitions.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Field"
          }
        }
      ]
    },
    "ExtensibleRecordType": {
      "description": "A record type that can be extended with additional fields.",
      "type": "array",
      "maxItems": 4,
      "minItems": 4,
      "items": [
        {
          "const": "ExtensibleRecord"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Name"
        },
        {
          "description": "Known fields.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Field"
          }
        }
      ]
    },
    "FunctionType": {
      "description": "Represents a function type. Multi-argument functions are represented via currying.\nItems: [tag, attributes, argumentType, returnType]\n",
      "type": "array",
      "maxItems": 4,
      "minItems": 4,
      "items": [
        {
          "const": "Function"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Type"
        },
        {
          "$ref": "#/definitions/Type"
        }
      ]
    },
    "UnitType": {
      "description": "The type with exactly one value (similar to void in some languages).",
      "type": "array",
      "maxItems": 2,
      "minItems": 2,
      "items": [
        {
          "const": "Unit"
        },
        {
          "$ref": "#/definitions/Attributes"
        }
      ]
    },
    "Field": {
      "description": "A field in a record type.",
      "type": "object",
      "required": [ "name", "tpe" ],
      "properties": {
        "name": {
          "description": "Field name.",
          "$ref": "#/definitions/Name"
        },
        "tpe": {
          "description": "Field type.",
          "$ref": "#/definitions/Type"
        }
      }
    },
    "TypeSpecification": {
      "description": "Defines the interface of a type without implementation details.",
      "oneOf": [
        {
          "$ref": "#/definitions/TypeAliasSpecification"
        },
        {
          "$ref": "#/definitions/OpaqueTypeSpecification"
        },
        {
          "$ref": "#/definitions/CustomTypeSpecification"
        },
        {
          "$ref": "#/definitions/DerivedTypeSpecification"
        }
      ]
    },
    "TypeAliasSpecification": {
      "description": "An alias for another type.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "TypeAliasSpecification"
        },
        {
          "description": "Type parameters.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Name"
          }
        },
        {
          "$ref": "#/definitions/Type"
        }
      ]
    },
    "OpaqueTypeSpecification": {
      "description": "A type with unknown structure. The implementation is hidden from consumers.\n",
      "type": "array",
      "maxItems": 2,
      "minItems": 2,
      "items": [
        {
          "const": "OpaqueTypeSpecification"
        },
        {
          "description": "Type parameters.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Name"
          }
        }
      ]
    },
    "CustomTypeSpecification": {
      "description": "A tagged union type (sum type).",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "CustomTypeSpecification"
        },
        {
          "description": "Type parameters.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Name"
          }
        },
        {
          "$ref": "#/definitions/Constructors"
        }
      ]
    },
    "DerivedTypeSpecification": {
      "description": "A type with platform-specific representation but known serialization.\n",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "DerivedTypeSpecification"
        },
        {
          "description": "Type parameters.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Name"
          }
        },
        {
          "description": "Details for derived type.",
          "type": "object",
          "required": [ "baseType", "fromBaseType", "toBaseType" ],
          "properties": {
            "baseType": {
              "description": "The type used for serialization.",
              "$ref": "#/definitions/Type"
            },
            "fromBaseType": {
              "description": "Function to convert from base type.",
              "$ref": "#/definitions/FQName"
            },
            "toBaseType": {
              "description": "Function to convert to base type.",
              "$ref": "#/definitions/FQName"
            }
          }
        }
      ]
    },
    "TypeDefinition": {
      "description": "Provides the complete implementation of a type.",
      "oneOf": [
        {
          "$ref": "#/definitions/TypeAliasDefinition"
        },
        {
          "$ref": "#/definitions/CustomTypeDefinition"
        }
      ]
    },
    "TypeAliasDefinition": {
      "description": "Complete definition of a type alias.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "TypeAliasDefinition"
        },
        {
          "description": "Type parameters.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Name"
          }
        },
        {
          "$ref": "#/definitions/Type"
        }
      ]
    },
    "CustomTypeDefinition": {
      "description": "Complete definition of a custom type. If constructors are Private, \nthe specification becomes OpaqueTypeSpecification.\n",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "CustomTypeDefinition"
        },
        {
          "description": "Type parameters.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Name"
          }
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/AccessControlled"
            },
            {
              "properties": {
                "value": {
                  "$ref": "#/definitions/Constructors"
                }
              }
            }
          ]
        }
      ]
    },
    "Constructors": {
      "description": "Dictionary of constructor names to their typed arguments.",
      "type": "array",
      "items": {
        "type": "array",
        "maxItems": 2,
        "minItems": 2,
        "items": [
          {
            "$ref": "#/definitions/Name"
          },
          {
            "description": "Constructor arguments as (name, type) pairs.",
            "type": "array",
            "items": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "items": [
                {
                  "$ref": "#/definitions/Name"
                },
                {
                  "$ref": "#/definitions/Type"
                }
              ]
            }
          }
        ]
      }
    },
    "Value": {
      "description": "A Value is a recursive tree structure representing computations.\nAll data and logic in Morphir are represented as value expressions.\n",
      "oneOf": [
        {
          "$ref": "#/definitions/LiteralValue"
        },
        {
          "$ref": "#/definitions/ConstructorValue"
        },
        {
          "$ref": "#/definitions/TupleValue"
        },
        {
          "$ref": "#/definitions/ListValue"
        },
        {
          "$ref": "#/definitions/RecordValue"
        },
        {
          "$ref": "#/definitions/VariableValue"
        },
        {
          "$ref": "#/definitions/ReferenceValue"
        },
        {
          "$ref": "#/definitions/FieldValue"
        },
        {
          "$ref": "#/definitions/FieldFunctionValue"
        },
        {
          "$ref": "#/definitions/ApplyValue"
        },
        {
          "$ref": "#/definitions/LambdaValue"
        },
        {
          "$ref": "#/definitions/LetDefinitionValue"
        },
        {
          "$ref": "#/definitions/LetRecursionValue"
        },
        {
          "$ref": "#/definitions/DestructureValue"
        },
        {
          "$ref": "#/definitions/IfThenElseValue"
        },
        {
          "$ref": "#/definitions/PatternMatchValue"
        },
        {
          "$ref": "#/definitions/UpdateRecordValue"
        },
        {
          "$ref": "#/definitions/UnitValue"
        }
      ]
    },
    "LiteralValue": {
      "description": "A literal constant value.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Literal"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Literal"
        }
      ]
    },
    "ConstructorValue": {
      "description": "Reference to a custom type constructor.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Constructor"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/FQName"
        }
      ]
    },
    "TupleValue": {
      "description": "A tuple value with multiple elements.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Tuple"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "description": "Element values in order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Value"
          }
        }
      ]
    },
    "ListValue": {
      "description": "A list of values.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "List"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "description": "List elements.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Value"
          }
        }
      ]
    },
    "RecordValue": {
      "description": "A record value with named fields.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Record"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "description": "Dictionary mapping field names to values.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "items": [
              {
                "$ref": "#/definitions/Name"
              },
              {
                "$ref": "#/definitions/Value"
              }
            ]
          }
        }
      ]
    },
    "VariableValue": {
      "description": "Reference to a variable in scope.",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Variable"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Name"
        }
      ]
    },
    "ReferenceValue": {
      "description": "Reference to a defined value (function or constant).",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "Reference"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/FQName"
        }
      ]
    },
    "FieldValue": {
      "description": "Field access on a record. Items: [tag, attributes, recordExpr, fieldName]",
      "type": "array",
      "maxItems": 4,
      "minItems": 4,
      "items": [
        {
          "const": "Field"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Value"
        },
        {
          "$ref": "#/definitions/Name"
        }
      ]
    },
    "FieldFunctionValue": {
      "description": "A function that extracts a field (e.g., .firstName).",
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": [
        {
          "const": "FieldFunction"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Name"
        }
      ]
    },
    "ApplyValue": {
      "description": "Function application. Items: [tag, attributes, function, argument].\nMulti-argument calls are represented via currying (nested Apply nodes).\n",
      "type": "array",
      "maxItems": 4,
      "minItems": 4,
      "items": [
        {
          "const": "Apply"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Value"
        },
        {
          "$ref": "#/definitions/Value"
        }
      ]
    },
    "LambdaValue": {
      "description": "Anonymous function (lambda abstraction).\nItems: [tag, attributes, argumentPattern, body]\n",
      "type": "array",
      "maxItems": 4,
      "minItems": 4,
      "items": [
        {
          "const": "Lambda"
        },
        {
          "$ref": "#/definitions/Attributes"
        },
        {
          "$ref": "#/definitions/Pattern"
        },
        {
          "$ref": "#/definitions/Value"
        }
      ]
    },
    "LetDefinitionValue": {
