{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/wasm-host-reports/0.1.0-preview.1/report.schema.json",
  "title": "WASM host qualification report",
  "type": "object",
  "required": [
    "$schema",
    "suite",
    "runner",
    "host",
    "artifact",
    "limits",
    "bounds",
    "guestKitCitations",
    "cases",
    "verdict"
  ],
  "properties": {
    "$schema": {
      "const": "https://morphir.finos.org/schemas/wasm-host-reports/0.1.0-preview.1/report.schema.json"
    },
    "suite": {
      "$ref": "#/$defs/suite"
    },
    "runner": {
      "$ref": "#/$defs/runner"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "bounds": {
      "type": "array",
      "maxItems": 3,
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/bound"
      }
    },
    "guestKitCitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "verdict": {
      "type": "string",
      "enum": [ "qualified", "not_qualified" ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "object",
      "required": [ "name", "version", "executable", "sha256" ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": [ "path", "commit", "sha256" ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": [ "id", "version", "path", "sha256" ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": [
        "kit",
        "kitVersion",
        "corpus",
        "contract",
        "deadlineMarginMs"
      ],
      "properties": {
        "kit": {
          "type": "string",
          "minLength": 1
        },
        "kitVersion": {
          "type": "string",
          "minLength": 1
        },
        "corpus": {
          "$ref": "#/$defs/corpus"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "deadlineMarginMs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "required": [
        "executable",
        "sha256",
        "arguments",
        "buildIdentity",
        "profiles",
        "offering",
        "platform",
        "engine"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "buildIdentity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profiles": {
          "type": "array",
          "maxItems": 2,
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "extism-kernel-v1"
          },
          "items": {
            "type": "string",
            "enum": [ "extism-kernel-v1", "morphir-bytes-v1" ]
          }
        },
        "offering": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [ "path", "sha256", "hostPath", "origin" ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hostPath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^:]+$",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [ "acquired", "source-built", "synthetic" ]
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "extismCallDeadlineMs",
        "bytesCallDeadlineMs",
        "marginMs",
        "helpTimeoutMs"
      ],
      "properties": {
        "extismCallDeadlineMs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "bytesCallDeadlineMs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        },
        "marginMs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "helpTimeoutMs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "declaration": {
      "oneOf": [
        {
          "type": "object",
          "required": [ "declaration" ],
          "properties": {
            "declaration": {
              "const": "enforced"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "declaration", "reason" ],
          "properties": {
            "declaration": {
              "const": "not_enforced"
            },
            "reason": {
              "type": "string",
              "enum": [
                "no-memory-ceiling",
                "no-instruction-metering",
                "no-call-interruption"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "declaration" ],
          "properties": {
            "declaration": {
              "const": "undeclared"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "bound": {
      "oneOf": [
        {
          "type": "object",
          "required": [ "bound", "declaration" ],
          "properties": {
            "bound": {
              "type": "string",
              "enum": [ "memoryCeiling", "instructionBudget", "callDeadline" ]
            },
            "declaration": {
              "const": "enforced"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "bound", "declaration", "reason" ],
          "properties": {
            "bound": {
              "type": "string",
              "enum": [ "memoryCeiling", "instructionBudget", "callDeadline" ]
            },
            "declaration": {
              "const": "not_enforced"
            },
            "reason": {
              "type": "string",
              "enum": [
                "no-memory-ceiling",
                "no-instruction-metering",
                "no-call-interruption"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "bound", "declaration" ],
          "properties": {
            "bound": {
              "type": "string",
              "enum": [ "memoryCeiling", "instructionBudget", "callDeadline" ]
            },
            "declaration": {
              "const": "undeclared"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "bound", "declaration", "declarations" ],
          "properties": {
            "bound": {
              "type": "string",
              "enum": [ "memoryCeiling", "instructionBudget", "callDeadline" ]
            },
            "declaration": {
              "const": "inconsistent"
            },
            "declarations": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/declaration"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "citation": {
      "type": "object",
      "required": [
        "profile",
        "kit",
        "kitVersion",
        "kitPath",
        "kitSha256",
        "report",
        "reportSha256",
        "hostSha256",
        "guestModuleSha256"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [ "extism-kernel-v1", "morphir-bytes-v1" ]
        },
        "kit": {
          "type": "string",
          "minLength": 1
        },
        "kitVersion": {
          "type": "string",
          "minLength": 1
        },
        "kitPath": {
          "type": "string",
          "minLength": 1
        },
        "kitSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "reportSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hostSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "guestModuleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": [ "path", "sha256", "observedSha256" ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observedSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "end": {
      "oneOf": [
        {
          "type": "object",
          "required": [ "kind", "exitCode" ],
          "properties": {
            "kind": {
              "const": "exited"
            },
            "exitCode": {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": -2147483648
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "kind", "processTreeStopped" ],
          "properties": {
            "kind": {
              "const": "stopped_by_runner"
            },
            "processTreeStopped": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "kind", "reason" ],
          "properties": {
            "kind": {
              "const": "not_started"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [ "kind", "reason" ],
          "properties": {
            "kind": {
              "const": "cleanup_incomplete"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "run": {
      "type": "object",
      "required": [
        "arguments",
        "framesWritten",
        "lastFrameWrittenMs",
        "end",
        "endMs",
        "stdoutBase64",
        "stderr"
      ],
      "properties": {
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "framesWritten": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "lastFrameWrittenMs": {
          "anyOf": [
            {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "$ref": "#/$defs/end"
        },
        "endMs": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "stdoutBase64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "stderr": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [ "atMs", "line" ],
            "properties": {
              "atMs": {
                "type": "integer",
                "maximum": 9007199254740991,
                "minimum": 0
              },
              "line": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [ "caseId", "module", "runs", "outcome" ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "$ref": "#/$defs/module"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "error",
            "refused",
            "not_applicable",
            "not_enforced"
          ]
        },
        "deviation": {
          "type": "object",
          "required": [ "tracking", "note" ],
          "properties": {
            "tracking": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
