  "finos/morphir-workbench-native/bridge",
  "finos/morphir-workbench-native/hosting" @desktop_host,
  "finos/morphir-host" @host,
  "finos/morphir-host/diagnostics",
  "moonrockz/moon-lander-config" @configuration,
  "moonrockz/moon-lander-core" @lander_core,
  "moonrockz/moon-lander-logging" @logging,
  "moonrockz/moon-lander-logging-hosting-async" @sinks,
