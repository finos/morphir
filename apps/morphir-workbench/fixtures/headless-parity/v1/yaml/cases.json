  "cases": [
    {
      "id": "readable",
      "scope": "document",
      "source": "formatVersion: 4\ndistribution:\n  Library:\n    packageName: parity\n    dependencies: {}\n    def: {modules: {}}\n",
      "expected": {
        "status": "ok",
        "normalizedJson": "{\"formatVersion\":4,\"distribution\":{\"Library\":{\"packageName\":\"parity\",\"dependencies\":{},\"def\":{\"modules\":{}}}}}"
      }
    },
    {
      "id": "structural",
      "scope": "document",
      "source": "formatVersion: 4\ndistribution:\n  Library:\n    packageName: [[parity]]\n    dependencies: {}\n    def: {modules: {}}\n",
      "expected": {
        "status": "ok",
        "normalizedJson": "{\"formatVersion\":4,\"distribution\":{\"Library\":{\"packageName\":\"parity\",\"dependencies\":{},\"def\":{\"modules\":{}}}}}"
      }
    },
    {
      "id": "v1-explicit-migration",
      "scope": "document",
      "source": "formatVersion: 1\ndistribution: [\"library\", [[\"parity\"]], [], {modules: []}]\n",
      "expected": {
        "status": "ok",
        "normalizedJson": "{\"formatVersion\":4,\"distribution\":{\"Library\":{\"packageName\":\"parity\",\"dependencies\":{},\"def\":{\"modules\":{}}}}}",
        "sourceVersion": "1.0.0"
      }
    },
    {
      "id": "v2-explicit-migration",
      "scope": "document",
      "source": "formatVersion: 2\ndistribution: [\"Library\", [[\"parity\"]], [], {modules: []}]\n",
      "expected": {
        "status": "ok",
        "normalizedJson": "{\"formatVersion\":4,\"distribution\":{\"Library\":{\"packageName\":\"parity\",\"dependencies\":{},\"def\":{\"modules\":{}}}}}",
        "sourceVersion": "2.0.0"
      }
    },
    {
      "id": "v3-explicit-migration",
      "scope": "document",
      "source": "formatVersion: 3\ndistribution: [\"Library\", [[\"parity\"]], [], {modules: []}]\n",
      "expected": {
        "status": "ok",
        "normalizedJson": "{\"formatVersion\":4,\"distribution\":{\"Library\":{\"packageName\":\"parity\",\"dependencies\":{},\"def\":{\"modules\":{}}}}}",
        "sourceVersion": "3.0.0"
      }
    },
    {
      "id": "bom-crlf-comments",
      "scope": "document",
      "source": "\ufeff# retained\r\nformatVersion: '4.0.0' # version\r\ndistribution:\r\n  Library:\r\n    packageName: parity\r\n    dependencies: {}\r\n    def: {modules: {}}\r\n",
      "expected": {
        "status": "ok",
        "normalizedJson": "{\"formatVersion\":4,\"distribution\":{\"Library\":{\"packageName\":\"parity\",\"dependencies\":{},\"def\":{\"modules\":{}}}}}",
        "original": "exact-source-utf8"
      }
    },
    {
      "id": "exact-integer",
      "scope": "physical-profile",
      "source": "value: 9007199254740993\n",
      "expected": {
        "status": "ok",
        "json": "{\"value\":9007199254740993}"
      }
    },
    {
      "id": "exact-decimal",
      "scope": "physical-profile",
      "source": "value: 123.4500\n",
      "expected": {
        "status": "ok",
        "json": "{\"value\":123.4500}"
      }
    },
    {
      "id": "date-looking",
      "scope": "physical-profile",
      "source": "value: 2026-01-15\n",
      "expected": {
        "status": "ok",
        "json": "{\"value\":\"2026-01-15\"}"
      }
    },
    {
      "id": "multiline",
      "scope": "physical-profile",
      "source": "value: |\n  first\n  second\n\n",
