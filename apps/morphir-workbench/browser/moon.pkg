  "finos/morphir-workbench/browser/result",
  "finos/morphir-workbench/browser/generated",
  "finos/morphir-workbench/browser/source-selection" @source_selection,
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/cmd",
  "moonbitlang/core/json",
}
