// Adapted from moonrockz/moon-lander tests/moonx-console-controller/console.c,
// commit 93dfb1411e0d2873a5848cb8b86acb0723770ae0, Apache-2.0.
// Changes: actual Morphir arguments and observed child process exit status.
// Test-only Windows console topology and event delivery. No production launcher
// or payload uses this code. MoonBit async owns ordinary I/O and process waits.
#ifndef _WIN32_WINNT
#define _WIN32_WINNT 0x0601
#endif
#include "moonbit.h"
#include <stdint.h>

#ifdef _WIN32
#include <windows.h>
#include <stdlib.h>
#include <string.h>
#include <wchar.h>

static PROCESS_INFORMATION owned_process;
static HANDLE observed_child;

int32_t morphir_test_moonx_console_prepare(void) {
  HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
  HANDLE output = GetStdHandle(STD_OUTPUT_HANDLE);
  HANDLE error = GetStdHandle(STD_ERROR_HANDLE);
  // Run before the ordinary async entry initializes its console handler. Keep
  // this console attached until process exit so that handler teardown is valid.
  FreeConsole();
  if (!AllocConsole()) return (int32_t)GetLastError();
  SetStdHandle(STD_INPUT_HANDLE, input);
  SetStdHandle(STD_OUTPUT_HANDLE, output);
  SetStdHandle(STD_ERROR_HANDLE, error);
  return SetConsoleCtrlHandler(NULL, FALSE) ? 0 : (int32_t)GetLastError();
}

static WCHAR *copy_text(moonbit_string_t text, int32_t length) {
  WCHAR *result = (WCHAR *)calloc((size_t)length + 1, sizeof(WCHAR));
  if (result) memcpy(result, text, (size_t)length * sizeof(WCHAR));
  return result;
}

// Standard Windows argv quoting, including trailing backslashes before a quote.
static WCHAR *quoted(WCHAR *out, const WCHAR *text, int32_t length) {
  *out++ = L'"';
  int32_t slashes = 0;
  for (int32_t i = 0; i < length; i++) {
    WCHAR c = text[i];
    if (c == L'\\') { slashes++; continue; }
    int32_t count = c == L'"' ? slashes * 2 + 1 : slashes;
    while (count-- > 0) *out++ = L'\\';
    *out++ = c;
    slashes = 0;
  }
  while (slashes-- > 0) { *out++ = L'\\'; *out++ = L'\\'; }
  *out++ = L'"';
  return out;
}

int32_t morphir_test_moonx_console_start(
  moonbit_string_t runner, int32_t runner_len,
  moonbit_string_t entry, int32_t entry_len,
  moonbit_string_t boundary, int32_t boundary_len,
  int32_t registry
) {
  WCHAR *exe = copy_text(runner, runner_len);
  size_t capacity = ((size_t)runner_len + entry_len + boundary_len) * 2 + 256;
  WCHAR *command = (WCHAR *)calloc(capacity, sizeof(WCHAR));
  if (!exe || !command) { free(exe); free(command); SetLastError(ERROR_NOT_ENOUGH_MEMORY); return 0; }
  WCHAR *end = quoted(command, exe, runner_len);
  *end++ = L' ';
  end = quoted(end, (const WCHAR *)entry, entry_len);
  const WCHAR *arguments = registry ? L" worksheet - --isolated --discovery-boundary " : L" -- worksheet - --isolated --discovery-boundary ";
  size_t length = wcslen(arguments);
  memcpy(end, arguments, length * sizeof(WCHAR)); end += length;
  end = quoted(end, (const WCHAR *)boundary, boundary_len);
  memcpy(end, L" --json", 7 * sizeof(WCHAR)); end += 7;
  *end = 0;

  HANDLE handles[3] = {NULL, NULL, NULL};
  DWORD ids[3] = {STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE};
  HANDLE original[3] = {GetStdHandle(STD_INPUT_HANDLE), GetStdHandle(STD_OUTPUT_HANDLE), GetStdHandle(STD_ERROR_HANDLE)};
  DWORD error = ERROR_SUCCESS;
  // The target inherits this ordinary isolated console and enabled Ctrl-C.
  // Ctrl-C cases retain the enabled console attribute, matching the real host.
  if (!SetConsoleCtrlHandler(NULL, FALSE)) { error = GetLastError(); goto done; }
  for (int i = 0; i < 3; i++) {
    if (!DuplicateHandle(GetCurrentProcess(), GetStdHandle(ids[i]), GetCurrentProcess(),
                         &handles[i], 0, TRUE, DUPLICATE_SAME_ACCESS)) {
      error = GetLastError(); goto done;
    }
  }
  SIZE_T bytes = 0;
  InitializeProcThreadAttributeList(NULL, 1, 0, &bytes);
  LPPROC_THREAD_ATTRIBUTE_LIST attributes = (LPPROC_THREAD_ATTRIBUTE_LIST)HeapAlloc(GetProcessHeap(), 0, bytes);
  if (!attributes) { error = ERROR_NOT_ENOUGH_MEMORY; goto done; }
  if (!InitializeProcThreadAttributeList(attributes, 1, 0, &bytes)) {
    error = GetLastError(); HeapFree(GetProcessHeap(), 0, attributes); goto done;
  }
  if (!UpdateProcThreadAttribute(attributes, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
                                 handles, sizeof(handles), NULL, NULL)) {
    error = GetLastError();
  } else {
    STARTUPINFOEXW startup;
    ZeroMemory(&startup, sizeof(startup));
    startup.StartupInfo.cb = sizeof(startup);
    startup.StartupInfo.dwFlags = STARTF_USESTDHANDLES | STARTF_USESHOWWINDOW;
    startup.StartupInfo.wShowWindow = SW_HIDE;
    startup.StartupInfo.hStdInput = handles[0];
    startup.StartupInfo.hStdOutput = handles[1];
    startup.StartupInfo.hStdError = handles[2];
    startup.lpAttributeList = attributes;
    ZeroMemory(&owned_process, sizeof(owned_process));
    DWORD flags = CREATE_UNICODE_ENVIRONMENT |
                  EXTENDED_STARTUPINFO_PRESENT | CREATE_SUSPENDED;
    if (!CreateProcessW(exe, command, NULL, NULL, TRUE, flags, NULL, NULL,
                        &startup.StartupInfo, &owned_process)) error = GetLastError();
  }
  DeleteProcThreadAttributeList(attributes);
  HeapFree(GetProcessHeap(), 0, attributes);
done:
  // Ignore Ctrl-C only in the controller, after the child inherited its normal
  // attribute. Do not detach or reset async's registered console handlers.
  SetConsoleCtrlHandler(NULL, TRUE);
  for (int i = 0; i < 3; i++) SetStdHandle(ids[i], original[i]);
  for (int i = 0; i < 3; i++) if (handles[i]) CloseHandle(handles[i]);
  free(exe); free(command);
  SetLastError(error);
  return error ? 0 : (int32_t)owned_process.dwProcessId;
}

int32_t morphir_test_moonx_console_resume(void) {
  return ResumeThread(owned_process.hThread) == (DWORD)-1 ? (int32_t)GetLastError() : 0;
}

int32_t morphir_test_moonx_console_event(void) {
  BOOL ok = GenerateConsoleCtrlEvent(CTRL_C_EVENT, 0);
  DWORD error = ok ? ERROR_SUCCESS : GetLastError();
  return (int32_t)error;
}

int32_t morphir_test_moonx_console_error(void) { return (int32_t)GetLastError(); }

int32_t morphir_test_moonx_process_running(int32_t pid) {
  HANDLE process = OpenProcess(SYNCHRONIZE, FALSE, (DWORD)pid);
  if (!process) return GetLastError() == ERROR_INVALID_PARAMETER ? 0 : -(int32_t)GetLastError();
  DWORD state = WaitForSingleObject(process, 0);
  CloseHandle(process);
  return state == WAIT_OBJECT_0 ? 0 : state == WAIT_TIMEOUT ? 1 : -1;
}

int32_t morphir_test_moonx_watch_child(int32_t pid) {
  if (observed_child) { SetLastError(ERROR_ALREADY_EXISTS); return ERROR_ALREADY_EXISTS; }
  observed_child = OpenProcess(SYNCHRONIZE | PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_TERMINATE, FALSE, (DWORD)pid);
  return observed_child ? 0 : (int32_t)GetLastError();
}

int32_t morphir_test_moonx_child_status(void) {
  DWORD status = 0;
  SetLastError(ERROR_SUCCESS);
  if (!GetExitCodeProcess(observed_child, &status)) return 0;
  SetLastError(ERROR_SUCCESS);
  return (int32_t)status;
}

void morphir_test_moonx_console_close(void) {
  if (observed_child) {
    // Emergency cleanup is not evidence of successful launcher finalization.
    if (WaitForSingleObject(observed_child, 0) == WAIT_TIMEOUT) {
      TerminateProcess(observed_child, 1);
      WaitForSingleObject(observed_child, 5000);
    }
    CloseHandle(observed_child);
    observed_child = NULL;
  }
  if (owned_process.hProcess) {
    // Emergency fixture cleanup only. Successful proof waited and checked the
    // real owned parent and Node child before reaching this cleanup path.
    if (WaitForSingleObject(owned_process.hProcess, 0) == WAIT_TIMEOUT)
      TerminateProcess(owned_process.hProcess, 1);
    CloseHandle(owned_process.hProcess);
    CloseHandle(owned_process.hThread);
    ZeroMemory(&owned_process, sizeof(owned_process));
  }
}
#else
int32_t morphir_test_moonx_console_prepare(void) { return -1; }
int32_t morphir_test_moonx_console_start(moonbit_string_t a, int32_t al, moonbit_string_t b, int32_t bl,
  moonbit_string_t c, int32_t cl, int32_t registry) { return 0; }
int32_t morphir_test_moonx_console_resume(void) { return -1; }
int32_t morphir_test_moonx_console_event(void) { return -1; }
int32_t morphir_test_moonx_console_error(void) { return -1; }
int32_t morphir_test_moonx_process_running(int32_t pid) { return -1; }
int32_t morphir_test_moonx_watch_child(int32_t pid) { return -1; }
int32_t morphir_test_moonx_child_status(void) { return -1; }
void morphir_test_moonx_console_close(void) {}
#endif
