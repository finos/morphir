import {
  "moonrockz/moon-lander" @lander,
  "moonrockz/moon-lander-core" @lander_core,
  "moonrockz/moon-lander-hosting" @hosting,
  "moonrockz/moon-lander-logging-hosting-async" @sinks,
  "moonrockz/moon-lander-config" @lander_config,
  "moonrockz/moon-lander-mediator/async" @mediator_async,
  "moonbitlang/async",
  "moonbitlang/async/js_async",
  "moonrockz/moon-lander-logging" @logging,
  "moonbitlang/x/crypto",
  "moonrockz/moon-lander-hosting/argparse",
  "moonbitlang/core/string",
  "finos/morphir-engine/execution",
  "finos/morphir-engine/execution/workbench" @connected_core,
  "finos/morphir-engine/worksheet",
  "finos/morphir-engine/worksheet/notebook",
  "moonbitlang/x/path/posix" @path_posix,
  "moonbitlang/x/path/win32" @path_windows,
  "finos/morphir-engine/conformance",
  "finos/morphir-engine/data",
  "finos/morphir-ir/wire" @model_wire,
  "finos/morphir-ir/versioned/json" @versioned_json,
  "finos/morphir-engine/model-document" @model_document,
  "finos/morphir-host/identity",
  "finos/morphir-execution" @protocol,
  "finos/morphir-execution/observability" @observe,
  "finos/morphir-engine" @engine,
  "finos/morphir-engine/moonbit" @moonbit_frontend,
  "finos/morphir-engine/elm" @elm_frontend,
  "finos/morphir-engine/config",
  "finos/morphir-engine/ids",
  "finos/morphir-engine/workspace",
  "finos/morphir-host" @host,
  "finos/morphir-host/diagnostics",
  "finos/morphir-host/metadata/grants" @metadata_grants,
  "finos/morphir-host/platform",
  "finos/morphir-host/toolchain",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
  "moonbit-community/casefold",
  "moonbit-community/unicode-normalization" @normalization,
  "finos/morphir-moonbit/mep",
  "finos/morphir-host/worker",
}

import {
  "moonrockz/expect",
  "moonbitlang/async",
  "moonbitlang/async/fs" @record_fs,
  "moonbitlang/async/process" @record_process,
} for "wbtest"

// The JS adapters use connected_core. Other targets use their own adapters.
// The worker host is for the native and Node entries: wasm-gc has no async
// event loop, and on wasm its driver would import non-WASI functions. The
// extension commands build on native and js; the WASI builds refuse them.

warnings = "-29"

// The CLI owns one process-scoped run at a time, including its foreign callbacks.

max_concurrent_tests = 1

options(
  targets: {
    "hosting_wbtest.mbt": [ "native", "js" ],
    "extension.mbt": [ "native", "js" ],
    "worker_hosting.mbt": [ "native", "js" ],
    "extension_unhosted.mbt": [ "wasm", "wasm-gc" ],
    "extension_wbtest.mbt": [ "native", "js" ],
    "extension_session_wbtest.mbt": [ "native", "js" ],
    "mep_recording_wbtest.mbt": [ "native" ],
  },
)
