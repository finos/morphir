  "finos/morphir-moonbit" @generator,
  "finos/morphir-ir/json" @ir_json,
  "finos/morphir-ir/wire",
  "finos/morphir-metadata/fixtures",
  "moonrockz/ion/binary",
  "moonrockz/ion/text" @ion_text,
  "moonrockz/ion/json" @ion_json,
}

options(
  backend: [ "native" ],
)
